{
  "name": "it-only-happens-once",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "npm run verify && astro build && node scripts/check-server-bundle.mjs",
    "build:unchecked": "astro build && node scripts/check-server-bundle.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "check": "astro check",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "verify": "npm run format:check && npm run lint && npm run check && npm run test",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,astro,mjs,js}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/vercel": "^11.0.5",
    "@iconify-json/ph": "^1.2.2",
    "@iconify-json/simple-icons": "^1.2.93",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tiptap/core": "^3.29.2",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.2.0",
    "astro-icon": "^1.2.0",
    "daisyui": "^5.7.16",
    "marked": "^18.0.9",
    "resend": "^6.18.1",
    "sanitize-html": "^2.17.6",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3",
    "tiptap-markdown": "^0.9.0",
    "wawoff2": "^2.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@fontsource/newsreader": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^22.20.1",
    "@types/sanitize-html": "^2.16.1",
    "devalue": "^5.9.0",
    "eslint": "^10.8.1",
    "eslint-plugin-astro": "^3.1.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "3.9.6",
    "prettier-plugin-astro": "0.14.1",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turndown": "^7.2.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "path-to-regexp": "6.3.0"
  }
}

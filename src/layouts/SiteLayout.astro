---
/*
  SiteLayout — chrome for the PUBLIC site (the reader-facing rooms).

  A quiet top bar with a plain wordmark (design.md §8), and a footer that is an
  address block rather than an ending. On desktop the nav, the theme toggle, and
  the colophon sit inline at the right; on mobile they collapse into a hamburger
  menu (a single set of controls that reflows — no duplicated ids). Wraps
  Base.astro (which owns <head>, fonts, the no-flash theme script, and opts this
  layout into view transitions). Pages set an `active` nav item.

  ⚠ THE BAR IS A RUNNING HEAD, NOT A MASTHEAD (2026-08-11, ADR 0029). It used
  to be the starter-template strip — translucent blurred ground, hairline
  bottom, wordmark set as a logo, accent underline on the active link — and on
  /blog that put TWO mastheads on screen, the bar and the page's own
  Writing · Quotes · Music switch, both marking "where you are" with the same
  `border-primary` underline. The page's switch is the good one. So the bar
  recedes to one uniform register (serif small caps, one size, distinguished
  only by ink) and the room's own switch becomes the only masthead. Every
  variant was driven on a bench over this exact element before any of it
  shipped; the alternatives — the bar as a journal cover, the nav dropping down
  to join the page's switch row — are in ADR 0029.

  ⚠ THE COLLAPSE POINT IS `md:` (768px), AND IT IS A DECISION, NOT A DEFAULT.
  This nav collapsed at `sm:` (640px) while the Observatory's sidebar collapsed
  at `md:`, so from 640–767px the public site showed a full desktop nav beside a
  workshop still wearing a burger — two answers to one question, arrived at by
  two defaults rather than by a choice. Unified on the LARGER of the two,
  because the direction is asymmetric: showing the burger slightly early costs a
  tap that the control is designed for, while showing a desktop nav slightly
  early crowds three links, a theme toggle and the colophon into whatever the
  wordmark leaves. Moving the admin down to `sm:` instead would have left a
  240px sidebar sharing a 640px viewport with the workshop.

  The one surviving `sm:` here is the wordmark's type step, which is typography
  and has nothing to do with the nav.
*/
import { Icon } from 'astro-icon/components';
import Analytics from '@vercel/analytics/astro';
import Base from './Base.astro';
import Colophon from '../components/Colophon.astro';
import BackToTop from '../components/BackToTop.astro';

interface Props {
  title?: string;
  /** Optional meta description, passed through to <head>. */
  description?: string;
  /** Which top-nav item is highlighted. */
  active?: 'home' | 'blog' | 'about';
  /** Constellation pages bring their own floating control (the sky-return ✦)
   *  and pass false — one quiet corner control at a time. */
  backToTop?: boolean;
  /** Passed straight through to Base → Social. A room that says nothing here
   *  still gets a correct card; these only make it a better one. */
  image?: string;
  ogType?: 'website' | 'article';
  canonical?: string;
}
const { title, description, active, backToTop = true, image, ogType, canonical } = Astro.props;
const pageTitle = title ? `${title} — It Only Happens Once` : 'It Only Happens Once';

// The room is explicit (not only the wordmark): the homepage is the site's
// strangest, most load-bearing room — visitors wandering the blog need an
// unambiguous way back to it. Constellation pages light it as active.
//
// ⚠ "CONSTELLATIONS", NOT "HOME" (2026-08-11). design.md §13 had been holding
// both positions since July — chrome that says Home, prose that says "visitors
// see constellations" — and `/constellations` has 301'd to `/` the whole time,
// so the routing was already calling the room by this name. "Home" was the more
// generic of the two words in the most-seen row on the site. Measured at 780px
// (the tightest width where the bar is still horizontal, since the burger
// arrives at 768) there is still a 264px gap between wordmark and nav.
//
// The `key` stays `home`: it is the prop every page passes as `active`, and
// renaming that is a six-file change for no reader-visible gain.
const nav = [
  { key: 'home', label: 'Constellations', href: '/' },
  { key: 'blog', label: 'Blog', href: '/blog' },
  { key: 'about', label: 'About', href: '/about' },
] as const;
---

<Base title={pageTitle} description={description} image={image} ogType={ogType} canonical={canonical} transitions>
  <Fragment slot="head">
    {
      /* The home-screen bookmark's face (plan 43 §0.5, ruled 2026-08-18). The
        same star the favicon draws, at the size iOS asks for — and NOT a
        reversal of AdminLayout's "the public site is not an app": no manifest,
        no standalone display, nothing installable. The alternative that lost
        was keeping it Observatory-only, whose cost fell on exactly one person —
        a reader who bookmarks the site to their home screen and gets a
        screenshot thumbnail where every other site puts a face. */
    }
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
  </Fragment>
  <div class="flex min-h-screen flex-col">
    {
      /* ⚠ THE ONLY THING THAT ANSWERS A NAV CLICK ON THIS SITE — see
        `scripts/route-progress.ts` for the whole argument, and `admin.css` for
        the bar's own shape, which the Observatory drew first and this reuses
        unchanged. Short version: `<ClientRouter />` turns a navigation into a
        `fetch()` and a swap, so the browser shows NO loading state of any kind
        — not even the weak tab spinner the workshop still gets. Between the
        press and the new page painting, nothing on screen moved.

        Rendered here always and merely flat, never created on demand: an
        element that has to be inserted cannot paint on the frame the click
        happened, which is the one frame it exists for. */
    }
    <div id="nav-progress" aria-hidden="true"></div>
    {
      /* Top bar — the site's primary navigation.

        ⚠ NO HAIRLINE, NO BLUR, AND THE GROUND IS SOLID. Dropping the border is
        the load-bearing move: it makes the PAGE's own rule the only one on
        screen. Dropping the blur is the second — a translucent frosted strip is
        itself one of the tells design.md §3 bans on sight. But the ground goes
        SOLID rather than transparent, because a sticky header still has to hide
        what passes under it; "no background" is a different proposal (an
        overlay) and nothing here is making it.

        `sticky` is deliberate and was re-tested, not inherited: the bench
        carried an unpin toggle through every variant and never found a reason
        to use it. It does not need re-litigating.

        ⚠ WHAT REPLACES THE HAIRLINE IS `.site-bar::after` — see app.css. A
        solid strip over a same-coloured page had no lower EDGE, so content
        under it was guillotined mid-letterform with no cue at all. The answer
        is a scrim, not a rule and not glass; the three were driven side by side
        and the argument is written beside the CSS. */
    }
    <header class="site-bar bg-base-100 sticky top-0 z-30 flex h-13 items-center gap-4 px-5">
      {
        /* The site's name is not a logo here — it is the first item of a running
          head. Same face, same size, same small caps as the links beside it,
          distinguished only by ink (80% against their 60%). This is design.md
          §7's VOICE register applied to chrome, which is a claim worth arguing
          with, since §7 assigns voice to the evocative rooms and sans to the
          machinery ones and this bar spans both. It is here because the bar is
          identity before it is instrument.

          The `aria-label` still says "home", deliberately: it names the
          DESTINATION, and "home" is what a browser calls that regardless of
          what the visible link now reads. */
      }
      <a
        href="/"
        class="text-base-content/80 mr-auto font-serif text-base tracking-[0.09em] whitespace-nowrap [font-variant:all-small-caps] md:leading-none"
        aria-label="It Only Happens Once — home"
      >
        It Only Happens Once
      </a>

      {/* Hamburger — mobile only. */}
      <button
        id="menu-toggle"
        type="button"
        class="rounded-field text-base-content/60 hover:bg-base-200 hover:text-base-content p-1.5 md:hidden"
        aria-label="Menu"
        aria-controls="site-menu"
        aria-expanded="false"
      >
        <Icon name="ph:list" class="text-lg" />
      </button>

      {/* Nav — inline row on desktop, dropdown panel on mobile. */}
      <nav
        id="site-menu"
        aria-label="Primary"
        class:list={[
          'site-menu items-center',
          'rounded-box border-base-300 bg-base-100 absolute top-full right-4 mt-2 hidden w-44 flex-col gap-1 border p-2 shadow-lg',
          'md:static md:right-auto md:mt-0 md:flex md:w-auto md:flex-row md:gap-5 md:border-0 md:bg-transparent md:p-0 md:shadow-none',
        ]}
      >
        {
          /* ⚠ THE ACTIVE ITEM IS MARKED BY INK ALONE — it used to carry
            `md:border-primary md:border-b md:pb-0.5`, and that is accent in
            chrome, which design.md §5 forbids in the sentence that defines it:
            "Accent color is for content, never for chrome … it never colors a
            label, an eyebrow, or a category tag." An active-state marker is
            furniture. The lamplight underline stays on the PAGE's switch, where
            the thing being marked is content navigation — so "where you are" is
            still said once, loudly, below.

            One register with the wordmark, at all widths including the mobile
            dropdown: a panel that switched back to sans would be exactly the
            unexplained fork §7 warns about. Only `leading-none` is held back to
            `md:`, so the dropdown's rows keep their tappable height.

            ⚠ `py-2.5` AND NOT `py-1.5` (2026-08-19). 16px type at normal
            leading is ~24px, so the old padding built a **36px** row — under
            every touch-target floor there is (WCAG 2.5.8 wants 24, Apple and
            Material both want 44), in the one place on this site that is only
            ever pressed with a thumb. 2.5 lands it at 44. It costs nothing
            above `md:`, where `md:p-0` takes it all back and the links are an
            inline row rather than a menu.

            ⚠ `data-nav-row` IS READ BY CSS, NOT BY THE SCRIPT — it marks the
            three links whose ink may run ahead of the page. `data-astro-prefetch`
            is `tap` rather than `viewport`, and the distinction is the same one
            the Sky's rows argue in the other direction: eleven links that ARE
            the page can afford to be fetched on sight, but these three sit on
            every page including the feed, so `viewport` would pull ~90 KB of
            documents a reader did not ask for on every single arrival. `tap`
            fires on pointerdown — the fetch starts a beat before the click
            resolves, costs nothing to anyone who does not press, and is the
            only strategy `hover` does not already cover on a phone. */
        }
        {
          nav.map((item) => (
            <a
              href={item.href}
              aria-current={active === item.key ? 'page' : undefined}
              data-nav-row
              data-astro-prefetch="tap"
              class:list={[
                'rounded-field w-full px-2 py-2.5 font-serif text-base tracking-[0.09em] transition-colors [font-variant:all-small-caps] md:w-auto md:rounded-none md:p-0 md:leading-none',
                active === item.key
                  ? 'text-base-content'
                  : 'text-base-content/60 hover:bg-base-200 hover:text-base-content md:hover:bg-transparent',
              ]}
            >
              {item.label}
            </a>
          ))
        }

        {
          /* Utilities: colophon + theme toggle (a divider above them on mobile).

            ⚠ THE ⌗ COMES FIRST, AND THE ORDER IS THE POINT (2026-08-11). It
            used to trail the sun/moon, which put the site's one piece of
            authorship at the far edge of the bar — past the instrument, in the
            corner reserved for things you dismiss. Reading inward from the nav
            the line now goes destinations → who made this → how you'd like to
            read it, which is descending order of what it says about the site.
            The footer's group was reordered to match on the same principle:
            "Say hello" (a sentence) then ⌗ then ⌁, credential before utility.

            ⚠ ON A PHONE THEY STACK AND THEY SPEAK (2026-08-19). Michael: *"I
            want some kind of label for the github icon and theme toggle in the
            mobile hamburger menu."* Two unlabelled marks in a row at the foot
            of a menu whose every other item is a WORD is the one place on this
            site where a reader is asked to decode rather than read — and the
            row was 28px tall, which is the other half of the same complaint.
            Below `md:` each becomes a full-width labelled row like the three
            above it; at `md:` and up `md:flex-row` and `md:p-1.5` restore
            exactly the inline pair of marks that shipped before, because up
            there they sit beside a wordmark in a 13-tall bar and a word each
            would crowd it.

            ⚠ THE ORDER IS NOW LOAD-BEARING TWICE. Reading inward it was
            already destinations → who made this → how you'd like to read it;
            stacked, ⌗ ABOVE the toggle is that same sequence turned ninety
            degrees, which is what Michael asked for by name. Do not let a
            future `flex-col-reverse` "fix" the visual weight. */
        }
        <div
          class="border-base-300 mt-1 flex w-full flex-col items-stretch gap-0.5 border-t px-1 pt-2 md:mt-0 md:w-auto md:flex-row md:items-center md:gap-1 md:border-0 md:p-0"
        >
          {
            /* A trigger only; the drawer it opens is mounted once at layout
              level (see the note on <Colophon /> below). It stays in the bar
              even though the footer now carries the same mark, because the two
              are not the same claim: this one is a CREDENTIAL, seen rather than
              read, saying at a glance and before anything is opened that a
              person built this.

              ⚠ "SOURCE", AND THE LOUDER CANDIDATES LOST ON REGISTER. The label
              has to imply the site was built rather than assembled, and the
              direct spellings of that — "Built from scratch", "Built by hand" —
              are the site boasting in its own chrome, which is the one voice
              this bar does not have. "Source" says only where to look; the
              drawer it opens is where the claim actually lives, in a sentence
              written for it ("This site is an independent project built with…").
              "Colophon" was the near-miss and is the truer word for the drawer —
              it lost because a menu row is not the place to teach one.

              ⚠ THE `aria-label` NOW OPENS WITH THE VISIBLE WORD, and the note
              in the footer forty lines down is why: WCAG 2.5.3 (Label in Name)
              is broken the moment a control SHOWS one thing and is NAMED
              another, and someone driving the page by voice says "click
              Source". That note used to end *"the bar's copy keeps the bare
              sentence and is correct as it stands — two instances, two right
              answers, do not unify them"*, on the reasoning that the bar
              rendered a mark with no visible text to disagree with. It renders
              a word now, below `md:`, so the exemption expired with it. Above
              `md:` the label is `display: none` and contributes nothing to the
              accessible name, which is exactly why the sentence stays attached
              rather than being replaced by the word. */
          }
          <button
            type="button"
            popovertarget="site-colophon"
            aria-label="Source — how this site was built"
            class="site-util rounded-field text-base-content/55 hover:bg-base-200 hover:text-base-content inline-flex items-center gap-2.5 px-2 py-2.5 transition-colors md:justify-center md:gap-0 md:p-1.5"
          >
            <Icon name="simple-icons:github" class="size-4 shrink-0" />
            <span class="font-serif text-base tracking-[0.09em] [font-variant:all-small-caps] md:hidden">Source</span>
          </button>
          {
            /* ⚠ THE LABEL IS THE NOUN AND NOT THE VERB, and that is the one
              decision in this control. "Light theme" / "Dark theme" — the state
              you would switch TO, matching what the icon already shows — reads
              better and cannot be rendered honestly: the theme is chosen by an
              inline script in <head> from `localStorage`, so the SERVER does
              not know which word is true and would ship the wrong one to every
              reader who has ever pressed this. A CSS swap keyed on
              `[data-theme]` would fix the flash and break WCAG 2.5.3 instead —
              "Light theme" is not a substring of any accessible name that is
              also correct in the other state. So the word is stable, the icon
              carries the direction, and `aria-pressed` carries the state. */
          }
          <button
            id="theme-toggle"
            class="site-util theme-toggle rounded-field text-base-content/55 hover:bg-base-200 hover:text-base-content inline-flex items-center gap-2.5 px-2 py-2.5 transition-colors md:justify-center md:gap-0 md:p-1.5"
            aria-label="Toggle light and dark theme"
            title="Toggle theme"
          >
            <Icon name="ph:sun" class="theme-icon-sun shrink-0 text-base" />
            <Icon name="ph:moon" class="theme-icon-moon shrink-0 text-base" />
            <span class="font-serif text-base tracking-[0.09em] [font-variant:all-small-caps] md:hidden">Theme</span>
          </button>
        </div>
      </nav>
    </header>

    {
      /* No transition:name here on purpose. <main> carried one ("content")
        with the page fade on it until 2026-08-05, and on the Sky that made the
        outgoing page SLIDE ~1000px across the incoming one rather than
        dissolve — <main>'s box is the whole document, so the group had two very
        different boxes to interpolate between. The fade moved up to the root in
        Base.astro, whose box is the viewport; the full account is there. */
    }
    <main class="min-w-0 flex-1">
      <slot />
    </main>

    {
      /* ─────────  THE FOOTER  ─────────
        Five things, one line, one register — the bar's own language, so both
        ends of the page speak the same way.

            Constellations · Blog · About        Say hello   ⌗ Source   ⌁ RSS

        ⚠ NOTHING HERE CLOSES THE PAGE, AND THAT IS THE DECISION (ADR 0029).
        Four variants were built on the assumption that a footer's job is to
        CLOSE — a rule and a display-size "← return" under every room, the
        wordmark set again as a back cover — and all four are wrong for the same
        reason: THE SUITE ALREADY CLOSES, AND IT CLOSES UPWARD. A site-wide
        return duplicates that in the one room where it works and INVENTS a
        destination in the room where it does not (at the front door "upward"
        means nothing, so the variant had to turn its arrow around and offer
        "the writing"). A close that changes direction per room is two patterns
        wearing one coat. A footer is where the addresses live.

        ⚠ THE ⌗ IS IN BOTH THE BAR AND HERE, DELIBERATELY. A variant that
        unfolded the colophon into the page and took the mark out of the bar was
        answering the wrong question: the ⌗ up there is not end matter, it is a
        CREDENTIAL, and a credential works by being seen rather than read. The
        bar says THAT a person built this, at a glance, before anything is
        opened; this says HOW. The drawer is opened on demand and reachable from
        every page including short ones; the footer is a terminus, reached only
        by finishing. Different jobs, so there is nothing to de-duplicate.

        ⚠ AND THEREFORE: NOTHING A READER NEEDS MAY LIVE ONLY HERE. On /blog,
        `scripts/blog-feed.ts` appends pages as you scroll and stops only at
        `pageCount`, so in the site's busiest room this is reached last or never.
        RSS passes that test only because it stays in the drawer too.

        Two measurements killed the alternatives and are worth keeping:
        · Dropping the utilities to §7's CHROME register (uppercase sans,
          11.5px) while the links stayed serif small caps measured 243px against
          245px, cap heights nearly identical. The two registers land in the
          same place at this size. A fork that cannot be seen is not a fork.
        · Two lines flush left vs one line split measured 143px against 149px
          tall at 390px — BOTH two lines. `stack` is just what this already
          becomes on a phone, and it only differs above ~600px, where one line
          reads better anyway.

        It is a sibling of <main> rather than its last child so the wrapper's
        `flex-1` pushes it to the bottom on a short page. (The bench could only
        render it inside main, since slot content lands there; both benched rooms
        overflow the viewport, so it never showed.) */
    }
    <footer class="site-foot">
      <div class="site-foot__inner">
        <nav class="site-foot__group" aria-label="Site">
          {
            /* Same two attributes as the bar's copies, and for the same two
              reasons — these are chrome links to the same three rooms, so a
              press here may move the mark here, and `tap` gives the fetch its
              head start. A reader who has scrolled to the footer of a
              constellation is one press from the site's heaviest document. */
            nav.map((item) => (
              <a
                href={item.href}
                aria-current={active === item.key ? 'page' : undefined}
                data-nav-row
                data-astro-prefetch="tap"
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        {
          /* "Say hello" carries no icon and the other two do — which is the
            brief, and it is also the honest split: the first is a sentence you
            read, the other two are marks you recognise. The ⌗ is a <button>
            targeting the bar's own popover by id; one drawer, two triggers. */
        }
        <div class="site-foot__group">
          <a href="/about#mv-hello">Say hello</a>
          {
            /* ⚠ THE LABEL OPENS WITH THE WORD ON SCREEN, AND THAT IS NOT
              REDUNDANCE. This button used to be NAMED "How this site was
              built" — an accessible name that does not contain the visible
              text (WCAG 2.5.3, Label in Name). The cost is not theoretical and
              it is not a screen reader's: someone driving the page by voice
              says the word they can see, and nothing happens. Flagged by
              Lighthouse 2026-08-11. So the name still leads with whatever this
              button shows, and if the word below ever changes again, this
              string changes with it — they are a pair.

              ⚠ IT SAID "GitHub" UNTIL 2026-08-19, AND THE TWO TRIGGERS NOW
              MATCH. The bar's copy grew a visible label the same day and took
              "Source"; this kept "GitHub" for one commit on the argument that a
              footer row reading `Say hello · GitHub · RSS` is three service
              names and "Source" would be the odd one out. Michael's call was to
              unify, and the argument for it is better than the argument
              against: this is ONE DRAWER WITH TWO TRIGGERS (see the note above
              the panel), and a reader who meets it as "Source" in the menu and
              as "GitHub" at the foot of the page has no way to know they are
              the same thing. Two names for one door is a worse cost than one
              slightly unusual word in a row of three. It also makes the claim
              the drawer exists to make — that a person wrote this, rather than
              assembled it — in both places instead of naming a vendor in one.

              The mark stays GitHub's, which is the half that should: the icon
              says which service, the word says what it is of. */
          }
          <button type="button" popovertarget="site-colophon" aria-label="Source — how this site was built">
            <Icon name="simple-icons:github" class="site-foot__icon" />
            Source
          </button>
          <a href="/rss.xml">
            <Icon name="ph:rss-simple" class="site-foot__icon" />
            RSS
          </a>
        </div>
      </div>
    </footer>
  </div>

  {
    /* ⚠ MOUNTED HERE, OUTSIDE EVERY TRIGGER'S CONTAINER, DELIBERATELY. It is one
      drawer with two triggers now — the bar's ⌗ and the footer's — and it used
      to render both panel and button together inside the bar's utilities
      <div>, which lives inside `#site-menu` and is therefore `display: none`
      below `md:` until the hamburger opens it. With only one trigger that was
      harmless (pressing it meant the menu was open). With two it is a silent
      failure: on a phone the footer's ⌗ flips the popover to `:popover-open`
      and paints nothing, because an element in a `display: none` subtree has no
      box at all. Layout level is the only place that belongs to neither
      trigger. */
  }
  <Colophon />

  {backToTop && <BackToTop />}

  {
    /* Vercel Web Analytics (plan 43 §6, ruled 2026-08-18): cookieless, so no
      consent chrome; pageviews only. The component, NOT the adapter's
      `webAnalytics` flag — that flag is the documented legacy path for
      @vercel/analytics ≤1.3, and this is 2.x. ⚠ NOT IN Base, on purpose: Base
      is also the Observatory's document, and the workshop's one inhabitant
      would count himself into the public numbers on every edit. The public
      chrome is the audience being measured. Inert until Web Analytics is
      enabled on the Vercel project (43a's checklist) — the script 404s quietly
      until then.

      ⚠ IN THE BODY, AND VERCEL'S OWN DOCS SAY <head>. THEY ARE WRONG, and it
      cost this site every page transition for a day. The component renders a
      `<vercel-analytics>` CUSTOM ELEMENT, which is not one of the handful of
      tags the HTML parser accepts in a head — so the parser closed the head at
      it and reparented everything after it into the body. Everything after it
      is all of the CSS: Astro appends the page's stylesheet <link> and its 22
      scoped <style> blocks LAST in head, which is after this slot. The site
      then rendered from a stylesheet living in the body, and `<ClientRouter />`
      replaces the body wholesale on every navigation — so each swap destroyed
      the stylesheet and re-created it, and the page painted at least one frame
      with NO CSS AT ALL: white ground, blue underlined links, and the StarMark
      blown up to the width of the viewport, which is what made it look like the
      favicon was flashing across the page. ClientRouter's own protection only
      covers `document.head` (it re-uses a matching <link> there instead of
      re-creating it), and the stylesheet was never in the head to be protected.
      The element belongs in the body regardless of this bug — it is a custom
      element, it reads its own `data-*` in its constructor, and it works from
      anywhere in the document. Keep it INSIDE the swapped body: a fresh element
      per navigation is what makes each one count as a pageview. */
  }
  <Analytics />

  <script>
    // The one thing that answers a nav click here — see the file, and the
    // `#nav-progress` note at the top of this layout.
    import '../scripts/route-progress';

    // The theme toggle used to be implemented here too, and this copy was the
    // wrong one: it set `aria-pressed` only inside its own click handler, so the
    // attribute was absent until you pressed the button and absent again after
    // every view transition replaced the DOM. It now lives once, in
    // `scripts/theme-toggle.ts`, mounted from Base.astro beside the no-flash
    // picker. Nothing about the markup changed.

    // ---- Mobile menu (delegated) ----
    //
    // ⚠ `closeMenu` TAKES AN ARGUMENT NOW, AND IT IS AN ACCESSIBILITY FIX RATHER
    // THAN A TIDY-UP. Escape used to close the panel and leave focus on whatever
    // was inside it — an element that is now in a `display: none` subtree, so
    // the browser drops focus to <body> and a keyboard reader is returned to the
    // top of the document instead of to the control they opened. Only the
    // dismissals that were not a navigation restore it: sending focus back to
    // the burger after tapping "Blog" would fight the page that is arriving.
    const closeMenu = (restoreFocus = false) => {
      const menu = document.getElementById('site-menu');
      const toggle = document.getElementById('menu-toggle');
      const wasOpen = menu?.classList.contains('is-open') ?? false;
      menu?.classList.remove('is-open');
      toggle?.setAttribute('aria-expanded', 'false');
      if (restoreFocus && wasOpen && menu?.contains(document.activeElement)) toggle?.focus();
    };
    document.addEventListener('click', (e) => {
      const target = e.target as Element;
      const menu = document.getElementById('site-menu');
      if (!menu) return;
      if (target?.closest?.('#menu-toggle')) {
        const open = menu.classList.toggle('is-open');
        document.getElementById('menu-toggle')?.setAttribute('aria-expanded', String(open));
        return;
      }
      // ⚠ `a` ONLY, AND A <button> IN HERE DELIBERATELY LEAVES THE PANEL OPEN.
      // This was briefly `a, button` on the reasoning that a control which
      // opens a drawer should get out of its way, and Michael reversed it
      // (2026-08-19): *"I'd much prefer the menu stay open behind it like it
      // was before."* He is right, and the reason is the one thing the ✕
      // version could not do — the ⌗ has to stay ON SCREEN to be the trigger
      // that lights up while its drawer is open, which is the whole point of
      // the `:popover-open` rule in app.css. A trigger that dismisses itself
      // has no state to show.
      //
      // It is the right rule for the other button too: flipping the theme is
      // something you may want to do twice, and this panel is where you can
      // watch it happen. An <a> is different in kind — it is leaving.
      if (target?.closest?.('#site-menu a')) return closeMenu();
      if (menu.classList.contains('is-open') && !menu.contains(target)) closeMenu(); // outside click
    });
    // ⚠ ESCAPE DISMISSES THE TOP LAYER ONLY, AND THE GUARD IS WHAT MAKES THE
    // DECISION ABOVE HOLD. Now that the ⌗ leaves this panel open behind its
    // drawer, there are genuinely two things stacked — and this listener fires
    // on the same keypress the popover's own light-dismiss does, so without the
    // check one Escape closed both and the reader was returned to the page
    // having pressed one key and lost two things. Measured, not assumed: the
    // theme toggle was unreachable after a single Escape.
    //
    // No `stopPropagation` anywhere — the popover's dismissal is the browser's,
    // not ours, and we cannot order ourselves after it. Asking whether it is
    // still open is the same question asked at a moment we can actually answer.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape') return;
      if (document.getElementById('site-colophon')?.matches(':popover-open')) return;
      closeMenu(true);
    });
    document.addEventListener('astro:page-load', () => closeMenu()); // each page starts closed
  </script>
</Base>

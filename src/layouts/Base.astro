---
/*
  Base — the document itself: <head>, fonts, the no-flash theme pick, and the
  view-transition opt-in. Wrapped by SiteLayout (public) and AdminLayout (the
  Observatory, which does not opt into transitions).

  THE PAGE FADE LIVES HERE, ON THE ROOT — not on <main>, and the difference is
  not cosmetic.

  A view-transition group interpolates its own BOX between the outgoing and
  incoming element. `root`'s box is the viewport, so both sides are the same
  size and in the same place: the old page dissolves out exactly where it stood
  and the new one dissolves in exactly where it stands. Nothing travels.

  ⚠ It used to be `transition:name="content"` on SiteLayout's <main>, with the
  root set to "none" — and on the Sky that was actively broken. <main> on a
  16-fragment suite and <main> on the overview are different heights and, once
  you have scrolled, in very different places: measured at 1280×720, the group
  translated 982px and shrank 670px across the 0.22s fade. So the outgoing page
  did not dissolve — it SLID a thousand pixels across the incoming one while
  both were half-opaque. Frozen and scrubbed frame by frame (2026-08-05) that is
  two full pages of serif text superimposed and moving over each other,
  illegible for most of the transition. It was the other half of "no jarring
  transitions", and plan 18's scroll restore could not touch it: that fixes
  where the page LANDS, this is what it does on the way.

  Two alternatives were built and measured before this one:
  - `::view-transition-group(content) { animation: none }` — pins the box to its
    destination, which removes the slide but replaces it with a JUMP CUT on the
    first frame: the reader's content vanishes and is replaced by a different
    part of the same page before the dissolve even starts.
  - dropping the page animation entirely, so only the name and stars morph —
    genuinely clean, and the closest thing to a rival. Rejected because the
    named elements keep their own fade while everything else swaps instantly, so
    the eleven constellation names ghost in over descriptions that are already
    solid. One page, two speeds.

  The named pairs (`c-<slug>`, `star-<slug>`) are unaffected either way: an
  element with its own transition:name is lifted out of its ancestor's snapshot,
  so the title still morphs ACROSS this fade rather than through it. Its travel
  is the point — see `scripts/sky-slot.ts` for what aims it.
*/
import { Font } from 'astro:assets';
import { ClientRouter, fade } from 'astro:transitions';
import Social from '../components/Social.astro';
import '../styles/app.css';

interface Props {
  title?: string;
  /** Optional meta description (permalink pages set it for search/sharing). */
  description?: string;
  /** Opt into animated view transitions (the public reader pages do). */
  transitions?: boolean;
  /** The link-preview card. Root-relative is fine — Social makes it absolute. */
  image?: string;
  /** `article` for one piece of writing or one quote; `website` otherwise. */
  ogType?: 'website' | 'article';
  /** Overrides the derived canonical. The Reader is why this exists: one essay
   *  is legitimately readable at `/blog/x`, `/blog#read=x` AND
   *  `/{constellation}#read=x`, and only one of the three is the address. */
  canonical?: string;
}

const { title = 'It Only Happens Once', description, transitions = false, image, ogType, canonical } = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="dusk" transition:name="root" transition:animate={fade({ duration: '0.22s' })}>
  <head>
    <meta charset="utf-8" />
    {
      /* Pick the theme before paint (no flash): a saved choice wins, and dusk
        otherwise.

        ⚠ THE SYSTEM PREFERENCE IS DELIBERATELY NOT CONSULTED. It used to be —
        `prefers-color-scheme: light` handed a first-time reader `paper`. But
        this site was drawn at dusk: the Sky only reads as a sky against dark,
        the accent OKLCH ramps were tuned there, and paper is the concession
        rather than the design. Following the OS meant most visitors met the
        weaker of the two themes without ever knowing there was another one.

        So dark is the site's own default and light is an opt-in — the toggle,
        which persists. The cost is real and accepted: a reader who keeps their
        whole machine light gets a dark page they did not ask for, and has to
        press the sun once. That is one click, remembered forever, against a
        first impression of the site as it was actually designed. */
    }
    <script is:inline>
      try {
        document.documentElement.dataset.theme = localStorage.getItem('theme') === 'paper' ? 'paper' : 'dusk';
        // Swallowed on purpose: `localStorage` THROWS in Safari's private mode
        // and wherever site data is blocked, and the cost of that is a reader
        // who gets the default theme instead of their chosen one. Letting it
        // escape an is:inline script in <head> would cost them the page.
      } catch {}
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {description && <meta name="description" content={description} />}
    <title>{title}</title>
    {
      /* Unconditional, so a new page cannot ship without a card by forgetting to
        ask for one. See the component for why it is not opt-in. */
    }
    <Social title={title} description={description} image={image} type={ogType} canonical={canonical} />
    {
      /* Feed discovery — how a reader's "subscribe" button finds anything at
        all (plan 34 · §5). ⚠ IN Base, NOT PER PAGE, on the argument Social's
        own header already won and this repo has already paid for once: the
        fourth page forgets, the fifth copies the fourth, and a missing <link>
        has no symptom on the page it is missing from. */
    }
    <link rel="alternate" type="application/rss+xml" title="It Only Happens Once" href="/rss.xml" />
    <Font cssVariable="--font-newsreader" preload />
    <Font cssVariable="--font-atkinson" preload />
    {transitions && <ClientRouter />}
    {
      /* A room's own <head> additions — the Observatory puts its web-app
        manifest here (AdminLayout). Last, so a room can override a default. */
    }
    <slot name="head" />
  </head>
  <body class="bg-base-100 text-base-content">
    <slot />
    <script>
      // The toggle itself — one implementation for both chromes, mounted here
      // beside the no-flash picker above rather than copied into each layout.
      import '../scripts/theme-toggle';

      // After each view-transition swap, re-apply the theme before paint so it
      // never flashes back to the default on client-side navigation. Same rule as
      // the initial pick: a saved `paper` wins, dusk otherwise. Inert unless a
      // page opted into transitions (the event never fires otherwise).
      document.addEventListener('astro:after-swap', () => {
        try {
          document.documentElement.dataset.theme = localStorage.getItem('theme') === 'paper' ? 'paper' : 'dusk';
          // Same swallow, same reason as the head script above: no storage
          // means the default theme, never a broken navigation.
        } catch {}
      });
    </script>
  </body>
</html>

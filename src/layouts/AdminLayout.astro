---
/*
  AdminLayout — chrome for the Observatory (docs/admin.md §1).

  Private, not a public surface: same dusk tokens, Atkinson chrome, but tuned
  for speed and density over poetry. Every /admin route is auth-gated by
  middleware and renders on demand (never cached, never public).

  ONE BUILDING, PLAIN ROOMS (ADR-0015). "Workshop" named both the whole and one
  of its parts once /admin stopped being the fragment table, so the building is
  the Observatory and the rooms keep nouns: Today · People · Agenda ·
  Fragments · Constellations · Library · About.
*/
import { Icon } from 'astro-icon/components';
import Base from './Base.astro';
import CaptureDialog from '../components/admin/CaptureDialog.astro';
import ConfirmDialog from '../components/admin/ConfirmDialog.astro';
import NotificationsDialog from '../components/admin/NotificationsDialog.astro';
import StarMark from '../components/StarMark.astro';
import BackToTop from '../components/BackToTop.astro';
import { attentionLabel, titlePrefix } from '../lib/hq/attention';

interface Props {
  title?: string;
  /** Which top-nav item is active. */
  active?: 'today' | 'people' | 'agenda' | 'notes' | 'fragments' | 'constellations' | 'library' | 'about';
}
const { title = 'Observatory', active = 'today' } = Astro.props;
const user = Astro.locals.user;

/**
 * `(2) Today — Observatory` (20 · §5).
 *
 * THE ONE SURFACE THAT REACHES YOU WHILE THE OBSERVATORY IS ONE OF TWENTY TABS.
 * No install, no permission, no service worker; correct on every navigation
 * because the whole page is server-rendered, which is most of Piece 7 for free.
 *
 * ⚠ NOTHING AT ZERO. `titlePrefix` returns '' rather than `(0)`, and the reason
 * is the one `progressLabel()` already gives about `0 of 3 done`: a status line
 * that is always there is a status line you stop reading. The prefix APPEARING
 * is the signal.
 *
 * ⚠ AND IT SAYS TODAY ON EVERY PAGE. The count is about the building, not about
 * the room you are standing in — `(2) People — Observatory` is correct and is
 * the entire point, because the fault this fixes is that navigating away from
 * Today used to make the system go silent.
 */
const total = Astro.locals.attention.total;
const prefix = titlePrefix(total);

/**
 * The pill, on both chromes (20 · §3 and §4).
 *
 * ⚠ IT MUST NOT BE RED, and this is the decision most likely to be "improved"
 * later. `PastDueZone` establishes the rule and states it: *"The one warm chip
 * on the page. Semantic, not a domain hue — red means pressing here and nowhere
 * [else]."* A red badge on Today EVERY SINGLE MORNING — because the check-in is
 * unanswered every morning, that is what a check-in is — would spend the urgency
 * hue on the most ordinary event in the building. It breaks the colour coding
 * everywhere it is doing real work, and it delivers exactly the accusation
 * ADR-0013 was written to prevent. Neutral: `base-300` ground, `base-content`
 * numeral, the same weight as an active nav row.
 *
 * `tabular-nums` so 1 → 2 does not shift the row's width.
 */
const PILL = 'bg-base-300 text-base-content rounded-full text-xs leading-none font-medium tabular-nums';

// Today first, and the corpus rooms after the rule: HQ is the daily half, the
// corpus is the weekly one, and the divider is the boundary of ADR-0012 made
// visible. `hr` draws it above that entry.
const nav = [
  { key: 'today', label: 'Today', href: '/admin', icon: 'ph:sun-horizon', hr: false },
  { key: 'people', label: 'People', href: '/admin/people', icon: 'ph:users-three', hr: false },
  // AGENDA, as §9 always intended — since 2026-08-03, when 13 · Piece 4 put a
  // calendar in it. It shipped as "Tasks" for a day and a half because naming a
  // room for something not in it is the same mistake 12 · Piece 1 declined to
  // make with the last-contact line. One room, three surfaces: Calendar, Tasks,
  // Goals (src/components/admin/AgendaTabs.astro).
  { key: 'agenda', label: 'Agenda', href: '/admin/agenda', icon: 'ph:calendar-blank', hr: false },
  // NOTES SITS LAST IN THE DAILY HALF, immediately above the divider — the
  // position says what it is. Dumping is a daily motion, so it belongs with
  // Today/People/Agenda; but a dump graduating into a piece is the front of the
  // corpus pipeline, so it wants to touch Fragments across the line.
  //
  // ⚠ It is NOT the old `/admin/fragments?view=notes`, which was deleted with
  // this room. That was the fragment manager's table with a filter on it —
  // title column, checkboxes, bulk bar — and it asked you to name a jotting and
  // then open it to find out what it said. Michael, 2026-08-03: *"I see
  // untitled, untitled, untitled, and I have to open each one… all I care about
  // is that I have writing fragments and I have brain dumps."*
  { key: 'notes', label: 'Notes', href: '/admin/notes', icon: 'ph:note', hr: false },
  { key: 'fragments', label: 'Fragments', href: '/admin/fragments', icon: 'ph:stack', hr: true },
  { key: 'constellations', label: 'Constellations', href: '/admin/constellations', icon: 'ph:moon-stars', hr: false },
  { key: 'library', label: 'Library', href: '/admin/library', icon: 'ph:books', hr: false },
  { key: 'about', label: 'About page', href: '/admin/about', icon: 'ph:user-circle', hr: false },
] as const;
---

<Base title={`${prefix}${title} — Observatory`}>
  {
    /* The Observatory installs to the home screen (docs/admin.md §9): its own
      icon, its own window, opening straight into /admin rather than the
      homepage. Only this layout carries a manifest; the public site is not an
      app. The file keeps its `workshop` path — it is an internal URL nobody
      reads, and `id`/`start_url` must not move or an installed app would fork.

      It was built to earn iOS's home-screen exemption from the 7-day
      script-storage wipe, protecting an offline outbox. That outbox is gone
      (ADR-0010) and this is now simply a convenience — no service worker, and
      the workshop needs a connection to load and to save. */
  }
  <Fragment slot="head">
    <link rel="manifest" href="/workshop.webmanifest" />
    {/* iOS reads its home-screen icon from here, never from the manifest. */}
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    {
      /* Tints the standalone app's status bar. Rendered at dusk because that is
        now the site's default regardless of the OS, and kept in step with the
        toggle by `scripts/theme-toggle.ts`.

        ⚠ It used to be two `media="(prefers-color-scheme: …)"` metas, on the
        grounds that following the system was close enough and cheaper than
        duplicating the toggle's logic. That stopped being true the moment dusk
        became unconditional: a light-machine user would get the dark app under
        a paper-coloured status bar EVERY time, which is the mismatch the
        media-query version was supposed to avoid. */
    }
    <meta name="theme-color" content="#1a1511" />
  </Fragment>
  {
    /* Skip to the content. The Observatory is the one place on this site the
      pattern clearly earns itself: eleven controls — the wordmark, seven nav
      links, the theme toggle, Site ↗, Sign out — sit before <main> on EVERY
      desktop page, and a keyboard user pays for all of them on every
      navigation. The public rooms have three nav items and were left alone.

      ⚠ Its value is desktop-only now, and that is the `inert` fix's doing
      rather than an oversight: below 768px the closed drawer is out of the tab
      order entirely, so the burger is already the first stop. Worth writing
      down, because "the admin puts seven links before the content" was the
      argument for this control and it is only half true after that change.

      Visually hidden until focused — the standard shape, and the reason it is
      a real anchor rather than a script: it must work on the first Tab, before
      any module has run. */
  }
  <a
    href="#admin-main"
    class="bg-base-100 text-base-content border-base-300 rounded-field sr-only z-50 border px-3 py-2 text-sm shadow-lg focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
  >
    Skip to content
  </a>
  {
    /* THE CLICK LANDS FIRST (24 · Piece 1). Every navigation in here is a full
      document load — no `<ClientRouter />` — so until this existed, pressing a
      sidebar row was answered by nothing at all except the browser's tab
      spinner, which a phone hides behind a collapsed URL bar.

      Rendered here, always, and revealed by `nav-progress.ts` — the same shape
      `#day-turn` below uses, and for the same reason: a script that has to
      CREATE its own element can't paint on the first frame after a click, which
      is the one frame this whole control exists for.

      ⚠ `aria-hidden`. The bar says "the thing you just pressed is happening",
      which a screen reader is already told by `aria-busy` on <main> — and a
      progressbar role with no meaningful value would be announcing a number
      this deliberately does not have (see admin.css: it creeps, it never
      completes, because the page arrives when it arrives). */
  }
  <div id="nav-progress" aria-hidden="true"></div>
  {
    /* `#hq` carries the server's answer about NOW — the day, the configured
      zone, and the two halves of the count. One element, because `day-turn.ts`
      and `attention.ts` both need it and two elements could be rendered from
      two different values. Data rather than a script tag so it is inspectable
      and so nothing has to be serialised into JavaScript.

      ⚠ THE COUNTS ARE NAMESPACED `data-count-*`, AND THAT PREFIX IS LOAD-BEARING.
      They shipped as bare `data-checkin` / `data-tasks`, and `data-checkin`
      collided head-on with the Morning zone's own hook (CheckinZone.astro) —
      the convention Zone.astro documents, where every zone is found by
      `[data-<zone>]`. This div WRAPS every zone and comes first in document
      order, so `document.querySelector('[data-checkin]')` in checkin.ts
      returned the page shell instead of the card. It has no `data-panel-initial`
      and no `data-writable`, so the script hid every panel and bound nothing:
      the Morning card rendered as a bare title with no buttons at all, and
      there was no error anywhere to say so. Three e2e specs resolved the same
      selector to two elements at the same moment.

      A page-wide wrapper must not claim a bare domain name. `data-count-*`
      says what these are — counts about the day — and leaves the domain names
      to the zones that ARE those domains. */
  }
  <div
    id="hq"
    data-today={Astro.locals.today.ymd}
    data-tz={Astro.locals.today.tz}
    data-count-checkin={Astro.locals.attention.checkin}
    data-count-tasks={Astro.locals.attention.tasks}
    class="bg-base-100 flex min-h-screen font-sans"
  >
    {/* Off-canvas backdrop (mobile only) */}
    <div
      id="sb-backdrop"
      class="pointer-events-none fixed inset-0 z-30 bg-black/50 opacity-0 transition-opacity duration-200 md:hidden"
    >
    </div>

    {
      /* Sidebar — fixed to the viewport on desktop (its own scroll + a pinned
        bottom block); an off-canvas drawer on mobile. */
    }
    <aside
      id="sidebar"
      class="border-base-300 bg-base-100 fixed inset-y-0 left-0 z-40 flex w-60 -translate-x-full flex-col border-r transition-transform duration-200 md:translate-x-0"
    >
      <div class="border-base-300 flex h-14 shrink-0 items-center gap-2 border-b px-4">
        <a href="/admin" class="flex items-baseline gap-2 whitespace-nowrap">
          <span class="text-primary text-lg leading-none"><StarMark /></span>
          <span class="font-display text-lg leading-none">Observatory</span>
        </a>
        <button
          id="sb-close"
          class="rounded-field text-base-content/50 hover:bg-base-200 hover:text-base-content ml-auto p-1 md:hidden"
          aria-label="Close menu"
        >
          <Icon name="ph:x" class="text-lg" />
        </button>
      </div>

      <nav class="flex-1 space-y-1 overflow-y-auto overscroll-contain p-3">
        {
          nav.map((item) => (
            <>
              {item.hr && <hr class="border-base-300 mx-3 my-2" />}
              {/* ⚠ `data-nav-row` (24 · Piece 1) marks a row whose highlight may
                  move the instant it is CLICKED, before the page it points at
                  exists. `nav-progress.ts` moves it for these rows only — a link
                  in the content moving a sidebar highlight would be a sidebar
                  answering for something it is not about, which is worse than
                  answering late. See admin.css for what `[data-nav-pending]`
                  looks like and why it takes the tint the active row uses.
                  ⚠ No apostrophes in here: inside this map expression the Astro
                  compiler reads one as the start of a string literal, and the
                  error it throws points at the `</a>` thirty lines below. */}
              <a
                href={item.href}
                id={item.key === 'today' ? 'nav-today' : undefined}
                aria-current={active === item.key ? 'page' : undefined}
                aria-label={item.key === 'today' ? attentionLabel(total) : undefined}
                data-nav-row
                class:list={[
                  'rounded-field flex items-center gap-3 px-3 py-2 text-sm transition-colors',
                  active === item.key
                    ? 'bg-base-200 text-base-content font-medium'
                    : 'text-base-content/60 hover:bg-base-200/60 hover:text-base-content',
                ]}
              >
                <Icon name={item.icon} class="text-lg" />
                {item.label}
                {/* ⚠ `aria-hidden`, and the LINK carries the meaning. A reader
                    handed "Today 2" has been given a number and not what it
                    counts; `attentionLabel` says "Today, 2 waiting". Rendered
                    even at zero, hidden, so the live update has something to
                    write into rather than a node to invent. */}
                {item.key === 'today' && (
                  <span
                    data-attention-pill
                    aria-hidden="true"
                    hidden={total === 0}
                    class:list={['ml-auto px-1.5 py-0.5', PILL]}
                  >
                    {total > 0 ? total : ''}
                  </span>
                )}
              </a>
            </>
          ))
        }
      </nav>

      <div class="border-base-300 shrink-0 space-y-2 border-t p-3">
        <div class="text-base-content/40 truncate px-1 text-xs" title={user?.email}>{user?.email}</div>
        <div class="text-base-content/50 flex items-center gap-1 text-xs">
          <button
            id="theme-toggle"
            class="theme-toggle rounded-field hover:bg-base-200 hover:text-base-content p-1.5"
            aria-label="Toggle light and dark theme"
            title="Toggle theme"
          >
            <Icon name="ph:sun" class="theme-icon-sun text-base" />
            <Icon name="ph:moon" class="theme-icon-moon text-base" />
          </button>
          {
            /* Notifications (21 · Phase 2). It sits with the theme toggle and
              Sign out because those are the three controls about THIS DEVICE
              and this session rather than about the corpus — and because push
              is subscribed per device, so "on" here never means "on everywhere".

              ⚠ NOT a nav item. There is no settings room in this building and
              one switch does not justify inventing the ninth entry in a list
              whose whole argument is that it is short. */
          }
          <button
            id="push-open"
            class="rounded-field hover:bg-base-200 hover:text-base-content p-1.5"
            aria-label="Notifications, off for this device"
            title="Notifications"
          >
            <Icon name="ph:bell" class="text-base" />
          </button>
          <a href="/" class="rounded-field hover:bg-base-200 hover:text-base-content px-2 py-1" title="View the site"
            >Site ↗</a
          >
          <button id="admin-signout" class="rounded-field hover:bg-base-200 hover:text-base-content ml-auto px-2 py-1"
            >Sign out</button
          >
        </div>
      </div>
    </aside>

    {/* Main column — padded left of the fixed sidebar on desktop. */}
    <div class="flex min-w-0 flex-1 flex-col md:pl-60">
      {/* Slim top bar — mobile only (desktop uses the full height for content) */}
      <header
        class="border-base-300 bg-base-100/90 sticky top-0 z-20 flex h-14 shrink-0 items-center gap-3 border-b px-4 backdrop-blur md:hidden"
      >
        {
          /* ⚠ THE PIECE THAT MATTERS MOST, because on a phone the sidebar is
            CLOSED — so the pill beside "Today" is invisible at exactly the
            moment it is for. 11-checkin.md was designed around this surface and
            ADR-0013 names it: *"the surface is opened first, and most reliably,
            on the mornings that are hardest."*

            A NUMBER, not a dot, and the argument is consistency: one signal, one
            shape, every surface. A dot on the phone and a number on the desktop
            is two answers to one question — which is the fault 19 · §7 already
            files against these two chromes disagreeing about a breakpoint.

            The ring is `bg-base-100`, the header's own colour, so the numeral
            reads as a badge sitting ON the icon rather than as part of it. */
        }
        <button
          id="sb-open"
          class="rounded-field text-base-content/70 hover:bg-base-200 hover:text-base-content relative -ml-1 p-1.5"
          aria-label={total > 0 ? `Open menu, ${total} waiting` : 'Open menu'}
          aria-controls="sidebar"
          aria-expanded="false"
        >
          <Icon name="ph:list" class="text-xl" />
          <span
            data-attention-pill
            aria-hidden="true"
            hidden={total === 0}
            class:list={['ring-base-100 absolute -top-0.5 -right-0.5 min-w-4 px-1 py-px text-center ring-2', PILL]}
          >
            {total > 0 ? total : ''}
          </span>
        </button>
        <span class="text-primary text-lg leading-none"><StarMark /></span>
        <span class="font-display text-base leading-none">{title}</span>
      </header>

      {
        /* ⚠ THE DAY HAS TURNED (20 · §6). The Observatory is a desktop workshop
          that lives in a tab, so it gets left open overnight — and at 00:01 the
          date bar, the check-in, the agenda and the count in the title are all
          about yesterday. This says so, in the layout, so no room has to
          remember to (the reason `local-time` gives for living here too).

          A LINK, NEVER A RELOAD — see the script's header for what an
          auto-reload at midnight would throw away. Rendered hidden and revealed
          by `day-turn.ts`; server-side it is always hidden, which is correct,
          because at render time the served day IS today. */
      }
      <div id="day-turn" hidden class="border-base-300 bg-base-200/60 border-b px-4 py-2 text-sm sm:px-6">
        <a href="/admin" class="text-base-content/70 hover:text-base-content underline-offset-2 hover:underline">
          The day has turned — this page is about yesterday →
        </a>
      </div>

      <main id="admin-main" class="min-w-0 flex-1" tabindex="-1">
        <slot />
      </main>
    </div>
  </div>

  <ConfirmDialog />
  {
    /* The ✚ belongs to the building, not to a room (10-hq §10c) — so it is
      mounted here, once, and every admin page gets it. */
  }
  <CaptureDialog />
  {/* Where the building is granted permission to speak first (21 · Phase 2). */}
  <NotificationsDialog />
  {/* the manager and library run long; the sheets bring their own */}
  <BackToTop />

  <script>
    // Every `<time data-local>` on every admin surface, rewritten into the
    // reader's own zone. Mounted from the layout rather than per-page on
    // purpose: "no UTC on screen, anywhere" is a project rule, and a rule that
    // each page has to remember to opt into is a rule that gets forgotten.
    import '../scripts/local-time';

    // Beside it, and for exactly the same reason: the day turning is a fact
    // about the whole building, and a page that had to opt in would be the page
    // that forgot. `day-turn` notices midnight; `attention` keeps the two pills
    // and the window title honest between navigations.
    import '../scripts/day-turn';
    import '../scripts/attention';

    // And a third fact about the building rather than about a room: what happens
    // in the second between pressing a nav row and the next document arriving
    // (24 · Piece 1). Mounted here for the same reason as the two above — every
    // room navigates, so a room that had to opt in would be the room that
    // forgot — and because the control it paints, a bar along the top of the
    // VIEWPORT, belongs to the window and not to any room.
    import '../scripts/nav-progress';

    // ⚠ MOUNTED FROM THE LAYOUT FOR A REASON THE OTHERS DO NOT HAVE. Its
    // `sync()` re-asserts this device's push subscription on every admin load,
    // and with no service worker that is the ONLY chance the app gets to notice
    // a subscription has gone stale. Mounted per-page it would run only where
    // somebody remembered it, which is the same as not running.
    import '../scripts/push';

    import { createBrowserClient } from '@supabase/ssr';
    const supabase = createBrowserClient(import.meta.env.PUBLIC_SUPABASE_URL, import.meta.env.PUBLIC_SUPABASE_ANON_KEY);
    document.getElementById('admin-signout')?.addEventListener('click', async () => {
      await supabase.auth.signOut();
      window.location.href = '/';
    });

    // --- mobile off-canvas sidebar ---
    const sidebar = document.getElementById('sidebar');
    const backdrop = document.getElementById('sb-backdrop');
    const openBtn = document.getElementById('sb-open');

    // ⚠ THE DRAWER CLOSES BY TRANSFORM, WHICH HIDES IT FROM THE EYE AND FROM
    // NOBODY ELSE. `-translate-x-full` moves the <aside> off the left edge; it
    // does not remove it from the document. Measured at 390px on all ten admin
    // rooms: THIRTEEN controls sat at x=-228..-13 and stayed in the tab order,
    // and they were the FIRST thirteen — so a keyboard or switch user pressing
    // Tab on a phone walked into an invisible menu (the wordmark, seven nav
    // links, close, theme, Site ↗, Sign out) before reaching anything on screen.
    //
    // `inert` is the fix because it removes the subtree from the tab order AND
    // from the accessibility tree in one move. ⚠ Not `aria-hidden`, which hides
    // it from a screen reader and LEAVES IT TABBABLE — strictly the worse half,
    // and the more obvious-looking attribute.
    const desktop = matchMedia('(min-width: 768px)');
    let open = false;

    // ⚠ WIDTH-AWARE, NOT JUST STATE-AWARE. The same <aside> is the permanent
    // desktop sidebar above `md` (`md:translate-x-0`), where `open` is never
    // true — so an `inert` that only tracked the open flag would make the real
    // sidebar inert on every desktop page. The next person to read `inert` on a
    // sidebar will assume it follows the drawer; it follows the drawer AND the
    // viewport.
    const syncInert = () => sidebar?.toggleAttribute('inert', !desktop.matches && !open);

    const openSidebar = () => {
      open = true;
      sidebar?.classList.remove('-translate-x-full');
      backdrop?.classList.remove('opacity-0', 'pointer-events-none');
      openBtn?.setAttribute('aria-expanded', 'true');
      syncInert();
    };
    const closeSidebar = () => {
      // Take focus back BEFORE going inert. Closing while focus is inside the
      // drawer would otherwise drop it on <body>, and the next Tab would start
      // from the top of the document — which is the same "where am I?" the
      // inert fix exists to remove, arriving by the other door.
      if (sidebar?.contains(document.activeElement) && openBtn instanceof HTMLElement) openBtn.focus();
      open = false;
      sidebar?.classList.add('-translate-x-full');
      backdrop?.classList.add('opacity-0', 'pointer-events-none');
      openBtn?.setAttribute('aria-expanded', 'false');
      syncInert();
    };

    openBtn?.addEventListener('click', openSidebar);
    document.getElementById('sb-close')?.addEventListener('click', closeSidebar);
    backdrop?.addEventListener('click', closeSidebar);
    desktop.addEventListener('change', syncInert);
    syncInert();

    // ⚠ GUARDED, AND IT MATTERS NOW THAT IT DIDN'T BEFORE. This is bound at
    // document level, so it also fires while a modal sheet is open. That was
    // harmless while closing an already-closed drawer was a no-op — closing it
    // now moves focus and sets an attribute, so Escape-to-dismiss-a-sheet would
    // have yanked focus to the burger behind it.
    document.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !open) return;
      if (document.querySelector('dialog[open]')) return; // the sheet owns Escape
      closeSidebar();
    });
  </script>
</Base>

---
/*
  /about — the public About page. Two sections from the `about` singleton:
  Who I am (me), then About the Blog (site), with an optional contact.
  Edited at /admin/about. SSR + edge cache.

  Editorial treatment (not SaaS): quiet serif small-caps section labels, no accent
  eyebrows, and a floated portrait the prose wraps around. Heading outline: a
  visually-hidden h1 names the page; each section is a <section> headed by an h2.

  ⚠ THREE THINGS ARE DELIBERATELY ABSENT — ADR-0020, 2026-08-07. There was a
  "My Interests" list (term + note), a `headline` display line, and a `thesis`
  pull-quote above the blog prose. All three are gone, and the reason is one rule:
  a conclusion may not outrank the thing that earns it.

    · The interests notes restated what the sky already delivers. The Jazz note WAS
      the closing lines of "The Spirit of Jazz" — 8,242 published characters, in
      the `wayfinding` constellation — compressed to one sentence. So it spent the
      essay's ending without the essay. Cooking had no essay behind it at all, so
      it read as an IOU. One form, two failure modes, and no rewrite reaches
      either: the shape `{term, note}` can hold only a claim ABOUT an interest.
    · `thesis` rendered as text-xl italic behind a left rule, ABOVE the prose —
      i.e. a deck, which is a genre for readers who won't read (SaaS) or are
      deciding whether to (editorial standfirst). This page presumes someone who
      came to read.

  ⚠ The change that looks like the fix is the one ADR-0020 argues is WORSE:
  promoting each interest's insight to its heading ("Ideas are not property")
  turns the section into a table of contents for the sky's punchlines. If you are
  about to re-add any of this, read that ADR's register table first.

  ⚠ And note what did NOT go: *practical empathy* stays. vision.md §8 calls it
  this page's SPINE — which runs the length of a body, not across the front of it.
  It belongs inside `me.body`, arrived at. Removing the field removed a container,
  never the idea.
*/
import SiteLayout from '../layouts/SiteLayout.astro';
import Label from '../components/Label.astro';
import ContactForm from '../components/ContactForm.astro';
import { renderMarkdown } from '../lib/markdown';
import { parseSpotifyEmbed, spotifyEmbedHeight, spotifyEmbedSrc } from '../lib/media';

const supabase = Astro.locals.supabase;
const { data: page } = await supabase.from('pages').select('content, updated_at').eq('slug', 'about').single();

const c = (page?.content ?? {}) as {
  me?: {
    portrait?: string | null;
    portrait_caption?: string;
    body?: string;
  };
  site?: { body?: string; name?: { blurb?: string; spotify_url?: string } };
  contact?: { intro?: string };
};
const me = c.me ?? {};
const site = c.site ?? {};
const siteName = site.name ?? {};
const contact = c.contact ?? {};

const meBodyHtml = renderMarkdown(me.body);
const siteBodyHtml = renderMarkdown(site.body);
const blurbHtml = renderMarkdown(siteName.blurb);
const contactIntroHtml = renderMarkdown(contact.intro);

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const cacheBust = page?.updated_at ? new Date(page.updated_at).getTime() : 0;
const portraitUrl = me.portrait ? `${SUPABASE_URL}/storage/v1/object/public/site/${me.portrait}?v=${cacheBust}` : '';

const embed = siteName.spotify_url ? parseSpotifyEmbed(siteName.spotify_url) : null;
const embedSrc = embed ? spotifyEmbedSrc(embed) : '';
const embedHeight = embed ? spotifyEmbedHeight(embed.kind) : 352;

const hasMe = !!(meBodyHtml || portraitUrl);
const hasSite = !!(siteBodyHtml || blurbHtml || embedSrc);

Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');
---

<SiteLayout title="About" active="about">
  <article class="mx-auto w-full max-w-2xl px-5 py-10 sm:py-16">
    <h1 class="sr-only">About</h1>
    {
      !hasMe && !hasSite ? (
        <div class="flex min-h-[16rem] flex-col items-center justify-center px-6 py-16 text-center">
          <p class="text-base-content/55 font-serif text-lg">This page is being composed.</p>
        </div>
      ) : (
        <>
          {/* ─────────  WHO I AM  ───────── */}
          {hasMe && (
            <section aria-labelledby="mv-me">
              <h2 id="mv-me">
                <Label as="span">Who I am</Label>
              </h2>

              <div class="mt-8 flow-root">
                {portraitUrl && (
                  <figure class="mb-5 sm:float-right sm:mb-2 sm:ml-10 sm:w-56">
                    <img
                      src={portraitUrl}
                      alt="Portrait of the author"
                      class="rounded-box border-base-300 w-full border object-cover"
                      style="aspect-ratio: 4 / 5"
                    />
                    {me.portrait_caption && (
                      <figcaption class="text-base-content/40 mt-2 font-serif text-sm italic">
                        {me.portrait_caption}
                      </figcaption>
                    )}
                  </figure>
                )}
                {meBodyHtml && <div class="reading" set:html={meBodyHtml} />}
              </div>
            </section>
          )}

          {hasMe && hasSite && <hr class="border-base-300 my-20" />}

          {/* ─────────  ABOUT THE BLOG  ───────── */}
          {hasSite && (
            <section aria-labelledby="mv-site" class="max-w-lg">
              <h2 id="mv-site">
                <Label as="span">About the Blog</Label>
              </h2>

              {siteBodyHtml && <div class="reading mt-8" set:html={siteBodyHtml} />}

              {(blurbHtml || embedSrc) && (
                <div class="mt-12">
                  <Label as="h3">About the Name</Label>
                  <div class="rounded-box border-base-300 bg-base-200 mt-4 border p-6">
                    {blurbHtml && <div class="reading" set:html={blurbHtml} />}
                    {embedSrc && (
                      <iframe
                        src={embedSrc}
                        title="Spotify player"
                        width="100%"
                        height={embedHeight}
                        style="border-radius:12px;border:0"
                        class:list={[blurbHtml && 'mt-5']}
                        loading="lazy"
                        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                        allowfullscreen
                      />
                    )}
                  </div>
                </div>
              )}
            </section>
          )}

          {/* ─────────  SAY HELLO  ───────── */}
          <section aria-labelledby="mv-hello" class="border-base-300 mt-20 border-t pt-10">
            <h2 id="mv-hello">
              <Label as="span">Say hello</Label>
            </h2>
            {contactIntroHtml ? (
              <div class="reading mt-6 max-w-lg" set:html={contactIntroHtml} />
            ) : (
              <p class="text-base-content/70 mt-6 max-w-lg font-serif text-lg leading-relaxed">
                Have a thought, a question, or a hello? I read everything.
              </p>
            )}
            <ContactForm />
          </section>

          {/* Authorship attestation — hardcoded so it is always present. */}
          <div class="border-base-300 mt-16 border-t pt-6">
            <p class="text-base-content/55 font-serif text-sm leading-relaxed italic">
              There is no AI-generated content on this blog; all content is authored, edited, and compiled by me. Claude
              Code was only used to streamline the development process of the site itself.
            </p>
          </div>
        </>
      )
    }
  </article>
</SiteLayout>

---
/*
  /blog/[slug] — the canonical page for a single essay (design.md §10).

  The same PostArticle the in-context Reader shows, but on its own URL: shareable,
  crawlable, and a no-JS fallback. The footer offers a way back into the Index,
  filtered to the subjects the piece touches. (Constellations, once they exist,
  will join this footer — the "this piece lives in" pattern.)

  It is also the DRAFT PREVIEW (docs/plans/01). An admin session renders an
  unpublished piece here rather than the 404 everyone else gets, so a piece can
  be read exactly as it will ship before it ships. Two things hold that up and
  neither is optional:

   · RLS decides what can be read. The admin check below only chooses whether to
     ask for unpublished rows; `fragments_select_published` is what stops anyone
     else receiving one.
   · A preview must never enter a shared cache. The published branch opts this
     route into 60s of CDN caching, so the preview branch has to opt back out
     explicitly — a draft cached at the edge would be served to the public by a
     machine that has no idea whose session produced it.
*/
import { Icon } from 'astro-icon/components';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import PreviewBar from '../../components/PreviewBar.astro';
import QuoteArticle from '../../components/QuoteArticle.astro';
import { getWritingBySlug } from '../../lib/blog';
import { getQuotePage } from '../../lib/quote-page';
import { toPlainText } from '../../lib/markdown';

const { slug } = Astro.params;
const isAdmin = Astro.locals.user?.app_metadata?.role === 'admin';

/*
  ⚠ THIS ROUTE SERVES A QUOTE AS WELL AS AN ESSAY (plan 32 · §3), and it is not
  a new route because it never needed to be: `fragments.slug` is `not null
  unique` across EVERY type, and lib/slug.ts already claims the whole namespace
  in its own docstring — "a fragment's URL identity (/blog/forgiveness) … unique
  across all fragments". One namespace, collisions impossible by constraint, and
  it is what ADR-0003's single table implies. A second route under /quotes would
  be a second namespace guarding against a collision the database prevents.

  ⚠ BOTH LOOKUPS RUN TOGETHER rather than one-then-the-other. The slug can only
  be one of them, so the sequential version is a wasted round trip on every
  quote page and on every 404 — plan 24's finding, and it matters more on a
  reader-facing page than on any admin one. Two queries, one latency.

  A side effect worth having: Reader.astro already falls back to /blog/<slug>
  for anything not on the page it is open in. That fallback becomes CORRECT for
  a quote instead of landing on this file's 404.
*/
const [item, quote] = slug
  ? await Promise.all([
      getWritingBySlug(Astro.locals.supabase, slug, { includeUnpublished: isAdmin }),
      getQuotePage(Astro.locals.supabase, slug, { includeUnpublished: isAdmin }),
    ])
  : [null, null];

const found = item ?? quote;

// Anything not published is a preview — drafts and notes alike. One rule, so a
// tier added later can't quietly fall through to the public cache branch. The
// quote branch is held to the same rule for the same reason: one route now
// serves two renderers, and a cache header that only covered one of them is how
// a draft reaches the CDN.
const previewId = item ? item.id : quote?.quote.id;
const preview =
  found && found.status !== 'published'
    ? { status: found.status, editHref: `/admin/fragments#edit=${previewId}` }
    : null;

if (!found) {
  Astro.response.status = 404;
} else if (preview) {
  Astro.response.headers.set('Cache-Control', 'private, no-store');
} else {
  Astro.response.headers.set('Cache-Control', 'public, s-maxage=60, stale-while-revalidate=86400');
}

// A quote's description IS the quote: a client that ignores the card image
// still shows the line, which is the whole thing being shared.
const description = item
  ? toPlainText(item.excerpt).slice(0, 200)
  : quote
    ? toPlainText(quote.quote.body).slice(0, 200)
    : undefined;

// A quote has no title of its own, so the tab and the card take its opening
// words. Trailing punctuation cut mid-line reads as a typo, so it is trimmed.
const quoteTitle = quote
  ? toPlainText(quote.quote.body)
      .slice(0, 70)
      .replace(/[\s.,;:—-]+$/, '')
  : '';
const title = item ? item.title : quote ? `${quoteTitle}${quoteTitle.length < 70 ? '' : '…'}` : 'Not found';
---

<SiteLayout
  title={title}
  active="blog"
  description={description}
  ogType="article"
  image={found ? `/og/${slug}.png` : undefined}
>
  {preview && <PreviewBar status={preview.status} editHref={preview.editHref} />}
  {
    !found ? (
      <div class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 text-center">
        <p class="text-muted font-serif text-2xl">This piece isn’t here.</p>
        <p class="text-whisper mt-2 font-sans text-sm">It may have been unpublished, or the link is off by a letter.</p>
        <a href="/blog" class="text-primary mt-6 inline-flex items-center gap-1 font-sans text-sm hover:underline">
          <Icon name="ph:caret-left" class="size-3.5" /> Back to the blog
        </a>
      </div>
    ) : quote ? (
      /* The permalink's own frame: a full screen with the line floated in the
         middle of it. The Reader supplies a different one for the same content
         — see QuoteArticle, which carries neither. */
      <main class="px-6 pb-24">
        <section class="mx-auto flex min-h-[76vh] max-w-3xl flex-col justify-center">
          <QuoteArticle page={quote} />
        </section>
      </main>
    ) : item ? (
      <div class="mx-auto w-full max-w-2xl px-5 py-10 sm:py-16">
        <a
          href="/blog"
          class="text-whisper hover:text-base-content inline-flex items-center gap-1 font-sans text-sm transition-colors"
        >
          <Icon name="ph:caret-left" class="size-3.5" /> The blog
        </a>

        <div class="prose-measure mt-8">
          <PostArticle item={item} />
        </div>
      </div>
    ) : null
  }
</SiteLayout>

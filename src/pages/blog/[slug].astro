---
/*
  /blog/[slug] — the canonical page for a single essay (design.md §10).

  The same PostArticle the in-context Reader shows, but on its own URL: shareable,
  crawlable, and a no-JS fallback. The footer offers a way back into the Index,
  filtered to the subjects the piece touches. (Constellations, once they exist,
  will join this footer — the "this piece lives in" pattern.)

  It is also the DRAFT PREVIEW (docs/plans/01). An admin session renders an
  unpublished piece here rather than the 404 everyone else gets, so a piece can
  be read exactly as it will ship before it ships. Two things hold that up and
  neither is optional:

   · RLS decides what can be read. The admin check below only chooses whether to
     ask for unpublished rows; `fragments_select_published` is what stops anyone
     else receiving one.
   · A preview must never enter a shared cache. The published branch opts this
     route into 60s of CDN caching, so the preview branch has to opt back out
     explicitly — a draft cached at the edge would be served to the public by a
     machine that has no idea whose session produced it.
*/
import { Icon } from 'astro-icon/components';
import SiteLayout from '../../layouts/SiteLayout.astro';
import PostArticle from '../../components/PostArticle.astro';
import PreviewBar from '../../components/PreviewBar.astro';
import QuoteArticle from '../../components/QuoteArticle.astro';
import { getWritingBySlug } from '../../lib/blog';
import { getQuotePage } from '../../lib/quote-page';
import { toPlainText } from '../../lib/markdown';
import { PRIVATE_PAGE, PUBLIC_PAGE } from '../../lib/http-cache';

const { slug } = Astro.params;
const isAdmin = Astro.locals.user?.app_metadata?.role === 'admin';

/*
  ⚠ THIS ROUTE SERVES A QUOTE AS WELL AS AN ESSAY (plan 32 · §3), and it is not
  a new route because it never needed to be: `fragments.slug` is `not null
  unique` across EVERY type, and lib/slug.ts already claims the whole namespace
  in its own docstring — "a fragment's URL identity (/blog/forgiveness) … unique
  across all fragments". One namespace, collisions impossible by constraint, and
  it is what ADR-0003's single table implies. A second route under /quotes would
  be a second namespace guarding against a collision the database prevents.

  ⚠ BOTH LOOKUPS RUN TOGETHER rather than one-then-the-other. The slug can only
  be one of them, so the sequential version is a wasted round trip on every
  quote page and on every 404 — plan 24's finding, and it matters more on a
  reader-facing page than on any admin one. Two queries, one latency.

  A side effect worth having: Reader.astro FETCHES /blog/<slug> for anything
  not on the page it is open in, and lifts the article out of this render —
  `article.post-article` for an essay, `.quote-article` for a quote. That is
  what lets a "related" row inside a sheet open the next piece in the same
  sheet rather than stranding the reader on a bare permalink (2026-11-09).
*/
const [item, quote] = slug
  ? await Promise.all([
      getWritingBySlug(Astro.locals.supabase, slug, { includeUnpublished: isAdmin }),
      getQuotePage(Astro.locals.supabase, slug, { includeUnpublished: isAdmin }),
    ])
  : [null, null];

const found = item ?? quote;

/*
  `?in=<constellation>` — the room the asker is standing in, sent ONLY by the
  Reader when a suite's sheet fetches a quote it has no template for. It means
  exactly what `QuoteArticle`'s `inConstellation` means: drop that room from
  "Appears in", because a door back into the room you are already in is not a
  door. The suite's own templates pass it at render time; a fetched quote has no
  other way to say it, and without this a related quote opened inside a
  constellation listed that same constellation as somewhere else to go.

  Harmless on a link anyone types: it can only REMOVE one row from a popover.
  It does not split the page's identity — `lib/canonical.ts` drops the query.
*/
const inConstellation = quote ? Astro.url.searchParams.get('in')?.trim() || undefined : undefined;

// Anything not published is a preview — drafts and notes alike. One rule, so a
// tier added later can't quietly fall through to the public cache branch. The
// quote branch is held to the same rule for the same reason: one route now
// serves two renderers, and a cache header that only covered one of them is how
// a draft reaches the CDN.
const previewId = item ? item.id : quote?.quote.id;
const preview =
  found && found.status !== 'published'
    ? { status: found.status, editHref: `/admin/fragments#edit=${previewId}` }
    : null;

if (!found) {
  Astro.response.status = 404;
} else if (preview) {
  Astro.response.headers.set('Cache-Control', PRIVATE_PAGE);
} else {
  Astro.response.headers.set('Cache-Control', PUBLIC_PAGE);
}

// A quote's description IS the quote: a client that ignores the card image
// still shows the line, which is the whole thing being shared.
const description = item
  ? toPlainText(item.excerpt).slice(0, 200)
  : quote
    ? toPlainText(quote.quote.body).slice(0, 200)
    : undefined;

// A quote has no title of its own, so the tab and the card take its opening
// words. Trailing punctuation cut mid-line reads as a typo, so it is trimmed.
const quoteTitle = quote
  ? toPlainText(quote.quote.body)
      .slice(0, 70)
      .replace(/[\s.,;:—-]+$/, '')
  : '';
const title = item ? item.title : quote ? `${quoteTitle}${quoteTitle.length < 70 ? '' : '…'}` : 'Not found';
---

<SiteLayout
  title={title}
  active="blog"
  description={description}
  ogType="article"
  image={found ? `/og/${slug}.png` : undefined}
>
  {preview && <PreviewBar status={preview.status} editHref={preview.editHref} />}
  {
    !found ? (
      <div class="mx-auto flex min-h-[60vh] max-w-2xl flex-col items-center justify-center px-5 text-center">
        <p class="text-muted font-serif text-2xl">This piece isn’t here.</p>
        <p class="text-whisper mt-2 font-sans text-sm">It may have been unpublished, or the link is off by a letter.</p>
        <a href="/blog" class="text-primary mt-6 inline-flex items-center gap-1 font-sans text-sm hover:underline">
          <Icon name="ph:caret-left" class="size-3.5" /> Back to the blog
        </a>
      </div>
    ) : quote ? (
      /* The permalink's own frame: a full screen with the line floated in the
         middle of it. The Reader supplies a different one for the same content
         — see QuoteArticle, which carries neither.

         ⚠ THE WAY BACK IS TO THE QUOTES, NOT "THE BLOG" (2026-11-09). This page
         shipped with no way back at all: the strip's doors all lead SIDEWAYS
         (a subject, an author, a constellation, a kin), and the nav's "Blog"
         lands on Writing — the wrong view — and on a phone sits behind the
         burger. Michael: *"there is no easy way to navigate back to just
         browsing quotes."* The essay's words were the obvious copy and are
         wrong here for the same reason the nav is: "The blog" names a room
         whose door opens on the other view. "All quotes" also tells a stranger
         arriving from a shared link the thing this page exists to tell them —
         that there is a collection behind the line. */
      <main class="px-6 pb-24">
        <div class="mx-auto max-w-3xl pt-6 sm:pt-10">
          <a href="/blog?view=quotes" class="reader-back" data-feed-return>
            <Icon name="ph:caret-left" class="size-3.5" /> <span data-feed-return-label>All quotes</span>
          </a>
        </div>
        <section class="mx-auto flex min-h-[72vh] max-w-3xl flex-col justify-center">
          <QuoteArticle page={quote} inConstellation={inConstellation} />
        </section>
      </main>
    ) : item ? (
      /* ⚠ `.reader-back`, THE SHEET'S OWN CLASS, ON PURPOSE. Reader.astro took
         its words and its mark from this page so a reader is never taught two
         ways home; sharing the class makes that literally true — the same 44px
         target, the caret aligned to the prose, the same lean on hover. */
      <div class="mx-auto w-full max-w-2xl px-5 py-10 sm:py-16">
        <a href="/blog" class="reader-back" data-feed-return>
          <Icon name="ph:caret-left" class="size-3.5" /> <span data-feed-return-label>The blog</span>
        </a>

        <div class="prose-measure mt-6">
          <PostArticle item={item} />
        </div>

        {/* ⚠ AND AGAIN AT THE FOOT, which is the half the sheet already had and
            this page did not. Reader.astro: the bottom control "is the half
            that earns the change" — a reader who has just finished an essay
            averaging 5,700 characters is at the far end of it, and the only
            explicit way back was thousands of pixels up. The site footer's
            "Blog" is below this, but it is a row of furniture, not an answer to
            "where do I go now?" */}
        <div class="mt-8">
          <a href="/blog" class="reader-back" data-feed-return>
            <Icon name="ph:caret-left" class="size-3.5" /> <span data-feed-return-label>The blog</span>
          </a>
        </div>
      </div>
    ) : null
  }
</SiteLayout>

<script>
  /*
    `data-feed-return` on the three ways back above: when this page was reached
    FROM the feed — an essay's title in the reading sheet, or a ⌕ result opened
    over the list — each one is re-pointed at the exact place the reader left
    (same filters, same depth, same card), and relabelled for the list it now
    leads to. Reached any other way — a shared link above all — the href the
    server wrote stands: the top of the list, because a stranger dropped into
    the middle of it would be lost, not helped. The whole argument is in
    scripts/feed-return.ts.
  */
  import { initFeedReturn } from '../../scripts/feed-return';
  initFeedReturn();
</script>

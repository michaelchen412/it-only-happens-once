<script>
  /* `Base` does not opt into view transitions, so every change is a real
     document load and this module runs fresh each time — no `astro:page-load`. */
  import { MIN_SEARCH } from '../../lib/search-highlight';
  // The room's own popover placement, not a second copy of it.
  import { anchorPopover } from '../../scripts/pop-anchor';

  const panel = document.querySelector<HTMLFormElement>('[data-sh-panel]');
  const box = document.querySelector<HTMLInputElement>('[data-sh-q]');
  const stat = document.querySelector<HTMLElement>('[data-sh-stat]');

  function go(mutate: (p: URLSearchParams) => void) {
    const p = new URLSearchParams(location.search);
    mutate(p);
    location.assign(`${location.pathname}?${p}`);
  }

  panel?.addEventListener('change', () => {
    const data = new FormData(panel);
    go((p) => {
      p.set('v', String(data.get('v') ?? 'inbox'));
      p.set('n', String(data.get('n') ?? '11'));
      if (data.get('multi') !== null) p.delete('multi');
      else p.set('multi', 'off');
      // The param spells the DEFECT, the checkbox spells the behaviour — so the
      // clean URL is the correct one and `?escape=off` is visibly an opt-in.
      if (data.get('escape') !== null) p.delete('escape');
      else p.set('escape', 'off');
      // ⚠ THE SHELF IS DROPPED ON EVERY PANEL CHANGE, deliberately. `flat` and
      // `grouped` show a shelf that `none` has no control for, so carrying the
      // selection into the control variant would filter the pile by something
      // the reader can no longer see or clear.
      p.delete('shelf');
    });
  });

  document.querySelectorAll<HTMLElement>('[data-sh-shelf]').forEach((b) => {
    b.addEventListener('click', () => {
      const slug = b.dataset.shShelf ?? '';
      go((p) => (slug ? p.set('shelf', slug) : p.delete('shelf')));
    });
  });

  /* The same `MIN_SEARCH` comparison the shipped clients make (docs/search.md
     §3): below it the term never reaches the URL. */
  const effective = (raw: string) => (raw.trim().length >= MIN_SEARCH ? raw.trim() : '');
  let last = effective(box?.value ?? '');
  let timer = 0;

  box?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      const next = effective(box.value);
      if (next === last) return;
      last = next;
      go((p) => (next ? p.set('q', next) : p.delete('q')));
    }, 260);
  });

  if (box?.value) {
    box.focus();
    box.setSelectionRange(box.value.length, box.value.length);
  }

  /* ══ FILING ══════════════════════════════════════════════════════════════
     The half /lab/shelves was missing until 2026-09-01: the shelves were
     assigned by me in advance and every card was inert, so the page could show
     you what a filed pile LOOKS like and not what filing FEELS like — which is
     the only half that decides anything.

     ⚠ NOTHING IS WRITTEN TO THE DATABASE, and there is nothing it could be
     written to: no migration has been applied and none should be until the
     shape is settled. An override lives in `localStorage`, keyed by the card,
     and `put the sample back` clears it. */
  const STORE = 'lab.shelves.v1';
  const root = document.querySelector<HTMLElement>('[data-sh-root]')!;
  const variant = root.dataset.variant ?? 'inbox';
  const pressed = root.dataset.shelf ?? '';
  const escapedView = root.dataset.escaped === '1';
  const isMulti = root.dataset.multi === '1';

  type Store = Record<string, string[]>;
  const load = (): Store => {
    try {
      return JSON.parse(localStorage.getItem(STORE) ?? '{}') as Store;
    } catch {
      return {}; // a corrupt value is not worth a broken bench
    }
  };
  let store = load();
  const save = () => localStorage.setItem(STORE, JSON.stringify(store));

  const cards = [...document.querySelectorAll<HTMLElement>('.dump')];
  const LABEL = new Map<string, string>(
    [...document.querySelectorAll<HTMLElement>('[data-pick]')]
      .filter((b) => b.dataset.pick)
      .map((b) => [b.dataset.pick!, (b.childNodes[0]?.textContent ?? '').trim()]),
  );

  /** A card's shelves: the reader's filing if there is any, else the sample's. */
  function shelvesOf(card: HTMLElement): string[] {
    const own = store[card.dataset.key!];
    if (own) return own;
    return [card.dataset.seed, card.dataset.seedAlso].filter((v): v is string => !!v);
  }

  /** The one visibility rule — the client's copy is the ONLY copy (see `rows`). */
  function isVisible(list: string[]): boolean {
    if (variant === 'none') return true;
    if (pressed) return list.includes(pressed);
    if (variant === 'inbox' && !escapedView) return list.length === 0;
    return true;
  }

  function draw() {
    let onScreen = 0;
    let homeless = 0;
    let onTwo = 0;

    for (const card of cards) {
      const list = shelvesOf(card);
      if (!list.length) homeless++;
      if (list.length > 1) onTwo++;

      // the chip(s)
      const slot = card.querySelector<HTMLElement>('[data-chips]')!;
      slot.textContent = '';
      if (variant === 'none') {
        // nothing — the control proposition has no shelves at all
      } else if (list.length) {
        for (const sl of list) {
          const chip = document.createElement('span');
          chip.className = 'sh__chip';
          chip.dataset.chip = '';
          chip.textContent = LABEL.get(sl) ?? sl;
          slot.append(chip);
        }
      } else {
        const chip = document.createElement('span');
        chip.className = 'sh__chip sh__chip--none';
        chip.dataset.homeless = '';
        chip.textContent = 'unshelved';
        slot.append(chip);
      }

      const show = isVisible(list);
      card.hidden = !show;
      if (show) onScreen++;

      // `grouped` re-sections a card the moment it is filed. Primary shelf only
      // — see the note on `groups` for why that is a finding and not a bug.
      if (variant === 'grouped' && !pressed) {
        const want = document.querySelector<HTMLElement>(`[data-group="${list[0] ?? ''}"]`);
        if (want && card.parentElement !== want) want.append(card);
      }
    }

    // the segment counts, over the WHOLE pile — pressing a shelf must never
    // change the number beside another one.
    for (const btn of document.querySelectorAll<HTMLElement>('[data-sh-shelf]')) {
      const slug = btn.dataset.shShelf ?? '';
      const n = btn.querySelector('.type-badge__n');
      if (!n) continue;
      n.textContent = String(
        slug ? cards.filter((c) => shelvesOf(c).includes(slug)).length : variant === 'inbox' ? homeless : cards.length,
      );
    }

    // group headings hide when their section empties
    for (const sec of document.querySelectorAll<HTMLElement>('.sh__group')) {
      const live = [...sec.querySelectorAll<HTMLElement>('.dump')].filter((c) => !c.hidden).length;
      sec.hidden = live === 0;
      const n = sec.querySelector<HTMLElement>('[data-groupn]');
      if (n) n.textContent = String(live);
    }

    const empty = document.querySelector<HTMLElement>('[data-sh-empty]');
    if (empty) {
      empty.hidden = onScreen > 0 || !cards.length;
      empty.textContent = pressed ? 'Nothing on this shelf.' : 'Inbox empty — everything here is filed.';
    }

    const filed = Object.keys(store).length;
    const note = document.querySelector<HTMLElement>('[data-sh-filed]');
    if (note)
      note.textContent = filed
        ? `${filed} note${filed === 1 ? '' : 's'} refiled by you`
        : 'none yet — the sample as written';

    measure(onScreen, homeless, onTwo);
    root.removeAttribute('data-sh-pending');
  }

  /* ── the chooser ──────────────────────────────────────────────────────── */
  const pop = document.querySelector<HTMLElement>('[data-sh-pop]');
  let target: HTMLElement | null = null;

  for (const btn of document.querySelectorAll<HTMLElement>('[data-file]')) {
    btn.addEventListener('click', () => {
      target = btn.closest<HTMLElement>('.dump');
      if (!pop || !target) return;
      // Tick what it is already on, so the menu says where the note lives
      // before it offers to move it.
      const on = shelvesOf(target);
      for (const row of pop.querySelectorAll<HTMLElement>('[data-pick]')) {
        row.classList.toggle('is-on', !!row.dataset.pick && on.includes(row.dataset.pick));
      }
      pop.querySelector<HTMLElement>('.sh-pop__off')!.hidden = on.length === 0;
    });
  }
  if (pop) anchorPopover(pop, () => target?.querySelector<HTMLElement>('[data-file]'));

  for (const row of document.querySelectorAll<HTMLElement>('[data-pick]')) {
    row.addEventListener('click', () => {
      if (!target) return;
      const card = target;
      const slug = row.dataset.pick ?? '';
      const before = shelvesOf(card);

      let next: string[];
      if (!slug) next = [];
      else if (!isMulti) next = [slug];
      else if (before.includes(slug)) next = before.filter((x) => x !== slug);
      // ⚠ TWO IS THE CAP, not an arbitrary one: the open question is whether a
      // note needs a SECOND drawer, and a third would be answering a question
      // nobody asked. A pick past the cap replaces the older of the two.
      else next = before.length >= 2 ? [before[1], slug] : [...before, slug];

      store[card.dataset.key!] = next;
      save();

      const wasVisible = !card.hidden;
      const nowVisible = isVisible(next);
      if (wasVisible && !nowVisible) {
        // It leaves. Say what happened and offer the way back — the room's own
        // strip, because filing out of the inbox is exactly as reversible as a
        // delete and should cost the same to undo.
        card.classList.add('dump--going');
        const where = next.length ? (LABEL.get(next[0]) ?? next[0]) : 'the inbox';
        showUndo(next.length ? `Filed under ${where}.` : 'Back in the inbox.', card, before);
        window.setTimeout(() => {
          card.classList.remove('dump--going');
          draw();
        }, 220);
      } else {
        draw();
      }
      pop?.hidePopover();
    });
  }

  /* ── the undo strip ───────────────────────────────────────────────────── */
  const undoBar = document.getElementById('sh-undo');
  const undoText = undoBar?.querySelector<HTMLElement>('[data-undo-text]');
  const undoBtn = undoBar?.querySelector<HTMLButtonElement>('[data-undo-do]');
  let undoTimer = 0;
  let pending: { card: HTMLElement; before: string[] } | null = null;

  function showUndo(text: string, card: HTMLElement, before: string[]) {
    if (!undoBar || !undoText) return;
    window.clearTimeout(undoTimer);
    pending = { card, before };
    undoText.textContent = text;
    undoBar.classList.add('is-visible');
    undoTimer = window.setTimeout(() => undoBar.classList.remove('is-visible'), 8000);
  }

  undoBtn?.addEventListener('click', () => {
    if (!pending) return;
    const { card, before } = pending;
    // Back to whatever it was — including "no override at all", so undoing the
    // first filing of a note leaves the sample genuinely untouched.
    const seed = [card.dataset.seed, card.dataset.seedAlso].filter(Boolean);
    if (before.join() === seed.join()) delete store[card.dataset.key!];
    else store[card.dataset.key!] = before;
    save();
    pending = null;
    undoBar?.classList.remove('is-visible');
    draw();
  });

  document.querySelector<HTMLElement>('[data-sh-reset]')?.addEventListener('click', () => {
    store = {};
    localStorage.removeItem(STORE);
    draw();
  });

  /**
   * The measurement. Two of these numbers are the ones that can REFUTE the
   * claim, so they are rendered in the accent and the others are not:
   *
   *   homeless — notes on no shelf. If this stays high as the pile grows, the
   *              inbox never empties and shelving changed nothing (failure 1).
   *   on two   — notes needing a second drawer. If this is more than a rounding
   *              error, single-valued is the wrong bill (failure 2).
   */
  function measure(shown: number, homeless: number, onTwo: number) {
    if (!stat) return;
    /* ⚠ COUNTED OVER THE WHOLE PILE BY `draw()`, never off the rendered cards.
       This was a real bug for one revision: read from the DOM, "needing two
       drawers" measured 0 under `inbox`, because the double-shelved note is
       hidden there BY DEFINITION — so the number quietly flattered the cheap
       schema it exists to challenge. It was a server value until filing became
       live; now the client owns the shelves, so the client owns the count. */
    const parts = [`${shown} card${shown === 1 ? '' : 's'} on screen`];
    // Windows ARE a render fact, so this one is still counted from the DOM —
    // and only the visible cards' windows, which is what "on screen" means.
    const windows = [...document.querySelectorAll<HTMLElement>('.dump')]
      .filter((c) => !c.hidden)
      .reduce((sum, c) => sum + c.querySelectorAll('.sh__win').length, 0);
    if (windows) parts.push(`${windows} excerpt window${windows === 1 ? '' : 's'}`);

    stat.innerHTML = '';
    stat.append(parts.join(' · '));
    if (homeless) {
      stat.append(' · ');
      const b = document.createElement('strong');
      b.textContent = `${homeless} unshelved in the pile`;
      stat.append(b);
    }
    if (onTwo) {
      stat.append(' · ');
      const b = document.createElement('strong');
      b.textContent = `${onTwo} needing two drawers`;
      stat.append(b);
    }
  }

  draw();
</script>

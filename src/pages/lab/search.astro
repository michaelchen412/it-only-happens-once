    font-size: 1.15rem;
  }

  /* Bottom-left, like /lab/nav-bar: the top-right belongs to the theme popover
     and the bottom-right to back-to-top. */
  .sb-panel {
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    z-index: 50;
    width: min(19rem, calc(100vw - 2rem));
    background: var(--color-base-100);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box);
    font-family: var(--font-sans);
    font-size: 0.82rem;
    box-shadow: 0 1px 2px rgb(0 0 0 / 0.06);
  }
  .sb-panel__summary {
    cursor: pointer;
    list-style: none;
    padding: 0.5rem 0.95rem;
    font-variant: all-small-caps;
    letter-spacing: 0.09em;
    color: var(--text-whisper);
    user-select: none;
  }
  .sb-panel__summary::-webkit-details-marker {
    display: none;
  }
  .sb-panel__form {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 0.75rem 0.95rem 0.85rem;
    border-top: 1px solid var(--color-base-300);
  }
  .sb-panel__set {
    display: flex;
    flex-direction: column;
    gap: 0.2rem;
    border: 0;
    padding: 0;
  }
  .sb-panel__legend {
    padding: 0;
    font-family: var(--font-serif);
    font-size: 0.85rem;
    letter-spacing: 0.08em;
    font-variant: all-small-caps;
    color: var(--text-whisper);
  }
  .sb-panel__row {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    cursor: pointer;
    line-height: 1.5;
  }
</style>

<script>
  /* The bench's own wiring. `Base` does not opt into view transitions, so every
     change here is a real document load and this module runs fresh each time —
     no `astro:page-load` listener, deliberately (see Base.astro's Props). */
  import { MIN_SEARCH } from '../../lib/search-highlight';

  const panel = document.querySelector<HTMLFormElement>('[data-sb-panel]');
  const box = document.querySelector<HTMLInputElement>('[data-sb-q]');
  const stat = document.querySelector<HTMLElement>('[data-sb-stat]');

  /** Rewrite the URL and reload. One place, so no control invents its own params. */
  function go(mutate: (p: URLSearchParams) => void) {
    const p = new URLSearchParams(location.search);
    mutate(p);
    location.assign(`${location.pathname}?${p}`);
  }

  panel?.addEventListener('change', () => {
    const data = new FormData(panel);
    go((p) => {
      p.set('v', String(data.get('v') ?? 'mark'));
      p.set('n', String(data.get('n') ?? '8'));
      // The checkbox is the PROPOSITION ("un-clamp"), the param is the STATE
      // ("clamp"), so the panel reads as a change to the room rather than as a
      // setting whose default is off.
      if (data.get('unclamp') !== null) p.set('clamp', 'off');
      else p.delete('clamp');
      if (data.get('gate') !== null) p.set('gate', 'on');
      else p.delete('gate');
    });
  });

  /* ⚠ THE SAME `MIN_SEARCH` COMPARISON THE SHIPPED CLIENTS MAKE (§3): below it
     the term is dropped from the URL entirely, so a stray short `q` never lands
     in the address bar — and typing or clearing a single letter costs nothing. */
  const effective = (raw: string) => (raw.trim().length >= MIN_SEARCH ? raw.trim() : '');
  let last = effective(box?.value ?? '');
  let timer = 0;

  box?.addEventListener('input', () => {
    clearTimeout(timer);
    timer = window.setTimeout(() => {
      const next = effective(box.value);
      if (next === last) return; // nothing the server would do differently
      last = next;
      go((p) => (next ? p.set('q', next) : p.delete('q')));
    }, 260);
  });

  document.querySelectorAll<HTMLElement>('[data-sb-probe]').forEach((b) => {
    b.addEventListener('click', () => {
      const term = b.dataset.sbProbe ?? '';
      go((p) => (effective(term) ? p.set('q', term) : p.delete('q')));
    });
  });

  /* A navigation destroys focus, and a search box you have to re-click after
     every keystroke-batch cannot be judged at all. Caret to the end, not to 0. */
  if (box?.value) {
    box.focus();
    box.setSelectionRange(box.value.length, box.value.length);
  }

  /**
   * The measurement, and the reason this is a bench rather than a mockup.
   *
   * ⚠ HITS BEHIND THE CLAMP CANNOT BE COUNTED ON THE SERVER. `.dump__text--clamped`
   * is `max-height: 16rem` plus a mask that fades over the final 2.5rem, so
   * whether a given `<mark>` is readable is a fact about layout. A hit that
   * STARTS inside the fade is already gone, which is why the test is against
   * `bottom - 40` and not against `bottom`.
   */
  function measure() {
    let marks = 0;
    let buried = 0;
    let notesWithBuried = 0;

    document.querySelectorAll<HTMLElement>('[data-text]').forEach((el) => {
      const found = el.querySelectorAll<HTMLElement>('mark.hl');
      marks += found.length;
      if (!el.classList.contains('dump__text--clamped')) return;
      const fold = el.getBoundingClientRect().bottom - 40; // the mask's 2.5rem
      let here = 0;
      found.forEach((m) => {
        if (m.getBoundingClientRect().top > fold) here++;
      });
      if (here) {
        buried += here;
        notesWithBuried++;
      }
    });

    const notes = document.querySelectorAll('.dump').length;
    if (!stat) return;

    const windows = document.querySelectorAll('.sb__win').length;
    const parts = [`${notes} note${notes === 1 ? '' : 's'} shown`];
    if (windows) parts.push(`${windows} excerpt window${windows === 1 ? '' : 's'}`);
    if (marks) parts.push(`${marks} match${marks === 1 ? '' : 'es'} marked`);
    if (!windows && !marks) parts.push('nothing marked');

    stat.innerHTML = '';
    stat.append(parts.join(' · '));
    if (buried) {
      stat.append(' · ');
      const b = document.createElement('strong');
      b.textContent = `${buried} hidden behind the clamp, in ${notesWithBuried} note${notesWithBuried === 1 ? '' : 's'}`;
      stat.append(b);
    }
  }

  // After fonts land: the clamp is a height in rem, so measuring before the
  // serif swaps counts marks against a box that is about to move.
  if (document.fonts?.ready) document.fonts.ready.then(measure);
  else measure();
  addEventListener('resize', measure);
</script>

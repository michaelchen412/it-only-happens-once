<script>
  /* The bench's behaviour. Kept in this file on purpose — a lab that reaches
     into `src/scripts/` leaves something behind when it is deleted. The three
     imports below are the exception and are the point: they are the SHIPPED
     editor, the SHIPPED popover arithmetic and the SHIPPED dialog exit, so what
     you are judging is the real feel of each, not a re-implementation that is
     kinder than the original. */
  import { actions } from 'astro:actions';
  // ⚠ NOT a bare `await actions.…`, here of all places. `astro:actions` THROWS
  // on a dead network instead of returning `{ error }`, and a bench whose
  // "Saved" silently never arrives would teach the wrong lesson about the very
  // thing it is measuring. `src/tests/action-guard.test.ts` enforces this.
  import { callAction, formatActionError } from '../../scripts/action-error';
  import { mountRichEditor } from '../../scripts/rich-editor';
  import { anchorPopover } from '../../scripts/pop-anchor';
  import { closeWithExit, openDialog } from '../../scripts/dialog-close';

  const lab = document.querySelector('.lab') as HTMLElement;
  const stage = document.getElementById('lab-stage') as HTMLDialogElement;
  const fab = document.getElementById('lab-fab') as HTMLButtonElement;

  /* ⚠ NOTHING FROM THE FRONTMATTER IS RESTATED DOWN HERE. The samples and the
     destination facts are rendered onto the buttons as data attributes and read
     back off them — one owner per fact (29). A second copy of the noun list in
     this script is exactly the drift that would let the bench print a
     destination the chooser no longer offers. */
  const NOUN_META = new Map<string, { label: string; row: string; where: string; whereLabel: string }>();

  // ---- controls ------------------------------------------------------------
  function group(attr: string, value: string) {
    document.querySelectorAll<HTMLButtonElement>(`.lab__ctl [${attr}]`).forEach((b) => {
      b.setAttribute('aria-pressed', String(b.getAttribute(attr) === value));
    });
  }
  /* Written to BOTH the lab and the document element. The lab copy drives the
     page's own layout; the root copy is the one that still reaches the box
     after it has moved into the dialog — see the `:root[data-nouns]` note in
     the stylesheet. */
  const settings = ['view', 'w', 'nouns', 'write'] as const;
  const put = (k: string, v: string) => {
    lab.setAttribute(`data-${k}`, v);
    document.documentElement.setAttribute(`data-${k}`, v);
    // The narrowed column folds its field by width, and CSS cannot express
    // "start closed on a phone" — so the panels are told when the width moves.
    window.dispatchEvent(new CustomEvent('lab:settings'));
  };
  settings.forEach((k) => {
    put(k, lab.getAttribute(`data-${k}`) ?? '');
    document.querySelectorAll<HTMLButtonElement>(`.lab__ctl [data-${k}]`).forEach((b) =>
      b.addEventListener('click', () => {
        const v = b.getAttribute(`data-${k}`)!;
        put(k, v);
        group(`data-${k}`, v);
      }),
    );
  });
  document.querySelector('[data-theme-flip]')?.addEventListener('click', () => {
    const root = document.documentElement;
    root.dataset.theme = root.dataset.theme === 'paper' ? 'dusk' : 'paper';
  });

  // ---- one panel -----------------------------------------------------------
  type Panel = ReturnType<typeof wire>;
  const panels = new Map<string, Panel>();

  function wire(section: HTMLElement) {
    const key = section.dataset.prop!;
    const frame = section.querySelector<HTMLElement>('[data-frame]')!;
    const home = document.createComment(`frame:${key}`); // where the frame lives when not on stage
    frame.before(home);
    const boxEl = section.querySelector<HTMLElement>('[data-box]')!;
    const statusEl = section.querySelector<HTMLElement>('[data-status]')!;
    const meterEl = section.querySelector<HTMLElement>('[data-meter]')!;
    const receiptEl = section.querySelector<HTMLElement>('[data-receipt]')!;
    const menuEl = section.querySelector<HTMLElement>('[data-menu]');
    const bodyEl = section.querySelector<HTMLElement>('[data-body]')!;
    const fieldsEl = section.querySelector<HTMLElement>('[data-fields]');

    /* THE MEASUREMENT. Taps and seconds are counted from the first thing you do
       to the moment you file — because "fast" is the whole question here and an
       estimate written into the markup would be me marking my own homework.
       Reset by picking a sample, so each run is one clean read. */
    let taps = 0;
    let t0 = 0;
    let tick: number | undefined;
    /* ⚠ IT HAS TO TICK. The first version repainted only on a tap, so the meter
       showed the time of your PREVIOUS click — a stopwatch that reads 0.0s
       while you sit deciding what the thing is, which is precisely the interval
       this bench is trying to measure. */
    const startClock = () => {
      if (t0) return;
      t0 = performance.now();
      tick = window.setInterval(() => paint(), 100);
    };
    const stopClock = () => {
      window.clearInterval(tick);
      tick = undefined;
    };
    const bump = () => {
      startClock();
      taps += 1;
      paint();
    };
    function paint(filedAs?: string) {
      const secs = t0 ? ((performance.now() - t0) / 1000).toFixed(1) : '0.0';
      meterEl.textContent = t0
        ? `${taps} tap${taps === 1 ? '' : 's'} · ${secs}s${filedAs ? ` → ${filedAs}` : ''}`
        : 'not touched yet';
    }
    /* ⚠ ON THE FRAME, NOT ON THE CARD. The frame is the thing that moves into
       the dialog for a walk-through; a delegated listener left on the section
       would stop hearing its own buttons the moment they left it — and, like
       the popover above, it would fail silently and only during the walk. */
    frame.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('[data-tap]')) bump();
    });

    // ---- the real editor ---------------------------------------------------
    const { editor, getMarkdown } = mountRichEditor({
      editorEl: boxEl,
      toolbarRoot: section.querySelector<HTMLElement>('.cap-tools')!,
      linkDialog: document.getElementById(`lab-link-${key}`) as HTMLDialogElement | null,
      placeholder: 'Write it down…',
      ariaLabel: 'What are you thinking?',
      breaks: true, // a jot's line breaks ARE its structure — the shipped box's setting
      docClass: 'jot-prose',
      onChange: () => {
        startClock();
        paint();
        marks();
        queueSave();
      },
    });

    /* ---- the jot's own save ------------------------------------------------
       Armed only by the "For real" switch. This is `fragments.saveWriting` with
       `status: note` — the SAME call the shipped box makes, debounce and all,
       including sending the slug back so it is minted once instead of churning
       on every keystroke (14 §9f). One id per sample per panel: re-typing
       updates that row rather than breeding new ones. */
    let noteId: string | null = null;
    let baseUpdatedAt = '';
    let slug = '';
    let lastSaved = '';
    let timer: number | undefined;
    let fadeTimer: number | undefined;

    function flash(text: string, sticky = false) {
      window.clearTimeout(fadeTimer);
      statusEl.textContent = text;
      statusEl.style.opacity = '1';
      if (sticky) return;
      fadeTimer = window.setTimeout(() => (statusEl.style.opacity = '0'), 1400);
    }
    function queueSave() {
      window.clearTimeout(timer);
      timer = window.setTimeout(save, 700);
    }
    async function save() {
      const text = getMarkdown();
      if (!text.trim() || text === lastSaved) return;
      if (lab.dataset.write !== 'on') {
        lastSaved = text;
        flash('Saved (dry run)');
        return;
      }
      const id = (noteId ??= crypto.randomUUID());
      const fd = new FormData();
      fd.set('id', id);
      fd.set('body', text);
      fd.set('status', 'note');
      if (slug) fd.set('slug', slug);
      if (baseUpdatedAt) fd.set('base_updated_at', baseUpdatedAt);
      const { data, error } = await callAction(actions.fragments.saveWriting(fd));
      if (error || !data) return flash(formatActionError(error), true);
      noteId = data.id;
      baseUpdatedAt = data.updated_at;
      slug = data.slug;
      lastSaved = text;
      flash('Saved');
    }

    // ---- proposition-specific behaviour ------------------------------------
    // `menu`: the list is the first screen; picking swaps it for the box.
    function showMenu(on: boolean) {
      if (!menuEl) return;
      menuEl.hidden = !on;
      bodyEl.hidden = on;
    }
    showMenu(Boolean(menuEl));

    // `tabs`: the kind decides which fields exist.
    function setTab(kind: string) {
      // ⚠ `frame`, not `section` — see the trigger-lookup note further down.
      frame.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) => {
        t.setAttribute('aria-selected', String(t.dataset.tab === kind));
      });
      if (!fieldsEl) return;
      let any = false;
      fieldsEl.querySelectorAll<HTMLElement>('[data-for]').forEach((set) => {
        const on = set.dataset.for === kind;
        set.hidden = !on;
        any ||= on;
      });
      fieldsEl.hidden = !any;
      syncLite();
    }

    /** Which kind the box is currently claiming to be. `jot` everywhere else. */
    const activeKind = () => frame.querySelector<HTMLElement>('[data-tab][aria-selected="true"]')?.dataset.tab ?? 'jot';

    /* ⚠ THE ANSWER TO "DO MY FIELDS SURVIVE A TAB SWITCH?" HAS TO BE VISIBLE.
       They always did — the sets are hidden, never emptied — but Michael could
       not tell by looking (2026-08-24), and a persistence guarantee you have to
       test by hand is not a guarantee anybody trusts. A mark on every tab that
       is holding something answers it at a glance, and it answers it for the
       BODY too: the jot tab carries the words every other kind is built from. */
    function marks() {
      const bodyHeld = getMarkdown().trim().length > 0;
      frame.querySelectorAll<HTMLElement>('[data-tab]').forEach((t) => {
        const kind = t.dataset.tab!;
        if (kind === 'jot') return void (t.dataset.held = String(bodyHeld));
        t.dataset.held = String(heldIn(fieldsEl?.querySelector<HTMLElement>(`[data-for="${kind}"]`), false).length > 0);
      });
    }
    fieldsEl?.addEventListener('input', marks);

    /* ---- the narrowed column, in one place ---------------------------------
       Everything `lite` does differently — which control is offered, whether it
       is folded, and what the card says the room will still ask for — is one
       function, because these are four faces of a single question ("what is
       this thought going to be?") and splitting them across handlers is how
       they drift apart.

       ⚠ A FIELD THAT HOLDS SOMETHING IS NEVER FOLDED, whatever the width says.
       Folding buys pixels back on a phone; hiding a value you already typed is
       the one thing it must never do — that is a field lying about being empty,
       and the tab's dot alone would be too quiet to correct it. */
    function syncLite() {
      if (!fieldsEl?.classList.contains('lab-fields--lite')) return;
      const tab = frame.querySelector<HTMLElement>('[data-tab][aria-selected="true"]');
      const kind = tab?.dataset.tab ?? 'jot';
      const set = fieldsEl.querySelector<HTMLElement>(`[data-for="${kind}"]`);
      const input = set?.querySelector<HTMLInputElement>('input') ?? null;
      const phone = document.documentElement.getAttribute('data-w') === 'phone';
      const held = heldIn(set, false).length > 0;
      const open = !!input && (held || !phone || set!.dataset.open === 'true');

      fieldsEl.hidden = !open;
      fieldsEl.querySelectorAll<HTMLElement>('[data-for]').forEach((one) => (one.hidden = one !== set || !open));

      const chip = frame.querySelector<HTMLElement>('[data-fold]');
      if (chip) {
        chip.hidden = !input || open;
        const label = chip.querySelector<HTMLElement>('[data-fold-label]');
        if (label) label.textContent = tab?.dataset.field ?? '';
      }

      // The annotation lives on the card, not in the box.
      const note = section.querySelector<HTMLElement>('[data-note]');
      if (note) {
        const becomes = tab?.dataset.becomes ?? '';
        const there = tab?.dataset.there ?? '';
        note.hidden = !becomes;
        note.innerHTML = becomes
          ? `${escapeHtml(becomes)}${there ? ` <span>· the room still asks for ${escapeHtml(there)}</span>` : ''}`
          : '';
      }
    }
    fieldsEl?.addEventListener('input', syncLite);

    /* One tap, and the pressed state IS the value — no hidden input to keep in
       step, and `aria-pressed` carries it to a screen reader without a second
       label. */
    frame.querySelectorAll<HTMLButtonElement>('.lab-kinds').forEach((group) =>
      group.addEventListener('click', (e) => {
        const chip = (e.target as HTMLElement).closest<HTMLElement>('[data-kind]');
        if (!chip) return;
        group.querySelectorAll('[data-kind]').forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      }),
    );

    /**
     * What a field set is currently holding, as "Label: value" lines.
     *
     * ⚠ THREE KINDS OF CONTROL AND ONE READER. A plain input has `.value`; the
     * kind chips keep their answer in `aria-pressed`; and `EntityCombo` is a
     * custom element whose committed name lives behind `getName()` — reaching
     * into the `<input>` it renders would read half-typed text as a choice, and
     * a person who is not on the roster is not a `personId`.
     *
     * `data-hold-default` marks a control that answers itself (the kind). It
     * counts for the receipt, which reports what would be written, and NOT for
     * the tab's dot, which asks whether you have put anything in — a dot lit by
     * a default is a dot that is always lit.
     */
    function heldIn(set: HTMLElement | null | undefined, includeDefaults: boolean) {
      if (!set) return [] as string[];
      return [...set.querySelectorAll<HTMLElement>('[data-hold]')]
        .filter((el) => includeDefaults || el.dataset.holdDefault === undefined)
        .map((el) => {
          const label = el.dataset.hold!;
          const combo = el.querySelector('entity-combo') as (HTMLElement & { getName?: () => string }) | null;
          if (combo) {
            const name = combo.getName?.() ?? '';
            return name ? `${label}: ${name}` : '';
          }
          const chip = el.querySelector<HTMLElement>('[aria-pressed="true"]');
          if (chip) return `${label}: ${chip.dataset.kindLabel ?? chip.textContent?.trim() ?? ''}`;
          const input = el.querySelector<HTMLInputElement>('input');
          return input?.value.trim() ? `${label}: ${input.value.trim()}` : '';
        })
        .filter(Boolean);
    }

    frame.querySelector<HTMLElement>('[data-fold]')?.addEventListener('click', () => {
      const kind = activeKind();
      const set = fieldsEl?.querySelector<HTMLElement>(`[data-for="${kind}"]`);
      if (!set) return;
      set.dataset.open = 'true';
      syncLite();
      set.querySelector<HTMLInputElement>('input')?.focus();
    });
    frame.addEventListener('combo:change', () => {
      syncLite();
      marks();
    });
    window.addEventListener('lab:settings', syncLite);

    frame.querySelectorAll<HTMLButtonElement>('[data-tab]').forEach((t) =>
      t.addEventListener('click', () => {
        /* ⚠ THE TEXT FOLLOWS THE TAB, AND SO DO THE FIELDS. Anything else is
           hostile: you typed a sentence and then said what it was, and a form
           that empties on that answer has thrown away the reason you opened it.
           The sets are hidden, never cleared — leave Quote half-filled, go to
           Task and back, and "said by" is still there. Only ＋ New and a new
           sample wipe them, because those are the two motions that mean "this
           is a different thought now". */
        setTab(t.dataset.tab!);
        marks();
      }),
    );
    marks();

    // `after`: the shipped popover arithmetic against this panel's trigger.
    const pop = frame.querySelector<HTMLElement>('.pop');
    /* ⚠ THE TRIGGER LOOKUP IS SCOPED TO THE FRAME, and this is the third face
       of the same bug the popover and the delegation already showed. When
       `anchorPopover` cannot find a trigger it returns early — leaving the
       `visibility: hidden` it set at `beforetoggle` in place. So a stale scope
       does not throw and does not mis-position: it opens a popover you cannot
       see, which is the most expensive way for this to fail. Anything that
       holds a reference into the frame must be looked up THROUGH the frame. */
    if (pop) anchorPopover(pop, () => frame.querySelector<HTMLElement>('[data-chooser]'));

    /** Everything that makes this thought THIS thought, put back to nothing. */
    function resetThought() {
      window.clearTimeout(timer);
      editor.commands.clearContent(true);
      frame.querySelectorAll<HTMLInputElement>('.lab-fields input').forEach((i) => (i.value = ''));
      // `clear()` is the combo's own API — blanking its <input> would leave the
      // committed id behind, so the next thought would be logged against the
      // last one's person.
      frame.querySelectorAll('entity-combo').forEach((c) => (c as HTMLElement & { clear?: () => void }).clear?.());
      frame
        .querySelectorAll<HTMLElement>('.lab-kinds')
        .forEach((group) =>
          group.querySelectorAll('[data-kind]').forEach((c, i) => c.setAttribute('aria-pressed', String(i === 0))),
        );
      noteId = null;
      baseUpdatedAt = '';
      slug = '';
      lastSaved = '';
      stopClock();
      taps = 0;
      t0 = 0;
      setTab('jot');
      // A new thought re-folds everything: the last one's disclosures are not
      // this one's business.
      frame.querySelectorAll<HTMLElement>('.lab-fields__set').forEach((set) => delete set.dataset.open);
      syncLite();
      marks();
      paint();
    }

    // ---- filing ------------------------------------------------------------
    /* Every route in — a chooser row, a chip, a menu row — lands here, so there
       is exactly one description of what filing WOULD do. */
    async function file(nounKey: string) {
      const meta = NOUN_META.get(nounKey);
      if (!meta) return;

      const body = getMarkdown().trim();

      /* The narrowed column is the only one that collects anything, so it is the
         only one that owes an account of it. Read off the set rather than from a
         table in this script — one owner per fact, and `there` is written once,
         in the frontmatter, next to the field it is about. */
      const liteTab = frame.querySelector<HTMLElement>(`.lab-fields--lite`)
        ? frame.querySelector<HTMLElement>(`[data-tab="${nounKey}"]`)
        : null;
      const held = heldIn(frame.querySelector<HTMLElement>(`.lab-fields--lite [data-for="${nounKey}"]`), true);
      const here = liteTab
        ? `<dt>collected here</dt><dd>${escapeHtml(held.join(' · ') || 'nothing — the tab only declared where it goes')}</dd>` +
          `<dt>still asked there</dt><dd>${escapeHtml(liteTab.dataset.there || 'nothing')}</dd>`
        : '';

      stopClock();
      paint(meta.label.replace('…', ''));
      const secs = t0 ? ((performance.now() - t0) / 1000).toFixed(1) : '0.0';

      /* ⚠ `jot` IS A DESTINATION LIKE ANY OTHER HERE, and making it one is what
         gave Done something to say. It used to early-return, so pressing Done
         on a jot did nothing visible — the button read as broken when it was
         merely finished. Parking a thought IS an outcome; it deserves the same
         receipt as filing one. */
      receiptEl.hidden = false;
      receiptEl.innerHTML = `
        <strong>${nounKey === 'jot' ? 'Parked as a jot' : `Filed as ${escapeHtml(meta.label.replace('…', ''))}`}</strong>
        <dl>
          <dt>would write</dt><dd><code>${escapeHtml(meta.row)}</code></dd>
          <dt>body</dt><dd><code>${escapeHtml(body || '(empty — the shipped box never writes an empty row)')}</code></dd>
          <dt>you land at</dt><dd><a href="${meta.where}">${escapeHtml(meta.where)}</a> — ${escapeHtml(meta.whereLabel)}</dd>
          ${here}
          <dt>cost</dt><dd>${taps} tap${taps === 1 ? '' : 's'} · ${secs}s</dd>
          ${
            nounKey === 'jot'
              ? ''
              : `<dt>and then</dt><dd>this jot is consumed — the destination is written first, so a failure leaves a dump you can still see (14 §10e)</dd>`
          }
        </dl>`;
      // Filing is the end of the run: in the real thing you have left for
      // another room, so the walk-through ends here too.
      if (stage.open) void closeWithExit(stage);

      /* ⚠ THE ONE REAL QUERY. 14 §11a: a lab fed hand-written answers shows a
         parser that is always right, which is the thing in question. The Agenda
         route is the only destination whose feel depends on something other
         than markup — it waits on a model — so it is the one this bench
         actually calls. A dead key or a dead network prints the degraded path,
         which is itself the finding worth seeing (§6.4: capture must never
         depend on the model). */
      if (nounKey === 'agenda' && body) {
        const line = document.createElement('p');
        line.style.marginTop = '0.5rem';
        line.textContent = 'Reading the sentence…';
        receiptEl.append(line);
        const t = performance.now();
        const { data, error } = await callAction(actions.tasks.parse({ text: body }));
        const ms = Math.round(performance.now() - t);
        if (error || !data?.parsed) {
          const why = data?.error ?? (error ? formatActionError(error) : 'unavailable');
          line.textContent = `No parse after ${ms}ms — ${why}. The sheet would open unparsed, which must always work.`;
          return;
        }
        line.innerHTML = `<code>${escapeHtml(JSON.stringify(data.parsed))}</code><br>parsed in <strong>${ms}ms</strong> — that wait is part of this design.`;
      }
    }

    /* One delegated handler for every route in — a chooser row, a chip, a menu
       row. The popover now lives inside the section, so this catches it too and
       the tap counter (which keys off `[data-tap]`) sees it like any other. */
    frame.addEventListener('click', (e) => {
      const pick = (e.target as HTMLElement).closest<HTMLElement>('[data-pick]');
      if (!pick) return;
      pop?.hidePopover();
      // In the `menu` proposition, "Write it down" is not a destination — it is
      // the door to the box. Everywhere else `jot` files, and Done sends it.
      if (pick.dataset.pick === 'jot' && menuEl && !menuEl.hidden) return showMenu(false);
      void file(pick.dataset.pick!);
    });
    /* ⚠ BOTH OF THESE WERE INERT AND READ AS BROKEN (Michael, 2026-08-24:
       *"I don't really get any feedback that something happens"*). An inert
       control that looks live is the exact fault 14 §10f caught with a
       screenshot after a spec had passed — you press it, nothing moves, and
       nothing tells you why. A bench cannot ask "does this feel fast" through
       buttons that do not answer. */

    // ＋ New — park what is there under its own id, hand over a blank one.
    frame.querySelector('[data-newjot]')?.addEventListener('click', () => {
      const had = getMarkdown().trim().length > 0;
      // `save()` reads the body before its first await, so parking-then-clearing
      // in this order cannot race the write. (The shipped box serialises the
      // same pair behind a lock; the bench has one box and needs no lock.)
      void save();
      resetThought();
      receiptEl.hidden = true;
      flash(had ? 'Parked. Next thought.' : 'Cleared.');
      editor.commands.focus();
    });

    /* Done — files as WHATEVER KIND THE BOX IS CLAIMING TO BE, which for three
       of the four propositions is always a jot and for `tabs` is the selected
       tab. That is not a bench convenience: it is the tabs proposition's actual
       semantics, and without it the tab is decoration. It also fixes the tap
       count in the tabs column, which was quietly charging for a chooser it
       does not have. */
    frame.querySelector('[data-done]')?.addEventListener('click', () => void file(activeKind()));

    frame.querySelector('[data-parse]')?.addEventListener('click', () => void file('agenda'));

    return {
      key,
      section,
      frame,
      home,
      onstage: section.querySelector<HTMLElement>('[data-onstage]')!,
      seed(text: string) {
        resetThought();
        editor.commands.setContent(text);
        receiptEl.hidden = true;
        receiptEl.innerHTML = '';
        statusEl.textContent = '';
        showMenu(Boolean(menuEl));
        marks();
      },
      focus() {
        editor.commands.focus('end');
      },
    };
  }

  /* The receipt prints your own words back at you, so it escapes them. Written
     out rather than reached for `sanitize-html`: this is four replacements into
     a bench, not the public renderer. */
  function escapeHtml(s: string) {
    return s
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  // ---- boot ----------------------------------------------------------------
  /* All four editors mount up front. One module, four instances — the parse
     cost `24 · Piece 5` measured is per MODULE, and lazy-mounting here would
     have made "does it feel instant" depend on which panel you clicked first,
     which is a bench artefact and not a property of any proposition. */
  document.querySelectorAll<HTMLElement>('.prop').forEach((s) => panels.set(s.dataset.prop!, wire(s)));

  // The noun metadata, read off the rendered rows so the script never restates
  // the frontmatter list (one owner per fact).
  document.querySelectorAll<HTMLElement>('[data-pick]').forEach((el) => {
    const k = el.dataset.pick!;
    if (NOUN_META.has(k)) return;
    NOUN_META.set(k, {
      label: el.dataset.label ?? k,
      row: el.dataset.row ?? '',
      where: el.dataset.where ?? '/admin',
      whereLabel: el.dataset.whereLabel ?? '',
    });
  });

  // ---- samples -------------------------------------------------------------
  document.querySelectorAll<HTMLButtonElement>('[data-jot]').forEach((b) =>
    b.addEventListener('click', () => {
      document
        .querySelectorAll<HTMLButtonElement>('[data-jot]')
        .forEach((o) => o.setAttribute('aria-pressed', String(o === b)));
      const text = b.dataset.text ?? '';
      panels.forEach((p) => p.seed(text));
    }),
  );

  // ---- the walk ------------------------------------------------------------
  /* ⚠ THE FRAME MOVES; IT IS NOT COPIED. A second rendering of the box would
     drift from the card within a day — the /lab/chrome rule. ProseMirror keeps
     working across the move because the editor's element is the same node on
     both sides of it; only focus is lost, and it is restored on open. */
  let walking: Panel | null = null;

  document.querySelectorAll<HTMLButtonElement>('[data-walk]').forEach((b) =>
    b.addEventListener('click', () => {
      walking = panels.get(b.dataset.walk!) ?? null;
      if (!walking) return;
      // `body:has([contenteditable]:focus) .cap-fab` hides the corner button
      // while you are typing — shipped behaviour, and it would hide the very
      // control we are asking you to tap.
      (document.activeElement as HTMLElement | null)?.blur();
      fab.hidden = false;
      fab.focus();
    }),
  );

  fab.addEventListener('click', () => {
    if (!walking) return;
    stage.append(walking.frame);
    walking.onstage.hidden = false;
    fab.hidden = true;
    openDialog(stage);
    walking.focus();
  });

  stage.addEventListener('close', () => {
    if (!walking) return;
    walking.home.after(walking.frame);
    walking.onstage.hidden = true;
    walking = null;
  });
</script>

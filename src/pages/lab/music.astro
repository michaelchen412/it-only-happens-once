  'Waterfall Dreams': [{ title: 'Everything\u2019s going to be okay.', slug: 'everythings-going-to-be-okay' }],
  'What Happened?': [{ title: 'Texting', slug: 'texting' }],
  "What She Didn't Say": [{ title: 'The Fear of Missing Out', slug: 'the-fear-of-missing-out' }],
  'Wounds Let in the Light': [{ title: 'Insecurity', slug: 'insecurity' }],
  'You Are': [{ title: 'Criticism', slug: 'criticism' }],
};

/* `embedForUrl` is the SAME function the published essay uses (src/lib/media.ts)
   — not a lab reimplementation. If a URL stops embedding here it stops
   embedding on /blog too, which is the only way a bench is worth trusting. */
const room: MusicRoomData = {
  vocabulary: VOCABULARY.map((w) => ({ slug: w, name: w })),
  songs: FIXTURE.map(([title, artist, feelings, url], i) => ({
    // Not a uuid: nothing here is a database row, and a fake one that LOOKED
    // like a real id is how a fixture ends up pasted into a query one day.
    id: `fixture-${i}`,
    title,
    artist,
    url,
    feelings: feelings.split(' '),
    /*
      ⚠ A NOTE ON EVERY FIFTH SONG, WHICH IS THE POINT OF PUTTING ONE HERE AT
      ALL (ADR 0031). The `†` on a card is the one thing in this room whose
      design question is still open — the mark, and whether the end of the
      feelings line is where it belongs — and it cannot be judged on a single
      example. A sparse scatter is also the honest density: the field is
      expected to be empty on nearly every song, so a bench where every card
      carries one would flatter a mark that will normally appear alone.

      Two lengths, because they fail differently: a phrase fits under its
      trigger, and a paragraph is what tests the height cap and the bottom-sheet
      treatment below 640px.
    */
    note:
      i % 5 !== 0
        ? ''
        : i % 10 === 0
          ? 'The tune keeps arriving at the same four bars and refusing to resolve them.'
          : 'Recorded in one take, apparently. You can hear the room — somebody shifts in a chair around the second chorus, and nobody stopped.\n\nIt is the take with the mistake in it, and it is the one they kept.',
    paired: PAIRED[title] ?? [],
  })),
};

/* The bench mounts the room at its own path, so a word's link stays here. */
const BASE = '/lab/music';
const selected = parseFeelings(Astro.url.searchParams.get('feeling'), room.vocabulary);
---

{
  /* SiteLayout, not Base — the room is rendered AS IT WOULD ACTUALLY SHIP,
    inside the site's real chrome and under the real /blog tab strip. Michael,
    2026-08-10: "can we actually render the page as it would be in reality? not
    containerized like this." */
}
<SiteLayout title="Music (bench)" active="blog" description="A local bench. Not the site.">
  <div class="mx-auto w-full max-w-6xl px-5 py-8 sm:py-10">
    <nav class="border-base-300 mb-8 flex flex-wrap items-baseline gap-x-7 gap-y-2 border-b" aria-label="Content">
      <a
        href="/blog"
        class="font-display text-base-content/35 hover:text-base-content/70 -mb-px border-b-2 border-transparent pb-3 text-2xl leading-none font-light sm:text-3xl"
        >Writing</a
      >
      <a
        href="/blog?view=quotes"
        class="font-display text-base-content/35 hover:text-base-content/70 -mb-px border-b-2 border-transparent pb-3 text-2xl leading-none font-light sm:text-3xl"
        >Quotes</a
      >
      <span
        aria-current="page"
        class="font-display border-primary text-base-content -mb-px border-b-2 pb-3 text-2xl leading-none font-light sm:text-3xl"
        >Music</span
      >
    </nav>

    <MusicRoom room={room} selected={selected} base={BASE} />
  </div>

  <Reader />

  {
    /* Everything that would not ship, collapsed to one chip so the page above
      can be judged as a page. */
  }
  <details
    class="border-base-300 bg-base-100/90 fixed top-20 right-4 z-50 rounded-lg border font-sans text-xs shadow-lg backdrop-blur"
  >
    <summary class="text-base-content/50 cursor-pointer list-none px-3 py-2 tracking-wide uppercase select-none"
      >bench</summary
    >
    <div class="border-base-300 flex flex-col gap-2 border-t px-3 py-3">
      <p class="text-warning max-w-[15rem] leading-relaxed">
        ⚠ Players are real. Every feeling is invented placeholder data — not Michael's readings.
      </p>
      <p class="text-base-content/35 max-w-[15rem] leading-relaxed">
        Players survive a filter change: start one, then narrow.
      </p>
    </div>
  </details>

  <style>
    /* See the note in MusicRoom: at bottom-right this control sits on top of a
       play button at every width under 1280. Page-local override, one rule. */
    :global(.back-to-top) {
      right: auto;
      left: 1.25rem;
    }
  </style>

  <script>
    import { wireMusicRoom } from '../../scripts/music-room';
    wireMusicRoom();
  </script>
</SiteLayout>

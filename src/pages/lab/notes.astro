  /* ── the propositions ────────────────────────────────────────────────────
     Each one is a rule or two keyed off `data-v`. That is the whole delta
     between them, which is the finding as much as the mechanism. */

  /* CAPPED — the surface stops and scrolls inside itself. The cap is on the
     HOST, not on the shell, so the toolbar stays put directly under the words
     instead of scrolling away with them. `.tt-host > .tiptap-doc { flex: 1 0
     auto }` (admin.css) is what lets the document grow past a scrolling host. */
  .lab[data-v='capped'] #lab-editor {
    max-height: 55vh;
    overflow-y: auto;
  }

  /* The ⤢ only means something under the two drawer propositions. Dimmed rather
     than removed, so the card's foot does not change shape between variants and
     take the comparison with it. */
  .lab[data-v='today'] [data-expand],
  .lab[data-v='capped'] [data-expand] {
    opacity: 0.25;
  }

  /* TWO PANES SIDE BY SIDE — the pile and the note. Everything about the note
     lives in the right-hand column, foot included, so the action bar underlines
     the thing it acts on and nothing else. */
  .lab__drawer {
    position: relative; /* the phone's rail slides against this */
    display: flex;
    height: 100%;
    overflow: hidden;
  }
  .lab__note {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-width: 0;
    /* ⚠ A CONTAINER, AND THE MEDIA QUERY BELOW COULD NOT HAVE DONE THIS JOB.
       The foot's labels do not depend on the window — they depend on how much
       room the RAIL LEFT THEM, which is a different number in Focus and Split at
       the same width. Measured at 768px with the rail still a column: five
       labelled buttons in a 512px pane wrapped to THREE rows, 136px of chrome
       eaten out of the words, while every viewport rule in the file said the
       desktop layout was fine. A window-width breakpoint can only guess at
       that; a container query asks the question that is actually being asked. */
    container-type: inline-size;
  }

  /* Below this the five destinations stop fitting on one line as words. The
     number is measured, not chosen: the labelled row needs ~40rem, and one that
     wraps costs more than the labels are worth. */
  @container (max-width: 40rem) {
    .lab__foot-word {
      display: none;
    }
    .lab__foot-btn {
      min-width: 2.75rem;
      justify-content: center;
      padding: 0.25rem;
    }
    .lab[data-acts='tucked'] .lab__foot-btn[data-open-chooser] .lab__foot-word {
      display: inline; /* the one door keeps its name — that is what it is for */
    }
    .lab__echo {
      display: none;
    }
  }
  .lab__drawer-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    flex-shrink: 0;
    padding: 0.6rem 1rem;
    border-bottom: 1px solid var(--color-base-300);
    font-family: var(--font-sans);
  }
  .lab__drawer-title {
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .lab__drawer-hint {
    font-size: 0.72rem;
    color: var(--text-whisper);

    color: var(--text-muted);
  }
  .lab__real {
    color: var(--text-faint);
  }

  .lab__bar {
    position: sticky;
    top: 0;
    z-index: 20;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    align-items: flex-start;
    justify-content: space-between;
    margin: 1.5rem 0;
    padding: 0.75rem;
    background: color-mix(in oklab, var(--color-base-100) 92%, transparent);

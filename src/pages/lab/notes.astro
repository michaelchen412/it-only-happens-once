     with the two-pane layout and took the push with it, leaving ✕ butted up
     against the word count. It is the ONLY thing in this head that is about the
     drawer rather than about the note, so it is also the only thing that should
     be nowhere near the note's facts.

     Sized down to the head's own register as well: it was inheriting 1rem beside
     0.72rem labels, which is why it read as the loudest thing in a strip of
     quiet ones. */
  .lab__drawer-x {
    display: grid;
    place-items: center;
    width: 2.25rem;
    height: 2.25rem;
    margin-left: auto;
    border-radius: var(--radius-field);
    cursor: pointer;
    font-size: 0.9rem;
    color: var(--text-faint);
  }
  .lab__drawer-x:hover {
    background: var(--color-base-200);
    color: var(--color-base-content);
  }
  .lab__doc {
    flex: 1;
    min-width: 0;
    overflow-y: auto;
  }
  /* The measure, not the drawer's width — WritingSheet's arrangement (a 5xl
     sheet around an independently centred 2xl column), because a document set
     the full width of a wide drawer is a worse thing to read than the card was. */
  .lab__doc .dump__shell {
    display: flex;
    flex-direction: column;
    max-width: 42rem;
    min-height: 100%;
    margin: 0 auto;
  }
  /* ⚠ THE TOOLBAR FLIPS ABOVE THE WORDS, AND ONLY HERE. The pile's rule (below
     the surface, so entering edit mode does not move the words) is a CARD-scale
     argument: at card scale the toolbar is 30px under a short thought. In a
     full-height drawer the same markup would put the controls at the bottom of
     a 4,000px document, reachable only by scrolling past the thing you wanted
     to format. Same DOM, one `order`, and it is a finding this bench produced
     rather than a decision it was built to test. */
  .lab__doc .dump__tools {
    order: -1;
    position: sticky;
    top: 0;
    z-index: 1;
    background: var(--color-base-100);
    border-top: 0;
    border-bottom: 1px solid color-mix(in oklch, var(--color-base-300) 70%, transparent);
  }
  .lab__doc #lab-editor {
    flex: 1;
  }
  .lab__doc .jot-prose {
    padding: 1.5rem 1.25rem 4rem;
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  /* The head's two quiet facts. `--text-whisper` is the AA floor in both
     themes (app.css, the quiet ladder) — never a hand-picked alpha. */
  /* ⚠ THE CLOCK IS `ph:clock-light`, WHICH THE ALLOWLIST ALREADY CARRIES — no
     `astro.config` line, and no new mark entering the building through a bench.
     It is the same glyph in both places a stamp appears, because a rail row and
     a note's head are saying the identical thing about the identical fact. */
  .lab__drawer-stamp,
  .lab__drawer-words {
    display: inline-flex;
    align-items: center;
    gap: 0.28rem;
    font-size: 0.72rem;
    color: var(--text-whisper);
  }
  .lab__drawer-stamp svg,
  .lab__rail-ago svg {
    width: 0.85em;
    height: 0.85em;
    flex-shrink: 0;
  }
  .lab__rail-ago {
    display: flex;
    align-items: center;
    gap: 0.28rem;
  }
  .lab__drawer-words {
    font-variant-numeric: tabular-nums;
  }

  /* The foot. A filled strip rather than a hairline, because unlike the card's
     foot it is a fixed rail against a scrolling document and needs to read as
     the floor rather than as the end of the words. */
  .lab__foot {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-shrink: 0;
    padding: 0.5rem 0.75rem;
    border-top: 1px solid var(--color-base-300);
    background: var(--color-base-200);
  }
  .lab__foot-acts {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .lab__foot-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 2.25rem;
    padding: 0.25rem 0.6rem;
    cursor: pointer;
    border-radius: var(--radius-field);
    font-family: var(--font-sans);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }
  .lab__foot-btn:hover {
    background: var(--color-base-100);
    color: var(--color-base-content);
  }
  .lab__foot-btn--danger {
    margin-left: auto;
  }
  .lab__foot-btn--danger:hover {
    color: var(--color-error);
  }
  /* The toggle, and it is the ONLY difference between the two spellings: the
     same five buttons either behind one door or standing in the open. */
  .lab[data-acts='tucked'] .lab__foot-btn--spread,
  .lab[data-acts='spread'] [data-open-chooser] {
    display: none;
  }
  /* The way to the pile, and the scrim that takes you back out of it. Both are
     phone-only: above the breakpoint the rail is simply THERE, and a control
     duplicating a visible one is worse than no control (10-hq §10b). */
  .lab__pile-btn,
  .lab__rail-scrim {
    display: none;
  }
  .lab__pile-btn {
    align-items: center;
    gap: 0.35rem;
    padding: 0.3rem 0.5rem;
    margin-right: 0.25rem;
    cursor: pointer;
    border-radius: var(--radius-field);
    font-family: var(--font-sans);
    font-size: 0.75rem;
    color: var(--text-muted);
  }
  .lab__pile-btn:hover {
    background: var(--color-base-200);
  }

  .lab__echo {
    flex: 1;
    min-width: 0;
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--text-faint);
  }
  .lab__acts-pick {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    flex: 0 0 auto;
  }
  .lab__acts-label {
    font-family: var(--font-sans);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--text-whisper);
  }
  .lab__acts-pick button {
    padding: 0.25rem 0.55rem;
    cursor: pointer;
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-field);
    font-family: var(--font-sans);
    font-size: 0.75rem;
  }
  .lab__acts-pick--in {
    margin-left: auto;
    margin-right: 0.5rem;
  }
  .lab__acts-pick--in button {
    border-style: dashed;
  }
  .lab__acts-pick button[aria-pressed='true'] {
    border-color: var(--color-primary);
    background: color-mix(in oklab, var(--color-primary) 10%, transparent);
  }
  /* The rail's second line — when it moved. A pile is ordered by touch, so the
     stamp is what tells you which end of it you are looking at. */
  .lab__rail-ago {
    margin-top: 0.2rem;
    font-size: 0.65rem;
    color: var(--text-whisper);
  }

  /* SPLIT — the rail. Absent under Focus rather than empty: 10-hq §10b's rule,
     and here it is also what keeps the two propositions honestly different. */
  .lab__rail {
    display: none;
    flex: 0 0 16rem;
    flex-direction: column;
    min-height: 0;
    border-right: 1px solid var(--color-base-300);
    background: color-mix(in oklab, var(--color-base-200) 55%, var(--color-base-100));
  }
  .lab[data-v='split'] .lab__rail {
    display: flex;
  }
  .lab__rail-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    flex-shrink: 0;
    padding: 0.6rem 0.75rem;
    border-bottom: 1px solid var(--color-base-300);
  }
  /* Its own line. At 16rem the title and the bench toggle were fighting and the
     title lost, wrapping to two lines under a control that is not even part of
     the room. */
  .lab__rail-title {
    flex: 1 0 100%;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-faint);
  }
  .lab__rail-rows {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 0.5rem;
  }
  .lab[data-v='split'] #lab-drawer {
    max-width: 76rem;
  }
  .lab[data-v='focus'] #lab-drawer {
    max-width: 60rem;
  }
  .lab__rail-row {
    display: block;
    width: 100%;
    padding: 0.5rem 0.6rem;
    margin-bottom: 0.15rem;
    text-align: left;
    cursor: pointer;
    border-radius: var(--radius-field);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    line-height: 1.45;
    color: var(--text-muted);
  }
  .lab__rail-row:hover {
    background: var(--color-base-200);
  }
  .lab__rail-row[aria-current='true'] {
    background: color-mix(in oklab, var(--color-primary) 12%, transparent);
    color: var(--color-base-content);
  }

  /* ── the phone ─────────────────────────────────────────────────────────────
     ⚠ THE QUESTION MICHAEL ASKED, AND IT HAS ONLY ONE HONEST ANSWER AT 390px:
     *"it's hard to have both the editor and the sidebar to browse."* It is not
     hard, it is impossible — a 16rem rail beside a readable measure needs about
     640px and there are 390. So the two panes stop being side by side and
     become one pane with the other sliding over it, which is the master/detail
     shape every phone reader already knows.

     ⚠ SPLIT DOES NOT DEGRADE INTO FOCUS, and that distinction is the whole
     reason this is worth building rather than conceding. Focus on a phone gives
     you no way to the pile at all; this keeps the proposition — the pile is one
     tap away and you never left the note — and pays for it with a button that
     exists only where the rail cannot.

     The breakpoint is 768px, the one the building already collapses its chrome
     at (plan 43's anon-mobile findings). */
  @media (max-width: 47.99rem) {
    .lab[data-v='split'] #lab-drawer,
    .lab[data-v='focus'] #lab-drawer {
      max-width: 100%;
    }
    .lab[data-v='split'] .lab__rail {
      position: absolute;
      inset: 0 auto 0 0;
      z-index: 2;
      width: min(19rem, 86%);
      translate: -100% 0;
      transition: translate 0.22s ease;
      box-shadow: 8px 0 30px -12px color-mix(in oklab, var(--shadow-color) 50%, transparent);
    }
    .lab__drawer[data-rail-open] .lab__rail {
      translate: 0 0;
    }
    .lab[data-v='split'] .lab__drawer[data-rail-open] .lab__rail-scrim {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 1;
      background: color-mix(in oklab, var(--color-base-100) 45%, transparent);
    }
    .lab[data-v='split'] .lab__pile-btn {
      display: inline-flex;
    }

    /* ⚠ THE FOOT'S LABELS ARE THE CONTAINER'S BUSINESS, NOT THIS BLOCK'S — see
       `@container` above. What is left here is genuinely about the window.

       ⚠ AND LOSING THE LABELS IS A REAL COST OF `spread`, not a detail: it is
       the argument `tucked` still has on a phone, where one labelled door can
       beat five unlabelled glyphs. The toggle stays so the two widths can be
       judged separately — they do not have to give the same answer. */
    .lab__drawer-words {
      display: none; /* the stamp is the fact worth the width */
    }

    /* ⚠ THE TOOLBAR GOES BACK UNDER THE WORDS, which is the shipped rule in
       both directions and my `order: -1` was the odd one out. `admin.css` moves
       `#ws-toolbar` to the bottom below this same breakpoint — *"formatting is
       the chrome you reach for WHILE typing, so on a phone it belongs against
       the keyboard rather than at the far end of the screen from your thumbs"* —
       and the pile's card editor has never put it anywhere else.

       The desktop flip stands: there the toolbar would otherwise sit at the
       bottom of a 4,000px document. Same markup, one `order`, and the answer
       genuinely differs by width. */
    .lab__doc .dump__tools {
      order: 0;
      top: auto;
      bottom: 0;
      border-top: 1px solid color-mix(in oklch, var(--color-base-300) 70%, transparent);
      border-bottom: 0;
    }
  }
</style>

<script>
  /*
    The bench's controls. Written plainly and kept in this file — the /lab/fields
    rule: a lab that reaches into `src/scripts/` leaves something behind when it
    is deleted. The two things it DOES import are the two things under test.
  */
  import { mountRichEditor } from '../../scripts/rich-editor';
  import { closeWithExit, openDialog } from '../../scripts/dialog-close';
  // ⚠ THE DISMISS RULE IS THE BUILDING'S, NOT THIS FILE'S — and the first cut of
  // the bench hand-rolled it and got it wrong in the way the helper exists to
  // prevent. Michael, 2026-08-26: *"the sheet doesn't close when I click on the
  // outside of it."* `wireSheetDismiss` is Escape + the ✕ + a backdrop press
  // that both STARTED and ENDED on the backdrop, which is the part worth
  // importing: a text selection dragged out of a paragraph and released over
  // the backdrop must not count as a dismissal, and this editor is exactly the
  // surface where that gesture happens (`backdrop-close.ts` has the account).
  import { wireSheetDismiss } from '../../scripts/sheet-dismiss';
  import { anchorPopover } from '../../scripts/pop-anchor';

  const lab = document.querySelector('.lab') as HTMLElement;
  const pile = document.getElementById('lab-pile') as HTMLElement;
  const shell = document.getElementById('lab-shell') as HTMLElement;
  const shellHome = shell.parentElement as HTMLElement;
  const drawer = document.getElementById('lab-drawer') as HTMLDialogElement;
  const slot = document.getElementById('lab-drawer-slot') as HTMLElement;
  const rail = document.getElementById('lab-rail') as HTMLElement;
  const drawerTitle = document.getElementById('lab-drawer-title') as HTMLElement;

  const variant = () => lab.dataset.v as 'today' | 'capped' | 'focus' | 'split';
  const lifts = () => variant() === 'focus' || variant() === 'split';

  const boxOf = (card: HTMLElement) => card.querySelector('[data-edit-box]') as HTMLTextAreaElement;
  const textOf = (card: HTMLElement) => card.querySelector('[data-text]') as HTMLElement;

  let editing: HTMLElement | null = null;
  let taps = 0;

  /* ── the one editor, with the pile's own options ─────────────────────────── */

  const { editor, getMarkdown } = mountRichEditor({
    editorEl: document.getElementById('lab-editor') as HTMLElement,
    toolbarRoot: shell.querySelector('[role="toolbar"]') as HTMLElement,
    linkDialog: document.getElementById('lab-link-dialog') as HTMLDialogElement,
    placeholder: 'Write it down…',
    ariaLabel: 'Edit this note',
    docClass: 'jot-prose',
    breaks: true,
    // ⚠ NO SAVE. Every proposition shares the shipped write path untouched, so
    // there is nothing here for a round trip to tell us — and a bench that
    // wrote would leave six junk rows in the real pile. `onChange` only keeps
    // the meter honest while you type, which is the one thing that does move.
    onChange: () => {
      measure();
      if (editing && drawer.open) reflectHead(editing);
    },
  });

  /* ── editing ─────────────────────────────────────────────────────────────── */

  function homeShell() {
    shell.hidden = true;
    shellHome.append(shell);
  }

  function enterEdit(card: HTMLElement) {
    if (editing === card) return;
    if (editing) leaveEdit(editing);
    editing = card;
    editor.commands.setContent(boxOf(card).value, { emitUpdate: false });

    if (lifts()) {
      slot.append(shell);
      shell.hidden = false;
      buildRail(card);
      drawerTitle.textContent = 'Note';
      reflectHead(card);
      echoEl.textContent = '';
      setRail(false);
      if (!drawer.open) openDialog(drawer);
    } else {
      card.insertBefore(shell, card.querySelector('.dump__foot'));
      shell.hidden = false;
      textOf(card).hidden = true;
      card.querySelector('[data-more]')?.setAttribute('hidden', '');
    }
    editor.commands.focus('end');
    measure();
  }

  function leaveEdit(card: HTMLElement) {
    const box = boxOf(card);
    box.value = getMarkdown();
    const text = textOf(card);
    // The rendered twin from the editor's own document, exactly as notes.ts
    // does it — no Markdown round trip, and no parser in the browser.
    text.innerHTML = editor.getHTML();
    homeShell();
    text.hidden = false;
    const long = box.value.split('\n').length > 10 || box.value.length > 700;
    text.classList.toggle('dump__text--clamped', long && !text.dataset.expanded);
    const more = card.querySelector('[data-more]') as HTMLElement | null;
    if (more) more.hidden = !long || !!text.dataset.expanded;
    editing = null;
    measure();
  }

  /* ── the rail (Split) ────────────────────────────────────────────────────── */

  /**
   * Built from the cards themselves at open time, so the rail can never
   * describe a pile that is one edit out of date. The label is the note's first
   * line — the pile's own rule, and the reason the room has no titles.
   */
  function buildRail(current: HTMLElement) {
    rail.textContent = '';
    pile.querySelectorAll<HTMLElement>('.dump').forEach((card) => {
      const row = document.createElement('button');
      row.type = 'button';
      row.className = 'lab__rail-row';
      row.dataset.railFor = card.dataset.note ?? '';
      const first = (
        boxOf(card)
          .value.split('\n')
          .find((l) => l.trim()) ?? ''
      ).replace(/^#+\s*/, '');
      const line = document.createElement('span');
      line.textContent = first.slice(0, 70) + (first.length > 70 ? '…' : '');
      row.append(line);
      const ago = document.createElement('span');
      ago.className = 'lab__rail-ago';
      // ⚠ CLONED FROM THE HEAD'S STAMP rather than hand-rolled as inline SVG.
      // `astro-icon` renders at build time, so a row built in the browser has no
      // way to ask for one — and an SVG retyped here would be a second copy of a
      // mark the allowlist owns, free to drift from it.
      const clock = stampEl.querySelector('svg');
      if (clock) ago.append(clock.cloneNode(true));
      const when = document.createElement('span');
      when.textContent = card.querySelector('.dump__stamp')?.textContent ?? '';
      ago.append(when);
      row.append(ago);
      if (card === current) row.setAttribute('aria-current', 'true');
      rail.append(row);
    });
  }

  /* ── the phone's rail ─────────────────────────────────────────────────────
     ⚠ IT CLOSES ON PICK, AND THAT IS THE HALF THAT MAKES IT A DETAIL VIEW
     RATHER THAN A MENU LEFT OPEN. Choosing a note is choosing to read it, so
     the pane that was covering it gets out of the way in the same gesture.
     Above the breakpoint `data-rail-open` is inert — the rail is a column, not
     an overlay, and nothing about it moves. */
  const drawerShell = document.getElementById('lab-drawer-shell') as HTMLElement;
  const pileBtn = document.getElementById('lab-pile-btn') as HTMLButtonElement;

  function setRail(open: boolean) {
    if (open) drawerShell.dataset.railOpen = '1';
    else delete drawerShell.dataset.railOpen;
    pileBtn.setAttribute('aria-expanded', String(open));
  }
  pileBtn.addEventListener('click', () => setRail(!drawerShell.dataset.railOpen));
  drawerShell.querySelector('[data-rail-scrim]')?.addEventListener('click', () => setRail(false));

  rail.addEventListener('click', (e) => {
    const row = (e.target as HTMLElement).closest<HTMLElement>('[data-rail-for]');
    if (!row) return;
    const card = pile.querySelector<HTMLElement>(`[data-note="${row.dataset.railFor}"]`);
    if (!card || card === editing) return;
    if (editing) leaveEdit(editing);
    enterEdit(card);
    setRail(false);
  });

  /* ── the drawer's head and foot ──────────────────────────────────────────── */

  const stampEl = document.getElementById('lab-drawer-stamp') as HTMLElement;
  const wordsEl = document.getElementById('lab-drawer-words') as HTMLElement;
  const echoEl = document.getElementById('lab-echo') as HTMLElement;
  const chooser = document.getElementById('lab-chooser') as HTMLElement;

  /**
   * ⚠ COUNTED OFF THE EDITOR'S TEXT, NOT ITS MARKDOWN. `getMarkdown()` would
   * count `**` and `###` as part of the words they format, so a note full of
   * headings would read heavier than it is. This is the same reason the pile
   * renders rather than prints.
   */
  function words(): number {
    const t = editor.getText().trim();
    return t ? t.split(/\s+/).length : 0;
  }

  function reflectHead(card: HTMLElement) {
    // ⚠ THE INNER SPAN, NOT THE ELEMENT — the stamp holds a clock now, and
    // `textContent =` on the wrapper would delete the glyph on the first note
    // opened and never put it back.
    (stampEl.querySelector('[data-ago]') as HTMLElement).textContent =
      card.querySelector('.dump__stamp')?.textContent ?? '';
    const n = words();
    wordsEl.textContent = n === 1 ? '1 word' : n + ' words';
  }

  /* The inert destinations. /lab/capture's rule: a bench PRINTS the row it would
     write and links nowhere, because building the write is what the decision
     is for — and here it is not even in question. All five already exist in the
     room; what is being judged is whether they read better behind one door or
     standing in the open. */
  function wireWay(root: HTMLElement) {
    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('[data-way]');
      if (!btn) return;
      chooser.hidePopover?.();
      echoEl.textContent = `${btn.dataset.way} — ${btn.dataset.echo}`;
    });
  }
  wireWay(document.querySelector('.lab__foot') as HTMLElement);
  wireWay(chooser);

  // Positioned against the button that opened it — the pile's own helper.
  anchorPopover(chooser, () => document.querySelector<HTMLElement>('[data-open-chooser]'));

  /* ── the drawer ──────────────────────────────────────────────────────────── */

  async function closeDrawer() {
    if (editing) leaveEdit(editing);
    await closeWithExit(drawer);
    measure();
  }

  // Escape, the ✕ and the backdrop, all three at once and all three flushing
  // first — `closeDrawer` is what dismissal MEANS here, which is the argument
  // the helper's signature makes for taking a callback rather than closing.
  wireSheetDismiss(drawer, () => void closeDrawer(), '[data-drawer-close]');

  /*
    ⚠ AND ESCAPE STILL HAS TO BE CLOSED BY HAND ON TOP OF THAT, which the bench
    found the way capture.ts found it: by sitting there.

    A `<dialog>` turns Escape into a close request only if the keydown's default
    survives, and ProseMirror's `captureKeyDown` preventDefaults keyCode 27
    unconditionally — so inside this editor the `cancel` event that
    `wireSheetDismiss` listens for never fires at all. The helper is right and
    complete for a sheet full of inputs; it is half a rule for a sheet whose
    body is a rich editor, and both of the shipped ones that qualify (the ✚,
    the check-in's mini fields) carry this second half.

    ⚠ FOUND HERE, WHICH IS AN ARGUMENT FOR THE BENCH RATHER THAN A FOOTNOTE.
    The drawer is a NEW modal holding an editor, so it inherits a trap that has
    already been paid for twice — `notes.spec.ts` and `checkin.spec.ts` both pin
    it. Whatever ships out of this file needs the pin as well.

    `preventDefault` here too, deliberately: focus on the toolbar or the foot is
    OUTSIDE the editor, where nothing swallows the key and the native `cancel`
    fires — claiming the default keeps the two paths from running two closes.
  */
  drawer.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    e.preventDefault();
    void closeDrawer();
  });

  /* ── the pile's clicks ───────────────────────────────────────────────────── */

  pile.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>(
      '[data-edit], [data-expand], [data-more], [data-inert], [data-text]',
    );
    if (!el) return;
    const card = el.closest<HTMLElement>('.dump');
    if (!card) return;

    if (el.hasAttribute('data-inert')) return;

    if (el.hasAttribute('data-more')) {
      const text = textOf(card);
      text.dataset.expanded = '1';
      text.classList.remove('dump__text--clamped');
      el.hidden = true;
      measure();
      return;
    }

    // ⚠ THE ⤢ FORCES THE DRAWER EVEN UNDER TODAY AND CAPPED — no. It is inert
    // there, and deliberately: a control that works under a proposition which
    // does not include it would make that proposition look better than it is.
    if (el.hasAttribute('data-expand') && !lifts()) return;

    if (el.hasAttribute('data-text') && editing === card) return;

    if (editing === card && el.hasAttribute('data-edit')) {
      if (drawer.open) void closeDrawer();
      else leaveEdit(card);
      return;
    }
    enterEdit(card);
  });

  /* ── switching propositions ──────────────────────────────────────────────── */

  document.querySelectorAll<HTMLButtonElement>('[data-v-pick]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = btn.dataset.vPick as string;
      if (next === lab.dataset.v) return;
      // Close whatever is open BEFORE the switch: a shell mid-flight between a
      // card and a drawer under two different sets of rules is a bug the bench
      // would be reporting about itself.
      if (drawer.open) void closeDrawer();
      else if (editing) leaveEdit(editing);
      lab.dataset.v = next;
      document
        .querySelectorAll<HTMLButtonElement>('[data-v-pick]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.vPick === next)));
      // Taps reset per run — the number is "what this proposition cost me just
      // now", which is only readable if it does not carry the last one's total.
      taps = 0;
      measure();
    });
  });

  /* ── where the actions live ──────────────────────────────────────────────── */

  document.querySelectorAll<HTMLButtonElement>('[data-acts-pick]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const next = btn.dataset.actsPick as string;
      lab.dataset.acts = next;
      chooser.hidePopover?.();
      document
        .querySelectorAll<HTMLButtonElement>('[data-acts-pick]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.actsPick === next)));
    });
  });

  /* Drives `--kb` on the root, which is where `keyboard-inset.ts` puts it and
     where `.drawer-dialog`'s `height: calc(100dvh - var(--kb))` reads it. */
  document.querySelectorAll<HTMLButtonElement>('[data-kb]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const px = btn.dataset.kb ?? '0';
      document.documentElement.style.setProperty('--kb', px + 'px');
      document
        .querySelectorAll<HTMLButtonElement>('[data-kb]')
        .forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.kb === px)));
      measure();
    });
  });

  document
    .querySelectorAll('[data-open-chooser]')
    .forEach((el) => el.addEventListener('click', () => chooser.showPopover?.()));

  /* ── the meter ───────────────────────────────────────────────────────────── */

  const mPage = document.getElementById('m-page') as HTMLElement;
  const mEditor = document.getElementById('m-editor') as HTMLElement;
  const mReach = document.getElementById('m-reach') as HTMLElement;
  const mTaps = document.getElementById('m-taps') as HTMLElement;

  function measure() {
    mPage.textContent = Math.round(document.documentElement.scrollHeight) + 'px';
    /*
      ⚠ THE VISIBLE INTERSECTION, NOT A BOX HEIGHT — and both simpler answers
      were tried first and are wrong, each in its own direction.

      `.tiptap-doc` is the document's full height under EVERY proposition, since
      the surface is free to grow past a scrolling host (admin.css, `.tt-host`);
      it reported 1310px for a `capped` box you can see 440px of. The host's own
      box is right in a card and wrong in the drawer, where `flex: 1` inside a
      scroller stretches it to the content again.

      What the eye actually gets is the part of the host inside the window, so
      that is what this counts. It is the number that separates the two bounded
      propositions: `capped` and `focus` both stop the page stretching, and only
      one of them gives you a screen to write on while doing it.
    */
    const host = document.getElementById('lab-editor') as HTMLElement;
    const r = host.getBoundingClientRect();
    const seen = Math.max(0, Math.min(r.bottom, window.innerHeight) - Math.max(r.top, 0));
    mEditor.textContent = shell.hidden ? '—' : Math.round(seen) + 'px';

    /*
      ⚠ THE JUDGEMENT INSIDE THIS NUMBER, WRITTEN DOWN. A card behind an open
      modal is not reachable: the drawer traps focus and light-dismisses, so
      "visible through a blurred backdrop" is not the same as "you can get to
      it". Focus therefore scores 0 while it is open, by definition rather than
      by measurement — and Split scores its rail, which is exactly the thing
      Split is proposing to buy.
    */
    if (drawer.open) {
      mReach.textContent = variant() === 'split' ? String(rail.childElementCount - 1) : '0';
    } else {
      const h = window.innerHeight;
      let n = 0;
      pile.querySelectorAll<HTMLElement>('.dump').forEach((card) => {
        if (card === editing) return;
        const r = card.getBoundingClientRect();
        if (r.bottom > 0 && r.top < h) n += 1;
      });
      mReach.textContent = String(n);
    }
    mTaps.textContent = String(taps);
  }

  // Every click on a control counts, wherever it lands — the /lab/capture rule
  // that a cost is counted rather than estimated.
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('button, [data-text]')) {
      taps += 1;
      mTaps.textContent = String(taps);
    }
  });

  window.addEventListener('scroll', measure, { passive: true });
  window.addEventListener('resize', measure);
  measure();
</script>

---
/*
  /admin/listening — where a song enters the corpus and is heard
  (docs/plans/37 §2, plan 33 §3, ADR 0031).

  ⚠ THIS PAGE IS NOW A LIST AND A DOOR. Everything that edits a song moved into
  `SongSheet`, which is the one editor for one object — because the split this
  replaced was not conceptual, it was TWO EDITORS DIVIDED BY FIELD: this page
  owned the feelings and could not touch the metadata, while the Fragment
  Manager's sheet owned the metadata and knew nothing about feelings. Michael,
  2026-08-11: *"this division is really uncomfortable for me… ideally we open up
  a sheet to edit all the fields, all in one place."*

  ⚠ ADDING A SONG AND SITTING WITH IT ARE THE SAME ACT (plan 33, ruling 1), and
  that is still the shape even though the paste bar moved into the sheet. The
  moment you paste the link is the moment you have decided this piece of music
  deserves consideration — so there is no state where a song is "added but not
  yet heard" by intent, and no backlog to burn down. What the sheet costs is one
  press to open it; whether that survives twenty songs in a sitting is the thing
  plan 37 says to measure rather than assume.

  ⚠ AND NOTHING HERE PROPOSES A FEELING. The corpus tags SUBJECTS with a model
  (ADR-0007) because a subject is what a piece is about and that is legible from
  the text. A feeling is not a property of the song — it is what happened in
  Michael. Since ADR 0031 also took subjects off songs, no part of a song is
  machine-taggable at all.
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import SongSheet from '../../components/admin/SongSheet.astro';
import { allFragmentPeople } from '../../lib/hq/links';

const supabase = Astro.locals.supabase;

const [{ data: feelings }, { data: songs }, { data: people }] = await Promise.all([
  supabase.from('feelings').select('id, name, slug, sort').order('sort'),
  supabase
    .from('fragments')
    .select('id, title, attribution, created_at, fragment_feelings(feeling_id)')
    .eq('type', 'song')
    .is('deleted_at', null)
    .order('created_at', { ascending: false }),
  supabase.from('people').select('id, display_name').order('display_name'),
]);

const vocabulary = feelings ?? [];
const nameById = new Map(vocabulary.map((f) => [f.id, f.name]));
const sharedBy = await allFragmentPeople(supabase);

/*
  ⚠ THE ROWS NO LONGER CARRY A RESOLVED EMBED, and that is a deliberate swap.
  They used to, so that pulling a song onto the bench cost no round trip. The
  sheet needs the album, the year, both notes and the paired essays as well —
  and putting those on every `<li>` would ship every note in the corpus in order
  to open one of them. `songs.forSheet` is one read on open instead, which is
  the cost that does not grow with the library.
*/
const rows = (songs ?? []).map((s) => ({
  id: s.id,
  title: s.title ?? '(untitled)',
  artist: s.attribution ?? '',
  // In the vocabulary's own order, never the order the rows came back in: the
  // spectrum is the claim (`feelings.sort`), and the sequence a pair of hands
  // happened to click in is not.
  words: vocabulary.filter((f) => (s.fragment_feelings ?? []).some((ff) => ff.feeling_id === f.id)).map((f) => f.name),
}));

const waiting = rows.filter((r) => r.words.length === 0);
const filed = rows.filter((r) => r.words.length > 0);
---

<AdminLayout title="Listening" active="listening">
  <div class="mx-auto max-w-3xl px-6 py-8">
    <PageHeader
      title="Listening"
      subtitle="Paste a link, play it, and press the words it leaves you with. A song enters the corpus here, in the same motion as the listening — there is no backlog to work through and no state where a song is added but not yet heard."
    >
      <button id="lst-new" slot="actions" type="button" class="btn btn-primary btn-sm normal-case">＋ Add a song</button
      >
    </PageHeader>

    <p id="lst-error" hidden role="alert" class="admin-alert mb-4"></p>

    {
      /* THE 48 SONGS ALREADY HERE ARE NOT A HEAD START (plan 33 §3). They
        arrived as paired media — chosen because they went with an essay, not
        because of what they evoke — so they need the same one-by-one attention
        as anything new. Listed rather than counted: a bare number would make it
        a backlog, and a backlog is the framing ruling 1 rejected. */
    }
    <section id="lst-lists" class="mt-8" data-vocab={JSON.stringify(Object.fromEntries(nameById))}>
      <h2 class="font-display mb-3 text-lg">
        Not yet heard <span id="lst-waiting-n" class="text-base-content/40 text-sm">({waiting.length})</span>
      </h2>
      <ul id="lst-waiting" class="divide-base-300 border-base-300 rounded-box mb-10 divide-y border">
        {
          waiting.map((s) => (
            <li class="lst-row flex items-baseline gap-3 px-3 py-2" data-song={s.id}>
              <button type="button" class="lst-open min-w-0 grow text-left">
                <span class="font-serif">{s.title}</span>
                <span class="text-base-content/50 ml-2 text-sm">{s.artist}</span>
              </button>
              <span class="lst-row-words text-base-content/45 shrink-0 font-sans text-xs">{s.words.join(' · ')}</span>
            </li>
          ))
        }
        {
          /* Rendered always, hidden when the list has rows — the script toggles
          it as rows move between the two lists, which a server-rendered-only
          line could not do. */
        }
        <li class="lst-empty admin-hint px-3 py-2 italic" hidden={waiting.length > 0}>
          Every song here has been sat with.
        </li>
      </ul>

      <h2 class="font-display mb-3 text-lg">
        Filed <span id="lst-filed-n" class="text-base-content/40 text-sm">({filed.length})</span>
      </h2>
      <ul id="lst-filed" class="divide-base-300 border-base-300 rounded-box divide-y border">
        {
          filed.map((s) => (
            <li class="lst-row flex items-baseline gap-3 px-3 py-2" data-song={s.id}>
              <button type="button" class="lst-open min-w-0 grow text-left">
                <span class="font-serif">{s.title}</span>
                <span class="text-base-content/50 ml-2 text-sm">{s.artist}</span>
              </button>
              <span class="lst-row-words text-base-content/45 shrink-0 font-sans text-xs">{s.words.join(' · ')}</span>
            </li>
          ))
        }
        <li class="lst-empty admin-hint px-3 py-2 italic" hidden={filed.length > 0}>Nothing filed yet.</li>
      </ul>
    </section>
  </div>

  <SongSheet feelings={vocabulary} people={people ?? []} sharedBy={sharedBy} />

  <script>
    import { wireListeningLists } from '../../scripts/listening';
    wireListeningLists();
  </script>
</AdminLayout>

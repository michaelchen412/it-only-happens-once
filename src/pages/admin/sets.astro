---
/*
  /admin/sets — the sets, where a curated listen is made (plan 40 §3).

  ⚠ THIS WAS SEVEN OPEN `<form>`s AND IS NOW A LIST OF ROWS (plan 42 · §4.D.2).
  The old page defended plain server-rendered forms — no client script, works
  with script disabled — and the argument is preserved in `SetSheet.astro`
  rather than deleted, because it was a real one. What it lost on:

   · ⚠ THE PAGE WAS THE COMMIT UNIT, SO IT COULD LOSE WORK. A reorder, a delete
     or a Save on ANY card posted and reloaded, silently discarding unsaved text
     in every other card. The Library has the identical hazard and guarded it on
     2026-08-12; this shipped unguarded three days later.
   · Its own escape clause had fired: "if a set ever grows a sixth field… this
     becomes a sheet like its neighbours." The card rendered six controls.
   · Publishing rode a `<select>` inside a whole-card save, six days after the
     composer's own comment argued in writing against exactly that control, and
     two days after plan 41 · §5a made `setStatus` the only writer of that
     column on the table next door.

  WHAT THE ROOM IS NOW, and every part of it is a shape this building already
  keeps: `PageHeader` + one primary, an `EmptyState` carrying the same door, rows
  with a status chip, drag-or-Alt reorder, and a ⋯ menu holding publish and
  delete — the `/admin/constellations` shape, which is the nearest sibling by
  construction (this table's own migration says it was "shaped after
  `constellations`").
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import StatusChip from '../../components/admin/StatusChip.astro';
import EmptyState from '../../components/admin/EmptyState.astro';
import SetSheet from '../../components/admin/SetSheet.astro';
import { listSetsAdmin } from '../../lib/sets';
import { embedForUrl } from '../../lib/media';
import { jsonForScript } from '../../lib/serialize';

const sb = Astro.locals.supabase;
const [rows, { data: quoteRows }] = await Promise.all([
  listSetsAdmin(sb),
  sb
    .from('fragments')
    .select('id, body, attribution')
    .eq('type', 'quote')
    .eq('status', 'published')
    .is('deleted_at', null)
    .order('attribution'),
]);

/*
  ⚠ RENDERED ONCE, NOT ONCE PER CARD. The old page put this list inside every
  set's form AND in the New form — seven sets × 77 quotes was 616 `<option>`
  elements for a control that is only ever open once, which is the same O(n²)
  shape plan 38 · §1.2 deleted from the Library. One sheet, one list.

  The label is still a truncation of the body plus the attribution, and it is
  still not good enough — picking a quote by its opening clause is what §4.D.4's
  `FragmentBrowser` mode exists to replace. Carried across unchanged so the
  finding stays visible.
*/
const quotes = (quoteRows ?? []).map((q) => ({
  id: q.id,
  label: `${(q.body ?? '').replace(/\s+/g, ' ').trim().slice(0, 70)}${(q.body ?? '').length > 70 ? '…' : ''} — ${q.attribution ?? 'unattributed'}`,
}));

/** Everything the sheet needs, which is the COLUMNS rather than what the row shows. */
const payload = (s: (typeof rows)[number]) =>
  jsonForScript({
    id: s.id,
    title: s.title,
    slug: s.slug,
    playlist_url: s.playlist_url,
    quote_fragment_id: s.quote_fragment_id,
    description: s.description ?? '',
    status: s.status,
  });
---

<AdminLayout title="Sets" active="sets">
  <div class="mx-auto max-w-3xl px-6 py-8">
    <PageHeader
      title="Sets"
      subtitle="A curated listen: one Spotify playlist, one quote, one description. The order here is the order the music page reads top to bottom."
    >
      {
        /* "New", not "New set" — the page already carries an h1 reading Sets,
          and `PageHeader.astro` holds the rule. */
      }
      <button
        slot="actions"
        type="button"
        data-open-set-sheet
        class="btn btn-primary btn-sm gap-1 font-sans normal-case"
      >
        <Icon name="ph:plus" /> New
      </button>
    </PageHeader>

    <p id="sets-error" hidden role="alert" class="admin-alert mb-4"></p>

    {
      rows.length === 0 ? (
        <EmptyState
          title="No sets yet."
          hint="A set is a playlist you'd want somebody to save — give it a sentence for a title and one quote that belongs beside it."
        >
          {/* The same control as the header's, not a second one — the button is
              bound by `[data-open-set-sheet]` across every element carrying it,
              so there is no second code path to keep in step. */}
          <button type="button" data-open-set-sheet class="btn btn-primary btn-sm mt-4 gap-1 font-sans normal-case">
            <Icon name="ph:plus" /> Name the first
          </button>
        </EmptyState>
      ) : (
        <ul id="sets-list" class="divide-base-300 rounded-box border-base-300 bg-base-200/50 divide-y border">
          {rows.map((s) => {
            const ref = embedForUrl(s.playlist_url);
            return (
              <li class="group flex items-center gap-3 px-4 py-3" data-id={s.id} data-set={payload(s)} draggable="true">
                <span
                  class="text-base-content/25 group-hover:text-base-content/50 shrink-0 cursor-grab transition-colors select-none"
                  title="Drag to reorder (or Alt+↑/↓)"
                  aria-hidden="true"
                >
                  ⋮⋮
                </span>
                <div class="min-w-0 grow">
                  <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                    {/* The title IS the edit affordance — no pencil on every
                        row announcing itself (the rule `tasks.astro` states). */}
                    <button type="button" class="font-display truncate text-left text-lg hover:underline" data-edit-set>
                      {s.title}
                    </button>
                    <StatusChip status={s.status} />
                  </div>
                  {/* One fact, and it is the one you cannot check by reading the
                      row: whether the link still resolves to a playlist. */}
                  <p class="text-base-content/45 mt-0.5 font-sans text-xs">
                    {ref ? 'playlist attached' : 'no playable link'}
                    {s.quote_fragment_id && ' · quote'}
                  </p>
                </div>

                <span class="row-edit flex shrink-0 items-center gap-0.5">
                  {/* Touch-only, like the constellations index and the composer
                      suite: with a pointer you drag the ⋮⋮ and with a keyboard
                      you Alt+↑/↓, so on a hovering device these would reserve
                      row width for a duplicate of drag (`.row-nudge`, app.css). */}
                  <button
                    type="button"
                    class="row-nudge btn btn-ghost btn-xs"
                    data-move="up"
                    aria-label={`Move ${s.title} up`}
                  >
                    <Icon name="ph:arrow-up" />
                  </button>
                  <button
                    type="button"
                    class="row-nudge btn btn-ghost btn-xs"
                    data-move="down"
                    aria-label={`Move ${s.title} down`}
                  >
                    <Icon name="ph:arrow-down" />
                  </button>
                  {/* `data-status` rides the trigger so the menu can word its
                      first item before it opens — the constellations rule. */}
                  <button
                    type="button"
                    class="btn btn-ghost btn-xs"
                    data-row-menu
                    data-status={s.status}
                    aria-haspopup="true"
                    aria-expanded="false"
                    aria-label={`More actions for ${s.title}`}
                  >
                    <Icon name="ph:dots-three" />
                  </button>
                </span>
              </li>
            );
          })}
        </ul>
      )
    }
  </div>

  {
    /* ONE MENU FOR THE WHOLE LIST, positioned against the ⋯ that opened it, and
      a top-layer `popover` so no ancestor's overflow clips it and no z-index
      covers it. The status row is worded at open time: one menu over a list of
      mixed drafts and published sets cannot render "Unpublish" on the server. */
  }
  <div id="sets-row-menu" popover class="pop" aria-label="Set actions">
    <button type="button" class="pop__row" data-act="status">
      <span data-icon-publish><Icon name="ph:eye" /></span>
      <span data-icon-unpublish hidden><Icon name="ph:eye-slash" /></span>
      <span data-status-label>Publish</span>
    </button>
    <button type="button" class="pop__row" data-act="open">
      <Icon name="ph:arrow-up-right" /> Open on Spotify
    </button>
    <button type="button" class="pop__row pop__row--danger" data-act="delete">
      <Icon name="ph:trash" /> Delete
    </button>
  </div>

  <SetSheet quotes={quotes} />

  <script>
    import '../../scripts/sets-index';
  </script>
</AdminLayout>

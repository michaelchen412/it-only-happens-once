---
/*
  /admin/sets — the sets, where a curated listen is made (plan 40 §3).

  ⚠ PLAIN FORMS, NO CLIENT SCRIPT, AND THAT IS A DEPARTURE WORTH DEFENDING.
  Every other room in the workshop is JS-driven — sheets, drawers, panels —
  because they edit objects with a dozen fields, bulk selection and live
  preview. A set has FIVE fields and there will be about seven of them. Astro's
  actions accept a form POST natively, so this page is server-rendered, works
  with script disabled, cannot get its optimistic state out of step with the
  database, and is about a tenth of the code a sheet would be.

  If a set ever grows a sixth field or the list passes ~30 rows, that argument
  expires and this becomes a sheet like its neighbours. Written down so the next
  person knows it was a decision rather than an omission.

  ⚠ THE QUOTE PICKER IS A `<select>`, AND IT HAS A CEILING. It lists every
  published quote — 77 today — which is browsable but not searchable. The right
  answer at three hundred is `FragmentBrowser` in a pair mode, exactly as the
  song pairing does it. Not built yet because a select over 77 is honest and a
  drawer over 77 is furniture.
*/
import { Icon } from 'astro-icon/components';
import { actions } from 'astro:actions';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import StatusChip from '../../components/admin/StatusChip.astro';
import EmptyState from '../../components/admin/EmptyState.astro';
import { listSetsAdmin } from '../../lib/sets';
import { embedForUrl } from '../../lib/media';

/*
  ⚠ REDIRECT AFTER A SUCCESSFUL POST, always. Without it a refresh resubmits the
  form — which for `save` means a duplicate set and for `remove` means a
  confusing error about a row that is already gone. The result is only read to
  decide whether to redirect or to render the message.
*/
for (const action of [actions.sets.save, actions.sets.setStatus, actions.sets.reorder, actions.sets.remove]) {
  const result = Astro.getActionResult(action);
  if (result && !result.error) return Astro.redirect('/admin/sets');
}
const saveError = Astro.getActionResult(actions.sets.save)?.error;
const otherError =
  Astro.getActionResult(actions.sets.remove)?.error ??
  Astro.getActionResult(actions.sets.setStatus)?.error ??
  Astro.getActionResult(actions.sets.reorder)?.error;

const sb = Astro.locals.supabase;
const [rows, { data: quoteRows }] = await Promise.all([
  listSetsAdmin(sb),
  sb
    .from('fragments')
    .select('id, body, attribution')
    .eq('type', 'quote')
    .eq('status', 'published')
    .is('deleted_at', null)
    .order('attribution'),
]);

const quotes = (quoteRows ?? []).map((q) => ({
  id: q.id,
  // One line in a dropdown: enough of the quote to recognise it, and the
  // attribution, which is how you actually remember which one it is.
  label: `${(q.body ?? '').replace(/\s+/g, ' ').trim().slice(0, 70)}${(q.body ?? '').length > 70 ? '…' : ''} — ${q.attribution ?? 'unattributed'}`,
}));

const ids = rows.map((r) => r.id);
/** The full order with `i` moved by `delta` — the whole list, because `reorder` rewrites 1..n. */
const moved = (i: number, delta: number) => {
  const next = [...ids];
  const [x] = next.splice(i, 1);
  next.splice(Math.max(0, Math.min(next.length, i + delta)), 0, x);
  return next.join(',');
};

const FIELD = 'input input-sm input-bordered w-full font-sans';
---

<AdminLayout title="Sets" active="sets">
  <div class="mx-auto max-w-3xl px-6 py-8">
    <PageHeader
      title="Sets"
      subtitle="A curated listen: one Spotify playlist, one quote, one description. The order here is the order the music page reads top to bottom."
    />

    {
      (saveError || otherError) && (
        <div role="alert" class="alert alert-error mb-6 font-sans text-sm">
          {saveError?.message ?? otherError?.message}
        </div>
      )
    }

    {
      rows.length === 0 && (
        <EmptyState
          title="No sets yet."
          hint="A set is a playlist you'd want somebody to save — give it a sentence for a title and one quote that belongs beside it."
          class="mb-8"
        />
      )
    }

    <ul class="flex flex-col gap-6">
      {
        rows.map((s, i) => {
          /*
            ⚠ `embedForUrl`, NOT A HAND-WRITTEN FRAME (plan 42 · §5). This
            preview carried `height="152"` — the TRACK height — for a PLAYLIST
            whose frame is 352, and **no `allow` attribute at all**, so the one
            control it exists to offer (press play, is this the right playlist?)
            was the one most likely not to work. `lib/media.ts` records why:
            Chrome blocks `autoplay`/`encrypted-media` in a cross-origin frame
            unless the EMBEDDER delegates them, and it fails per-profile, so it
            reads as "the embed is broken" rather than "the attribute is
            missing".

            The gate is now the embed itself rather than a separate parse: a URL
            that cannot be embedded shows no player and no Open link, which is
            one answer instead of two that could disagree.

            ⚠ THE HEIGHT IS THE CANONICAL 352 AND THE PUBLIC PAGE RENDERS 480
            (`MusicSets.astro`, chosen at the bench). Matching that is plan 42 ·
            §4.D.6 and belongs with the sheet rebuild, not here — this commit
            fixes what was WRONG, and the remaining gap is a deliberate
            difference between a preview and the page.
          */
          const ref = embedForUrl(s.playlist_url);
          return (
            <li class="border-base-300 rounded-box border p-5">
              <div class="mb-4 flex items-start justify-between gap-4">
                <h2 class="font-display text-xl leading-snug font-light">{s.title}</h2>
                <div class="flex shrink-0 items-center gap-2">
                  <StatusChip status={s.status} />
                  {/* Reorder posts the WHOLE order, because `sort` is rewritten
                      1..n rather than nudged — the same rule constellations
                      follow. Disabled at the ends rather than hidden, so the
                      row's controls do not shift as you move it. */}
                  <form method="POST" action={actions.sets.reorder} class="contents">
                    <input type="hidden" name="ids" value={moved(i, -1)} />
                    <button class="btn btn-ghost btn-xs" disabled={i === 0} aria-label={`Move ${s.title} up`}>
                      <Icon name="ph:arrow-up" />
                    </button>
                  </form>
                  <form method="POST" action={actions.sets.reorder} class="contents">
                    <input type="hidden" name="ids" value={moved(i, 1)} />
                    <button
                      class="btn btn-ghost btn-xs"
                      disabled={i === rows.length - 1}
                      aria-label={`Move ${s.title} down`}
                    >
                      <Icon name="ph:arrow-down" />
                    </button>
                  </form>
                </div>
              </div>

              <form method="POST" action={actions.sets.save} class="flex flex-col gap-3">
                <input type="hidden" name="id" value={s.id} />
                <label class="block">
                  <span class="f__k">Title</span>
                  <input name="title" value={s.title} required class={FIELD} />
                </label>
                <label class="block">
                  <span class="f__k">Slug</span>
                  <input name="slug" value={s.slug} class={FIELD} />
                </label>
                <label class="block">
                  <span class="f__k">Playlist</span>
                  <input name="playlist_url" value={s.playlist_url} required class={FIELD} />
                  <p class="admin-hint mt-1.5">
                    Any Spotify playlist link — the <code>?si=</code> token is stripped on save.
                  </p>
                </label>
                <label class="block">
                  <span class="f__k">Quote — optional</span>
                  <select name="quote_fragment_id" class="select select-sm select-bordered w-full font-sans">
                    <option value="">None</option>
                    {quotes.map((q) => (
                      <option value={q.id} selected={q.id === s.quote_fragment_id}>
                        {q.label}
                      </option>
                    ))}
                  </select>
                </label>
                <label class="block">
                  <span class="f__k">Description</span>
                  {/* ⚠ `set:text`, NOT A CHILD EXPRESSION. A textarea preserves everything
                      between its tags, so `<textarea>\n  {value}\n</textarea>` saves the
                      indentation with the prose and grows it by two spaces every time the
                      form is opened and saved. */}
                  <textarea
                    name="description"
                    rows="3"
                    class="textarea textarea-bordered w-full font-sans text-sm"
                    set:text={s.description}
                  />
                </label>
                <label class="block">
                  <span class="f__k">Status</span>
                  <select name="status" class="select select-sm select-bordered w-full font-sans">
                    <option value="draft" selected={s.status === 'draft'}>
                      Draft
                    </option>
                    <option value="published" selected={s.status === 'published'}>
                      Published
                    </option>
                  </select>
                </label>
                <div class="flex items-center gap-2">
                  <button class="btn btn-primary btn-sm font-sans normal-case">Save</button>
                  {/* ⚠ THE ONE FIELD YOU CANNOT CHECK BY READING IT — the same
                      argument the constellation composer makes about its score.
                      A playlist id is 22 opaque characters, and the only other
                      way to find out it is the wrong one is to publish the page
                      and press play. */}
                  {ref && (
                    <a
                      href={s.playlist_url}
                      target="_blank"
                      rel="noreferrer"
                      class="admin-hint hover:text-primary inline-flex items-center gap-1 underline"
                    >
                      Open <Icon name="ph:arrow-up-right" />
                    </a>
                  )}
                </div>
              </form>

              {ref &&
                (ref.height === null ? (
                  <div class="mt-4 aspect-video overflow-hidden" style="border-radius: var(--radius-box)">
                    <iframe
                      class="h-full w-full"
                      src={ref.src}
                      loading="lazy"
                      allow={ref.allow}
                      title={s.title}
                      style="border: 0"
                    />
                  </div>
                ) : (
                  <iframe
                    class="mt-4"
                    src={ref.src}
                    width="100%"
                    height={ref.height}
                    loading="lazy"
                    allow={ref.allow}
                    title={s.title}
                    style="border-radius: var(--radius-box); border: 0"
                  />
                ))}

              <form
                method="POST"
                action={actions.sets.remove}
                class="border-base-300 mt-4 border-t pt-3"
                onsubmit="return confirm('Delete this set? The playlist on Spotify is untouched.')"
              >
                <input type="hidden" name="id" value={s.id} />
                <button class="btn btn-ghost btn-xs text-error font-sans normal-case">Delete</button>
              </form>
            </li>
          );
        })
      }
    </ul>

    <section class="border-base-300 rounded-box mt-10 border border-dashed p-5">
      <h2 class="font-display mb-4 text-xl font-light">New set</h2>
      <form method="POST" action={actions.sets.save} class="flex flex-col gap-3">
        <label class="block">
          <span class="f__k">Title</span>
          <input name="title" required placeholder="If nothing else, I love you" class={FIELD} />
        </label>
        <label class="block">
          <span class="f__k">Playlist</span>
          <input
            name="playlist_url"
            required
            type="url"
            placeholder="https://open.spotify.com/playlist/…"
            class={FIELD}
          />
        </label>
        <label class="block">
          <span class="f__k">Quote — optional</span>
          <select name="quote_fragment_id" class="select select-sm select-bordered w-full font-sans">
            <option value="">None</option>
            {quotes.map((q) => <option value={q.id}>{q.label}</option>)}
          </select>
        </label>
        <label class="block">
          <span class="f__k">Description</span>
          <textarea name="description" rows="3" class="textarea textarea-bordered w-full font-sans text-sm"></textarea>
        </label>
        {
          /* A new set starts as a draft and says so by omission — `status`
            defaults to draft in the action, so there is no control here to get
            wrong. Publish it from its own card once it reads right. */
        }
        <div>
          <button class="btn btn-primary btn-sm gap-1 font-sans normal-case">
            <Icon name="ph:plus" /> Create as draft
          </button>
        </div>
      </form>
    </section>
  </div>
</AdminLayout>

---
/*
  /admin/fragments-panel — an Astro PARTIAL (no doctype/head/scripts) serving
  the shared FragmentListPanel. Two consumers fetch it:

   · /admin/fragments' in-place refresh (mode=manage, filters as query params);
   · the composer's browser sheet (mode=pick&constellation=<id>), which also
     marks already-placed rows so they render dimmed and unselectable;
   · the song sheet's pairing picker (mode=pair&song=<id>), plan 39 · §2 — the
     same idea one notch narrower: writing only, single-select, and rows already
     paired to that song render the same dimmed way placed ones do.

  Auth: middleware gates every /admin path, so this partial is admin-only too.
  Styling comes from the host page's global stylesheet; behavior from the host's
  fragment-panel.ts wiring — this route ships HTML only.
*/
import FragmentListPanel from '../../components/admin/FragmentListPanel.astro';
import { parseListParams, queryFragmentList } from '../../lib/fragment-query';

export const partial = true;

const modeParam = Astro.url.searchParams.get('mode');
const mode = modeParam === 'pick' || modeParam === 'pair' || modeParam === 'epigraph' ? modeParam : 'manage';
const params = parseListParams(Astro.url.searchParams);
if (mode === 'pick') {
  params.view = 'list'; // trash never reaches the picker
  // ⚠ `params.placeable = true` STOOD HERE AND EMPTIED THIS PICKER (fixed
  // 2026-08-17). It meant "no songs" (ADR 0031), but ADR 0035 had already taken
  // songs out of `fragment_type`, so the filter it produced compared the column
  // to an enum label that no longer exists — which Postgres answers with an
  // error, not an empty match. Every fragment vanished from the composer's
  // browser. There is nothing to replace it with: both remaining kinds ARE
  // suite stanzas, so the picker's scope is now simply "not trash, not a note",
  // which the shared `scoped` already applies.
  params.pairedSong = null; // paired-marking is a pair-mode concern
} else if (mode === 'pair') {
  params.view = 'list'; // ditto — nor does trash reach this one
  // `songs.pair` filters its update to `type = 'writing'`, so writing is the
  // whole of what may be offered here (plan 39 · §2).
  params.pairable = true;
} else if (mode === 'epigraph') {
  // The set sheet's quote picker (plan 42 · §4.D.4). Published quotes only —
  // `quotable` pins both, and says why the pin is narrower than `checkQuote`.
  params.view = 'list';
  params.quotable = true;
  params.constellation = null;
  params.pairedSong = null;
} else {
  params.constellation = null; // placed-marking is a pick-mode concern
  params.pairedSong = null;
}
const data = await queryFragmentList(Astro.locals.supabase, params);
---

<FragmentListPanel data={data} params={params} mode={mode} />

---
/*
  /admin/library — the vocabulary manager (docs/admin.md §8). Grooms the
  cross-cutting reference entities that editors create on the fly: SUBJECTS
  (with definitions — the taxonomy the AI classifier reads), AUTHORS, and WORKS.
  Each row: edit in place, merge into another (reassigns links, deletes the
  loser), or delete (FK-safe: fragments are never orphaned). Counts show usage.
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import { Icon } from 'astro-icon/components';

const supabase = Astro.locals.supabase;

const [{ data: subjects }, { data: authors }, { data: works }, { data: feelings }] = await Promise.all([
  supabase.from('subjects').select('id, name, definition').order('name'),
  supabase.from('authors').select('id, name, note').order('name'),
  supabase.from('works').select('id, title, author_id, year, kind').order('title'),
  // ⚠ BY `sort`, NOT BY NAME. The other three vocabularies are lists and sort
  // alphabetically; this one is a SPECTRUM, ordered dark → light, and that
  // ordering is a claim about the material (plan 33 §1). Alphabetising it here
  // would show a different vocabulary from the one the room shows, and the
  // Library is where the order is edited.
  supabase.from('feelings').select('id, name, slug, sort').order('sort'),
]);

// usage counts
const { data: fs } = await supabase.from('fragment_subjects').select('subject_id');
const { data: ff } = await supabase.from('fragment_feelings').select('feeling_id');
const { data: frs } = await supabase.from('fragments').select('author_id, work_id').is('deleted_at', null);
const tally = (rows: any[] | null, key: string) => {
  const m: Record<string, number> = {};
  for (const r of rows ?? []) if (r[key]) m[r[key]] = (m[r[key]] || 0) + 1;
  return m;
};
const subjCount = tally(fs, 'subject_id');
const feelingCount = tally(ff, 'feeling_id');
const authorCount = tally(frs, 'author_id');
const workCount = tally(frs, 'work_id');

// ⚠ THE SHELF COUNT, BECAUSE A DELETE TAKES IT AND THE DIALOG NEVER SAID SO
// (plans/30 · §6a). Plan 26 stopped `works.merge` destroying `person_works`
// rows and the notes written on them; `works.remove` still does, by cascade,
// and that is what a delete MEANS — but "only this label and its links are
// removed" is doing a lot of quiet work when one of those links is somebody's
// shelf with a sentence on it. Counted here so the confirm can say the number.
//
// Notes counted separately from links: losing a shelf entry is a fact you can
// re-add from the person's page in ten seconds, and losing what you wrote on it
// is not.
const { data: shelved } = await supabase.from('person_works').select('work_id, note');
const shelfCount: Record<string, number> = {};
const shelfNotes: Record<string, number> = {};
for (const row of shelved ?? []) {
  shelfCount[row.work_id] = (shelfCount[row.work_id] || 0) + 1;
  if (row.note?.trim()) shelfNotes[row.work_id] = (shelfNotes[row.work_id] || 0) + 1;
}
---

<AdminLayout title="Library" active="library">
  <div class="mx-auto max-w-5xl px-6 py-8">
    <PageHeader
      title="Library"
      subtitle="The vocabularies the workshop shares — subjects (what a piece is about; their definitions feed the AI suggester), feelings (what a song does to you), authors and works (where it comes from). Edit in place, merge duplicates, or delete."
    >
      {
        /* The export lives here rather than in the composing room: it's a
          housekeeping tool, like everything else on this page. A plain link,
          not a button with script — the endpoint sets Content-Disposition, so
          the browser downloads it and never navigates.

          It says "everything" because it now is everything: the corpus AND the
          private HQ tables in one file (ADR-0012). The label has to carry that,
          because a file called "corpus" gets treated like one. */
      }
      <a
        slot="actions"
        href="/admin/export.json"
        download
        class="btn btn-ghost btn-sm normal-case"
        title="Everything in one JSON file — the whole corpus and every private HQ table. The most sensitive file this site can produce; keep it somewhere you'd keep a password."
      >
        <Icon name="ph:arrow-down" class="text-base-content/60" /> Export everything
      </a>
    </PageHeader>
    <p id="lib-error" hidden role="alert" class="admin-alert mb-4"></p>

    {/* SUBJECTS */}
    <section class="mb-12">
      <h2 class="font-display mb-3 text-lg">
        Subjects <span class="text-base-content/40 text-sm">({(subjects ?? []).length})</span>
      </h2>
      <div class="rounded-box border-base-300 overflow-x-auto border">
        <table class="w-full font-sans text-sm">
          <thead>
            <tr
              class="border-base-300 bg-base-200/50 text-base-content/60 border-b text-left text-xs tracking-wide uppercase"
            >
              <th scope="col" class="px-3 py-2 font-normal">Name</th>
              <th scope="col" class="px-3 py-2 font-normal">Definition</th>
              <th scope="col" class="w-14 px-3 py-2 text-right font-normal">Used</th>
              <th scope="col" class="w-64 px-3 py-2 font-normal">Actions</th>
            </tr>
          </thead>
          <tbody>
            {
              (subjects ?? []).map((s) => (
                <tr
                  class="lib-row border-base-300 border-b align-top last:border-0"
                  data-entity="subject"
                  data-id={s.id}
                  data-name={s.name}
                  data-uses={subjCount[s.id] ?? 0}
                >
                  <td class="px-3 py-2">
                    <input
                      data-field="name"
                      value={s.name}
                      aria-label="Subject name"
                      class="input input-xs input-bordered w-36"
                    />
                  </td>
                  <td class="px-3 py-2">
                    <input
                      data-field="definition"
                      value={s.definition ?? ''}
                      placeholder="one-line meaning…"
                      class="input input-xs input-bordered w-full"
                    />
                  </td>
                  <td class="text-base-content/60 px-3 py-2 text-right">{subjCount[s.id] ?? 0}</td>
                  <td class="px-3 py-2">
                    <div class="flex items-center gap-2">
                      <button class="lib-save btn btn-primary btn-xs normal-case">Save</button>
                      <select class="lib-merge select select-xs select-bordered max-w-[8rem]" aria-label="Merge into">
                        <option value="">Merge into…</option>
                        {(subjects ?? [])
                          .filter((o) => o.id !== s.id)
                          .map((o) => (
                            <option value={o.id}>{o.name}</option>
                          ))}
                      </select>
                      <button class="lib-delete btn btn-ghost btn-xs text-error normal-case">Delete</button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      /* FEELINGS (plan 33 §1) — the fourth vocabulary, and the one whose rows
        behave differently from the other three.

        ⚠ THE SLUG IS FROZEN AND THE NAME IS NOT. Every other row on this page
        re-derives its slug from its name on save. A feeling's slug goes into a
        public URL people send each other (`/blog?view=music&feeling=regretful`),
        and moving one hard-404s every link already handed out — so a rename
        changes the word and leaves the address alone, and the two are allowed to
        drift apart forever. That is why the link is SHOWN in its own column: it
        is the only place the drift is visible, and it is what a collision on a
        new word will be about.

        ⚠ MERGE MATTERS MORE HERE THAN ANYWHERE ELSE ON THIS PAGE. §1's size
        discipline is the whole risk: the taxonomy dies by `wistful` and
        `reminiscent` splitting one shelf in month three, not by anything the
        unique index can catch. Merge is the tool for that, and the only exit
        when a new word collides with a link a renamed feeling still owns. */
    }
    <section class="mb-12">
      <h2 class="font-display mb-3 text-lg">
        Feelings <span class="text-base-content/40 text-sm">({(feelings ?? []).length})</span>
      </h2>
      <p class="text-base-content/50 mb-3 max-w-2xl font-sans text-sm">
        The words a song is filed under, in the order the room reads them — dark to light. Keep it short: two words for
        one shelf is how a vocabulary stops meaning anything.
      </p>

      {
        /* Adding one here rather than mid-listen, when it is a considered
        addition rather than something a track just did to you. */
      }
      <div class="mb-3 flex items-center gap-2">
        <input
          id="feeling-new"
          placeholder="a new word…"
          aria-label="New feeling"
          class="input input-xs input-bordered w-44"
        />
        <button id="feeling-add" class="btn btn-primary btn-xs normal-case">Add</button>
      </div>

      <div class="rounded-box border-base-300 overflow-x-auto border">
        <table class="w-full font-sans text-sm">
          <thead>
            <tr
              class="border-base-300 bg-base-200/50 text-base-content/60 border-b text-left text-xs tracking-wide uppercase"
            >
              <th scope="col" class="px-3 py-2 font-normal">Word</th>
              <th scope="col" class="w-20 px-3 py-2 font-normal">Order</th>
              <th scope="col" class="px-3 py-2 font-normal">Link</th>
              <th scope="col" class="w-14 px-3 py-2 text-right font-normal">Songs</th>
              <th scope="col" class="w-64 px-3 py-2 font-normal">Actions</th>
            </tr>
          </thead>
          <tbody>
            {
              (feelings ?? []).map((f) => (
                <tr
                  class="lib-row border-base-300 border-b align-top last:border-0"
                  data-entity="feeling"
                  data-id={f.id}
                  data-name={f.name}
                  data-uses={feelingCount[f.id] ?? 0}
                >
                  <td class="px-3 py-2">
                    <input
                      data-field="name"
                      value={f.name}
                      aria-label="Feeling"
                      class="input input-xs input-bordered w-36"
                    />
                  </td>
                  <td class="px-3 py-2">
                    <input
                      data-field="sort"
                      type="number"
                      value={f.sort}
                      aria-label="Position in the spectrum"
                      class="input input-xs input-bordered w-16"
                    />
                  </td>
                  {/* Not editable, and shown so the freeze is visible rather than
                      surprising. A word renamed away from its link is the one
                      state that can make a later addition fail. */}
                  <td class="text-base-content/45 px-3 py-2 font-mono text-xs">{f.slug}</td>
                  <td class="text-base-content/60 px-3 py-2 text-right">{feelingCount[f.id] ?? 0}</td>
                  <td class="px-3 py-2">
                    <div class="flex items-center gap-2">
                      <button class="lib-save btn btn-primary btn-xs normal-case">Save</button>
                      <select class="lib-merge select select-xs select-bordered max-w-[8rem]" aria-label="Merge into">
                        <option value="">Merge into…</option>
                        {(feelings ?? [])
                          .filter((o) => o.id !== f.id)
                          .map((o) => (
                            <option value={o.id}>{o.name}</option>
                          ))}
                      </select>
                      <button class="lib-delete btn btn-ghost btn-xs text-error normal-case">Delete</button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {/* AUTHORS */}
    <section class="mb-12">
      <h2 class="font-display mb-3 text-lg">
        Authors <span class="text-base-content/40 text-sm">({(authors ?? []).length})</span>
      </h2>
      <div class="rounded-box border-base-300 overflow-x-auto border">
        <table class="w-full font-sans text-sm">
          <thead>
            <tr
              class="border-base-300 bg-base-200/50 text-base-content/60 border-b text-left text-xs tracking-wide uppercase"
            >
              <th scope="col" class="px-3 py-2 font-normal">Name</th>
              <th scope="col" class="px-3 py-2 font-normal">Note</th>
              <th scope="col" class="w-14 px-3 py-2 text-right font-normal">Used</th>
              <th scope="col" class="w-64 px-3 py-2 font-normal">Actions</th>
            </tr>
          </thead>
          <tbody>
            {
              (authors ?? []).map((a) => (
                <tr
                  class="lib-row border-base-300 border-b align-top last:border-0"
                  data-entity="author"
                  data-id={a.id}
                  data-name={a.name}
                  data-uses={authorCount[a.id] ?? 0}
                  data-own-note={a.note?.trim() ? '1' : ''}
                >
                  <td class="px-3 py-2">
                    <input
                      data-field="name"
                      value={a.name}
                      aria-label="Author name"
                      class="input input-xs input-bordered w-44"
                    />
                  </td>
                  <td class="px-3 py-2">
                    <input
                      data-field="note"
                      value={a.note ?? ''}
                      placeholder="dates, a line…"
                      class="input input-xs input-bordered w-full"
                    />
                  </td>
                  <td class="text-base-content/60 px-3 py-2 text-right">{authorCount[a.id] ?? 0}</td>
                  <td class="px-3 py-2">
                    <div class="flex items-center gap-2">
                      <button class="lib-save btn btn-primary btn-xs normal-case">Save</button>
                      <select class="lib-merge select select-xs select-bordered max-w-[8rem]" aria-label="Merge into">
                        <option value="">Merge into…</option>
                        {(authors ?? [])
                          .filter((o) => o.id !== a.id)
                          .map((o) => (
                            <option value={o.id}>{o.name}</option>
                          ))}
                      </select>
                      <button class="lib-delete btn btn-ghost btn-xs text-error normal-case">Delete</button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {/* WORKS */}
    <section class="mb-12">
      <h2 class="font-display mb-3 text-lg">
        Works <span class="text-base-content/40 text-sm">({(works ?? []).length})</span>
      </h2>
      <div class="rounded-box border-base-300 overflow-x-auto border">
        <table class="w-full font-sans text-sm">
          <thead>
            <tr
              class="border-base-300 bg-base-200/50 text-base-content/60 border-b text-left text-xs tracking-wide uppercase"
            >
              <th scope="col" class="px-3 py-2 font-normal">Title</th>
              <th scope="col" class="px-3 py-2 font-normal">Author</th>
              <th scope="col" class="w-16 px-3 py-2 font-normal">Year</th>
              <th scope="col" class="w-14 px-3 py-2 text-right font-normal">Used</th>
              <th scope="col" class="w-64 px-3 py-2 font-normal">Actions</th>
            </tr>
          </thead>
          <tbody>
            {
              (works ?? []).map((w) => (
                <tr
                  class="lib-row border-base-300 border-b align-top last:border-0"
                  data-entity="work"
                  data-id={w.id}
                  data-name={w.title}
                  data-uses={workCount[w.id] ?? 0}
                  data-shelves={shelfCount[w.id] ?? 0}
                  data-shelf-notes={shelfNotes[w.id] ?? 0}
                >
                  <td class="px-3 py-2">
                    <input
                      data-field="title"
                      value={w.title}
                      aria-label="Work title"
                      class="input input-xs input-bordered w-44"
                    />
                  </td>
                  <td class="px-3 py-2">
                    <select data-field="author_id" class="select select-xs select-bordered max-w-[10rem]">
                      <option value="">— none —</option>
                      {(authors ?? []).map((a) => (
                        <option value={a.id} selected={a.id === w.author_id}>
                          {a.name}
                        </option>
                      ))}
                    </select>
                  </td>
                  <td class="px-3 py-2">
                    <input
                      data-field="year"
                      type="number"
                      value={w.year ?? ''}
                      aria-label="Year"
                      class="input input-xs input-bordered w-16"
                    />
                  </td>
                  <td class="text-base-content/60 px-3 py-2 text-right">{workCount[w.id] ?? 0}</td>
                  <td class="px-3 py-2">
                    <input data-field="kind" type="hidden" value={w.kind ?? ''} />
                    <div class="flex items-center gap-2">
                      <button class="lib-save btn btn-primary btn-xs normal-case">Save</button>
                      <select class="lib-merge select select-xs select-bordered max-w-[8rem]" aria-label="Merge into">
                        <option value="">Merge into…</option>
                        {(works ?? [])
                          .filter((o) => o.id !== w.id)
                          .map((o) => (
                            <option value={o.id}>{o.title}</option>
                          ))}
                      </select>
                      <button class="lib-delete btn btn-ghost btn-xs text-error normal-case">Delete</button>
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>
  </div>

  <script>
    import { actions } from 'astro:actions';
    import { confirmDialog } from '../../scripts/confirm-dialog';
    import { callAction, formatActionError } from '../../scripts/action-error';
    import { deleteWarning } from '../../lib/library-delete';

    const A: Record<string, any> = {
      subject: actions.subjects,
      author: actions.authors,
      work: actions.works,
      feeling: actions.feelings,
    };

    const err = document.getElementById('lib-error') as HTMLParagraphElement;
    const showErr = (m: string) => {
      err.textContent = m;
      err.hidden = false;
      err.scrollIntoView({ block: 'nearest' });
    };

    document.querySelectorAll<HTMLElement>('.lib-row').forEach((row) => {
      const entity = row.dataset.entity!;
      const id = row.dataset.id!;
      const api = A[entity];

      row.querySelector('.lib-save')?.addEventListener('click', async (e) => {
        const btn = e.currentTarget as HTMLButtonElement;
        const fd = new FormData();
        fd.set('id', id);
        row
          .querySelectorAll<HTMLInputElement | HTMLSelectElement>('[data-field]')
          .forEach((el) => fd.set(el.dataset.field!, el.value));
        btn.disabled = true;
        const { error } = await api.update(fd);
        btn.disabled = false;
        if (error) showErr(error.message);
        else location.reload();
      });

      row.querySelector('.lib-delete')?.addEventListener('click', async () => {
        const ok = await confirmDialog({
          title: 'Delete',
          // The counts are rendered onto the row above; this reads them back
          // rather than re-querying, so the number in the dialog is exactly the
          // number in the "Used" column beside the button you pressed.
          message: deleteWarning({
            entity: row.dataset.entity as 'subject' | 'author' | 'work' | 'feeling',
            name: row.dataset.name,
            uses: Number(row.dataset.uses ?? 0),
            shelves: Number(row.dataset.shelves ?? 0),
            shelfNotes: Number(row.dataset.shelfNotes ?? 0),
            ownNote: !!row.dataset.ownNote,
          }),
          confirmLabel: 'Delete',
          danger: true,
        });
        if (!ok) return;
        const fd = new FormData();
        fd.set('id', id);
        const { error } = await api.remove(fd);
        if (error) showErr(error.message);
        else location.reload();
      });

      const merge = row.querySelector<HTMLSelectElement>('.lib-merge');
      merge?.addEventListener('change', async () => {
        const into = merge.value;
        if (!into) return;
        const ok = await confirmDialog({
          title: 'Merge',
          message: 'Move everything onto the target and delete this one? This can’t be undone.',
          confirmLabel: 'Merge',
          danger: true,
        });
        if (!ok) {
          merge.value = '';
          return;
        }
        const fd = new FormData();
        fd.set('from', id);
        fd.set('into', into);
        const { error } = await api.merge(fd);
        if (error) showErr(error.message);
        else location.reload();
      });
    });

    // ⚠ THE ONLY VOCABULARY ON THIS PAGE WITH A CREATE CONTROL, and the reason
    // is that it is the only one nothing else creates. A subject, author or work
    // comes into existence as a side effect of saving a fragment that names it;
    // a feeling is never implied by anything, so without this row the vocabulary
    // could only ever grow from the listening bench.
    //
    // It reloads on success rather than appending a row, because a new word
    // changes three things at once — the table, every "Merge into…" menu, and
    // the bench's chip order — and re-rendering all of that by hand is how two
    // of them end up disagreeing.
    const newFeeling = document.getElementById('feeling-new') as HTMLInputElement | null;
    const addFeeling = document.getElementById('feeling-add') as HTMLButtonElement | null;
    const createFeeling = async () => {
      const name = newFeeling?.value.trim();
      if (!newFeeling || !addFeeling || !name) return;
      const fd = new FormData();
      fd.set('name', name);
      addFeeling.disabled = true;
      // `callAction`, not a bare await: `astro:actions` THROWS on a dead
      // network rather than returning `{ error }`, and the rejection would skip
      // the line below — leaving the button disabled with nothing said, on the
      // one control on this page that has no row to fall back to.
      const { error } = await callAction(actions.feelings.create(fd));
      addFeeling.disabled = false;
      if (error) showErr(formatActionError(error));
      else location.reload();
    };
    addFeeling?.addEventListener('click', () => void createFeeling());
    newFeeling?.addEventListener('keydown', (e) => {
      if (e.key !== 'Enter') return;
      e.preventDefault();
      void createFeeling();
    });
  </script>
</AdminLayout>

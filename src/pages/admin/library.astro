---
/*
  /admin/library — the vocabulary manager (docs/admin.md §8). Grooms the
  cross-cutting reference entities that editors create on the fly: SUBJECTS
  (with definitions — the taxonomy the AI classifier reads), AUTHORS, and WORKS.
  Each row: edit in place, merge into another (reassigns links, deletes the
  loser), or delete (FK-safe: fragments are never orphaned). Counts show usage.
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import FilterField from '../../components/admin/FilterField.astro';
import VocabTable from '../../components/admin/VocabTable.astro';
import VocabActions from '../../components/admin/VocabActions.astro';
import MergeDialog from '../../components/admin/MergeDialog.astro';
import { Icon } from 'astro-icon/components';
import { MAX_SHELVES, readShelfIndex } from '../../lib/shelves';

const supabase = Astro.locals.supabase;

const [{ data: subjects }, { data: authors }, { data: works }, shelfIndex] = await Promise.all([
  supabase.from('subjects').select('id, name, definition').order('name'),
  supabase.from('authors').select('id, name, note').order('name'),
  supabase.from('works').select('id, title, author_id, year, kind').order('title'),
  /*
    ⚠ THE FOURTH VOCABULARY, ADDED 2026-09-18. Shelves shipped on 2026-09-01
    with a create-only door — makeable from the pile's → chooser and then
    unreachable by any grooming tool in the building. Michael: *"I also dont see
    a place where to even manage the notes categories."* This is that place, and
    the action file had already named it: *"Both belong beside the subjects
    vocabulary, not behind a row you can hit by accident."*

    `readShelfIndex` rather than a bare select, because the row needs the
    membership count and that helper already derives it — over LIVE notes only,
    which matters here: a soft-deleted jotting must not inflate the number the
    delete confirm is about to quote.
  */
  readShelfIndex(supabase),
  // ⚠ BY `sort`, NOT BY NAME. The other three vocabularies are lists and sort
  // alphabetically; this one is a SPECTRUM, ordered dark → light, and that
  // ordering is a claim about the material (plan 33 §1). Alphabetising it here
  // would show a different vocabulary from the one the room shows, and the
  // Library is where the order is edited.
]);

// usage counts
const { data: fs } = await supabase.from('fragment_subjects').select('subject_id');
const { data: frs } = await supabase.from('fragments').select('author_id, work_id').is('deleted_at', null);
const tally = (rows: any[] | null, key: string) => {
  const m: Record<string, number> = {};
  for (const r of rows ?? []) if (r[key]) m[r[key]] = (m[r[key]] || 0) + 1;
  return m;
};
const subjCount = tally(fs, 'subject_id');
const authorCount = tally(frs, 'author_id');
const workCount = tally(frs, 'work_id');

// ⚠ THE SHELF COUNT, BECAUSE A DELETE TAKES IT AND THE DIALOG NEVER SAID SO
// (plans/30 · §6a). Plan 26 stopped `works.merge` destroying `person_works`
// rows and the notes written on them; `works.remove` still does, by cascade,
// and that is what a delete MEANS — but "only this label and its links are
// removed" is doing a lot of quiet work when one of those links is somebody's
// shelf with a sentence on it. Counted here so the confirm can say the number.
//
// Notes counted separately from links: losing a shelf entry is a fact you can
// re-add from the person's page in ten seconds, and losing what you wrote on it
// is not.
const { data: shelved } = await supabase.from('person_works').select('work_id, note');
const shelfCount: Record<string, number> = {};
const shelfNotes: Record<string, number> = {};
for (const row of shelved ?? []) {
  shelfCount[row.work_id] = (shelfCount[row.work_id] || 0) + 1;
  if (row.note?.trim()) shelfNotes[row.work_id] = (shelfNotes[row.work_id] || 0) + 1;
}

/* The merge picker's whole option set, built once. This is what replaces 11,309
   per-row `<option>` elements (plan 38 · §1.2): four arrays instead of one list
   per row, serialized into a single <script type="application/json">. */
const mergeOptions = {
  subject: (subjects ?? []).map((r) => ({ id: r.id, name: r.name })),
  author: (authors ?? []).map((r) => ({ id: r.id, name: r.name })),
  work: (works ?? []).map((r) => ({ id: r.id, name: r.title })),
};
---

<AdminLayout title="Library" active="library">
  <div class="mx-auto max-w-5xl px-6 py-8">
    <PageHeader
      title="Library"
      subtitle="The vocabularies the workshop shares — subjects (what a piece is about; their definitions feed the AI suggester), authors and works (where it comes from). Edit in place, merge duplicates, or delete."
    >
      {
        /* The export lives here rather than in the composing room: it's a
          housekeeping tool, like everything else on this page. A plain link,
          not a button with script — the endpoint sets Content-Disposition, so
          the browser downloads it and never navigates.

          It says "everything" because it now is everything: the corpus AND the
          private HQ tables in one file (ADR-0012). The label has to carry that,
          because a file called "corpus" gets treated like one. */
      }
      <a
        slot="actions"
        href="/admin/export.json"
        download
        class="btn btn-ghost btn-sm normal-case"
        title="Everything in one JSON file — the whole corpus and every private HQ table. The most sensitive file this site can produce; keep it somewhere you'd keep a password."
      >
        <Icon name="ph:arrow-down" class="text-faint" /> Export everything
      </a>
    </PageHeader>
    <p id="lib-error" hidden role="alert" class="admin-alert mb-4"></p>

    {
      /* ⚠ ONE FIELD OVER ALL THREE TABLES, not one per table (plan 42 · §4.B.2).
        This is the longest list in the building — roughly 106 rows — and it was
        the only one with no way to find a row at all, on the page whose whole
        job is *find the duplicate, then groom it*. Three boxes would make you
        guess the table first, and the guess is exactly what you came here
        without: a name you half-remember could be an author or a work. A
        vocabulary with no hit hides itself, heading and all.

        ⚠ NO THRESHOLD — `threshold={null}`. The rule the constant encodes is
        about a picker inside a sheet, scanned mid-decision; this is a page you
        opened to search. It never has too few rows to be worth a box. */
    }
    <FilterField
      count={(subjects ?? []).length + (authors ?? []).length + (works ?? []).length}
      rows=".lib-row"
      groups="[data-vocab]"
      threshold={null}
      placeholder="Find a subject, author or work…"
      label="Find a subject, author or work"
      noMatch="Nothing in the vocabularies by that name."
      fieldClass="mb-6 max-w-md"
    >
      {/* SUBJECTS */}
      <VocabTable
        title="Subjects"
        count={(subjects ?? []).length}
        columns={[
          { label: 'Name' },
          { label: 'Definition' },
          { label: 'Used', w: 'w-14', right: true },
          { label: 'Actions', w: 'w-64' },
        ]}
      >
        {
          (subjects ?? []).map((s) => (
            <tr
              class="lib-row border-base-300 border-b align-top last:border-0"
              data-entity="subject"
              data-id={s.id}
              data-name={s.name}
              data-search={`${s.name} ${s.definition ?? ''}`.toLowerCase()}
              data-uses={subjCount[s.id] ?? 0}
            >
              <td class="px-3 py-2">
                <input data-field="name" value={s.name} aria-label="Subject name" class="input input-xs w-36" />
              </td>
              <td class="px-3 py-2">
                <input
                  data-field="definition"
                  value={s.definition ?? ''}
                  placeholder="one-line meaning…"
                  class="input input-xs w-full"
                />
              </td>
              <td class="text-faint px-3 py-2 text-right">{subjCount[s.id] ?? 0}</td>
              <td class="px-3 py-2">
                <VocabActions entity="subject" id={s.id} name={s.name} />
              </td>
            </tr>
          ))
        }
      </VocabTable>

      {/* AUTHORS */}
      <VocabTable
        title="Authors"
        count={(authors ?? []).length}
        columns={[
          { label: 'Name' },
          { label: 'Note' },
          { label: 'Used', w: 'w-14', right: true },
          { label: 'Actions', w: 'w-64' },
        ]}
      >
        {
          (authors ?? []).map((a) => (
            <tr
              class="lib-row border-base-300 border-b align-top last:border-0"
              data-entity="author"
              data-id={a.id}
              data-name={a.name}
              data-search={`${a.name} ${a.note ?? ''}`.toLowerCase()}
              data-uses={authorCount[a.id] ?? 0}
              data-own-note={a.note?.trim() ? '1' : ''}
            >
              <td class="px-3 py-2">
                <input data-field="name" value={a.name} aria-label="Author name" class="input input-xs w-44" />
              </td>
              <td class="px-3 py-2">
                <input
                  data-field="note"
                  value={a.note ?? ''}
                  placeholder="dates, a line…"
                  class="input input-xs w-full"
                />
              </td>
              <td class="text-faint px-3 py-2 text-right">{authorCount[a.id] ?? 0}</td>
              <td class="px-3 py-2">
                <VocabActions entity="author" id={a.id} name={a.name} />
              </td>
            </tr>
          ))
        }
      </VocabTable>

      {/* WORKS */}
      <VocabTable
        title="Works"
        count={(works ?? []).length}
        columns={[
          { label: 'Title' },
          { label: 'Author' },
          { label: 'Year', w: 'w-16' },
          { label: 'Used', w: 'w-14', right: true },
          { label: 'Actions', w: 'w-64' },
        ]}
      >
        {
          (works ?? []).map((w) => (
            <tr
              class="lib-row border-base-300 border-b align-top last:border-0"
              data-entity="work"
              data-id={w.id}
              data-name={w.title}
              data-search={`${w.title} ${(authors ?? []).find((a) => a.id === w.author_id)?.name ?? ''}`.toLowerCase()}
              data-uses={workCount[w.id] ?? 0}
              data-shelves={shelfCount[w.id] ?? 0}
              data-shelf-notes={shelfNotes[w.id] ?? 0}
            >
              <td class="px-3 py-2">
                <input data-field="title" value={w.title} aria-label="Work title" class="input input-xs w-44" />
              </td>
              <td class="px-3 py-2">
                <select data-field="author_id" class="select select-xs max-w-[10rem]">
                  <option value="">— none —</option>
                  {(authors ?? []).map((a) => (
                    <option value={a.id} selected={a.id === w.author_id}>
                      {a.name}
                    </option>
                  ))}
                </select>
              </td>
              <td class="px-3 py-2">
                <input
                  data-field="year"
                  type="number"
                  value={w.year ?? ''}
                  aria-label="Year"
                  class="input input-xs w-16"
                />
              </td>
              <td class="text-faint px-3 py-2 text-right">{workCount[w.id] ?? 0}</td>
              <td class="px-3 py-2">
                <input data-field="kind" type="hidden" value={w.kind ?? ''} />
                <VocabActions entity="work" id={w.id} name={w.title} />
              </td>
            </tr>
          ))
        }
      </VocabTable>

      {/* SHELVES */}
      <VocabTable
        title="Shelves"
        count={shelfIndex.vocab.length}
        columns={[{ label: 'Name' }, { label: 'Notes', w: 'w-16', right: true }, { label: 'Actions', w: 'w-48' }]}
      >
        <Fragment slot="lede">
          {
            /* ⚠ THE ONE VOCABULARY ON THIS PAGE THAT NO READER EVER SEES, and
              saying so is worth a line because the other three are all public
              in some way. A shelf is what a jotting is FOR; a subject is what a
              piece is ABOUT (ADR 0042). The two must never merge, and a room
              that lists them one above the other is exactly where somebody
              would get the idea. */
          }
          <p class="text-muted mb-3 max-w-prose text-sm">
            Where a jotting lives when it is never going to be a piece — private, and never rendered for a reader. A
            note sits on at most {MAX_SHELVES}. New ones are made from the <strong>→</strong> on a card in the pile.
          </p>
        </Fragment>
        {
          shelfIndex.vocab.map((sh) => (
            <tr
              class="lib-row border-base-300 border-b align-top last:border-0"
              data-entity="shelf"
              data-id={sh.id}
              data-name={sh.name}
              data-search={sh.name.toLowerCase()}
              data-uses={shelfIndex.byShelf[sh.id] ?? 0}
            >
              <td class="px-3 py-2">
                <input data-field="name" value={sh.name} aria-label="Shelf name" class="input input-xs w-44" />
                {/* ⚠ THE SLUG IS SHOWN AND IS NOT EDITABLE, which is the honest
                  rendering of `shelves.rename`'s hardest constraint: `?shelf=`
                  addresses this view, so the slug is an identifier that happens
                  to have been minted from the first name. Printing it stops the
                  rename control looking like it renames the URL too. */}
                <span class="text-whisper mt-1 block font-mono text-xs">/{sh.slug}</span>
              </td>
              <td class="text-faint px-3 py-2 text-right">
                {/* Links to the shelf rather than printing a dead number: this
                  is the count of a thing you can go and look at, and the pile
                  is one press away. */}
                <a class="hover:underline" href={`/admin/notes?shelf=${sh.slug}`}>
                  {shelfIndex.byShelf[sh.id] ?? 0}
                </a>
              </td>
              <td class="px-3 py-2">
                <VocabActions entity="shelf" id={sh.id} name={sh.name} mergeable={false} />
              </td>
            </tr>
          ))
        }
        {
          shelfIndex.vocab.length === 0 && (
            <tr>
              <td colspan="3" class="text-whisper px-3 py-4 text-sm">
                No shelves yet. The <strong>→</strong> on a card in the pile is where the first one gets made.
              </td>
            </tr>
          )
        }
      </VocabTable>
    </FilterField>
  </div>

  <MergeDialog options={mergeOptions} />

  <script>
    import '../../scripts/library';
  </script>
</AdminLayout>

---
/*
  /admin/library — the vocabulary manager (docs/admin.md §8). Grooms the
  cross-cutting reference entities that editors create on the fly: SUBJECTS
  (with definitions — the taxonomy the AI classifier reads), AUTHORS, and WORKS.
  Each row: edit in place, merge into another (reassigns links, deletes the
  loser), or delete (FK-safe: fragments are never orphaned). Counts show usage.
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import VocabTable from '../../components/admin/VocabTable.astro';
import VocabActions from '../../components/admin/VocabActions.astro';
import MergeDialog from '../../components/admin/MergeDialog.astro';
import { Icon } from 'astro-icon/components';

const supabase = Astro.locals.supabase;

const [{ data: subjects }, { data: authors }, { data: works }, { data: feelings }] = await Promise.all([
  supabase.from('subjects').select('id, name, definition').order('name'),
  supabase.from('authors').select('id, name, note').order('name'),
  supabase.from('works').select('id, title, author_id, year, kind').order('title'),
  // ⚠ BY `sort`, NOT BY NAME. The other three vocabularies are lists and sort
  // alphabetically; this one is a SPECTRUM, ordered dark → light, and that
  // ordering is a claim about the material (plan 33 §1). Alphabetising it here
  // would show a different vocabulary from the one the room shows, and the
  // Library is where the order is edited.
  supabase.from('feelings').select('id, name, slug, sort').order('sort'),
]);

// usage counts
const { data: fs } = await supabase.from('fragment_subjects').select('subject_id');
const { data: ff } = await supabase.from('fragment_feelings').select('feeling_id');
const { data: frs } = await supabase.from('fragments').select('author_id, work_id').is('deleted_at', null);
const tally = (rows: any[] | null, key: string) => {
  const m: Record<string, number> = {};
  for (const r of rows ?? []) if (r[key]) m[r[key]] = (m[r[key]] || 0) + 1;
  return m;
};
const subjCount = tally(fs, 'subject_id');
const feelingCount = tally(ff, 'feeling_id');
const authorCount = tally(frs, 'author_id');
const workCount = tally(frs, 'work_id');

// ⚠ THE SHELF COUNT, BECAUSE A DELETE TAKES IT AND THE DIALOG NEVER SAID SO
// (plans/30 · §6a). Plan 26 stopped `works.merge` destroying `person_works`
// rows and the notes written on them; `works.remove` still does, by cascade,
// and that is what a delete MEANS — but "only this label and its links are
// removed" is doing a lot of quiet work when one of those links is somebody's
// shelf with a sentence on it. Counted here so the confirm can say the number.
//
// Notes counted separately from links: losing a shelf entry is a fact you can
// re-add from the person's page in ten seconds, and losing what you wrote on it
// is not.
const { data: shelved } = await supabase.from('person_works').select('work_id, note');
const shelfCount: Record<string, number> = {};
const shelfNotes: Record<string, number> = {};
for (const row of shelved ?? []) {
  shelfCount[row.work_id] = (shelfCount[row.work_id] || 0) + 1;
  if (row.note?.trim()) shelfNotes[row.work_id] = (shelfNotes[row.work_id] || 0) + 1;
}

/* The merge picker's whole option set, built once. This is what replaces 11,309
   per-row `<option>` elements (plan 38 · §1.2): four arrays instead of one list
   per row, serialized into a single <script type="application/json">. */
const mergeOptions = {
  subject: (subjects ?? []).map((r) => ({ id: r.id, name: r.name })),
  feeling: (feelings ?? []).map((r) => ({ id: r.id, name: r.name })),
  author: (authors ?? []).map((r) => ({ id: r.id, name: r.name })),
  work: (works ?? []).map((r) => ({ id: r.id, name: r.title })),
};
---

<AdminLayout title="Library" active="library">
  <div class="mx-auto max-w-5xl px-6 py-8">
    <PageHeader
      title="Library"
      subtitle="The vocabularies the workshop shares — subjects (what a piece is about; their definitions feed the AI suggester), feelings (what a song does to you), authors and works (where it comes from). Edit in place, merge duplicates, or delete."
    >
      {
        /* The export lives here rather than in the composing room: it's a
          housekeeping tool, like everything else on this page. A plain link,
          not a button with script — the endpoint sets Content-Disposition, so
          the browser downloads it and never navigates.

          It says "everything" because it now is everything: the corpus AND the
          private HQ tables in one file (ADR-0012). The label has to carry that,
          because a file called "corpus" gets treated like one. */
      }
      <a
        slot="actions"
        href="/admin/export.json"
        download
        class="btn btn-ghost btn-sm normal-case"
        title="Everything in one JSON file — the whole corpus and every private HQ table. The most sensitive file this site can produce; keep it somewhere you'd keep a password."
      >
        <Icon name="ph:arrow-down" class="text-base-content/60" /> Export everything
      </a>
    </PageHeader>
    <p id="lib-error" hidden role="alert" class="admin-alert mb-4"></p>

    {/* SUBJECTS */}
    <VocabTable
      title="Subjects"
      count={(subjects ?? []).length}
      columns={[
        { label: 'Name' },
        { label: 'Definition' },
        { label: 'Used', w: 'w-14', right: true },
        { label: 'Actions', w: 'w-64' },
      ]}
    >
      {
        (subjects ?? []).map((s) => (
          <tr
            class="lib-row border-base-300 border-b align-top last:border-0"
            data-entity="subject"
            data-id={s.id}
            data-name={s.name}
            data-uses={subjCount[s.id] ?? 0}
          >
            <td class="px-3 py-2">
              <input
                data-field="name"
                value={s.name}
                aria-label="Subject name"
                class="input input-xs input-bordered w-36"
              />
            </td>
            <td class="px-3 py-2">
              <input
                data-field="definition"
                value={s.definition ?? ''}
                placeholder="one-line meaning…"
                class="input input-xs input-bordered w-full"
              />
            </td>
            <td class="text-base-content/60 px-3 py-2 text-right">{subjCount[s.id] ?? 0}</td>
            <td class="px-3 py-2">
              <VocabActions entity="subject" id={s.id} name={s.name} />
            </td>
          </tr>
        ))
      }
    </VocabTable>

    {
      /* FEELINGS (plan 33 §1) — the fourth vocabulary, and the one whose rows
        behave differently from the other three.

        ⚠ THE SLUG IS FROZEN AND THE NAME IS NOT. Every other row on this page
        re-derives its slug from its name on save. A feeling's slug goes into a
        public URL people send each other (`/blog?view=music&feeling=regretful`),
        and moving one hard-404s every link already handed out — so a rename
        changes the word and leaves the address alone, and the two are allowed to
        drift apart forever. That is why the link is SHOWN in its own column: it
        is the only place the drift is visible, and it is what a collision on a
        new word will be about.

        ⚠ MERGE MATTERS MORE HERE THAN ANYWHERE ELSE ON THIS PAGE. §1's size
        discipline is the whole risk: the taxonomy dies by `wistful` and
        `reminiscent` splitting one shelf in month three, not by anything the
        unique index can catch. Merge is the tool for that, and the only exit
        when a new word collides with a link a renamed feeling still owns. */
    }
    <VocabTable
      title="Feelings"
      count={(feelings ?? []).length}
      columns={[
        { label: 'Word' },
        { label: 'Order', w: 'w-20' },
        { label: 'Link' },
        { label: 'Songs', w: 'w-14', right: true },
        { label: 'Actions', w: 'w-64' },
      ]}
    >
      <Fragment slot="lede">
        <p class="text-base-content/50 mb-3 max-w-2xl font-sans text-sm">
          The words a song is filed under, in the order the room reads them — dark to light. Keep it short: two words
          for one shelf is how a vocabulary stops meaning anything.
        </p>

        {
          /* Adding one here rather than mid-listen, when it is a considered
        addition rather than something a track just did to you. */
        }
        <div class="mb-3 flex items-center gap-2">
          <input
            id="feeling-new"
            placeholder="a new word…"
            aria-label="New feeling"
            class="input input-xs input-bordered w-44"
          />
          <button id="feeling-add" class="btn btn-primary btn-xs normal-case">Add</button>
        </div>
      </Fragment>
      {
        (feelings ?? []).map((f) => (
          <tr
            class="lib-row border-base-300 border-b align-top last:border-0"
            data-entity="feeling"
            data-id={f.id}
            data-name={f.name}
            data-uses={feelingCount[f.id] ?? 0}
          >
            <td class="px-3 py-2">
              <input data-field="name" value={f.name} aria-label="Feeling" class="input input-xs input-bordered w-36" />
            </td>
            <td class="px-3 py-2">
              <input
                data-field="sort"
                type="number"
                value={f.sort}
                aria-label="Position in the spectrum"
                class="input input-xs input-bordered w-16"
              />
            </td>
            {/* Not editable, and shown so the freeze is visible rather than
                      surprising. A word renamed away from its link is the one
                      state that can make a later addition fail. */}
            <td class="text-base-content/45 px-3 py-2 font-mono text-xs">{f.slug}</td>
            <td class="text-base-content/60 px-3 py-2 text-right">{feelingCount[f.id] ?? 0}</td>
            <td class="px-3 py-2">
              <VocabActions entity="feeling" id={f.id} name={f.name} />
            </td>
          </tr>
        ))
      }
    </VocabTable>

    {/* AUTHORS */}
    <VocabTable
      title="Authors"
      count={(authors ?? []).length}
      columns={[
        { label: 'Name' },
        { label: 'Note' },
        { label: 'Used', w: 'w-14', right: true },
        { label: 'Actions', w: 'w-64' },
      ]}
    >
      {
        (authors ?? []).map((a) => (
          <tr
            class="lib-row border-base-300 border-b align-top last:border-0"
            data-entity="author"
            data-id={a.id}
            data-name={a.name}
            data-uses={authorCount[a.id] ?? 0}
            data-own-note={a.note?.trim() ? '1' : ''}
          >
            <td class="px-3 py-2">
              <input
                data-field="name"
                value={a.name}
                aria-label="Author name"
                class="input input-xs input-bordered w-44"
              />
            </td>
            <td class="px-3 py-2">
              <input
                data-field="note"
                value={a.note ?? ''}
                placeholder="dates, a line…"
                class="input input-xs input-bordered w-full"
              />
            </td>
            <td class="text-base-content/60 px-3 py-2 text-right">{authorCount[a.id] ?? 0}</td>
            <td class="px-3 py-2">
              <VocabActions entity="author" id={a.id} name={a.name} />
            </td>
          </tr>
        ))
      }
    </VocabTable>

    {/* WORKS */}
    <VocabTable
      title="Works"
      count={(works ?? []).length}
      columns={[
        { label: 'Title' },
        { label: 'Author' },
        { label: 'Year', w: 'w-16' },
        { label: 'Used', w: 'w-14', right: true },
        { label: 'Actions', w: 'w-64' },
      ]}
    >
      {
        (works ?? []).map((w) => (
          <tr
            class="lib-row border-base-300 border-b align-top last:border-0"
            data-entity="work"
            data-id={w.id}
            data-name={w.title}
            data-uses={workCount[w.id] ?? 0}
            data-shelves={shelfCount[w.id] ?? 0}
            data-shelf-notes={shelfNotes[w.id] ?? 0}
          >
            <td class="px-3 py-2">
              <input
                data-field="title"
                value={w.title}
                aria-label="Work title"
                class="input input-xs input-bordered w-44"
              />
            </td>
            <td class="px-3 py-2">
              <select data-field="author_id" class="select select-xs select-bordered max-w-[10rem]">
                <option value="">— none —</option>
                {(authors ?? []).map((a) => (
                  <option value={a.id} selected={a.id === w.author_id}>
                    {a.name}
                  </option>
                ))}
              </select>
            </td>
            <td class="px-3 py-2">
              <input
                data-field="year"
                type="number"
                value={w.year ?? ''}
                aria-label="Year"
                class="input input-xs input-bordered w-16"
              />
            </td>
            <td class="text-base-content/60 px-3 py-2 text-right">{workCount[w.id] ?? 0}</td>
            <td class="px-3 py-2">
              <input data-field="kind" type="hidden" value={w.kind ?? ''} />
              <VocabActions entity="work" id={w.id} name={w.title} />
            </td>
          </tr>
        ))
      }
    </VocabTable>
  </div>

  <MergeDialog options={mergeOptions} />

  <script>
    import '../../scripts/library';
  </script>
</AdminLayout>

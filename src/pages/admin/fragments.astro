---
/*
  /admin/fragments — the Fragment Manager (docs/admin.md §2). A flat, sortable
  table over ALL fragments (admin sees everything via RLS), rendered by the shared
  FragmentListPanel (also served as the fragments-panel partial to the
  composer's browser sheet). Filtering/sorting swap the table in place
  (fragment-panel.ts) — no full reload. Every fragment edits in an overlay:
  quotes/songs in the FragmentSheet, writing in the WritingSheet — the page
  underneath never navigates away.

  It lived at `/admin` until 2026-08-02; the root is Today now (ADR-0015). The
  `#edit=<id>` / `#new-writing` deep links came with it — a hash never reaches
  the server, so Today bounces them here client-side rather than 302ing and
  silently dropping the identifier.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import FragmentListPanel from '../../components/admin/FragmentListPanel.astro';
import TypeMark from '../../components/admin/TypeMark.astro';
import StarMark from '../../components/StarMark.astro';
import FragmentSheet from '../../components/admin/FragmentSheet.astro';
import SongSheet from '../../components/admin/SongSheet.astro';
import WritingSheet from '../../components/admin/WritingSheet.astro';
import { parseListParams, queryFragmentList } from '../../lib/fragment-query';
import { allFragmentPeople } from '../../lib/hq/links';

const supabase = Astro.locals.supabase;

// `?view=notes` was this room's third view until 2026-08-03 (14 · Piece 1).
// Brain dumps have their own room now, and a jotting rendered as a table row
// with an empty title column was the thing that made a note feel like a
// document it never was. Redirect rather than 404: the old URL is in browser
// history and on the old capture lab's header.
if (Astro.url.searchParams.get('view') === 'notes') return Astro.redirect('/admin/notes', 302);

const params = parseListParams(Astro.url.searchParams);
params.constellation = null; // pick-mode concern; never used here
const data = await queryFragmentList(supabase, params);
const view = params.view;
const subjectNames = data.allSubjects.map((s) => s.name);

/*
  THE SEAM (12 · Piece 3, §5). This room is corpus-side, and these two reads
  are the only HQ data on it — the roster for "Shared by", and the existing
  edges so opening a sheet needs no round trip.

  `?person=<slug>&new=quote` is the arrival from a profile's "Add a quote": the
  quote sheet opens already attributed to them, so a quote somebody said out
  loud enters the corpus AND attaches in one move. An unknown slug is ignored
  rather than 404ing — you came here to write a quote, and the worst outcome of
  a stale link should be an unattributed one, not a dead end.
*/
const [people, sharedBy] = await Promise.all([
  supabase.from('people').select('id, display_name').order('display_name'),
  allFragmentPeople(supabase),
]);

const personSlug = Astro.url.searchParams.get('person');
const linkPerson = personSlug
  ? (await supabase.from('people').select('id').eq('slug', personSlug).maybeSingle()).data
  : null;
const autoNew = linkPerson && Astro.url.searchParams.get('new') === 'quote' ? 'quote' : null;

const TITLES = { list: 'Fragments', trash: 'Trash' } as const;
const SUBTITLES = {
  list: undefined,
  trash:
    'Deleted fragments wait here until you empty them. Anything placed in a constellation leaves that suite while it sits in the trash.',
} as const;
---

<AdminLayout title={TITLES[view]} active="fragments">
  <div class="mx-auto max-w-5xl px-6 py-8">
    <PageHeader
      title={TITLES[view]}
      back={view === 'list' ? undefined : { href: '/admin/fragments', label: 'Fragments' }}
      subtitle={SUBTITLES[view]}
    >
      <Fragment slot="actions">
        {
          view === 'trash' ? (
            <button
              id="empty-trash"
              class="btn btn-outline btn-sm text-error gap-1.5 font-sans"
              disabled={data.rows.length === 0}
            >
              <Icon name="ph:trash" class="text-base" /> Empty trash
            </button>
          ) : (
            <>
              {view === 'list' && (
                <>
                  {/* No Notes button, and no `?view=notes` behind it — brain
                      dumps are a room in the sidebar now (14 · Piece 1). This
                      room is pieces: drafts and published, nothing else. */}
                  <a href="/admin/fragments?view=trash" class="btn btn-ghost btn-sm gap-1.5 font-sans">
                    <Icon name="ph:trash" />
                    Trash
                    <span id="trash-count" class="bg-base-300 text-muted rounded-full px-1.5 text-xs empty:hidden">
                      {data.trashCount || ''}
                    </span>
                  </a>
                </>
              )}
              <div class="relative">
                <button
                  id="add-btn"
                  class="btn btn-primary btn-sm gap-1 font-sans"
                  aria-haspopup="menu"
                  aria-expanded="false"
                >
                  <Icon name="ph:plus" /> Add <span aria-hidden="true">▾</span>
                </button>
                <div
                  id="add-menu"
                  hidden
                  role="menu"
                  aria-label="Add a fragment"
                  class="rounded-box border-base-300 bg-base-100 absolute right-0 z-30 mt-1 w-40 overflow-hidden border py-1 shadow-lg"
                >
                  {/* ⚠ NO "Note" ITEM. It opened a near-fullscreen sheet with a
                      title field for something that has no title — the exact
                      door 14 §2 was written to replace ("today a note costs
                      Add ▾ → Note"). The ✚ in the corner is the only way to
                      write one now, from any room. A piece can still be sent
                      DOWN to the pile: that is the bulk bar's "Make notes",
                      which is a demotion rather than a second front door. */}
                  {/* `w-3` on both marks, and it is load-bearing now that
                      writing has no glyph (TYPE_META, 2026-08-17): the mark is
                      a COLUMN here, not an inline character, so the two labels
                      keep a common left edge instead of "Writing" sliding a
                      quote-mark's width to the left of "Quote". */}
                  <button
                    data-new-writing
                    role="menuitem"
                    class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"
                  >
                    <TypeMark type="writing" class="w-3 text-center" /> Writing
                  </button>
                  <button
                    data-new="quote"
                    role="menuitem"
                    class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"
                  >
                    <TypeMark type="quote" class="w-3 text-center" /> Quote
                  </button>
                  {/* ⚠ NO SONG, AND ITS ABSENCE IS THE DECISION (ADR 0031). A
                      song enters the corpus from the ESSAY THAT WANTED IT —
                      the writing sheet's Music tab, where a pasted link
                      resolves and offers to create (plan 40). It used to enter
                      at /admin/listening in the same motion as the listening,
                      and that room is gone with the feelings it existed for. A "New
                      song" button on a management table is precisely the split
                      that ruling refuses: it would make a row first and a
                      decision about the music later, which is a queue of
                      obligations where there was an act of attention.

                      The other door is the writing sheet's Music tab, which
                      creates one from a pasted link. Both go through
                      `createSong` → `saveSong`, so they are two doors and not
                      two write paths. */}
                </div>
              </div>
            </>
          )
        }
      </Fragment>
    </PageHeader>

    <FragmentListPanel data={data} params={params} mode="manage" />
  </div>

  {/* Floating bulk-action bar (buttons rendered per view) */}
  <div id="bulkbar" class="bulkbar font-sans text-sm" data-view={view}>
    {/* nowrap: "7 selected · 0 shown here" is one fact, not two lines. */}
    <span id="bulkcount" class="text-muted whitespace-nowrap">0 selected</span>
    <div class="flex gap-1">
      {
        view === 'trash' ? (
          <>
            <button data-bulk="restore" class="btn btn-xs btn-ghost normal-case">
              Restore
            </button>
            <button data-bulk="purge" class="btn btn-xs btn-ghost text-error normal-case">
              Delete forever
            </button>
          </>
        ) : (
          <>
            {/* Elevate a selection into the sky — the bulk half of the
                fragment→constellation view (docs/admin.md §2). */}
            <div class="relative">
              <button
                id="bulk-cn-btn"
                class="btn btn-xs btn-ghost gap-1 normal-case"
                aria-haspopup="menu"
                aria-expanded="false"
              >
                <span class="text-primary">
                  <StarMark />
                </span>{' '}
                Constellation <span aria-hidden="true">▾</span>
              </button>
              <div
                id="bulk-cn-menu"
                hidden
                role="menu"
                aria-label="Add to or remove from a constellation"
                class="rounded-box border-base-300 bg-base-100 absolute bottom-full left-0 z-40 mb-1 max-h-96 w-96 overflow-y-auto border py-1 shadow-lg"
              >
                {/* The full description (4-line cap): you're about to elevate a
                    whole selection, so "what is this constellation for" should
                    be readable here, not hidden behind a hover. */}
                <p class="sec__k px-3 pt-1.5">Add to</p>
                {data.allConstellations.map((c) => (
                  <button role="menuitem" class="add-item block w-full px-3 py-2 text-left" data-cn-add={c.id}>
                    <span class="block truncate text-sm leading-snug">{c.name}</span>
                    {c.description && (
                      <span class="text-whisper mt-0.5 line-clamp-4 block text-xs leading-snug">{c.description}</span>
                    )}
                  </button>
                ))}
                <p id="bulk-cn-remove-label" class="sec__k border-base-300 mt-1 border-t px-3 pt-2" hidden>
                  Remove from
                </p>
                {data.allConstellations.map((c) => (
                  <button
                    role="menuitem"
                    hidden
                    class="add-item text-error/80 block w-full truncate px-3 py-1.5 text-left text-sm"
                    data-cn-remove={c.id}
                  >
                    {c.name}
                  </button>
                ))}
                {data.allConstellations.length === 0 && <p class="admin-hint px-3 py-2">No constellations yet.</p>}
              </div>
            </div>
            <button data-bulk="publish" class="btn btn-xs btn-ghost normal-case">
              Publish
            </button>
            <button data-bulk="draft" class="btn btn-xs btn-ghost normal-case">
              Unpublish
            </button>
            <button data-bulk="note" class="btn btn-xs btn-ghost normal-case">
              Make notes
            </button>
            <button data-bulk="trash" class="btn btn-xs btn-ghost text-error normal-case">
              Delete
            </button>
          </>
        )
      }
      {
        /* Clear sits apart from the actions, after a gap: the selection now
          survives a filter change, so "change the filter" has stopped being
          the way to empty it and there has to be a real control. It is not an
          action ON the selection, so it doesn't join the row of things that
          are. */
      }
      <button id="bulk-clear" class="btn btn-xs btn-ghost ml-2 normal-case">Clear</button>
    </div>
  </div>
  <p
    id="bulk-error"
    hidden
    role="alert"
    class="rounded-field border-error/40 bg-base-200 text-error fixed bottom-20 left-1/2 z-40 -translate-x-1/2 border px-3 py-1.5 font-sans text-xs shadow"
  >
  </p>

  <FragmentSheet
    subjects={subjectNames}
    authors={data.allAuthors.map((a) => ({ id: a.id, name: a.name }))}
    works={data.allWorks.map((w) => ({ id: w.id, title: w.title, authorId: w.author_id }))}
    constellations={data.allConstellations}
    people={people.data ?? []}
    sharedBy={sharedBy}
    linkPersonId={linkPerson?.id ?? null}
    autoNew={autoNew}
  />
  <WritingSheet subjects={subjectNames} constellations={data.allConstellations} />
  {
    /* ⚠ THE ONLY PLACE THIS SHEET IS MOUNTED, since /admin/listening was
      retired (plan 40 phase 2) — it used to be the second. A song
      row here opens THIS, through the `song:edit` seam in open-editor.ts — so
      the manager keeps LISTING songs, which is what search, trash and bulk
      publish are for, and stops EDITING them, which is what had two homes.

      That is what the paste bar living inside the sheet bought: a sheet with
      its own front door is mountable anywhere, where a page-level one would
      have forced either a second copy or a navigation out of the room. */
  }
  <SongSheet people={people.data ?? []} sharedBy={sharedBy} />

  <script>
    import '../../scripts/admin-list';
  </script>
</AdminLayout>

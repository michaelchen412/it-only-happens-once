<script>
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string) => Array.from(document.querySelectorAll<T>(s));

  const BL: Record<string, string> = {
    full: 'A real week. Past due is FIRST here — the opposite of Today, and consistent rather than contradictory: both rooms order by time, and arrears are chronologically first.',
    empty: 'Day one. Not a scold, and not an onboarding checklist.',
    editor: 'The two mechanics nobody has drawn. Change effort or priority and watch the lead date move; pick a schedule and read the next three occurrences.',
    goals: 'Intentions, not projects. Five is the cap. No progress bars anywhere — a direction cannot be 60% travelled.',
    goal: 'One goal, with the tasks under it and the only number it gets: what actually happened in the last 30 days.',
  };

  /* §3a. Effort decides WHEN; priority only bumps it up one bucket, and never
     down — hiding a warning is not a kindness. */
  const LEAD: Record<string, number> = { quick: 1, sitting: 3, block: 7, project: 21 };
  const ORDER = ['quick', 'sitting', 'block', 'project'];
  const DAYNAME = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];

  let surface = 'tasks';
  let state = 'full';
  let effort = 'sitting';
  let prio = 'normal';
  let rep = 'none';

  function ordinal(n: number) { const r = n % 100; return r >= 11 && r <= 13 ? `${n}th` : `${n}${['th', 'st', 'nd', 'rd'][n % 10] ?? 'th'}`; }
  function pretty(d: Date) { return `${DAYNAME[d.getDay()].slice(0, 3)}, ${d.toLocaleDateString('en-US', { month: 'short' })} ${ordinal(d.getDate())}`; }
  const iso = (d: Date) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;

  function dueDate(): Date {
    const v = $<HTMLInputElement>('[data-due]').value;
    const [y, m, d] = v.split('-').map(Number);
    return new Date(y, m - 1, d);
  }

  /* The whole point of the explainer: the rule is invisible machinery until it
     names a real date, and an invisible rule is one you fight instead of use. */
  function paintLead() {
    const base = LEAD[effort];
    const bumped = prio === 'high' ? LEAD[ORDER[Math.min(3, ORDER.indexOf(effort) + 1)]] : base;
    const override = $<HTMLInputElement>('[data-override-on]').checked;
    const n = Math.max(0, Number($<HTMLInputElement>('[data-override-n]').value) || 0);
    const lead = override ? n : bumped;

    const from = new Date(dueDate().getTime() - lead * 86400000);
    const today = new Date(new Date().setHours(0, 0, 0, 0));
    const days = `${lead} day${lead === 1 ? '' : 's'} ahead`;
    /* A lead that reaches back past today is the common case for a project, and
       naming a date that has already gone by reads as a bug. Say what is true
       instead: it is on Today already. */
    $('[data-lead-line]').innerHTML = from <= today
      ? `<strong>Already on Today</strong> — ${days}`
      : `On Today from <strong>${pretty(from)}</strong> — ${days}`;
  }

  /* You cannot verify FREQ=MONTHLY;BYDAY=3MO by reading it, so every schedule
     shows the next three dates it actually produces. That is the check. */
  function occurrences(kind: string, from: Date, n = 3): Date[] {
    const out: Date[] = [];
    const d = new Date(from);
    const push = (x: Date) => out.push(new Date(x));
    if (kind === 'daily') { for (let i = 0; i < n; i++) { push(d); d.setDate(d.getDate() + 1); } }
    else if (kind === 'weekly' || kind === 'biweekly') {
      const step = kind === 'weekly' ? 7 : 14;
      for (let i = 0; i < n; i++) { push(d); d.setDate(d.getDate() + step); }
    } else if (kind === 'weekdays') {
      while (out.length < n) { if (d.getDay() !== 0 && d.getDay() !== 6) push(d); d.setDate(d.getDate() + 1); }
    } else if (kind === 'monthly-date') {
      for (let i = 0; i < n; i++) { push(d); d.setMonth(d.getMonth() + 1); }
    } else if (kind === 'monthly-nth') {
      // the 3rd Monday of each month, starting with the month `from` is in
      let y = from.getFullYear(), m = from.getMonth();
      while (out.length < n) {
        const first = new Date(y, m, 1);
        const shift = (1 - first.getDay() + 7) % 7;          // to the first Monday
        const third = new Date(y, m, 1 + shift + 14);
        if (third >= from) push(third);
        m++; if (m > 11) { m = 0; y++; }
      }
    }
    return out;
  }
  const RRULE: Record<string, (d: Date) => string> = {
    daily: () => 'FREQ=DAILY',
    weekly: (d) => `FREQ=WEEKLY;BYDAY=${['SU','MO','TU','WE','TH','FR','SA'][d.getDay()]}`,
    biweekly: (d) => `FREQ=WEEKLY;INTERVAL=2;BYDAY=${['SU','MO','TU','WE','TH','FR','SA'][d.getDay()]}`,
    'monthly-date': (d) => `FREQ=MONTHLY;BYMONTHDAY=${d.getDate()}`,
    'monthly-nth': () => 'FREQ=MONTHLY;BYDAY=3MO',
    weekdays: () => 'FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR',
  };
  function paintRepeat() {
    $$('[data-rep-panel]').forEach((p) => (p.hidden = p.dataset.repPanel !== rep));
    if (rep !== 'fixed') return;
    const kind = $<HTMLSelectElement>('[data-rrule]').value;
    const d = dueDate();
    $('[data-prev]').textContent = 'Next: ' + occurrences(kind, d).map(pretty).join('  ·  ');
    const rr = $<HTMLElement>('[data-rrule-str]');
    rr.textContent = RRULE[kind](d);
    rr.hidden = !document.body.classList.contains('show-src');
  }

  function paint() {
    $$('[data-surface]').forEach((s) => s.classList.toggle('hidden', s.dataset.surface !== surface));
    $$('[data-state]').forEach((s) => s.classList.toggle('hidden', s.dataset.state !== state));
    $$<HTMLElement>('[data-tasks-only]').forEach((s) => (s.hidden = surface !== 'tasks'));
    $('#blurb').textContent = surface === 'tasks' ? BL[state] : BL[surface];
    $$<HTMLButtonElement>('[data-surf]').forEach((b) => {
      const hit = b.dataset.surf === surface;
      b.classList.toggle('btn-neutral', hit); b.classList.toggle('btn-ghost', !hit);
    });
    $$<HTMLButtonElement>('[data-st]').forEach((b) => {
      const hit = b.dataset.st === state;
      b.classList.toggle('btn-neutral', hit); b.classList.toggle('btn-ghost', !hit);
    });
  }

  $$<HTMLButtonElement>('[data-surf]').forEach((b) => b.addEventListener('click', () => { surface = b.dataset.surf!; paint(); }));
  $$<HTMLButtonElement>('[data-st]').forEach((b) => b.addEventListener('click', () => { state = b.dataset.st!; paint(); }));
  $$<HTMLElement>('[data-open-editor]').forEach((b) => b.addEventListener('click', () => { surface = 'editor'; paint(); window.scrollTo(0, 0); }));
  $$<HTMLElement>('[data-open-tasks]').forEach((b) => b.addEventListener('click', () => { surface = 'tasks'; paint(); window.scrollTo(0, 0); }));
  $$<HTMLElement>('[data-open-goals]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); surface = 'goals'; paint(); window.scrollTo(0, 0); }));
  $$<HTMLElement>('[data-open-goal]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); surface = 'goal'; paint(); window.scrollTo(0, 0); }));

  // One click ticks it off; it stays visible, struck through; the same click undoes.
  $$<HTMLButtonElement>('[data-tick]').forEach((b) => b.addEventListener('click', () => {
    b.closest('.task')!.classList.toggle('task--done');
  }));

  $$<HTMLButtonElement>('[data-effort]').forEach((b) => b.addEventListener('click', () => {
    effort = b.dataset.effort!;
    $$('[data-effort]').forEach((o) => o.classList.toggle('seg__b--on', o === b));
    paintLead();
  }));
  $$<HTMLButtonElement>('[data-prio]').forEach((b) => b.addEventListener('click', () => {
    prio = b.dataset.prio!;
    $$('[data-prio]').forEach((o) => o.classList.toggle('seg__b--on', o === b));
    paintLead();
  }));
  $<HTMLInputElement>('[data-override-on]').addEventListener('change', (e) => {
    $<HTMLInputElement>('[data-override-n]').disabled = !(e.target as HTMLInputElement).checked;
    paintLead();
  });
  $<HTMLInputElement>('[data-override-n]').addEventListener('input', paintLead);

  $$<HTMLButtonElement>('[data-rep]').forEach((b) => b.addEventListener('click', () => {
    rep = b.dataset.rep!;
    $$('[data-rep]').forEach((o) => o.classList.toggle('seg__b--on', o === b));
    paintRepeat();
  }));
  $$<HTMLButtonElement>('[data-u]').forEach((b) => b.addEventListener('click', () => {
    $$('[data-u]').forEach((o) => o.classList.toggle('seg__b--on', o === b));
  }));
  $<HTMLSelectElement>('[data-rrule]').addEventListener('change', paintRepeat);

  const time = $<HTMLInputElement>('[data-time]');
  const anytime = $<HTMLElement>('[data-anytime]');
  const syncTime = () => (anytime.hidden = !!time.value);
  time.addEventListener('input', syncTime);
  $<HTMLButtonElement>('[data-clear-time]').addEventListener('click', () => { time.value = ''; syncTime(); });
  $<HTMLInputElement>('[data-due]').addEventListener('input', () => { paintLead(); paintRepeat(); });

  $$<HTMLButtonElement>('[data-w]').forEach((b) => b.addEventListener('click', () => {
    const phone = b.dataset.w === 'phone';
    const frame = $('#frame');
    frame.classList.toggle('max-w-3xl', !phone);
    frame.style.maxWidth = phone ? '390px' : '';
    frame.classList.toggle('rounded-box', phone); frame.classList.toggle('border', phone); frame.classList.toggle('border-base-300', phone);
    $$<HTMLButtonElement>('[data-w]').forEach((o) => {
      const hit = o === b;
      o.classList.toggle('btn-neutral', hit); o.classList.toggle('btn-ghost', !hit);
    });
  }));

  const srcBtn = $<HTMLButtonElement>('#src-btn');
  srcBtn.addEventListener('click', () => {
    const active = document.body.classList.toggle('show-src');
    srcBtn.textContent = active ? 'Hide provenance' : 'Show provenance';
    srcBtn.classList.toggle('btn-neutral', active); srcBtn.classList.toggle('btn-ghost', !active);
    paintRepeat();
  });

  // The editor opens on a real date so every derived line has something to say.
  $<HTMLInputElement>('[data-due]').value = iso(new Date(Date.now() + 6 * 86400000));
  syncTime();
  paintLead();
  paintRepeat();
  paint();
</script>

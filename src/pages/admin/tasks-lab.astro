---
/*
  /admin/tasks-lab — a LOCAL-ONLY bench for the task manager and goals
  (docs/plans/13-agenda.md, Pieces 1 and 2). Dev-gated below; never linked.
  Deleted by the pieces it informs.

  This is the highest-risk surface in HQ (10-hq.md §11): recurrence with two
  modes, effort→lead, and disposition are all mechanics that read fine in prose
  and have never been drawn. Three of them are only judgeable by using them, so
  they are LIVE here:

    · the lead explainer   change effort or priority and watch the date move
    · the recurrence       pick a rule and read the next three occurrences
    · the tick             one click, stays visible, undoes

  FOUR SURFACES:
    TASKS   /admin/tasks              the inventory, ordered by when
    EDITOR  a sheet                   where effort→lead has to make sense
    GOALS   /admin/goals              five, capped, no progress bars
    GOAL    /admin/goals/[slug]       an intention with its tasks under it

  Static invented data, `data-src` on everything (10-hq.md §10g).
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

if (import.meta.env.PROD) return Astro.redirect('/admin', 302);

function ordinal(n: number) { const r = n % 100; return r >= 11 && r <= 13 ? `${n}th` : `${n}${['th','st','nd','rd'][n % 10] ?? 'th'}`; }
function dmd(d: Date) {
  const y = d.getFullYear() === new Date().getFullYear() ? '' : `/${String(d.getFullYear()).slice(2)}`;
  return `${d.getMonth() + 1}/${d.getDate()}${y} ${d.toLocaleDateString('en-US', { weekday: 'short' })}`;
}
function t12(hhmm: string) { const [h, m] = hhmm.split(':').map(Number); return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`; }
function fullDate(d: Date) { return `${d.toLocaleDateString('en-US', { weekday: 'long' })}, ${d.toLocaleDateString('en-US', { month: 'long' })} ${ordinal(d.getDate())}, ${d.getFullYear()}`; }
const day = (n: number) => new Date(new Date().setHours(0, 0, 0, 0) + n * 86400000);
const daysBetween = (a: Date, b: Date) => Math.round((b.getTime() - a.getTime()) / 86400000);

/* §3a. EFFORT DECIDES *WHEN*, PRIORITY DECIDES *HOW LOUD*. Surfacing an
   unimportant, large task two weeks early costs nothing; surfacing an important,
   tiny one two weeks early is noise for thirteen days. */
type Effort = 'quick' | 'sitting' | 'block' | 'project';
const EFFORT: { key: Effort; label: string; hint: string; lead: number; step: number }[] = [
  { key: 'quick',   label: 'Quick',   hint: 'under 15 minutes',   lead: 1,  step: 1 },
  { key: 'sitting', label: 'Sitting', hint: 'about an hour',      lead: 3,  step: 2 },
  { key: 'block',   label: 'Block',   hint: 'half a day or more', lead: 7,  step: 3 },
  { key: 'project', label: 'Project', hint: 'several sessions',   lead: 21, step: 4 },
];
const eff = (k: Effort) => EFFORT.find((e) => e.key === k)!;
type Priority = 'low' | 'normal' | 'high';
const PRIORITIES: { key: Priority; label: string }[] = [
  { key: 'low', label: 'Low' }, { key: 'normal', label: 'Normal' }, { key: 'high', label: 'High' },
];

interface Goal { slug: string; name: string; horizon: string; why: string; obs: string; cold?: boolean }
const GOALS: Goal[] = [
  { slug: 'sky', name: 'Finish the Sky', horizon: 'this season', obs: '4 tasks done in the last 30 days',
    why: 'The constellations are the only part of the site that is properly mine, and they have been three-quarters built for a year.' },
  { slug: 'family', name: 'See more of the family', horizon: 'this year', obs: '2 tasks done in the last 30 days',
    why: 'Portland is a two-hour flight and I manage it about once a year, which is not the relationship I want to have.' },
  { slug: 'shape', name: 'Get back in shape', horizon: 'this year', obs: 'nothing in 6 weeks', cold: true,
    why: 'Not a number on a scale. Being able to do the Tahoe hike in September without hating it.' },
];

interface Task {
  id: string; title: string; due: Date | null; time?: string;
  effort: Effort; priority: Priority; lead?: number;
  goal?: string; done?: boolean;
  repeat?: { mode: 'after_completion' | 'fixed'; words: string };
  drift?: string;   // the disposition payoff line (§4)
}
const TASKS: Task[] = [
  { id: 'dentist',  title: 'Rebook the dentist',     due: day(-4), effort: 'quick',   priority: 'normal' },
  { id: 'water',    title: 'Pay the water bill',     due: day(-2), effort: 'quick',   priority: 'high' },
  { id: 'recycle',  title: 'Take the recycling out', due: day(-1), effort: 'quick',   priority: 'low',
    repeat: { mode: 'after_completion', words: 'every week after I do it' } },
  { id: 'bank',     title: 'Call the bank',          due: day(0), time: '16:30', effort: 'quick', priority: 'high' },
  { id: 'plants',   title: 'Water the plants',       due: day(0), effort: 'quick',   priority: 'low',
    repeat: { mode: 'after_completion', words: 'every 3 days after I do it' } },
  { id: 'rent',     title: 'Rent',                   due: day(1), effort: 'quick',   priority: 'high',
    repeat: { mode: 'fixed', words: 'the 1st of every month' } },
  { id: 'essay',    title: 'Draft the Sky essay',    due: day(4), effort: 'block',    priority: 'normal', goal: 'sky' },
  { id: 'bathroom', title: 'Deep clean the bathroom', due: day(6), effort: 'sitting', priority: 'normal',
    repeat: { mode: 'after_completion', words: 'every 2 weeks after I do it' },
    drift: 'Skipped 4 of the last 6 — every 3 weeks instead?' },
  { id: 'flights',  title: 'Book the Portland flights', due: day(12), effort: 'sitting', priority: 'normal', goal: 'family' },
  { id: 'passport', title: 'Renew the passport',     due: day(42), effort: 'project',  priority: 'normal' },
  { id: 'bike',     title: 'Sort the bike out',      due: null,    effort: 'sitting',  priority: 'normal' },
  { id: 'shed',     title: 'Fix the shed door',      due: null,    effort: 'block',    priority: 'low' },
];

/* Grouped by WHEN, and past due is FIRST here — the opposite of Today
   (10-hq.md §10f), and consistent rather than contradictory: both rooms order
   by time, and arrears are chronologically first. Today is a summary you read
   forward; this room is where triage happens. */
const GROUPS = [
  { key: 'past',   title: 'Past due',    of: (t: Task) => t.due !== null && daysBetween(t.due, day(0)) > 0 },
  { key: 'today',  title: 'Today',       of: (t: Task) => t.due !== null && daysBetween(t.due, day(0)) === 0 },
  { key: 'week',   title: 'This week',   of: (t: Task) => t.due !== null && daysBetween(day(0), t.due) > 0 && daysBetween(day(0), t.due) <= 7 },
  { key: 'later',  title: 'Later',       of: (t: Task) => t.due !== null && daysBetween(day(0), t.due) > 7 },
  { key: 'none',   title: 'Unscheduled', of: (t: Task) => t.due === null },
];

const SUBJECT = GOALS[0];
const SUB_TASKS = TASKS.filter((t) => t.goal === 'sky');
const SUB_UNSCHED = [
  { title: 'Write the constellation copy' },
  { title: 'Decide what happens at zoom level 3' },
];
const SUB_DONE = [
  { title: 'Ship the zoom morph', on: day(-4) },
  { title: 'Seed four constellations', on: day(-11) },
  { title: 'Typeset the suite marks', on: day(-19) },
  { title: 'Pick the eight hues', on: day(-26) },
];
---

<AdminLayout title="Tasks lab">
  <div class="sticky top-0 z-30 mb-6 border-b border-warning/40 bg-warning/10 px-4 py-3 font-sans">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <span class="font-semibold">Tasks lab</span>
      <span class="flex flex-wrap items-center gap-1">
        <span class="admin-hint mr-1 text-xs">Surface</span>
        <button type="button" data-surf="tasks" class="btn btn-xs btn-neutral font-sans">Tasks</button>
        <button type="button" data-surf="editor" class="btn btn-xs btn-ghost font-sans">New task</button>
        <button type="button" data-surf="goals" class="btn btn-xs btn-ghost font-sans">Goals</button>
        <button type="button" data-surf="goal" class="btn btn-xs btn-ghost font-sans">One goal</button>
      </span>
      <span class="flex items-center gap-1" data-tasks-only>
        <span class="admin-hint mr-1 text-xs">State</span>
        <button type="button" data-st="full" class="btn btn-xs btn-neutral font-sans">A real week</button>
        <button type="button" data-st="empty" class="btn btn-xs btn-ghost font-sans">Empty</button>
      </span>
      <span class="flex items-center gap-1">
        <span class="admin-hint mr-1 text-xs">Width</span>
        <button type="button" data-w="wide" class="btn btn-xs btn-neutral font-sans">Desktop</button>
        <button type="button" data-w="phone" class="btn btn-xs btn-ghost font-sans">390px</button>
      </span>
      <button type="button" id="src-btn" class="btn btn-xs btn-ghost font-sans">Show provenance</button>
      <a href="/admin" class="admin-back ml-auto text-xs">← Observatory</a>
    </div>
    <p id="blurb" class="mx-auto mt-2 max-w-5xl text-xs text-base-content/60"></p>
  </div>

  <div id="frame" class="lab-cq mx-auto w-full max-w-3xl px-4 pb-28">

    {/* ══════════════════ SURFACE 1 · THE TASKS ══════════════════ */}
    <div data-surface="tasks">
      <header class="mb-5 flex flex-wrap items-center justify-between gap-3 pt-1">
        <h1 class="font-display text-2xl font-light">Tasks</h1>
        <button type="button" data-open-editor class="btn btn-sm gap-1 font-sans zone__cta cn-amber"><Icon name="ph:plus" /> New</button>
      </header>

      <section data-state="empty" class="hidden">
        <div class="rounded-box border border-dashed border-base-300 px-6 py-12 text-center">
          <p class="font-serif text-lg">Nothing to do.</p>
          <button type="button" data-open-editor class="btn btn-sm mt-4 gap-1 font-sans zone__cta cn-amber"><Icon name="ph:plus" /> Add the first</button>
        </div>
      </section>

      <section data-state="full">
        {GROUPS.map((g) => {
          const items = TASKS.filter(g.of);
          if (!items.length) return null;
          const past = g.key === 'past';
          return (
            <section class:list={['tgroup', past && 'tgroup--past']} data-group={g.key}>
              <h2 class="tgroup__k">
                {past && <Icon name="ph:warning" />}
                {g.title}
                <span class="tgroup__n">{items.length}</span>
              </h2>
              <ul>
                {items.map((t) => (
                  <li class:list={['task', `task--${t.priority}`]} data-task={t.id} data-src="tasks ⋈ task_events">
                    {/* One click, and it stays (10-hq.md §10f). NOT in past due:
                        there the choice IS the interaction, and a circle beside
                        a "Did it" chip is two paths to one outcome while saying
                        nothing about the other one. */}
                    {!past && (
                      <button type="button" class="tick" data-tick aria-label={`Mark "${t.title}" done`}>
                        <Icon name="ph:circle" class="tick__o" />
                        <Icon name="ph:check-circle" class="tick__x" />
                      </button>
                    )}
                    <span class="min-w-0 flex-1">
                      <span class="task__t">{t.title}</span>
                      <span class="task__m">
                        {past && <span class="task__late">{daysBetween(t.due!, day(0))} {daysBetween(t.due!, day(0)) === 1 ? 'day' : 'days'} late</span>}
                        {/* "anytime" earns its place ONLY in Today, where the
                            list is time-ordered and a missing time changes where
                            a row sits. Elsewhere the date already says it, and
                            printing it on six of eight rows is just noise. */}
                        {!past && t.due && g.key === 'today' && (
                          <button type="button" class="stamp" title={fullDate(t.due)}>
                            <Icon name="ph:clock-light" class="stamp__i" />
                            {t.time ? t12(t.time) : <em class="task__any">anytime</em>}
                          </button>
                        )}
                        {!past && t.due && g.key !== 'today' && (
                          <button type="button" class="stamp" title={fullDate(t.due)}>
                            <Icon name="ph:clock-light" class="stamp__i" />
                            {dmd(t.due)}{t.time ? ` · ${t12(t.time)}` : ''}
                          </button>
                        )}
                        {t.repeat && <span class="task__rep" data-src="tasks.recurrence — a RULE, never rows"><Icon name="ph:arrows-clockwise" /> {t.repeat.words}</span>}
                        {/* EFFORT IS ORDINAL, so it is drawn as a magnitude, not
                            a category: a four-step meter plus the word. Four
                            identical grey pills threw the ordering away and made
                            the field unscannable. No new hue — the ramp is the
                            agenda's own amber at four densities, so 10-hq §10a
                            still holds. */}
                        <span class:list={['eff', `eff--${t.effort}`]} data-src="tasks.effort → lead_days">
                          <span class="eff__m" aria-hidden="true">{[1,2,3,4].map((n) => <i class:list={[n <= eff(t.effort).step && 'on']} />)}</span>
                          {eff(t.effort).label}
                        </span>
                        {t.goal && <span class="task__goal" data-src="tasks.goal_id"><Icon name="ph:target" /> {GOALS.find((x) => x.slug === t.goal)!.name}</span>}
                      </span>
                      {t.drift && <button type="button" class="chip chip--suggest mt-1.5" data-src="task_events: 4 skipped of 6">{t.drift}</button>}
                    </span>
                    {past && (
                      <span class="flex shrink-0 gap-1">
                        <button type="button" class="chip chip--act chip--did" data-tick><Icon name="ph:check" /> Did it</button>
                        <button type="button" class="chip chip--act chip--skip"><Icon name="ph:skip-forward" /> Skipping it</button>
                      </span>
                    )}
                  </li>
                ))}
              </ul>
            </section>
          );
        })}
      </section>
    </div>

    {/* ══════════════════ SURFACE 2 · THE EDITOR ══════════════════
        The sheet where the two mechanics nobody has drawn have to make sense.
        Both are LIVE: change effort or priority and the lead sentence names a
        real date; pick a rule and the next three occurrences appear. */}
    <div data-surface="editor" class="hidden">
      <div class="sheet">
        <div class="sheet__head">
          <h2 class="font-display text-lg font-light">New task</h2>
          <button type="button" data-open-tasks class="zone__act" aria-label="Close"><Icon name="ph:x" /></button>
        </div>

        <div class="sheet__body">
          <label class="f">
            <span class="f__k">What</span>
            <input type="text" value="Deep clean the bathroom" data-src="tasks.title" />
          </label>
          <label class="f mt-3">
            <span class="f__k">Notes</span>
            <textarea rows="2" placeholder="Optional. Markdown." data-src="tasks.notes"></textarea>
          </label>

          <div class="fs">
            <p class="fs__k">When</p>
            <div class="flex flex-wrap items-end gap-2">
              <label class="f">
                <span class="f__k">Date</span>
                <input type="date" data-due data-src="tasks.due_on (a DATE — does not shift when you travel)" />
              </label>
              <label class="f">
                <span class="f__k">Time</span>
                <input type="time" data-time data-src="tasks.due_time — NULLABLE" />
              </label>
              <button type="button" class="btn btn-ghost btn-xs mb-1 font-sans" data-clear-time>Clear</button>
              {/* Nullable time is not a shrug (§3) — but the UI says it in one
                  word beside the field, not a paragraph under it. */}
              <span class="f__tag" data-anytime>anytime</span>
            </div>
          </div>

          <div class="fs">
            <div class="flex flex-wrap gap-x-8 gap-y-3">
              <div>
                <p class="fs__k">Effort</p>
                <div class="seg" data-src="tasks.effort">
                  {EFFORT.map((e) => (
                    <button type="button" class:list={['seg__b', e.key === 'sitting' && 'seg__b--on']} data-effort={e.key} title={e.hint}>{e.label}</button>
                  ))}
                </div>
              </div>
              <div>
                <p class="fs__k">Priority</p>
                <div class="seg" data-src="tasks.priority">
                  {PRIORITIES.map((p) => (
                    <button type="button" class:list={['seg__b', p.key === 'normal' && 'seg__b--on']} data-prio={p.key}>{p.label}</button>
                  ))}
                </div>
              </div>
            </div>

            {/* The lead rule is invisible machinery until it names a date. ONE
                line — the date. The paragraph that used to explain which rule
                fired was teaching, not interface. */}
            <div class="lead" data-src="derived: effort → lead_days, +1 bucket if high, lead_days overrides">
              <p class="lead__l"><Icon name="ph:calendar-blank" /> <span data-lead-line></span></p>
              <label class="lead__o">
                <input type="checkbox" data-override-on />
                <span>Warn me</span>
                <input type="text" inputmode="numeric" value="3" class="lead__n" data-override-n disabled />
                <span>days ahead instead</span>
              </label>
            </div>
          </div>

          <div class="fs">
            <p class="fs__k">Repeats</p>
            <div class="seg seg--wrap" data-src="tasks.recurrence jsonb">
              <button type="button" class="seg__b seg__b--on" data-rep="none">Doesn't repeat</button>
              <button type="button" class="seg__b" data-rep="after">After I do it</button>
              <button type="button" class="seg__b" data-rep="fixed">On a schedule</button>
            </div>

            <div class="mt-3" data-rep-panel="after" hidden>
              <div class="flex items-center gap-2">
                <span class="admin-hint text-xs">Every</span>
                <input type="text" inputmode="numeric" value="2" class="lead__n" data-every />
                <span class="seg" data-unit>
                  <button type="button" class="seg__b" data-u="days">days</button>
                  <button type="button" class="seg__b seg__b--on" data-u="weeks">weeks</button>
                  <button type="button" class="seg__b" data-u="months">months</button>
                </span>
                <span class="admin-hint text-xs">after I finish</span>
              </div>
              {/* This mode has no schedule to preview. One clause, not a lecture. */}
              <p class="prev prev--none">Counted from the day you tick it.</p>
            </div>

            <div class="mt-3" data-rep-panel="fixed" hidden>
              <select class="fsel" data-rrule data-src="RRULE (RFC 5545) — the language Google already speaks">
                <option value="daily">Every day</option>
                <option value="weekly" selected>Every week, on this weekday</option>
                <option value="biweekly">Every 2 weeks, on this weekday</option>
                <option value="monthly-date">Monthly, on this date</option>
                <option value="monthly-nth">Monthly, on the 3rd Monday</option>
                <option value="weekdays">Every weekday</option>
              </select>
              {/* You cannot verify FREQ=MONTHLY;BYDAY=3MO by reading it, so the
                  next three occurrences are the check. The RRULE string itself
                  is storage, not interface — it stays behind the provenance
                  toggle with every other column name. */}
              <p class="prev" data-prev></p>
              <p class="rrule" data-rrule-str hidden></p>
            </div>
          </div>

          <div class="fs">
            <p class="fs__k">Goal</p>
            <select class="fsel" data-src="tasks.goal_id — ON DELETE SET NULL">
              <option>— none —</option>
              {GOALS.map((g) => <option>{g.name}</option>)}
            </select>
          </div>
        </div>

        <div class="sheet__foot">
          <button type="button" data-open-tasks class="btn btn-ghost btn-sm font-sans">Cancel</button>
          <button type="button" data-open-tasks class="btn btn-sm font-sans zone__cta cn-amber">Add task</button>
        </div>
      </div>
    </div>

    {/* ══════════════════ SURFACE 3 · GOALS ══════════════════
        An intention, not a project (§4a). No progress bar, no percent, no
        subtask count — a goal is not 60% done, and saying it is would be both
        false and a guilt engine. */}
    <div data-surface="goals" class="hidden">
      <header class="mb-5 flex flex-wrap items-center justify-between gap-3 pt-1">
        <h1 class="font-display text-2xl font-light">Goals</h1>
        <div class="flex items-center gap-3">
          <span class="admin-hint text-xs" data-src="count(goals where status='active') — cap 5, enforced in the action">{GOALS.length} of 5 active</span>
          <button type="button" class="btn btn-sm gap-1 font-sans zone__cta cn-amber"><Icon name="ph:plus" /> New</button>
        </div>
      </header>

      <div class="ggrid">
        {GOALS.map((g) => (
          <a href="#" data-open-goal class="gcard" data-src="goals ⋈ count(task_events last 30d)">
            <span class="gcard__k"><Icon name="ph:target" /> {g.horizon}</span>
            <span class="gcard__n">{g.name}</span>
            <span class:list={['gcard__o', g.cold && 'gcard__o--cold']}>{g.obs}</span>
          </a>
        ))}
      </div>

      <section class="mt-8">
        <h2 class="admin-label mb-2">Not active <span class="opacity-50">1</span></h2>
        <ul class="zone__list rounded-box border border-base-300">
          <li class="row" data-src="goals.status = 'let_go'">
            <span class="row__mark"><Icon name="ph:target" /></span>
            <span class="min-w-0 flex-1"><span class="text-sm">Learn to solder properly</span></span>
            <span class="chip chip--soon shrink-0">Let go · March</span>
          </li>
        </ul>
      </section>
    </div>

    {/* ══════════════════ SURFACE 4 · ONE GOAL ══════════════════ */}
    <div data-surface="goal" class="hidden">
      <a href="#" data-open-goals class="admin-back mb-3 inline-flex"><span aria-hidden="true">←</span> Goals</a>

      <header class="ghead">
        <div class="min-w-0 flex-1">
          <p class="ghead__k"><Icon name="ph:target" /> {SUBJECT.horizon}</p>
          <h1 class="font-display text-3xl font-light">{SUBJECT.name}</h1>
          <p class="mt-2 max-w-xl font-serif text-base leading-relaxed text-base-content/75" data-src="goals.why (Markdown)">{SUBJECT.why}</p>
          {/* The one number a goal gets, and it is an observation rather than a
              score: "am I actually spending time on what I said mattered?" */}
          <p class="ghead__o" data-src="count(task_events where outcome='done' and task.goal_id = … in the last 30 days)">{SUBJECT.obs}</p>
        </div>
        <div class="flex shrink-0 items-center gap-1">
          <span class="seg" data-src="goals.status">
            <button type="button" class="seg__b seg__b--on">Active</button>
            <button type="button" class="seg__b">Paused</button>
            <button type="button" class="seg__b">Achieved</button>
            <button type="button" class="seg__b">Let go</button>
          </span>
          <button type="button" class="zone__act" aria-label="Edit this goal"><Icon name="ph:pencil-simple" /></button>
        </div>
      </header>

      <div class="lab-grid mt-6">
        <div class="col-main">
          <section class="zone cn-amber o-1">
            <div class="zone__head">
              <span class="zone__chip"><Icon name="ph:calendar-blank" /></span>
              <h2 class="zone__title">Scheduled</h2>
              <span class="zone__count ml-auto">{SUB_TASKS.length}</span>
            </div>
            <ul class="zone__list pb-2">
              {SUB_TASKS.map((t) => (
                <li class="task" data-src="tasks where goal_id = … and due_on is not null">
                  <button type="button" class="tick" data-tick aria-label={`Mark "${t.title}" done`}>
                    <Icon name="ph:circle" class="tick__o" /><Icon name="ph:check-circle" class="tick__x" />
                  </button>
                  <span class="min-w-0 flex-1">
                    <span class="task__t">{t.title}</span>
                    <span class="task__m"><button type="button" class="stamp"><Icon name="ph:clock-light" class="stamp__i" />{dmd(t.due!)}</button><span class="task__eff">Block</span></span>
                  </span>
                </li>
              ))}
            </ul>
          </section>

          <section class="zone cn-sand o-2">
            <div class="zone__head">
              <span class="zone__chip"><Icon name="ph:dots-three" /></span>
              <h2 class="zone__title">Not scheduled yet</h2>
              <span class="zone__count ml-auto">{SUB_UNSCHED.length}</span>
              <button type="button" class="zone__act ml-1" aria-label="Add a task to this goal"><Icon name="ph:plus" /></button>
            </div>
            <ul class="zone__list pb-2">
              {SUB_UNSCHED.map((t) => (
                <li class="task" data-src="tasks where goal_id = … and due_on is null">
                  <button type="button" class="tick" data-tick aria-label={`Mark "${t.title}" done`}>
                    <Icon name="ph:circle" class="tick__o" /><Icon name="ph:check-circle" class="tick__x" />
                  </button>
                  <span class="min-w-0 flex-1"><span class="task__t">{t.title}</span></span>
                  <button type="button" class="chip chip--suggest shrink-0">Give it a date</button>
                </li>
              ))}
            </ul>
          </section>
        </div>

        <div class="col-rail">
          <section class="zone cn-ice o-3">
            <div class="zone__head">
              <span class="zone__chip"><Icon name="ph:check-circle" /></span>
              <h2 class="zone__title">Done toward this</h2>
            </div>
            <ul class="zone__list pb-2">
              {SUB_DONE.map((t) => (
                <li class="row" data-src="task_events ⋈ tasks">
                  <span class="row__mark"><Icon name="ph:check-circle" /></span>
                  <span class="min-w-0 flex-1"><span class="text-sm line-through opacity-70">{t.title}</span></span>
                  <span class="admin-hint shrink-0 text-xs">{dmd(t.on)}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>


---
/*
  /admin/tasks-lab — a LOCAL-ONLY bench for GOALS (docs/plans/13-agenda.md,
  Piece 2). Dev-gated below; never linked.

  ⚠ HALF OF THIS LAB IS GONE. It was built for Pieces 1 and 2 together, and
  Piece 1 shipped on 2026-08-03 — so the Tasks list and the task editor were
  deleted with it, per the rule that a piece deletes its lab. What survives is
  the two surfaces Piece 2 still has to build against: the goals room and one
  goal's page. The real task list is now `/admin/tasks`, and the real editor is
  `src/components/admin/TaskSheet.astro`.

  What the deleted half caught, kept here because the lessons outlived it:
  `:hover` beating the selected state (trap 6); "1 days late"; `anytime`
  printed on six rows in eight; and a lead date in the past presented as a
  future one. All four are now assertions — in `src/tests/hq-tasks.test.ts` and
  `tests/e2e/tasks.spec.ts`.

  Static invented data, `data-src` on everything (10-hq.md §10g).
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

if (import.meta.env.PROD) return Astro.redirect('/admin', 302);

function dmd(d: Date) {
  const y = d.getFullYear() === new Date().getFullYear() ? '' : `/${String(d.getFullYear()).slice(2)}`;
  return `${d.getMonth() + 1}/${d.getDate()}${y} ${d.toLocaleDateString('en-US', { weekday: 'short' })}`;
}
const day = (n: number) => new Date(new Date().setHours(0, 0, 0, 0) + n * 86400000);

interface Goal { slug: string; name: string; horizon: string; why: string; obs: string; cold?: boolean }
const GOALS: Goal[] = [
  { slug: 'sky', name: 'Finish the Sky', horizon: 'this season', obs: '4 tasks done in the last 30 days',
    why: 'The constellations are the only part of the site that is properly mine, and they have been three-quarters built for a year.' },
  { slug: 'family', name: 'See more of the family', horizon: 'this year', obs: '2 tasks done in the last 30 days',
    why: 'Portland is a two-hour flight and I manage it about once a year, which is not the relationship I want to have.' },
  { slug: 'shape', name: 'Get back in shape', horizon: 'this year', obs: 'nothing in 6 weeks', cold: true,
    why: 'Not a number on a scale. Being able to do the Tahoe hike in September without hating it.' },
];

const SUBJECT = GOALS[0];
const SUB_TASKS = [{ title: 'Draft the Sky essay', due: day(4), effort: 'Block' }];
const SUB_UNSCHED = [
  { title: 'Write the constellation copy' },
  { title: 'Decide what happens at zoom level 3' },
];
const SUB_DONE = [
  { title: 'Ship the zoom morph', on: day(-4) },
  { title: 'Seed four constellations', on: day(-11) },
  { title: 'Typeset the suite marks', on: day(-19) },
  { title: 'Pick the eight hues', on: day(-26) },
];
---

<AdminLayout title="Goals lab">
  <div class="sticky top-0 z-30 mb-6 border-b border-warning/40 bg-warning/10 px-4 py-3 font-sans">
    <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <span class="font-semibold">Goals lab</span>
      <span class="flex flex-wrap items-center gap-1">
        <span class="admin-hint mr-1 text-xs">Surface</span>
        <button type="button" data-surf="goals" class="btn btn-xs btn-neutral font-sans">Goals</button>
        <button type="button" data-surf="goal" class="btn btn-xs btn-ghost font-sans">One goal</button>
      </span>
      <span class="flex items-center gap-1">
        <span class="admin-hint mr-1 text-xs">Width</span>
        <button type="button" data-w="wide" class="btn btn-xs btn-neutral font-sans">Desktop</button>
        <button type="button" data-w="phone" class="btn btn-xs btn-ghost font-sans">390px</button>
      </span>
      <button type="button" id="src-btn" class="btn btn-xs btn-ghost font-sans">Show provenance</button>
      <a href="/admin/tasks" class="admin-back ml-auto text-xs">← Tasks</a>
    </div>
    <p id="blurb" class="mx-auto mt-2 max-w-5xl text-xs text-base-content/60"></p>
  </div>

  <div id="frame" class="lab-cq mx-auto w-full max-w-3xl px-4 pb-28">

    {/* ══════════════════ SURFACE 1 · GOALS ══════════════════
        An intention, not a project (§4a). No progress bar, no percent, no
        subtask count — a goal is not 60% done, and saying it is would be both
        false and a guilt engine. */}
    <div data-surface="goals">
      <header class="mb-5 flex flex-wrap items-center justify-between gap-3 pt-1">
        <h1 class="font-display text-2xl font-light">Goals</h1>
        <div class="flex items-center gap-3">
          <span class="admin-hint text-xs" data-src="count(goals where status='active') — cap 5, enforced in the action">{GOALS.length} of 5 active</span>
          <button type="button" class="btn btn-sm gap-1 font-sans zone__cta cn-amber"><Icon name="ph:plus" /> New</button>
        </div>
      </header>

      <div class="ggrid">
        {GOALS.map((g) => (
          <a href="#" data-open-goal class="gcard" data-src="goals ⋈ count(task_events last 30d)">
            <span class="gcard__k"><Icon name="ph:target" /> {g.horizon}</span>
            <span class="gcard__n">{g.name}</span>
            <span class:list={['gcard__o', g.cold && 'gcard__o--cold']}>{g.obs}</span>
          </a>
        ))}
      </div>

      <section class="mt-8">
        <h2 class="admin-label mb-2">Not active <span class="opacity-50">1</span></h2>
        <ul class="zone__list rounded-box border border-base-300">
          <li class="row" data-src="goals.status = 'let_go'">
            <span class="row__mark"><Icon name="ph:target" /></span>
            <span class="min-w-0 flex-1"><span class="text-sm">Learn to solder properly</span></span>
            <span class="chip chip--soon shrink-0">Let go · March</span>
          </li>
        </ul>
      </section>
    </div>

    {/* ══════════════════ SURFACE 2 · ONE GOAL ══════════════════ */}
    <div data-surface="goal" class="hidden">
      <a href="#" data-open-goals class="admin-back mb-3 inline-flex"><span aria-hidden="true">←</span> Goals</a>

      <header class="ghead">
        <div class="min-w-0 flex-1">
          <p class="ghead__k"><Icon name="ph:target" /> {SUBJECT.horizon}</p>
          <h1 class="font-display text-3xl font-light">{SUBJECT.name}</h1>
          <p class="mt-2 max-w-xl font-serif text-base leading-relaxed text-base-content/75" data-src="goals.why (Markdown)">{SUBJECT.why}</p>
          {/* The one number a goal gets, and it is an observation rather than a
              score: "am I actually spending time on what I said mattered?" */}
          <p class="ghead__o" data-src="count(task_events where outcome='done' and task.goal_id = … in the last 30 days)">{SUBJECT.obs}</p>
        </div>
        <div class="flex shrink-0 items-center gap-1">
          <span class="seg" data-src="goals.status">
            <button type="button" class="seg__b seg__b--on">Active</button>
            <button type="button" class="seg__b">Paused</button>
            <button type="button" class="seg__b">Achieved</button>
            <button type="button" class="seg__b">Let go</button>
          </span>
          <button type="button" class="zone__act" aria-label="Edit this goal"><Icon name="ph:pencil-simple" /></button>
        </div>
      </header>

      <div class="lab-grid mt-6">
        <div class="col-main">
          <section class="zone cn-amber o-1">
            <div class="zone__head">
              <span class="zone__chip"><Icon name="ph:calendar-blank" /></span>
              <h2 class="zone__title">Scheduled</h2>
              <span class="zone__count ml-auto">{SUB_TASKS.length}</span>
            </div>
            <ul class="zone__list pb-2">
              {SUB_TASKS.map((t) => (
                <li class="task" data-src="tasks where goal_id = … and due_on is not null">
                  <button type="button" class="tick" data-tick aria-label={`Mark "${t.title}" done`}>
                    <Icon name="ph:circle" class="tick__o" /><Icon name="ph:check-circle" class="tick__x" />
                  </button>
                  <span class="min-w-0 flex-1">
                    <span class="task__t">{t.title}</span>
                    <span class="task__m"><span class="stamp">{dmd(t.due)}</span><span class="eff eff--block">{t.effort}</span></span>
                  </span>
                </li>
              ))}
            </ul>
          </section>

          <section class="zone cn-sand o-2">
            <div class="zone__head">
              <span class="zone__chip"><Icon name="ph:dots-three" /></span>
              <h2 class="zone__title">Not scheduled yet</h2>
              <span class="zone__count ml-auto">{SUB_UNSCHED.length}</span>
              <button type="button" class="zone__act ml-1" aria-label="Add a task to this goal"><Icon name="ph:plus" /></button>
            </div>
            <ul class="zone__list pb-2">
              {SUB_UNSCHED.map((t) => (
                <li class="task" data-src="tasks where goal_id = … and due_on is null">
                  <button type="button" class="tick" data-tick aria-label={`Mark "${t.title}" done`}>
                    <Icon name="ph:circle" class="tick__o" /><Icon name="ph:check-circle" class="tick__x" />
                  </button>
                  <span class="min-w-0 flex-1"><span class="task__t">{t.title}</span></span>
                  <button type="button" class="chip chip--suggest shrink-0">Give it a date</button>
                </li>
              ))}
            </ul>
          </section>
        </div>

        <div class="col-rail">
          <section class="zone cn-ice o-3">
            <div class="zone__head">
              <span class="zone__chip"><Icon name="ph:check-circle" /></span>
              <h2 class="zone__title">Done toward this</h2>
            </div>
            <ul class="zone__list pb-2">
              {SUB_DONE.map((t) => (
                <li class="row" data-src="task_events ⋈ tasks">
                  <span class="row__mark"><Icon name="ph:check-circle" /></span>
                  <span class="min-w-0 flex-1"><span class="text-sm line-through opacity-70">{t.title}</span></span>
                  <span class="admin-hint shrink-0 text-xs">{dmd(t.on)}</span>
                </li>
              ))}
            </ul>
          </section>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  .lab-cq { container-type: inline-size; }
  .lab-grid { display: flex; flex-direction: column; gap: 1.25rem; }
  .col-main, .col-rail { display: contents; }
  .o-1 { order: 1 } .o-2 { order: 2 } .o-3 { order: 3 }
  @container (min-width: 46rem) {
    .lab-grid { flex-direction: row; align-items: flex-start; }
    .col-main, .col-rail { display: flex; flex-direction: column; gap: 1.25rem; min-width: 0; }
    .col-main { flex: 1.5 1 0; } .col-rail { flex: 1 1 0; }
    .o-1, .o-2, .o-3 { order: 0 }
  }

  /* `.zone`, `.row`, `.chip`, `.stamp`, `.task`, `.tick` and `.eff` all live in
     app.css now — the first four graduated with 11 · Piece 0b, the last three
     with 13 · Piece 1. What is left below is the goals-only vocabulary, which
     is what Piece 2 will decide whether to graduate. */
  .chip--soon { background: var(--color-base-200); color: color-mix(in oklch, var(--color-base-content) 62%, transparent); border-color: var(--color-base-300); }
  .chip--suggest { cursor: pointer; background: transparent; color: color-mix(in oklch, var(--color-base-content) 62%, transparent); border: 1px dashed var(--color-base-300); }
  .chip--suggest:hover { background: var(--color-base-200); color: var(--color-base-content); }

  .seg { display: inline-flex; border: 1px solid var(--color-base-300); border-radius: var(--radius-field, 0.5rem); overflow: hidden; }
  .seg__b { cursor: pointer; padding: 0.3125rem 0.6875rem; font-family: var(--font-sans); font-size: 0.8125rem; white-space: nowrap; }
  .seg__b + .seg__b { border-left: 1px solid var(--color-base-300); }
  .seg__b:hover { background: var(--color-base-200); }
  /* TRAP 6: AFTER :hover, with its own hover rule. */
  .seg__b--on, .seg__b--on:hover { background: var(--color-primary); color: var(--color-primary-content); }
  .seg__b--on:hover { filter: brightness(1.08); }

  .ggrid { display: grid; gap: 0.75rem; grid-template-columns: 1fr; }
  @container (min-width: 34rem) { .ggrid { grid-template-columns: 1fr 1fr; } }
  .gcard { display: block; border: 1px solid var(--color-base-300); border-radius: var(--radius-box); background: var(--color-base-100); padding: 0.875rem; cursor: pointer; transition: background-color 0.12s, border-color 0.12s; }
  .gcard:hover { background: var(--color-base-200); border-color: color-mix(in oklch, var(--color-warning) 40%, var(--color-base-300)); }
  .gcard__k { display: flex; align-items: center; gap: 0.3125rem; font-family: var(--font-sans); font-size: 0.625rem; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in oklch, var(--color-base-content) 42%, transparent); }
  .gcard__n { display: block; margin-top: 0.25rem; font-family: var(--font-display, serif); font-size: 1.25rem; line-height: 1.25; font-weight: 300; }
  .gcard__o { display: block; margin-top: 0.5rem; font-family: var(--font-sans); font-size: 0.75rem; color: color-mix(in oklch, var(--color-base-content) 58%, transparent); }
  /* A cold goal reads QUIETER, not redder. It is an observation, not a verdict. */
  .gcard__o--cold { font-style: italic; color: color-mix(in oklch, var(--color-base-content) 40%, transparent); }

  .ghead { display: flex; flex-wrap: wrap; gap: 1rem; align-items: flex-start; }
  .ghead__k { display: flex; align-items: center; gap: 0.3125rem; font-family: var(--font-sans); font-size: 0.625rem; letter-spacing: 0.07em; text-transform: uppercase; color: color-mix(in oklch, var(--color-base-content) 42%, transparent); margin-bottom: 0.25rem; }
  .ghead__o { margin-top: 0.75rem; font-family: var(--font-sans); font-size: 0.8125rem; color: color-mix(in oklch, var(--color-base-content) 62%, transparent); }

  body.show-src [data-src] { outline: 1px dashed color-mix(in oklch, var(--color-info) 55%, transparent); outline-offset: 2px; position: relative; }
  body.show-src [data-src]::after { content: attr(data-src); position: absolute; left: 0; top: 100%; z-index: 10; margin-top: 2px; padding: 1px 5px; border-radius: 3px; font-family: ui-monospace, monospace; font-size: 9px; line-height: 1.5; white-space: nowrap; background: var(--color-info); color: var(--color-info-content); pointer-events: none; }
</style>

<script>
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string) => Array.from(document.querySelectorAll<T>(s));

  const BL: Record<string, string> = {
    goals: 'Intentions, not projects. Five is the cap. No progress bars anywhere — a direction cannot be 60% travelled.',
    goal: 'One goal, with the tasks under it and the only number it gets: what actually happened in the last 30 days.',
  };

  let surface = 'goals';

  function paint() {
    $$('[data-surface]').forEach((s) => s.classList.toggle('hidden', s.dataset.surface !== surface));
    $('#blurb').textContent = BL[surface];
    $$<HTMLButtonElement>('[data-surf]').forEach((b) => {
      const hit = b.dataset.surf === surface;
      b.classList.toggle('btn-neutral', hit); b.classList.toggle('btn-ghost', !hit);
    });
  }

  $$<HTMLButtonElement>('[data-surf]').forEach((b) => b.addEventListener('click', () => { surface = b.dataset.surf!; paint(); }));
  $$<HTMLElement>('[data-open-goals]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); surface = 'goals'; paint(); window.scrollTo(0, 0); }));
  $$<HTMLElement>('[data-open-goal]').forEach((b) => b.addEventListener('click', (e) => { e.preventDefault(); surface = 'goal'; paint(); window.scrollTo(0, 0); }));

  $$<HTMLButtonElement>('[data-tick]').forEach((b) => b.addEventListener('click', () => {
    b.closest('.task')!.classList.toggle('task--done');
  }));

  $$<HTMLButtonElement>('[data-w]').forEach((b) => b.addEventListener('click', () => {
    const phone = b.dataset.w === 'phone';
    const frame = $('#frame');
    frame.classList.toggle('max-w-3xl', !phone);
    frame.style.maxWidth = phone ? '390px' : '';
    frame.classList.toggle('rounded-box', phone); frame.classList.toggle('border', phone); frame.classList.toggle('border-base-300', phone);
    $$<HTMLButtonElement>('[data-w]').forEach((o) => {
      const hit = o === b;
      o.classList.toggle('btn-neutral', hit); o.classList.toggle('btn-ghost', !hit);
    });
  }));

  const srcBtn = $<HTMLButtonElement>('#src-btn');
  srcBtn.addEventListener('click', () => {
    const active = document.body.classList.toggle('show-src');
    srcBtn.textContent = active ? 'Hide provenance' : 'Show provenance';
    srcBtn.classList.toggle('btn-neutral', active); srcBtn.classList.toggle('btn-ghost', !active);
  });

  paint();
</script>

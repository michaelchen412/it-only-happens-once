---
/*
  /admin/about — the About page builder (docs/admin.md). A dedicated, per-section
  editor for the `about` singleton in the `pages` table. The page is two co-equal
  movements: WHO I AM (me) and WHAT THIS IS (site), plus an optional contact line.
  Each movement has its own rich-text body (the shared TipTap editor supports
  multiple instances). Always live; saved deliberately (no autosave).

  ⚠ THREE CONTROLS WERE REMOVED HERE — ADR-0020, 2026-08-07: the "My Interests"
  repeater (an InterestRow list, a "+ Add" button and a clone <template>), the
  "Headline" input, and the "Thesis — the large opening statement" textarea. The
  reasoning is on the public page (`src/pages/about.astro`) and in the ADR; the
  reason it matters HERE is that an empty field in an editor is a standing
  invitation. "Thesis — the large opening statement" is a sentence that asks to be
  filled in, and leaving it while intending never to use it was the rejected
  alternative: a decision not recorded in the schema is a decision that gets
  re-made.
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import EditorToolbar from '../../components/admin/EditorToolbar.astro';
import LinkDialog from '../../components/admin/LinkDialog.astro';
import MiniEditor from '../../components/admin/MiniEditor.astro';
import { Icon } from 'astro-icon/components';
import { jsonForScript } from '../../lib/serialize';

const supabase = Astro.locals.supabase;
const { data: page } = await supabase.from('pages').select('content').eq('slug', 'about').single();

const c = (page?.content ?? {}) as {
  me?: {
    portrait?: string | null;
    portrait_caption?: string;
    body?: string;
  };
  site?: { body?: string; name?: { blurb?: string; spotify_url?: string } };
  contact?: { intro?: string };
};
const me = c.me ?? {};
const site = c.site ?? {};
const siteName = site.name ?? {};
const contact = c.contact ?? {};

const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL;
const portraitPath = me.portrait ?? '';
const portraitUrl = portraitPath ? `${SUPABASE_URL}/storage/v1/object/public/site/${portraitPath}` : '';

const aboutInit = {
  meBody: me.body ?? '',
  siteBody: site.body ?? '',
  // Two more since plan 43: the blurb and the contact intro are mini editors
  // now, and this is already how this page hands server values to its editors.
  blurb: siteName.blurb ?? '',
  contactIntro: contact.intro ?? '',
};

/* ⚠ THREE PAGE-LOCAL STYLE CONSTANTS USED TO LIVE HERE — `input`, `fieldLabel`
   and `groupLabel` — and they were a whole fourth form system, declared in one
   page, matching neither of the two the admin already had. ADR 0033 deleted
   them: the fields are `.f` / `.f__k` and the movement headings are `.fs__k`,
   like every other form in the building.

   Worth knowing WHY they appeared, because it is the argument for having one
   grammar rather than a note about tidiness: this page was written when the
   admin offered two precedents and no rule, so picking either was a coin-flip
   and inventing a third was the cheapest way to stop thinking about it. That is
   also how `SongSheet` grew a fifth. A single answer is what stops the next
   page doing it again. */
---

<AdminLayout title="About page" active="about">
  <div class="flex min-h-[calc(100vh-3.5rem)] flex-col">
    {/* Command bar */}
    <div class="border-base-300 bg-base-100/95 sticky top-14 z-10 border-b px-6 py-2 backdrop-blur md:top-0">
      <div class="mx-auto flex max-w-2xl items-center gap-3">
        {
          /* The <span> was the room's only title and carried no heading
            semantics, so this page measured zero headings of any level. It is
            an <h1> now: same styling, same position, nothing visual changes —
            Tailwind preflight already zeroes a heading's margin, size and
            weight, so the utilities below still decide everything. Visible
            rather than `sr-only` (unlike Today) because there is a real title
            on screen here; the rule is to promote the words that are already
            doing the job, and only invent hidden ones where none exist. */
        }
        <h1 class="font-display text-lg">About page</h1>
        <div
          id="about-status"
          class="text-base-content/55 ml-auto flex items-center gap-2 font-sans text-xs"
          aria-live="polite"
        >
          <span id="about-spinner" hidden class="loading loading-spinner loading-xs"></span>
          <span id="about-status-text">Edit and save</span>
        </div>
        <a href="/about" target="_blank" class="btn btn-ghost btn-sm normal-case">View ↗</a>
        <button type="button" id="save-about" class="btn btn-primary btn-sm normal-case" disabled>Save</button>
      </div>
    </div>

    <form id="about-form" class="mx-auto w-full max-w-2xl flex-1 px-6 py-10">
      <p id="about-error" hidden role="alert" class="admin-alert mb-4"></p>

      {/* ─────────────  MOVEMENT I — WHO I AM  ───────────── */}
      <section class="space-y-6">
        <div>
          <p class="fs__k"><span class="text-primary" aria-hidden="true">✦</span> Who I am</p>
          <p class="text-base-content/45 mt-1 font-sans text-xs">
            The person. Weave your heritage and origin into the prose — no facts row.
          </p>
        </div>

        <div class="space-y-2">
          <span class="f__k">Portrait <span>— one photo (optional)</span></span>
          <div class="flex items-center gap-4">
            <div
              class="rounded-box border-base-300 bg-base-200 flex h-24 w-24 shrink-0 items-center justify-center overflow-hidden border"
            >
              <img
                id="portrait-preview"
                src={portraitUrl}
                alt=""
                class:list={['h-full w-full object-cover', portraitUrl ? '' : 'hidden']}
              />
              <Icon
                id="portrait-placeholder"
                name="ph:image"
                class:list={['text-base-content/30 text-2xl', portraitUrl ? 'hidden' : '']}
              />
            </div>
            <div class="flex flex-col gap-2 font-sans text-sm">
              <label class="btn btn-outline btn-sm w-fit normal-case">
                Upload…
                <input id="portrait-input" type="file" accept="image/*" class="hidden" />
              </label>
              <button
                type="button"
                id="portrait-remove"
                class:list={[
                  'text-base-content/50 hover:text-error w-fit text-left text-xs',
                  portraitUrl ? '' : 'hidden',
                ]}>Remove photo</button
              >
            </div>
          </div>
          <input type="hidden" id="portrait-path" value={portraitPath} />
        </div>

        <div class="f">
          <label for="f-portrait-caption" class="f__k"
            >Photo caption <span>(optional — a place, a date, a moment)</span></label
          >
          <input
            id="f-portrait-caption"
            type="text"
            placeholder="New York City · 2024"
            value={me.portrait_caption ?? ''}
          />
        </div>

        <div class="f">
          <label class="f__k">Your story <span>(the main identity prose)</span></label>
          <div class="rounded-box border-base-300 border" data-editor="me">
            <EditorToolbar class="border-base-300 border-b px-3 py-1.5" />
            {
              /* min-h: these two hold long prose, so they open at a page's
                height rather than growing from one line. Stated here since
                `.tiptap-doc` stopped assuming it (admin.css). */
            }
            <div id="me-editor" class="reading min-h-96 px-4 py-4"></div>
          </div>
        </div>
      </section>

      <hr class="border-base-300 my-12" />

      {/* ─────────────  MOVEMENT II — WHAT THIS IS  ───────────── */}
      <section class="space-y-6">
        <div>
          <p class="fs__k"><span class="text-primary" aria-hidden="true">✦</span> About the Blog</p>
          <p class="text-base-content/45 mt-1 font-sans text-xs">
            The site and its ethos — why you write, and where the name came from.
          </p>
        </div>

        <div class="f">
          <label class="f__k">Why I write here <span>(the ethos prose)</span></label>
          <div class="rounded-box border-base-300 border" data-editor="site">
            <EditorToolbar class="border-base-300 border-b px-3 py-1.5" />
            <div id="site-editor" class="reading min-h-96 px-4 py-4"></div>
          </div>
        </div>

        <p class="text-base-content/45 pt-2 font-sans text-xs tracking-widest uppercase">About the Name</p>
        {
          /* ⚠ THE LABEL USED TO TEACH THE ASTERISK. It read *"(Markdown —
            *italics* for the album title)"* — a form field explaining its own
            storage format to the one person who ever fills it in, and doing it
            by printing the very syntax he then had to type. Michael's words on
            the whole class of field: *"I hate that there are markdown fields …
            I don't want to do \*hello\* if I need to bold something; it doesn't
            feel right entering it."*

            So the syntax is gone and the INTENT stays: the album title still
            wants italics, and now ⌘I is how you say so. Same Markdown in the
            column either way.

            `id` is unchanged from the textarea's, exactly as `CaptureDialog`
            kept `cap-box` — TipTap renders its own editable inside this
            element, so anything hunting for the text wants
            `#f-blurb [contenteditable]`. */
        }
        <div class="f">
          <span class="f__k">Where the name came from <span>(italicise the album title)</span></span>
          <MiniEditor id="f-blurb" wrapId="f-blurb-wrap" size="max-h-[30vh] min-h-[5rem]" />
        </div>
        <div class="f">
          <label for="f-spotify" class="f__k">Spotify link <span>(album or track — we render the embed)</span></label>
          <input
            id="f-spotify"
            type="url"
            placeholder="https://open.spotify.com/album/…"
            value={siteName.spotify_url ?? ''}
          />
        </div>
      </section>

      <hr class="border-base-300 my-12" />

      {/* ─────────────  SAY HELLO  ───────────── */}
      <section class="space-y-4">
        <div>
          <p class="fs__k"><span class="text-primary" aria-hidden="true">✦</span> Say hello</p>
          <p class="text-base-content/45 mt-1 font-sans text-xs">
            The public About page closes with a contact form (name · email · message), guarded against spam. Set an
            optional line of copy to sit above it.
          </p>
        </div>
        <div class="f">
          <span class="f__k">Intro line <span>(optional — shown above the form)</span></span>
          <MiniEditor id="f-contact-intro" wrapId="f-contact-intro-wrap" size="max-h-[24vh] min-h-[3.25rem]" />
        </div>
      </section>
    </form>
  </div>

  <LinkDialog id="me-link" />
  <LinkDialog id="site-link" />

  <script type="application/json" id="about-init" is:inline set:html={jsonForScript(aboutInit)} />
  <script>
    import '../../scripts/about-builder';
  </script>
</AdminLayout>

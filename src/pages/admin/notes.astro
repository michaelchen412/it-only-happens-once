---
/*
  /admin/notes — the pile (14 · Piece 1, plan §4; 10-hq §10c's "its own room").

  THE ROOM SHOWS THE WORDS. Every card holds the dump's own text — no title, no
  slug, no type mark, no checkbox, no open action. That is the whole point of
  this room existing, and it is a correction rather than an addition. Michael,
  2026-08-03, on the fragment manager's old `?view=notes`:

    "I have a notes fragment, and it's an uncomfortable middle ground because I
     have to title these things… I see untitled, untitled, untitled, and I have
     to open each one to see what I jotted down, unless I put a title, which I'm
     not going to do in a brain dump. All I care about is that I have writing
     fragments and I have brain dumps."

  So there are exactly two things now, and the third was deleted with this
  commit: `?view=notes`, the Notes button on the manager, and notes in the
  trash. The manager holds drafts and published; dumps live here.

  ⚠ THE STORAGE DID NOT CHANGE, and that was the deciding argument (14 §3). A
  dump is still a `writing` fragment at `status: 'note'`, so **make it a piece**
  is one status flip on the row you already typed — same id, same text, same
  history, no copy and no second write path. A `captures` table of its own would
  have bought an honest model (no slug, no title, ever) and paid for it with a
  migration and a cross-table move on the one motion that matters most.

  NO BOX AT THE TOP OF THIS PAGE. Writing is the ✚'s job, from every room
  including this one (CaptureDialog.astro). A box here as well would be a second
  place to type, and "which one do I use" is the middle ground arriving again in
  a different costume.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import { elapsedSince } from '../../lib/hq/dates';

const supabase = Astro.locals.supabase;

// Newest first, by when it was last TOUCHED rather than created: editing a
// thought is thinking about it again, and it belongs back at the top.
//
// The cap is a backstop, not paging. The pile is meant to be triaged, so a
// healthy one is short; if it is ever genuinely 100 deep the answer is a search
// field, which is the moment to add one and not before.
const { data: rows } = await supabase
  .from('fragments')
  .select('id, body, slug, updated_at')
  .eq('status', 'note')
  .is('deleted_at', null)
  .order('updated_at', { ascending: false })
  .limit(100);

const notes = (rows ?? []).map((n) => ({
  id: n.id,
  body: n.body ?? '',
  // Both ride the card so an edit needs no round trip to start: the slug so
  // `saveWriting` doesn't re-derive (and churn) it, the token so a stale tab
  // gets a CONFLICT instead of overwriting a newer edit.
  slug: n.slug,
  updatedAt: n.updated_at,
  ago: elapsedSince(n.updated_at),
  // Roughly a card's worth. The clamp is CSS (10 lines); this only decides
  // whether the `more` control is offered, and it counts wrapped-looking length
  // as well as newlines so one long paragraph earns it too.
  long: (n.body ?? '').split('\n').length > 10 || (n.body ?? '').length > 700,
}));

// Where a dump can be filed. Drafts first — a draft is what you are actively
// writing, so it is the likely destination — then published, newest first
// within each.
//
// SERVER-RENDERED AND FILTERED IN THE BROWSER, the same call LinkSheet makes
// and for the same reason: there are 60 of these, it is already one round trip,
// and a keystroke that has to ask the server is slower and no more correct.
const { data: pieceRows } = await supabase
  .from('fragments')
  .select('id, title, slug, status, updated_at')
  .eq('type', 'writing')
  .neq('status', 'note')
  .is('deleted_at', null)
  .order('status', { ascending: true }) // draft < published
  .order('updated_at', { ascending: false });

const pieces = (pieceRows ?? []).map((p) => ({
  id: p.id,
  title: p.title?.trim() || '(untitled)',
  status: p.status,
}));
---

<AdminLayout title="Notes" active="notes">
  <div class="mx-auto max-w-3xl px-6 py-8">
    <PageHeader title="Notes" />

    {
      notes.length === 0 ? (
        /* A room with nothing in it says one plain sentence and offers the way
           in — never an empty skeleton of the cards that would be here
           (10-hq §10b). */
        <p class="font-sans text-sm text-base-content/55">
          Nothing here yet. The <span class="text-base-content/80">✚</span> in the corner is the way in — from any room.
        </p>
      ) : (
        <ul id="notes-pile" class="space-y-3">
          {notes.map((n) => (
            <li class="dump" data-note={n.id} data-slug={n.slug} data-updated={n.updatedAt}>
              {/* `pre-wrap` in the stylesheet, so the line breaks you typed are
                  the line breaks you see. A dump's shape is part of what it
                  says. */}
              <div class:list={['dump__text', n.long && 'dump__text--clamped']} data-text>{n.body}</div>
              {n.long && (
                <button type="button" class="dump__more" data-more>
                  more
                </button>
              )}
              {/* The editable twin, revealed in place by the pencil. Reading is
                  the dominant motion in this room, so a tap must not put a
                  cursor (and on a phone, a keyboard) into a card you were only
                  scrolling past. */}
              <textarea class="dump__edit" hidden aria-label="Edit this note" data-edit-box>{n.body}</textarea>

              <div class="dump__foot">
                <time class="dump__stamp" datetime={n.updatedAt} data-ago>{n.ago}</time>
                <button type="button" class="dump__act" data-edit title="Edit" aria-label="Edit">
                  <Icon name="ph:pencil-simple" />
                </button>
                {/* The two ways out of the pile, and the only two this piece
                    ships. Task and log-entry triage is 14 · Piece 2 — it needs
                    a sheet each, and neither belongs on a card this quiet. */}
                <button type="button" class="dump__act" data-promote title="Make it a piece" aria-label="Make it a piece">
                  <Icon name="ph:pen-nib" />
                </button>
                <button type="button" class="dump__act" data-append title="Add to a piece…" aria-label="Add to a piece">
                  <Icon name="ph:article" />
                </button>
                <button type="button" class="dump__act dump__act--danger" data-delete title="Delete" aria-label="Delete">
                  <Icon name="ph:trash" />
                </button>
              </div>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  {/* ONE PICKER, MANY CARDS — the TaskSheet rule. The room lists dozens of
      dumps and 60 destinations; rendering a dialog per card would be 60 lists
      in the DOM to keep in step. The card being filed is written onto the
      dialog when it opens. */}
  <dialog id="note-file" class="modal-dialog w-full max-w-md" aria-labelledby="note-file-title">
    <div class="flex max-h-[80vh] flex-col overflow-hidden font-sans">
      <header class="flex shrink-0 items-center justify-between gap-4 border-b border-base-300 px-5 py-3.5">
        <h2 id="note-file-title" class="font-display text-lg">Add to a piece</h2>
        <button type="button" data-close class="text-base-content/50 hover:text-base-content" aria-label="Close">✕</button>
      </header>

      <div class="shrink-0 px-5 py-3">
        <input
          id="note-file-q"
          type="search"
          class="input input-sm input-bordered w-full"
          placeholder="Search pieces…"
          aria-label="Search pieces"
        />
      </div>

      <ul id="note-file-list" class="min-h-0 flex-1 overflow-y-auto px-2 pb-3">
        {pieces.map((p) => (
          <li>
            <button
              type="button"
              class="flex w-full items-baseline gap-2 rounded-field px-3 py-2 text-left text-sm hover:bg-base-200"
              data-piece={p.id}
              data-title={p.title}
            >
              <span class="min-w-0 flex-1 truncate">{p.title}</span>
              {/* A draft and a published piece are different places to put a
                  loose paragraph, and the chip is the whole explanation. */}
              {p.status === 'draft' && <span class="chip chip--off shrink-0">draft</span>}
            </button>
          </li>
        ))}
        {pieces.length === 0 && <li class="px-3 py-2 text-sm text-base-content/55">No writing yet.</li>}
      </ul>
      <p id="note-file-none" class="px-5 pb-4 text-sm text-base-content/55" hidden>Nothing matches.</p>
    </div>
  </dialog>

  {/* The way back from a one-tap action. Lives outside the list so a card
      leaving the pile cannot take its own undo with it. */}
  <div id="notes-undo" class="undo-bar" role="status" aria-live="polite">
    <span data-undo-text></span>
    <button type="button" class="btn btn-xs font-sans" data-undo-do>Undo</button>
  </div>

  <script>
    import '../../scripts/notes';
  </script>
</AdminLayout>

---
/*
  /admin — TODAY, ASSEMBLED (ADR-0015, docs/admin.md §2, 13-agenda.md §6,
  10-hq.md §10c). The Observatory's front door and the reason all of this is in
  one app: the correlation thesis needs the sleep, the agenda, the people and the
  practice on ONE page or it is four apps again.

  The Fragment Manager lived here until 2026-08-02 and now lives at
  `/admin/fragments`. This is the daily surface: the one page opened every
  morning, which is why it took the root from a surface used weekly.

  ⚠ ONLY THE CHECK-IN FOLLOWS THE DATE BAR, and that is the rule this page is
  built on. The bar exists to BACKFILL A CHECK-IN — every other zone is a
  statement about *now*. "Past due", "Been a while" and "Last published" are all
  false on a Tuesday last March, and offering their dismissals there would write
  a row dated today from a page that is not about today. So on any other date the
  page is the date bar and the check-in, which is exactly what it was before this
  piece and is still the honest answer.

  ⚠ NOTHING ON THIS PAGE COUNTS WHAT YOU OWE. No total, no badge, no streak.
  `1 of 2 done` counts what you DID and says nothing until you have done one;
  Coming up is bounded by honest leads rather than by a window; past due is
  capped at eight rows with a door. That is 10-hq.md §3 — *absence never
  accumulates* — spent on every zone rather than argued once.

  ⚠ A DOMAIN WITH NOTHING TO SAY RENDERS NOTHING (§10b). Every zone below is
  wrapped in its own emptiness check, so a quiet morning is a short page rather
  than a grid of "no data" boxes — which reads as a broken app *and* as a list of
  things you have already failed to do. The "the agenda isn't built yet" sentence
  that stood here from 2026-08-02 is gone: it is built.

  NO WritingSheet, NO TipTap, NO TaskSheet. The sheets are imported by
  `/admin/fragments`, the composer and the agenda rooms, never by the layout — so
  the page opened on a phone at 7am stays free of editors it will not use. Today
  reads; the rooms write.

  THE DATE BAR IS SERVER-DRIVEN. Every control is a real link to
  `?date=YYYY-MM-DD`, the month grid is 42 rendered anchors, and the popover is
  a <details>. No JS builds any of it — which sidesteps trap 3 (Astro's scoped
  styles never reach runtime-created DOM) and means the page works before a
  byte of script runs.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../layouts/AdminLayout.astro';
import AgendaZone from '../../components/admin/AgendaZone.astro';
import CheckinZone from '../../components/admin/CheckinZone.astro';
import ComingUpZone from '../../components/admin/ComingUpZone.astro';
import PastDueZone from '../../components/admin/PastDueZone.astro';
import PeopleZone from '../../components/admin/PeopleZone.astro';
import PracticeZone from '../../components/admin/PracticeZone.astro';
import { parseYmd, shiftYmd, utcToZonedTime, type Ymd } from '../../lib/hq/time';
import { headerDate, monthGrid, monthTitle, shiftMonth } from '../../lib/hq/dates';
import {
  BACKFILL_DAYS,
  DEFAULT_TIMES,
  medianClock,
  type Checkin,
  type DreamEntry,
  type DreamTone,
  type NapEntry,
  type WakingEntry,
} from '../../lib/hq/checkin';
import { loadToday, type TodayData } from '../../lib/hq/today-data';
import type { Database } from '../../lib/database.types';

const supabase = Astro.locals.supabase;
const { tz, ymd: todayYmd } = Astro.locals.today;

// Navigating is free; EDITING is not — the 3-day backfill limit belongs to the
// check-in, not to the ability to look at a date. So no clamp here.
const selected: Ymd = parseYmd(Astro.url.searchParams.get('date')) ?? todayYmd;
const offToday = selected !== todayYmd;

// The same window the action enforces. Stated once, in the module both read.
const writable = selected <= todayYmd && selected >= shiftYmd(todayYmd, -BACKFILL_DAYS);

/**
 * The night and its pieces, in ONE round trip.
 *
 * Since 2026-08-06 a night can hold several dream tones, several timed wakings
 * and several naps. Embedding them in the parent's select rather than issuing
 * three follow-up queries is not a micro-optimisation: this is the first query
 * on the first card of the page every admin request begins with, and a
 * four-deep waterfall in front of it would be felt.
 */
type Tables = Database['public']['Tables'];
type CheckinWithNight = Checkin & {
  checkin_dreams: Tables['checkin_dreams']['Row'][];
  checkin_wakings: Tables['checkin_wakings']['Row'][];
  checkin_naps: Tables['checkin_naps']['Row'][];
};

const { data: checkin } = await supabase
  .from('daily_checkins')
  .select('*, checkin_dreams(*), checkin_wakings(*), checkin_naps(*)')
  .eq('log_date', selected)
  .maybeSingle<CheckinWithNight>();

// Back out of UTC into wall-clock times, because that is what the pickers and
// the summary both speak. The instants stay canonical in the database.
const times = {
  bed: checkin?.bed_at ? utcToZonedTime(checkin.bed_at, tz) : null,
  woke: checkin?.woke_at ? utcToZonedTime(checkin.woke_at, tz) : null,
  gotUp: checkin?.got_up_at ? utcToZonedTime(checkin.got_up_at, tz) : null,
  asleepAt: checkin?.asleep_at ? utcToZonedTime(checkin.asleep_at, tz) : null,
};

const clock = (ts: string | null) => (ts ? utcToZonedTime(ts, tz) : null);

/** Nulls last, then oldest first — ISO instants sort as strings. */
const byInstant = (a: string | null, b: string | null) => (a ?? '￿').localeCompare(b ?? '￿');

const dreams: DreamEntry[] = (checkin?.checkin_dreams ?? []).map((d) => ({
  tone: d.tone as DreamTone,
  intensity: d.intensity,
  wokeYou: d.woke_you,
  recurring: d.recurring,
}));

// ORDER IS NOT GUARANTEED BY AN EMBEDDED SELECT, and these two are lists a
// person reads down. A night whose wakings shuffled between reloads would look
// like the record had changed when only the row order had.
const wakings: WakingEntry[] = (checkin?.checkin_wakings ?? [])
  .slice()
  .sort((a, b) => byInstant(a.woke_at, b.woke_at))
  .map((w) => ({ woke: clock(w.woke_at), backAsleep: clock(w.back_asleep_at), leftBed: w.left_bed }));

const naps: NapEntry[] = (checkin?.checkin_naps ?? [])
  .slice()
  .sort((a, b) => byInstant(a.started_at, b.started_at))
  .map((n) => ({ start: clock(n.started_at), end: clock(n.ended_at) }));

/**
 * The median of recent bed and wake times — what keeps this under a minute,
 * because it usually turns two pickers into one tap each to confirm.
 *
 * Only fetched when it could be used: a backfill deliberately gets no prefill
 * (a plausible suggested time on a day you are reconstructing gets confirmed
 * without being recalled), and a row that already has times has no use for one.
 */
let prefill: { bed: string; woke: string; up?: string } | null = null;
if (selected === todayYmd && !times.bed && !times.woke) {
  const { data: recent } = await supabase
    .from('daily_checkins')
    .select('bed_at, woke_at, got_up_at')
    .not('bed_at', 'is', null)
    .not('woke_at', 'is', null)
    .order('log_date', { ascending: false })
    .limit(14);

  const rows = recent ?? [];
  // Three rows is the floor: a "usual time" from one night is not a usual time,
  // and offering it as one would be the interface inventing a habit.
  if (rows.length >= 3) {
    // Bed times straddle midnight, so their median is taken on a clock rotated
    // by twelve hours — see `medianClock`. Waking times do not, so they are not.
    const bed = medianClock(
      rows.map((r) => utcToZonedTime(r.bed_at!, tz)),
      12,
    );
    const woke = medianClock(
      rows.map((r) => utcToZonedTime(r.woke_at!, tz)),
      0,
    );
    // "Up" gets a median or it gets nothing — and unlike the other two it has
    // no `DEFAULT_TIMES` to fall back on. A suggested rising time invented for
    // the occasion is exactly the invented row this feature keeps refusing to
    // write, and the column is new enough that most rows have no answer yet.
    const ups = rows.map((r) => r.got_up_at).filter((v): v is string => v !== null);
    const up =
      ups.length >= 3
        ? medianClock(
            ups.map((v) => utcToZonedTime(v, tz)),
            0,
          )
        : null;
    if (bed && woke) prefill = up ? { bed, woke, up } : { bed, woke };
  }
  prefill ??= DEFAULT_TIMES;
}

/* ── the stack (13 · Piece 5) ───────────────────────────────────────────────
   Everything below is a statement about NOW — see the header, and note what
   that buys: off today none of it is fetched, so stepping through the calendar
   to backfill a check-in costs ONE query rather than thirteen.

   ⚠ THE GUARD LIVES HERE, NOT INSIDE `loadToday`. Putting it inside would read
   as tidier and would quietly turn that saving into thirteen queries behind an
   `if`. The decision about which day this page is about belongs to the page. */
const data: TodayData | null = offToday ? null : await loadToday(supabase, todayYmd);
// `?cal=` is the month the popover is showing, and its presence is what keeps
// the popover open across a month step. Stepping months is a real navigation
// rather than a script, which is the price of rendering the grid server-side —
// and on a page this small it is a price worth paying.
const calAnchor = parseYmd(Astro.url.searchParams.get('cal'));
const calOpen = calAnchor !== null;
const anchor = calAnchor ?? selected;
const cells = monthGrid(anchor);

const at = (date: Ymd, cal?: Ymd) => `/admin?date=${date}${cal ? `&cal=${cal}` : ''}`;
const DOW = ['S', 'M', 'T', 'W', 'T', 'F', 'S'];
---

<AdminLayout title="Today" active="today">
  {
    /* Deep links from before the move, and from muscle memory. A hash never
      reaches the server, so this cannot be a redirect — every *producer* was
      updated instead (the retired writing page's 302, the blog's edit link,
      the manager's history base), and this catches what is already in a
      browser's history or an old note. `is:inline` so it runs while the
      document parses rather than after paint; `replace` so Back does not
      bounce you here again. */
  }
  <script is:inline>
    (function () {
      const h = location.hash;
      if (/^#edit=[0-9a-f][0-9a-f-]{30,40}$/i.test(h) || h === '#new-writing' || h === '#new-note') {
        location.replace('/admin/fragments' + h);
      }
    })();
  </script>

  <div class="hq-cq mx-auto w-full max-w-4xl px-4 py-6 pb-24 sm:px-6">
    {
      /* The room's name, for a screen reader and for heading navigation only.
        This page had NO heading of any level — the Observatory's front door,
        the one page opened every morning, presenting as an undifferentiated
        pile of links.

        ⚠ Not the date bar, which is the obvious candidate and the wrong one:
        it is a CONTROL, and it says whatever `?date=` says, so on a backfill
        the page's heading would announce last Tuesday while the room is still
        Today. The room's name does not move. (Same reason, and the same
        `sr-only` pattern, as `/` and `about.astro` — three rooms, one answer.) */
    }
    <h1 class="sr-only">Today</h1>
    {/* ── the date bar: the header IS the control ─────────────────────── */}
    <header class="datebar mb-6 pt-1">
      <a class="datebar__step" href={at(shiftYmd(selected, -1))} aria-label="Previous day">
        <Icon name="ph:caret-left" />
      </a>

      <details class="cal-wrap" open={calOpen}>
        <summary class="datebar__date" aria-label="Choose a date">
          <span data-header-date>{headerDate(selected)}</span>
          <Icon name="ph:caret-down" class="datebar__caret" />
        </summary>
        <div class="cal">
          <div class="cal__head">
            <a class="datebar__step" href={at(selected, shiftMonth(anchor, -1))} aria-label="Previous month">
              <Icon name="ph:caret-left" />
            </a>
            <span>{monthTitle(anchor)}</span>
            <a class="datebar__step" href={at(selected, shiftMonth(anchor, 1))} aria-label="Next month">
              <Icon name="ph:caret-right" />
            </a>
          </div>
          <div class="cal__dow">{DOW.map((d) => <span>{d}</span>)}</div>
          {
            /* 42 cells always, never 35 or 28 — a grid that changes height
              between months makes the page jump under the cursor. */
          }
          <div class="cal__grid">
            {
              cells.map((c) => (
                <a
                  href={at(c.ymd)}
                  class:list={[c.outside && 'is-out', c.ymd === todayYmd && 'is-today', c.ymd === selected && 'is-sel']}
                  aria-current={c.ymd === selected ? 'date' : undefined}
                >
                  {c.day}
                </a>
              ))
            }
          </div>
        </div>
      </details>

      <a class="datebar__step" href={at(shiftYmd(selected, 1))} aria-label="Next day">
        <Icon name="ph:caret-right" />
      </a>

      {/* Being on another day must never be ambiguous. */}
      {
        offToday && (
          <a class="datebar__back" href="/admin">
            <Icon name="ph:arrow-up" class="rotate-90" /> Today
          </a>
        )
      }
    </header>

    {
      /* The configured zone always wins; a device somewhere else gets a quiet
        note and nothing more. A silent switch mid-trip corrupts the sleep
        series exactly at the boundary — doubling or skipping a day — and does
        it invisibly (docs/plans/11-checkin.md §2). */
    }
    <p id="tz-note" hidden class="admin-hint mb-4 text-xs" data-tz={tz}></p>

    {
      /* One alert for every write on this page: the tick, and both of drift's
        dismissals. The zones themselves are read-only. */
    }
    <p hidden role="alert" class="admin-alert mb-4" data-task-error></p>

    {
      /* ⚠ ADR-0014'S ONE DEMAND. A one-way mirror buys its simplicity by
         introducing a new silent failure: if the sync stops, this page is
         confidently wrong about the day. It says so — and only then. */
      data?.stale && (
        <p class="mstale mb-4" data-stale>
          <Icon name="ph:warning" /> {data.stale.text}
        </p>
      )
    }

    {
      /* ⚠ THE ORDER IS §10c's, AND THE `o-*` CLASSES ARE WHY IT SURVIVES A PHONE.
        The wrappers go `display: contents` when narrow, so these five zones
        collapse into one stack and `order` resequences them — People outranks
        Coming up on a small screen, because who you are seeing today matters
        more than what is approaching. Wide, the orders reset and the columns
        take over. (Trap 1: a `grid-column: 2` here would conjure an implicit
        column and put every zone on its own row.) */
    }
    <div class="hq-grid">
      <div class="col-main">
        {
          /* ══ MORNING ══ pinned first, always, answered or not. Every field is
            a real column on `daily_checkins` — or, since 2026-08-06, a real row
            in one of its three child tables. ══ */
        }
        <CheckinZone
          logDate={selected}
          today={todayYmd}
          row={checkin ?? null}
          times={times}
          dreams={dreams}
          wakings={wakings}
          naps={naps}
          prefill={prefill}
          writable={writable}
          tz={tz}
        />

        {/* ══ TODAY ══ the day itself: events and tasks in one time order. ══ */}
        <AgendaZone items={data?.dayItems ?? []} answered={data?.answeredToday ?? new Map()} />

        {/* ══ COMING UP ══ each item's own lead, and no window to tune. ══ */}
        <ComingUpZone items={data?.comingItems ?? []} today={todayYmd} />
      </div>

      <div class="col-rail">
        {
          /* ══ PEOPLE ══ the brief, then drift capped at three. The rail rather
            than the main column: the check-in is the thing you came to do, and
            this is the thing you came to notice. ══ */
        }
        <PeopleZone
          briefs={data?.briefs ?? []}
          drifting={data?.drifting ?? []}
          today={todayYmd}
          photos={data?.peoplePhotos ?? new Map()}
        />

        {/* ══ PRACTICE ══ signals. Nothing here is tickable or countable. ══ */}
        <PracticeZone published={data?.published ?? null} goals={data?.goalSignals ?? []} />
      </div>
    </div>

    {/* ══ PAST DUE ══ full width, below both columns, always open (§10f). ══ */}
    <PastDueZone rows={data?.pastDue ?? []} today={todayYmd} />
  </div>

  <script>
    import '../../scripts/checkin';
    // The tick, and the two dismissals on a drift row. Both are the rooms' own
    // scripts, reused verbatim rather than reimplemented for this page.
    import '../../scripts/task-list';
    // Render first, then ask Google (13 · Piece 3). Today is drawn from the
    // mirror immediately and never waits on the network.
    import '../../scripts/calendar-sync';

    // The travel note (docs/plans/11-checkin.md §2). Client-side because the
    // server has no business asking what the device thinks the zone is — and
    // this is the ONLY thing on the page the browser's zone is allowed to
    // influence: a sentence. It never moves the day.
    import { deviceZoneNote } from '../../lib/hq/time';

    const el = document.getElementById('tz-note');
    const configured = el?.dataset.tz;
    if (el && configured) {
      const device = Intl.DateTimeFormat().resolvedOptions().timeZone;
      const note = deviceZoneNote(configured, device);
      if (note) {
        el.textContent = note;
        el.hidden = false;
      }
    }

    // A <details> closes on Escape and on a click outside, like every other
    // popover in here. Progressive enhancement only: without this it still
    // opens, closes and navigates.
    const cal = document.querySelector<HTMLDetailsElement>('.cal-wrap');
    document.addEventListener('click', (e) => {
      if (cal?.open && !(e.target as Element).closest('.cal-wrap')) cal.open = false;
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && cal?.open) cal.open = false;
    });
  </script>
</AdminLayout>

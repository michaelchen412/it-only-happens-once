---
/*
  /admin — the Fragment Manager (docs/admin.md §2). A flat, sortable table over
  ALL fragments (admin sees everything via RLS), rendered by the shared
  FragmentListPanel (also served as the fragments-panel partial to the
  composer's browser sheet). Filtering/sorting swap the table in place
  (fragment-panel.ts) — no full reload. Every fragment edits in an overlay:
  quotes/songs in the FragmentSheet, writing in the WritingSheet — the page
  underneath never navigates away.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../layouts/AdminLayout.astro';
import PageHeader from '../../components/admin/PageHeader.astro';
import FragmentListPanel from '../../components/admin/FragmentListPanel.astro';
import TypeMark from '../../components/admin/TypeMark.astro';
import StarMark from '../../components/StarMark.astro';
import FragmentSheet from '../../components/admin/FragmentSheet.astro';
import WritingSheet from '../../components/admin/WritingSheet.astro';
import { parseListParams, queryFragmentList } from '../../lib/fragment-query';

const supabase = Astro.locals.supabase;
const params = parseListParams(Astro.url.searchParams);
params.constellation = null; // pick-mode concern; never used here
const data = await queryFragmentList(supabase, params);
const view = params.view;
const subjectNames = data.allSubjects.map((s) => s.name);

const TITLES = { list: 'Fragments', notes: 'Notes', trash: 'Trash' } as const;
const SUBTITLES = {
  list: undefined,
  notes:
    'The scratch tier: thoughts before they are drafts. Never public — the site only ever reads published rows. Promote one to a draft when it starts becoming a piece.',
  trash:
    'Deleted fragments wait here until you empty them. Anything placed in a constellation leaves that suite while it sits in the trash.',
} as const;
---

<AdminLayout title={TITLES[view]} active="fragments">
  <div class="mx-auto max-w-5xl px-6 py-8">
    <PageHeader
      title={TITLES[view]}
      back={view === 'list' ? undefined : { href: '/admin', label: 'Fragments' }}
      subtitle={SUBTITLES[view]}
    >
      <Fragment slot="actions">
        {
          view === 'trash' ? (
            <button id="empty-trash" class="btn btn-outline btn-sm gap-1.5 font-sans text-error" disabled={data.rows.length === 0}>
              <Icon name="ph:trash" class="text-base" /> Empty trash
            </button>
          ) : (
            <>
              {view === 'list' && (
                <>
                  {/* Notes get their own room rather than a filter on this one:
                      scratch work shouldn't sit beside finished pieces, and a
                      view can't be accidentally cleared into showing them. */}
                  <a href="/admin?view=notes" class="btn btn-ghost btn-sm gap-1.5 font-sans">
                    <Icon name="ph:note" />
                    Notes
                    <span class="rounded-full bg-base-300 px-1.5 text-xs text-base-content/70 empty:hidden">{data.noteCount || ''}</span>
                  </a>
                  <a href="/admin?view=trash" class="btn btn-ghost btn-sm gap-1.5 font-sans">
                    <Icon name="ph:trash" />
                    Trash
                    <span id="trash-count" class="rounded-full bg-base-300 px-1.5 text-xs text-base-content/70 empty:hidden">{data.trashCount || ''}</span>
                  </a>
                </>
              )}
              <div class="relative">
                <button id="add-btn" class="btn btn-primary btn-sm gap-1 font-sans" aria-haspopup="menu" aria-expanded="false">
                  <Icon name="ph:plus" /> Add <span aria-hidden="true">▾</span>
                </button>
                <div id="add-menu" hidden role="menu" aria-label="Add a fragment" class="absolute right-0 z-30 mt-1 w-40 overflow-hidden rounded-box border border-base-300 bg-base-100 py-1 shadow-lg">
                  <button data-new-note role="menuitem" class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"><Icon name="ph:note" class="text-base-content/50" /> Note</button>
                  <button data-new-writing role="menuitem" class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"><TypeMark type="writing" /> Writing</button>
                  <button data-new="quote" role="menuitem" class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"><TypeMark type="quote" /> Quote</button>
                  <button data-new="song" role="menuitem" class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"><TypeMark type="song" /> Song</button>
                </div>
              </div>
            </>
          )
        }
      </Fragment>
    </PageHeader>

    <FragmentListPanel data={data} params={params} mode="manage" />
  </div>

  {/* Floating bulk-action bar (buttons rendered per view) */}
  <div id="bulkbar" class="bulkbar font-sans text-sm" data-view={view}>
    <span id="bulkcount" class="text-base-content/70">0 selected</span>
    <div class="flex gap-1">
      {
        view === 'trash' ? (
          <>
            <button data-bulk="restore" class="btn btn-xs btn-ghost normal-case">Restore</button>
            <button data-bulk="purge" class="btn btn-xs btn-ghost normal-case text-error">Delete forever</button>
          </>
        ) : view === 'notes' ? (
          <>
            {/* Promotion, the one motion this tier exists for: a note becomes a
                draft and joins the working list. */}
            <button data-bulk="draft" class="btn btn-xs btn-ghost normal-case">Make drafts</button>
            <button data-bulk="trash" class="btn btn-xs btn-ghost normal-case text-error">Delete</button>
          </>
        ) : (
          <>
            {/* Elevate a selection into the sky — the bulk half of the
                fragment→constellation view (docs/admin.md §2). */}
            <div class="relative">
              <button id="bulk-cn-btn" class="btn btn-xs btn-ghost gap-1 normal-case" aria-haspopup="menu" aria-expanded="false">
                <span class="text-primary"><StarMark /></span> Constellation <span aria-hidden="true">▾</span>
              </button>
              <div
                id="bulk-cn-menu"
                hidden
                role="menu"
                aria-label="Add to or remove from a constellation"
                class="absolute bottom-full left-0 z-40 mb-1 max-h-96 w-96 overflow-y-auto rounded-box border border-base-300 bg-base-100 py-1 shadow-lg"
              >
                {/* The full description (4-line cap): you're about to elevate a
                    whole selection, so "what is this constellation for" should
                    be readable here, not hidden behind a hover. */}
                <p class="admin-label px-3 pt-1.5">Add to</p>
                {data.allConstellations.map((c) => (
                  <button role="menuitem" class="add-item block w-full px-3 py-2 text-left" data-cn-add={c.id}>
                    <span class="block truncate text-sm leading-snug">{c.name}</span>
                    {c.description && (
                      <span class="mt-0.5 block line-clamp-4 text-xs leading-snug text-base-content/55">{c.description}</span>
                    )}
                  </button>
                ))}
                <p id="bulk-cn-remove-label" class="admin-label mt-1 border-t border-base-300 px-3 pt-2" hidden>Remove from</p>
                {data.allConstellations.map((c) => (
                  <button role="menuitem" hidden class="add-item block w-full truncate px-3 py-1.5 text-left text-sm text-error/80" data-cn-remove={c.id}>
                    {c.name}
                  </button>
                ))}
                {data.allConstellations.length === 0 && (
                  <p class="admin-hint px-3 py-2">No constellations yet.</p>
                )}
              </div>
            </div>
            <button data-bulk="publish" class="btn btn-xs btn-ghost normal-case">Publish</button>
            <button data-bulk="draft" class="btn btn-xs btn-ghost normal-case">Unpublish</button>
            <button data-bulk="note" class="btn btn-xs btn-ghost normal-case">Make notes</button>
            <button data-bulk="trash" class="btn btn-xs btn-ghost normal-case text-error">Delete</button>
          </>
        )
      }
    </div>
  </div>
  <p id="bulk-error" hidden role="alert" class="fixed bottom-20 left-1/2 z-40 -translate-x-1/2 rounded-field border border-error/40 bg-base-200 px-3 py-1.5 font-sans text-xs text-error shadow"></p>

  <FragmentSheet
    subjects={subjectNames}
    authors={data.allAuthors.map((a) => ({ id: a.id, name: a.name }))}
    works={data.allWorks.map((w) => ({ id: w.id, title: w.title, authorId: w.author_id }))}
    constellations={data.allConstellations}
  />
  <WritingSheet subjects={subjectNames} constellations={data.allConstellations} />

  <script>
    import '../../scripts/admin-list';
  </script>
</AdminLayout>

---
/*
  /admin/goals — INTENTIONS, NOT PROJECTS (docs/plans/13-agenda.md §4a).

  ⚠ WHAT IS ABSENT HERE IS THE DESIGN. No progress bar, no percent, no subtask
  count, no "3 of 7 done". A goal is a direction, and a direction cannot be 60%
  travelled — claiming otherwise would be false AND a guilt engine (ADR-0013).
  There is also **no paragraph explaining the absence of a progress bar**: an
  absence needs no note (10-hq.md §10i).

  The one number a goal gets is an OBSERVATION over the last 30 days, and a cold
  one reads QUIETER, never redder — the moment it turns amber it becomes a debt.

  ⚠ AND A GOAL WITH NOTHING TO OBSERVE SAYS NOTHING. See `observationFor`: a
  goal written this morning is new, not neglected, and the naive version greets
  it with "nothing in 6 weeks".

  One of the Agenda room's three surfaces (10-hq.md §9), beside the calendar
  and the tasks it gathers. Goals are visited monthly, so they were never going
  to earn a sidebar entry of their own.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import AgendaTabs from '../../../components/admin/AgendaTabs.astro';
import GoalSheet from '../../../components/admin/GoalSheet.astro';
import { today as hqToday } from '../../../lib/hq/time';
import { shiftYmd } from '../../../lib/hq/time';
import { ACTIVE_CAP, OBSERVATION_DAYS, horizonLabel, observationFor, statusLabel } from '../../../lib/hq/goals';
import type { Tables } from '../../../lib/database.types';

type Goal = Tables<'goals'>;

const supabase = Astro.locals.supabase;
const { ymd: todayYmd } = await hqToday(supabase);
// The window's boundary is computed HERE, from the configured home zone —
// never by Postgres, whose `current_date` is UTC and would move the edge of
// "the last 30 days" by a day for anyone west of Greenwich.
const since = shiftYmd(todayYmd, -OBSERVATION_DAYS);

const [{ data: goalData, error }, { data: lastDone }, { data: recent }] = await Promise.all([
  supabase.from('goals').select('*').order('created_at'),
  supabase.from('goal_last_done').select('*'),
  supabase
    .from('task_events')
    .select('tasks!inner(goal_id)')
    .eq('outcome', 'done')
    .gte('occurred_on', since),
]);

const all: Goal[] = goalData ?? [];
const lastById = new Map((lastDone ?? []).map((r) => [r.goal_id, r.last_done_on]));
// The lifetime tally, which is what an inactive goal shows instead of a
// 30-day window: "how much I did toward this" does not stop being true
// because I stopped pursuing it.
const totalById = new Map((lastDone ?? []).map((r) => [r.goal_id, r.done_total ?? 0]));

const doneIn30 = new Map<string, number>();
for (const row of recent ?? []) {
  const id = (row.tasks as { goal_id: string | null } | null)?.goal_id;
  if (id) doneIn30.set(id, (doneIn30.get(id) ?? 0) + 1);
}

const observe = (g: Goal) => observationFor(doneIn30.get(g.id) ?? 0, lastById.get(g.id) ?? null, todayYmd);

const active = all.filter((g) => g.status === 'active');
const inactive = all.filter((g) => g.status !== 'active');
---

<AdminLayout title="Goals" active="agenda">
  <div class="hq-cq mx-auto w-full max-w-3xl px-4 py-6 pb-24 sm:px-6">
    <AgendaTabs active="goals" />

    <header class="mb-5 flex flex-wrap items-center justify-between gap-3">
      <h1 class="font-display text-2xl font-light">Goals</h1>
      <div class="flex items-center gap-3">
        {/* The cap as a FACT you can see, not an error you hit. */}
        <span class="admin-hint text-xs">{active.length} of {ACTIVE_CAP} active</span>
        <button type="button" data-open-goal-sheet class="btn btn-sm gap-1 font-sans zone__cta cn-amber">
          <Icon name="ph:plus" /> New
        </button>
      </div>
    </header>

    {error && <p class="admin-alert mb-5" role="alert">Couldn’t load your goals: {error.message}</p>}
    <p hidden role="alert" class="admin-alert mb-5" data-goal-error></p>

    {
      all.length === 0 ? (
        <div class="rounded-box border border-dashed border-base-300 px-6 py-12 text-center">
          <p class="font-serif text-lg">Nothing you’re working toward yet.</p>
          <button type="button" data-open-goal-sheet class="btn btn-sm mt-4 gap-1 font-sans zone__cta cn-amber">
            <Icon name="ph:plus" /> Name the first
          </button>
        </div>
      ) : (
        <>
          <div class="ggrid">
            {active.map((g) => {
              const obs = observe(g);
              return (
                <a href={`/admin/agenda/goals/${g.slug}`} class="gcard">
                  <span class="gcard__k"><Icon name="ph:target" /> {horizonLabel(g.horizon)}</span>
                  <span class="gcard__n">{g.name}</span>
                  {/* Nothing here at all when there is nothing to observe. */}
                  {obs && <span class:list={['gcard__o', obs.cold && 'gcard__o--cold']}>{obs.text}</span>}
                </a>
              );
            })}
          </div>

          {inactive.length > 0 && (
            <section class="mt-8">
              <h2 class="admin-label mb-2">
                Not active <span class="opacity-50">{inactive.length}</span>
              </h2>
              <ul class="zone__list rounded-box border border-base-300">
                {inactive.map((g) => (
                  <li class="row">
                    <span class="row__mark"><Icon name="ph:target" /></span>
                    <a href={`/admin/agenda/goals/${g.slug}`} class="min-w-0 flex-1 text-sm hover:underline">{g.name}</a>
                    {/* THE TALLY IS THE POINT, and it replaces a sentence.
                        §4a asked for a line stating that nothing was deleted
                        and the tasks done toward it stay done — but a visible
                        count of them says exactly that, cannot go stale, and
                        obeys 10-hq.md §10i's first preference: let the
                        affordance say it rather than writing the reassurance. */}
                    {!!totalById.get(g.id) && (
                      <span class="admin-hint shrink-0 text-xs">{totalById.get(g.id)} done toward this</span>
                    )}
                    <span class="chip u-none shrink-0">{statusLabel(g.status)}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )
    }
  </div>

  <GoalSheet />
</AdminLayout>

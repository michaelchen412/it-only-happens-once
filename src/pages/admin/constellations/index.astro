---
/*
  /admin/constellations — the sky's index (design.md §13; the composing room).
  Every constellation, draft and published: create, publish/unpublish, reorder
  the sky's authored order, delete (placements cascade; fragments untouched).
  A "pile" is just a draft constellation — start one in seconds, compose later.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import EmptyState from '../../../components/admin/EmptyState.astro';
import StarMark from '../../../components/StarMark.astro';
import { COLOR_SLOTS } from '../../../lib/constellation-colors';

const sb = Astro.locals.supabase;
const [{ data: cs }, { data: links }] = await Promise.all([
  sb.from('constellations').select('id, name, slug, description, status, sort, color').order('sort'),
  sb
    .from('fragment_constellations')
    .select('constellation_id, fragments!inner(status, deleted_at)')
    .is('fragments.deleted_at', null),
]);

const placed = new Map<string, { total: number; published: number }>();
for (const l of links ?? []) {
  const e = placed.get(l.constellation_id) ?? { total: 0, published: 0 };
  e.total++;
  if ((l.fragments as unknown as { status: string }).status === 'published') e.published++;
  placed.set(l.constellation_id, e);
}
const rows = (cs ?? []).map((c) => ({ ...c, ...(placed.get(c.id) ?? { total: 0, published: 0 }) }));
---

<AdminLayout title="Constellations" active="constellations">
  <div class="mx-auto max-w-4xl px-6 py-8">
    <PageHeader
      title="Constellations"
      subtitle="The sky's authored order — the sequence the home page reads top to bottom. A draft never reaches the public sky, so start one as a pile and compose when you're ready."
    >
      <Fragment slot="actions">
        <button id="cl-new-btn" data-cl-new class="btn btn-primary btn-sm gap-1 font-sans normal-case">
          <Icon name="ph:plus" /> New constellation
        </button>
      </Fragment>
    </PageHeader>

    <p id="cl-error" hidden role="alert" class="admin-alert mb-4"></p>

    <form
      id="new-constellation"
      hidden
      class="rounded-box border-base-300 bg-base-200/50 mb-6 flex flex-wrap items-end gap-3 border p-4"
    >
      <div class="grow">
        <label class="f__k" for="cl-new-name">Name it</label>
        <input
          id="cl-new-name"
          name="name"
          required
          placeholder="A new way of seeing…"
          class="input input-sm input-bordered font-display w-full max-w-sm text-base"
        />
      </div>
      <div class="flex items-center gap-2">
        <button type="button" id="cl-new-cancel" class="btn btn-ghost btn-sm font-sans normal-case">Cancel</button>
        <button type="submit" class="btn btn-primary btn-sm font-sans normal-case">Create &amp; compose</button>
      </div>
      <p class="admin-hint w-full">It starts as a draft — invisible in the sky until you publish it.</p>
    </form>

    {
      rows.length === 0 ? (
        <EmptyState title="No constellations yet." hint="Name the first way of seeing, and the sky begins.">
          {/* ⚠ THE SAME BUTTON AS THE HEADER'S, NOT A SECOND ONE (plan 38 ·
              §4.2). The form it opens is `hidden` until asked for, so an empty
              room described a door — "name the first way of seeing" — whose only
              control was a header button folded over a collapsed form.

              `data-cl-new` rather than a second id: `constellations-index.ts`
              binds the toggle across every element carrying it, so this is one
              control in two places and there is no second code path to keep in
              step. An `id` cannot be in two places, which is exactly why the
              script had to change shape for this. */}
          <button type="button" data-cl-new class="btn btn-sm zone__cta cn-gold mt-4 gap-1 font-sans">
            <Icon name="ph:plus" /> Name the first
          </button>
        </EmptyState>
      ) : (
        <ul id="cl-list" class="divide-base-300 rounded-box border-base-300 bg-base-200/50 divide-y border">
          {rows.map((c) => (
            /* `data-name` and `data-slug` ride along for what stays on the
               PAGE — the delete confirmation names the constellation, and a
               recolour announces `{id, name, slug, color}` to anything else
               mounted beside this list. They are no longer sent anywhere:
               `data-status` went with the last caller that resent a whole row
               to change one field (see `fieldForm` in the script). */
            <li
              class:list={['group flex items-center gap-3 px-4 py-3', `cn-${c.color}`]}
              data-id={c.id}
              data-name={c.name}
              data-slug={c.slug}
              data-color={c.color}
              draggable="true"
            >
              <span
                class="text-base-content/25 group-hover:text-base-content/50 shrink-0 cursor-grab transition-colors select-none"
                title="Drag to reorder (or Alt+↑/↓)"
                aria-hidden="true"
              >
                ⋮⋮
              </span>
              {/* The row's own star IS the colour control (see the popover below). */}
              <button
                type="button"
                data-color-btn
                class="cn-star-btn shrink-0"
                style="color: var(--cn)"
                aria-haspopup="dialog"
                aria-expanded="false"
                aria-label={`Star colour for ${c.name} — currently ${c.color}`}
                title={`Star colour — ${c.color}`}
              >
                <StarMark />
              </button>
              <div class="min-w-0 grow">
                <div class="flex flex-wrap items-center gap-x-2.5 gap-y-1">
                  <a href={`/admin/constellations/${c.id}`} class="font-display text-lg hover:underline">
                    {c.name}
                  </a>
                  <StatusChip status={c.status} />
                </div>
                <p class="text-base-content/45 mt-0.5 font-sans text-xs">
                  {c.total === 0 ? 'nothing composed yet' : `${c.total} placed`}
                  {c.total > 0 && c.total !== c.published && ` · ${c.published} public`}
                </p>
              </div>
              {/* `.row-nudge` deletes these on a hovering device: with a pointer
                  you drag the ⋮⋮ and with a keyboard you Alt+↑/↓, so on a
                  desktop they would only reserve row width for a duplicate of
                  drag — and that width is what pays for the colour trigger this
                  row just gained. On a touchscreen drag doesn't exist and they
                  are the ONLY reorder path, which is why they aren't simply
                  deleted. The sky's order gets fiddled with anywhere; the
                  composer's suite is built at a desk. */}
              <span class="row-edit flex shrink-0 items-center gap-0.5">
                <button
                  type="button"
                  class="row-nudge btn btn-ghost btn-xs"
                  data-move="up"
                  title="Move up"
                  aria-label={`Move ${c.name} up`}
                >
                  <Icon name="ph:arrow-up" />
                </button>
                <button
                  type="button"
                  class="row-nudge btn btn-ghost btn-xs"
                  data-move="down"
                  title="Move down"
                  aria-label={`Move ${c.name} down`}
                >
                  <Icon name="ph:arrow-down" />
                </button>
                <button
                  type="button"
                  class="btn btn-ghost btn-xs font-sans normal-case"
                  data-toggle-status={c.status}
                  data-name={c.name}
                >
                  {c.status === 'published' ? 'Unpublish' : 'Publish'}
                </button>
                <button
                  type="button"
                  class="btn btn-ghost btn-xs text-error"
                  data-delete
                  data-name={c.name}
                  title="Delete"
                  aria-label={`Delete ${c.name}`}
                >
                  <Icon name="ph:trash" />
                </button>
              </span>
            </li>
          ))}
        </ul>
      )
    }

    {
      /* THE COLOUR PICKER — one popover, reused by every row.
        (docs/plans/16 · Piece 3.)

        A POPOVER RATHER THAN INLINE SWATCHES, because the rest of the list has
        to stay visible behind it — that is the entire point of the control
        being in this room. Eight inline swatches per row was the alternative
        and it scales badly: fine at four constellations, 120 swatches at
        fifteen, and it would push the name out of a row that already carries a
        grip, a status chip and four buttons.

        ONE element, not one per row: the popover is positioned against
        whichever star opened it, so N copies would be N times the DOM for a
        thing only ever open once.

        `popover` (the native attribute) rather than a hand-rolled dropdown,
        because it renders in the TOP LAYER — a menu absolutely positioned
        inside a list is either covered by the sticky admin header or clipped by
        an ancestor's overflow, and both failures are invisible to typecheck, to
        build and to a screenshot of the closed state. It also brings
        outside-click and Escape for free.

        THE COUNTS ARE THE POINT. The judgement being made is "is this
        distinguishable from its neighbours", so how many constellations already
        wear each slot belongs on screen rather than in your memory of the list
        you just scrolled past. This is exactly what `leastUsedSlot` knows when
        it picks automatically — surfaced, at last, for the human doing it by
        hand. */
    }
    {
      /* ONE RANK OF EIGHT, not a 4×2 block. Measured rather than assumed: the
        square version stood three rows of the list tall, so it covered the
        neighbours it exists to let you compare against. Laid out flat it is the
        whole ramp, hot → cool, in the order design.md §13 defines it — and the
        thing you are judging (does this read apart from the others?) is exactly
        what a single line of eight is for. */
    }
    <div id="cl-colors" popover class="cl-colors rounded-box border-base-300 bg-base-100 border px-2 py-1.5 shadow-lg">
      <div class="flex items-end gap-0.5" role="group" aria-labelledby="cl-colors-label">
        {
          COLOR_SLOTS.map((slot) => (
            <button type="button" class="cn-slot" data-slot={slot} aria-pressed="false">
              <span class:list={['cn-swatch', `cn-${slot}`]}>
                <StarMark />
              </span>
              <span class="cn-slot__n" data-count aria-hidden="true" />
              <span class="sr-only">{slot}</span>
            </button>
          ))
        }
      </div>
      {
        /* The numerals need one word to be numerals OF something. Everything
          else about why this control is in this room is in the code comments
          and in the plan — a paragraph of reasoning on screen is a paragraph
          you read once and scroll past forever. */
      }
      <p id="cl-colors-label" class="admin-hint mt-1 text-center text-[0.65rem]">how many wear each</p>
    </div>
  </div>
</AdminLayout>

<script>
  import '../../../scripts/constellations-index';
</script>

---
/*
  /admin/constellations/[id] — the Composer (design.md §13; the composing room).

  Two stacked concerns, in the order you think about them:
   1. THE CONSTELLATION — its name (edited in place, as the page title), then a
      labelled settings card: slug, visibility, description, score. One primary
      Save; Preview opens the real public page; Delete sits apart, below a rule.
   2. THE SUITE — in two views over one sequence, under count badges reading
      the constellation's shape at a glance:
        • COMPOSE — dense editable rows in composed order (drag, or Alt+↑/↓;
          the arrow buttons survive on touch only, where drag doesn't exist).
          ✕ unplaces, never deletes.
        • READ — the same stanzas the public sky sets (SuiteStanza, verbatim),
          so a composition is judged on the writing rather than on truncated
          snips, and DRAFTS are included — which the public page can't show.
      One Add button opens the FragmentBrowser (the Fragment Manager in
      miniature). Every fragment edits in an overlay, so composing is never
      interrupted by a navigation.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import TypeMark from '../../../components/admin/TypeMark.astro';
import TypeCount from '../../../components/admin/TypeCount.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import FragmentSheet from '../../../components/admin/FragmentSheet.astro';
import WritingSheet from '../../../components/admin/WritingSheet.astro';
import FragmentBrowser from '../../../components/admin/FragmentBrowser.astro';
import Reader from '../../../components/Reader.astro';
import PostArticle from '../../../components/PostArticle.astro';
import SuiteStanza from '../../../components/SuiteStanza.astro';
import { FRAGMENT_TYPES, TYPE_META, type FragmentType } from '../../../lib/fragments-display';
import { excerpt, readingMinutes } from '../../../lib/markdown';
import type { SuiteItem } from '../../../lib/constellations';
import { revealOf } from '../../../lib/provenance';
import { suiteHints } from '../../../lib/suite-shape';
import type { SubjectRef } from '../../../lib/blog';
import { PAIRED_SELECT, pairedMediaOf } from '../../../lib/blog';
import { allFragmentPeople } from '../../../lib/hq/links';
import StarMark from '../../../components/StarMark.astro';

const sb = Astro.locals.supabase;
const { id = '' } = Astro.params;

const { data: c } = await sb
  .from('constellations')
  .select('id, name, slug, description, status, score_url, color')
  .eq('id', id)
  .maybeSingle();
if (!c) return Astro.redirect('/admin/constellations');

const [
  { data: placements },
  { data: allLinks },
  { data: allConstellations },
  { data: subjectRows },
  { data: authors },
  { data: works },
  { data: people },
] = await Promise.all([
  sb
    .from('fragment_constellations')
    .select(
      // `details` comes in via PAIRED_SELECT rather than being named twice.
      // `is_self` and `details` join `authors`/`works` in feeding the Read
      // view's citation reveal (2026-08-05, plan 17a) — the composer previews
      // what a reader gets, so it has to derive from the same three facts.
      `position, fragments!inner(id, type, slug, title, body, excerpt, attribution, is_self, details, source_url, status, occurred_at, updated_at, date_precision, author_id, work_id, deleted_at, authors(name), works(title), fragment_subjects(subjects(name, slug)), ${PAIRED_SELECT})`,
    )
    .eq('constellation_id', c.id)
    .is('fragments.deleted_at', null)
    .order('position'),
  sb.from('fragment_constellations').select('fragment_id, constellation_id'),
  sb.from('constellations').select('id, name, slug, description, color').order('sort'),
  sb.from('subjects').select('name').order('name'),
  sb.from('authors').select('id, name').order('name'),
  sb.from('works').select('id, title, author_id').order('title'),
  // The roster, for the sheet's "Shared by" field (12 · Piece 3). Passed
  // here as well as from /admin/fragments on purpose: a field that exists in
  // one room and silently not in the other is worse than not having it.
  sb.from('people').select('id, display_name').order('display_name'),
]);

// `fragment_id -> person_id[]`, so opening a sheet needs no round trip.
const sharedBy = await allFragmentPeople(sb);

const snip = (s: string | null | undefined, max = 110) => (s ?? '').replace(/\s+/g, ' ').trim().slice(0, max);

// how many OTHER constellations each fragment lives in (the ✦×n hint)
const elsewhere = new Map<string, number>();
for (const l of allLinks ?? []) {
  if (l.constellation_id === c.id) continue;
  elsewhere.set(l.fragment_id, (elsewhere.get(l.fragment_id) ?? 0) + 1);
}

const suite = (placements ?? []).map((p) => {
  const f = p.fragments as unknown as {
    id: string;
    type: FragmentType;
    slug: string;
    title: string | null;
    body: string | null;
    excerpt: string | null;
    attribution: string | null;
    source_url: string | null;
    status: string;
    occurred_at: string;
    updated_at: string | null;
    date_precision: 'day' | 'year';
    details: Record<string, unknown> | null;
    author_id: string | null;
    work_id: string | null;
    authors: { name: string } | null;
    works: { title: string } | null;
    fragment_subjects: { subjects: SubjectRef | null }[] | null;
  };
  const subjects = (f.fragment_subjects ?? [])
    .map((fs) => fs.subjects?.name)
    .filter(Boolean)
    .join(', ');
  // the FragmentSheet edit payload (same shape FragmentRow emits)
  const editorData =
    f.type === 'writing'
      ? null
      : JSON.stringify({
          id: f.id,
          type: f.type,
          title: f.title,
          body: f.body,
          attribution: f.attribution,
          source_url: f.source_url,
          status: f.status,
          year: (f.details as { year?: number } | null)?.year ?? null,
          occurredIso: f.occurred_at,
          datePrecision: f.date_precision,
          authorId: f.author_id,
          authorName: f.authors?.name ?? '',
          workId: f.work_id,
          workName: f.works?.title ?? '',
          subjects,
          details: f.details ?? {},
          constellationIds: (allLinks ?? []).filter((l) => l.fragment_id === f.id).map((l) => l.constellation_id),
        });
  // The Read view's stanza — the SAME SuiteItem shape the public sky renders,
  // built from this admin query so DRAFT fragments are included (the public
  // `getConstellation` stays published-only, deliberately).
  const authored = (f.excerpt ?? '').trim();
  const lede = authored || excerpt(f.body, 400);
  const read: SuiteItem =
    f.type === 'quote'
      ? { kind: 'quote', body: f.body ?? '', attribution: f.attribution, reveal: revealOf(f) }
      : f.type === 'song'
        ? {
            kind: 'song',
            title: f.title || '(untitled)',
            body: f.body ?? '',
            attribution: f.attribution,
            sourceUrl: f.source_url,
          }
        : {
            kind: 'writing',
            item: {
              id: f.id,
              slug: f.slug,
              title: f.title || '(untitled)',
              bodyMarkdown: f.body ?? '',
              excerpt: lede,
              hasMore: (f.body ?? '').trim().length > lede.length,
              occurredAt: f.occurred_at,
              updatedAt: f.updated_at,
              precision: f.date_precision,
              readMinutes: readingMinutes(f.body),
              subjects: (f.fragment_subjects ?? [])
                .map((fs) => fs.subjects)
                .filter((s): s is SubjectRef => !!s)
                .sort((a, b) => a.name.localeCompare(b.name)),
              // Same PostArticle as the public Reader, so the pairing has to
              // travel here too — this is the construction site plan 04's
              // Piece 1 missed, and it is still the easy one to forget.
              paired: pairedMediaOf(f),
            },
          };

  return {
    id: f.id,
    type: f.type,
    status: f.status,
    editorData,
    read,
    summary:
      f.type === 'quote'
        ? snip(f.body)
        : f.type === 'song'
          ? `${f.title ?? ''} — ${f.attribution ?? ''}`
          : (f.title ?? '(untitled)'),
    attribution: f.type === 'quote' ? (f.attribution ?? '') : '',
    subjects: (f.fragment_subjects ?? []).map((fs) => fs.subjects?.name).filter(Boolean) as string[],
    others: elsewhere.get(f.id) ?? 0,
  };
});

// the writings placed here — their full text rides along for the Reader
const readerWritings = suite
  .map((s) => s.read)
  .filter((r): r is Extract<SuiteItem, { kind: 'writing' }> => r.kind === 'writing')
  .map((r) => r.item);

// The three tests, as instruments — never police. Hints appear only off-band.
// The thresholds themselves live in lib/constellations.ts, because the script
// below recomputes all of this after an unplace and the two must not drift.
const placedCount = suite.length;
const subjectSpread = new Set(suite.flatMap((s) => s.subjects)).size;
const mix = { writing: 0, quote: 0, song: 0 } as Record<FragmentType, number>;
for (const s of suite) mix[s.type]++;
const { size: sizeHint, spread: spreadHint } = suiteHints(placedCount, subjectSpread);

const subjectNames = (subjectRows ?? []).map((s) => s.name);
---

<AdminLayout title={c.name} active="constellations">
  <div id="ccomposer" class="mx-auto max-w-4xl px-6 py-8" data-id={c.id} data-slug={c.slug}>
    <p id="cc-error" hidden role="alert" class="admin-alert mb-4"></p>

    {/* ── 1. the constellation itself ──────────────────────────────── */}
    <form id="cc-form">
      <input type="hidden" name="id" value={c.id} />

      <PageHeader back={{ href: '/admin/constellations', label: 'Constellations' }}>
        <div slot="title" class:list={['flex items-center gap-3', `cn-${c.color}`]}>
          <span id="cc-star" class="text-xl leading-none" style="color: var(--cn)"><StarMark /></span>
          <input name="name" required value={c.name} aria-label="Constellation name" class="admin-title-input" />
        </div>
        <Fragment slot="actions">
          <span id="cc-saved" hidden class="text-success font-sans text-xs">saved</span>
          <a
            id="cc-preview"
            href={`/${c.slug}`}
            target="_blank"
            class="btn btn-ghost btn-sm gap-1.5 font-sans normal-case"
            title="Opens the real public page — a draft renders for you only"
          >
            Preview <Icon name="ph:arrow-up-right" />
          </a>
          <button type="submit" id="cc-save" class="btn btn-primary btn-sm font-sans normal-case" disabled>Save</button>
        </Fragment>
      </PageHeader>

      <div class="rounded-box border-base-300 bg-base-200/50 border p-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="admin-label" for="cc-slug">URL</label>
            <div class="flex items-center gap-1.5">
              <span class="text-base-content/40 font-mono text-xs">/</span>
              <input
                id="cc-slug"
                name="slug"
                value={c.slug}
                class="input input-sm input-bordered w-full font-mono text-xs"
              />
            </div>
            <p class="admin-hint mt-1.5">Leave blank to follow the name.</p>
          </div>
          <div>
            <label class="admin-label">Star colour</label>
            {
              /* ⚠ THE CONTROL IS DELIBERATELY NOT HERE (docs/plans/16 · Piece 3).
                Eight swatches used to sit in this card. They were moved to
                /admin/constellations, and this hint exists so their absence
                reads as a decision rather than as something missing.

                WHY: a colour slot is not a property of one constellation. It is
                a property of one constellation RELATIVE to the other seven
                slots and to whatever its neighbours are already wearing.
                Choosing it in here asked you to make a comparative judgement
                with nothing to compare against — one star, and a guess about a
                sky. The codebase already believed this: `leastUsedSlot` picks a
                new constellation's colour by looking at every OTHER
                constellation's, so the automatic choice was better informed
                than the manual one. That is backwards, and moving the control
                is what fixes it — not more polish on the swatch where it stood.

                ⚠ If a future session is tempted to put an editing control back
                here, read the rest of that plan first: the composer carries the
                saved colour as a `cn-*` class on three separate ancestors (this
                title wrapper, #suite-read, and FragmentBrowser's cached
                data-constellation-color), and none of them were repainted on
                save. Rendering the server's value and never editing it is what
                makes that class of "which copy is authoritative" bug impossible
                here, rather than merely fixed. */
            }
            <p class="admin-hint mt-1 flex items-center gap-1.5">
              <span class="text-base" style="color: var(--cn)"><StarMark /></span>
              <span>
                Chosen in <a href="/admin/constellations" class="underline">the sky</a>, where you can see what the
                others are wearing.
              </span>
            </p>
          </div>
          <div>
            <label class="admin-label" for="cc-status">Visibility</label>
            <select id="cc-status" name="status" class="select select-sm select-bordered w-full font-sans">
              <option value="draft" selected={c.status === 'draft'}>Draft — visible only to you</option>
              <option value="published" selected={c.status === 'published'}>Published — live in the sky</option>
            </select>
          </div>
        </div>

        <div class="mt-5">
          <label class="admin-label" for="cc-description">Description</label>
          <textarea
            id="cc-description"
            name="description"
            rows="3"
            class="textarea textarea-bordered w-full font-serif leading-relaxed"
            placeholder="Why this way of seeing exists — what truth it tells, how it relates to who you are."
            >{c.description}</textarea
          >
          <p class="admin-hint mt-1.5">Shown under the name on the home overview, and again as the suite's epigraph.</p>
        </div>

        <div class="mt-5">
          <label class="admin-label" for="cc-score"
            >The score <span class="normal-case opacity-70">— optional</span></label
          >
          <input
            id="cc-score"
            name="score_url"
            value={c.score_url}
            placeholder="https://open.spotify.com/playlist/…"
            class="input input-sm input-bordered w-full font-sans"
          />
          <p class="admin-hint mt-1.5">
            A Spotify playlist to play through the read; it appears above the first fragment.
          </p>
        </div>

        <div class="border-base-300 mt-5 flex items-center justify-between gap-4 border-t pt-4">
          <p class="admin-hint">Deleting removes this composition only — the fragments themselves are never touched.</p>
          <button type="button" id="cc-delete" class="btn btn-ghost btn-sm text-error gap-1.5 font-sans normal-case">
            <Icon name="ph:trash" /> Delete
          </button>
        </div>
      </div>
    </form>

    {/* ── 2. the suite ─────────────────────────────────────────────── */}
    <section class="mt-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-lg">The suite</h2>
        {
          /* Every piece of suite chrome below renders UNCONDITIONALLY and hides
            with `hidden`, rather than being branched away when the suite is
            empty. Two reasons, both about what happens after the page loads:
            the ✕ now removes rows in the browser, and taking out the LAST one
            would otherwise need markup that was never sent; and Piece 5's
            refresh swaps `innerHTML` into these containers, which means they
            have to exist for it to have somewhere to swap into. The cost is a
            few bytes of hidden markup on an empty constellation. */
        }
        <div class="flex items-center gap-2">
          <div id="suite-viewseg" class="seg" role="group" aria-label="Suite view" hidden={placedCount === 0}>
            <button type="button" class="type-badge is-active" data-view="compose" aria-pressed="true">Compose</button>
            <button type="button" class="type-badge" data-view="read" aria-pressed="false">Read</button>
          </div>
          <button type="button" data-browse class="btn btn-primary btn-sm gap-1 font-sans normal-case">
            <Icon name="ph:plus" /> Add
          </button>
        </div>
      </div>

      <div id="suite-stats" class="mt-3 flex flex-wrap items-center gap-2">
        {FRAGMENT_TYPES.map((t) => <TypeCount type={t} count={mix[t]} />)}
        <span id="suite-spread" class="admin-stat" title={spreadHint || undefined}>
          <b class="admin-stat__n">{subjectSpread}</b>
          <span class="admin-stat__label">{subjectSpread === 1 ? 'subject' : 'subjects'}</span>
        </span>
        <span id="suite-placed" class="admin-stat" title={sizeHint || undefined}>
          <b class="admin-stat__n">{placedCount}</b>
          <span class="admin-stat__label">placed</span>
        </span>
      </div>
      <p id="suite-hints" class="admin-hint mt-2" hidden={!(sizeHint || spreadHint)}>
        {[sizeHint, spreadHint].filter(Boolean).join(' · ')}
      </p>

      <div
        id="suite-empty"
        class="rounded-box border-base-300 mt-4 border border-dashed px-6 py-12 text-center"
        hidden={placedCount > 0}
      >
        <p class="font-display text-base-content/60 text-lg">Nothing placed yet.</p>
        <p class="admin-hint mt-1">
          Press <b>Add</b> to browse everything you've written, quoted, or heard — or make something new inside it.
        </p>
      </div>

      <ol
        id="suite-rows"
        class="divide-base-300 rounded-box border-base-300 bg-base-200/50 mt-4 divide-y border"
        hidden={placedCount === 0}
      >
        {
          /* `data-subjects` rides on every row because the subject-spread badge
            is recomputed in the browser after an unplace — the row that leaves
            takes its subjects with it, and the union of what remains can only be
            read off the rows. Pipe-joined: a subject name may contain a comma. */
          suite.map((s, i) => (
            <li
              class="suite-row group flex items-center gap-3 px-3 py-2.5"
              draggable="true"
              data-fid={s.id}
              data-type={s.type}
              data-subjects={s.subjects.join('|')}
              data-fragment={s.editorData}
              data-writing={s.type === 'writing' ? s.id : undefined}
            >
              <span
                class="text-base-content/25 group-hover:text-base-content/50 cursor-grab transition-colors select-none"
                title="Drag to reorder (or Alt+↑/↓)"
                aria-hidden="true"
              >
                ⋮⋮
              </span>
              <span
                data-num
                class="text-base-content/35 w-4 shrink-0 text-right font-sans text-xs tabular-nums"
                aria-hidden="true"
              >
                {i + 1}
              </span>
              <TypeMark type={s.type} class="w-4 text-center" />
              <button
                type="button"
                class="row-open min-w-0 grow truncate text-left font-serif text-[0.95rem]"
                data-open
              >
                {s.summary}
                {s.attribution && <span class="text-base-content/45 ml-1.5 font-sans text-xs">— {s.attribution}</span>}
              </button>
              {s.status === 'draft' && <StatusChip status={s.status} />}
              {s.others > 0 && (
                <span
                  class="text-base-content/40 font-sans text-xs"
                  title={`Also lives in ${s.others} other constellation${s.others > 1 ? 's' : ''}`}
                >
                  <StarMark />
                  &times;{s.others + 1}
                </span>
              )}
              {/* The nudges are the TOUCH path only — with a pointer you drag,
                  and with a keyboard you Alt+↑/↓. On a hovering device they'd
                  reserve row width for a duplicate of drag, so `.row-nudge`
                  removes them there entirely (app.css). */}
              <span class="row-edit flex shrink-0 items-center gap-0.5">
                <button
                  type="button"
                  class="row-nudge btn btn-ghost btn-xs"
                  data-move="up"
                  title="Move up"
                  aria-label="Move up"
                >
                  <Icon name="ph:arrow-up" />
                </button>
                <button
                  type="button"
                  class="row-nudge btn btn-ghost btn-xs"
                  data-move="down"
                  title="Move down"
                  aria-label="Move down"
                >
                  <Icon name="ph:arrow-down" />
                </button>
                <button
                  type="button"
                  class="btn btn-ghost btn-xs text-error/70"
                  data-unplace
                  title="Remove from this constellation"
                  aria-label="Remove from this constellation"
                >
                  <Icon name="ph:x" />
                </button>
              </span>
            </li>
          ))
        }
      </ol>

      {
        /* ── the Read view ────────────────────────────────────────────────
          The same stanzas the sky sets (SuiteStanza, verbatim), so composing
          can be judged on the writing rather than on 110-character snips —
          and it includes DRAFTS, which the public page can't show. It stops
          at the content on purpose: the arcs, the lamplight and the score are
          Preview's job. Read asks "is this composition any good?"; Preview
          asks "does the page look right?" */
      }
      <div id="suite-read" class:list={['mt-8', `cn-${c.color}`]} hidden>
        {
          c.description && (
            <p class="prose-measure border-base-300 text-base-content/55 border-l pl-5 text-lg italic">
              {c.description}
            </p>
          )
        }
        <div id="suite-read-list" class="mt-10 flex flex-col gap-14">
          {
            suite.map((s, i) => (
              <article
                class:list={['group flex gap-4 sm:gap-6', s.type === 'writing' && 'suite-writing']}
                data-fid={s.id}
                data-type={s.type}
                data-fragment={s.editorData}
                data-writing={s.type === 'writing' ? s.id : undefined}
              >
                <div class="flex w-6 shrink-0 flex-col items-center gap-1">
                  <span class="suite-mark text-base-content/35 font-serif text-base select-none" aria-hidden="true">
                    {TYPE_META[s.type].glyph}
                  </span>
                  <span data-num class="text-base-content/30 font-sans text-[0.65rem] tabular-nums" aria-hidden="true">
                    {i + 1}
                  </span>
                  <button
                    type="button"
                    class="row-edit btn btn-ghost btn-xs mt-0.5 px-1"
                    data-open
                    title="Edit this fragment"
                    aria-label="Edit this fragment"
                  >
                    <Icon name="ph:pencil-simple" />
                  </button>
                </div>
                <div class="min-w-0 grow">
                  {s.status === 'draft' && (
                    <div class="mb-2">
                      <StatusChip status={s.status} />
                    </div>
                  )}
                  <SuiteStanza item={s.read} />
                </div>
              </article>
            ))
          }
        </div>
      </div>
    </section>
  </div>

  {
    /* Essays open in the blog's own Reader — the same component, the same
      PostArticle, so a piece reads here exactly as it will out there. */
  }
  <Reader />
  {
    readerWritings.map((w) => (
      <template data-reader-content={w.slug}>
        <PostArticle item={w} linkTitle />
      </template>
    ))
  }

  <FragmentSheet
    subjects={subjectNames}
    authors={authors ?? []}
    works={(works ?? []).map((w) => ({ id: w.id, title: w.title, authorId: w.author_id }))}
    constellations={allConstellations ?? []}
    people={people ?? []}
    sharedBy={sharedBy}
  />
  <WritingSheet subjects={subjectNames} constellations={allConstellations ?? []} />
  <FragmentBrowser
    constellation={c.id}
    constellationName={c.name}
    constellationDescription={c.description}
    constellationColor={c.color}
  />
</AdminLayout>

<script>
  import '../../../scripts/constellation-composer';
</script>

---
/*
  /admin/constellations/[id] — the Composer (design.md §13; the composing room).

  Two stacked concerns, in the order you think about them:
   1. THE CONSTELLATION — its name (edited in place, as the page title), then a
      labelled settings card: slug, visibility, description, score. One primary
      Save; Preview opens the real public page; Delete sits apart, below a rule.
   2. THE SUITE — dense editable rows in composed order (drag or nudge; ✕
      unplaces, never deletes), under count badges reading the constellation's
      shape at a glance. One Add button opens the FragmentBrowser (the Fragment
      Manager in miniature). Every fragment edits in an overlay, so composing is
      never interrupted by a navigation.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PageHeader from '../../../components/admin/PageHeader.astro';
import TypeMark from '../../../components/admin/TypeMark.astro';
import TypeCount from '../../../components/admin/TypeCount.astro';
import StatusChip from '../../../components/admin/StatusChip.astro';
import FragmentSheet from '../../../components/admin/FragmentSheet.astro';
import WritingSheet from '../../../components/admin/WritingSheet.astro';
import FragmentBrowser from '../../../components/admin/FragmentBrowser.astro';
import type { FragmentType } from '../../../lib/fragments-display';
import { COLOR_SLOTS } from '../../../lib/constellation-colors';

const sb = Astro.locals.supabase;
const { id = '' } = Astro.params;

const { data: c } = await sb
  .from('constellations')
  .select('id, name, slug, description, status, score_url, color')
  .eq('id', id)
  .maybeSingle();
if (!c) return Astro.redirect('/admin/constellations');

const [{ data: placements }, { data: allLinks }, { data: allConstellations }, { data: subjectRows }, { data: authors }, { data: works }] =
  await Promise.all([
    sb
      .from('fragment_constellations')
      .select(
        'position, fragments!inner(id, type, slug, title, body, attribution, source_url, status, occurred_at, date_precision, details, author_id, work_id, deleted_at, authors(name), works(title), fragment_subjects(subjects(name)))'
      )
      .eq('constellation_id', c.id)
      .is('fragments.deleted_at', null)
      .order('position'),
    sb.from('fragment_constellations').select('fragment_id, constellation_id'),
    sb.from('constellations').select('id, name, slug, description, color').order('sort'),
    sb.from('subjects').select('name').order('name'),
    sb.from('authors').select('id, name').order('name'),
    sb.from('works').select('id, title, author_id').order('title'),
  ]);

const snip = (s: string | null | undefined, max = 110) => (s ?? '').replace(/\s+/g, ' ').trim().slice(0, max);

// how many OTHER constellations each fragment lives in (the ✦×n hint)
const elsewhere = new Map<string, number>();
for (const l of allLinks ?? []) {
  if (l.constellation_id === c.id) continue;
  elsewhere.set(l.fragment_id, (elsewhere.get(l.fragment_id) ?? 0) + 1);
}

const suite = (placements ?? []).map((p) => {
  const f = p.fragments as unknown as {
    id: string; type: FragmentType; slug: string; title: string | null; body: string | null;
    attribution: string | null; source_url: string | null; status: string; occurred_at: string;
    date_precision: string; details: Record<string, unknown> | null; author_id: string | null; work_id: string | null;
    authors: { name: string } | null; works: { title: string } | null;
    fragment_subjects: { subjects: { name: string } | null }[] | null;
  };
  const subjects = (f.fragment_subjects ?? []).map((fs) => fs.subjects?.name).filter(Boolean).join(', ');
  // the FragmentSheet edit payload (same shape FragmentRow emits)
  const editorData =
    f.type === 'writing'
      ? null
      : JSON.stringify({
          id: f.id, type: f.type, title: f.title, body: f.body, attribution: f.attribution,
          source_url: f.source_url, status: f.status,
          year: (f.details as { year?: number } | null)?.year ?? null,
          occurredIso: f.occurred_at, datePrecision: f.date_precision,
          authorId: f.author_id, authorName: f.authors?.name ?? '',
          workId: f.work_id, workName: f.works?.title ?? '',
          subjects, details: f.details ?? {},
          constellationIds: (allLinks ?? []).filter((l) => l.fragment_id === f.id).map((l) => l.constellation_id),
        });
  return {
    id: f.id, type: f.type, status: f.status, editorData,
    summary: f.type === 'quote' ? snip(f.body) : f.type === 'song' ? `${f.title ?? ''} — ${f.attribution ?? ''}` : (f.title ?? '(untitled)'),
    attribution: f.type === 'quote' ? (f.attribution ?? '') : '',
    subjects: (f.fragment_subjects ?? []).map((fs) => fs.subjects?.name).filter(Boolean) as string[],
    others: elsewhere.get(f.id) ?? 0,
  };
});

// The three tests, as instruments — never police. Hints appear only off-band.
const placedCount = suite.length;
const subjectSpread = new Set(suite.flatMap((s) => s.subjects)).size;
const mix = { writing: 0, quote: 0, song: 0 } as Record<FragmentType, number>;
for (const s of suite) mix[s.type]++;
const sizeHint =
  placedCount === 0 ? '' : placedCount < 5 ? 'thin — a constellation usually holds ~5–15' : placedCount > 15 ? 'heavy — two constellations fused? (~5–15)' : '';
const spreadHint = placedCount > 0 && subjectSpread < 3 ? 'narrow — a way of seeing usually crosses ≥3 subjects' : '';

const subjectNames = (subjectRows ?? []).map((s) => s.name);
const TYPES = ['writing', 'quote', 'song'] as const;
---

<AdminLayout title={c.name} active="constellations">
  <div id="ccomposer" class="mx-auto max-w-4xl px-6 py-8" data-id={c.id} data-slug={c.slug}>
    <p id="cc-error" hidden role="alert" class="admin-alert mb-4"></p>

    {/* ── 1. the constellation itself ──────────────────────────────── */}
    <form id="cc-form">
      <input type="hidden" name="id" value={c.id} />

      <PageHeader back={{ href: '/admin/constellations', label: 'Constellations' }}>
        <div slot="title" class:list={['flex items-center gap-3', `cn-${c.color}`]}>
          <span id="cc-star" class="font-display text-xl leading-none" style="color: var(--cn)" aria-hidden="true">&#10022;</span>
          <input name="name" required value={c.name} aria-label="Constellation name" class="admin-title-input" />
        </div>
        <Fragment slot="actions">
          <span id="cc-saved" hidden class="font-sans text-xs text-success">saved</span>
          <a
            id="cc-preview"
            href={`/${c.slug}`}
            target="_blank"
            class="btn btn-ghost btn-sm gap-1.5 font-sans normal-case"
            title="Opens the real public page — a draft renders for you only"
          >
            Preview <Icon name="ph:arrow-up-right" />
          </a>
          <button type="submit" id="cc-save" class="btn btn-primary btn-sm font-sans normal-case" disabled>Save</button>
        </Fragment>
      </PageHeader>

      <div class="rounded-box border border-base-300 bg-base-200/50 p-5">
        <div class="grid gap-5 sm:grid-cols-2">
          <div>
            <label class="admin-label" for="cc-slug">URL</label>
            <div class="flex items-center gap-1.5">
              <span class="font-mono text-xs text-base-content/40">/</span>
              <input id="cc-slug" name="slug" value={c.slug} class="input input-sm input-bordered w-full font-mono text-xs" />
            </div>
            <p class="admin-hint mt-1.5">Leave blank to follow the name.</p>
          </div>
          <div>
            <label class="admin-label">Star colour</label>
            {/* The colour is a SLOT, not a value — app.css owns what each means
                in dusk and paper (design.md §13). It tints this constellation's
                star out front, its lamplight inside, and its chips in here. */}
            <div class="flex flex-wrap items-center gap-1.5" role="radiogroup" aria-label="Star colour">
              {COLOR_SLOTS.map((slot) => (
                <label class:list={['cn-swatch', `cn-${slot}`, c.color === slot && 'is-active']} title={slot}>
                  <input type="radio" name="color" value={slot} checked={c.color === slot} class="sr-only" />
                  <span aria-hidden="true">&#10022;</span>
                  <span class="sr-only">{slot}</span>
                </label>
              ))}
            </div>
          </div>
          <div>
            <label class="admin-label" for="cc-status">Visibility</label>
            <select id="cc-status" name="status" class="select select-sm select-bordered w-full font-sans">
              <option value="draft" selected={c.status === 'draft'}>Draft — visible only to you</option>
              <option value="published" selected={c.status === 'published'}>Published — live in the sky</option>
            </select>
          </div>
        </div>

        <div class="mt-5">
          <label class="admin-label" for="cc-description">Description</label>
          <textarea id="cc-description" name="description" rows="3" class="textarea textarea-bordered w-full font-serif leading-relaxed"
            placeholder="Why this way of seeing exists — what truth it tells, how it relates to who you are.">{c.description}</textarea>
          <p class="admin-hint mt-1.5">Shown under the name on the home overview, and again as the suite's epigraph.</p>
        </div>

        <div class="mt-5">
          <label class="admin-label" for="cc-score">The score <span class="normal-case opacity-70">— optional</span></label>
          <input
            id="cc-score"
            name="score_url"
            value={c.score_url}
            placeholder="https://open.spotify.com/playlist/…"
            class="input input-sm input-bordered w-full font-sans"
          />
          <p class="admin-hint mt-1.5">A Spotify playlist to play through the read; it appears above the first fragment.</p>
        </div>

        <div class="mt-5 flex items-center justify-between gap-4 border-t border-base-300 pt-4">
          <p class="admin-hint">Deleting removes this composition only — the fragments themselves are never touched.</p>
          <button type="button" id="cc-delete" class="btn btn-ghost btn-sm gap-1.5 font-sans text-error normal-case">
            <Icon name="ph:trash" /> Delete
          </button>
        </div>
      </div>
    </form>

    {/* ── 2. the suite ─────────────────────────────────────────────── */}
    <section class="mt-10">
      <div class="flex flex-wrap items-center justify-between gap-3">
        <h2 class="font-display text-lg">The suite</h2>
        <button type="button" data-browse class="btn btn-primary btn-sm gap-1 font-sans normal-case">
          <Icon name="ph:plus" /> Add
        </button>
      </div>

      <div class="mt-3 flex flex-wrap items-center gap-2">
        {TYPES.map((t) => <TypeCount type={t} count={mix[t]} />)}
        <span class="admin-stat" title={spreadHint || undefined}>
          <b class="admin-stat__n">{subjectSpread}</b>
          <span class="admin-stat__label">{subjectSpread === 1 ? 'subject' : 'subjects'}</span>
        </span>
        <span class="admin-stat" title={sizeHint || undefined}>
          <b class="admin-stat__n">{placedCount}</b>
          <span class="admin-stat__label">placed</span>
        </span>
      </div>
      {
        (sizeHint || spreadHint) && (
          <p class="admin-hint mt-2">{[sizeHint, spreadHint].filter(Boolean).join(' · ')}</p>
        )
      }

      {suite.length === 0 ? (
        <div class="mt-4 rounded-box border border-dashed border-base-300 px-6 py-12 text-center">
          <p class="font-display text-lg text-base-content/60">Nothing placed yet.</p>
          <p class="admin-hint mt-1">Press <b>Add</b> to browse everything you've written, quoted, or heard — or make something new inside it.</p>
        </div>
      ) : (
        <ol id="suite-rows" class="mt-4 divide-y divide-base-300 rounded-box border border-base-300 bg-base-200/50">
          {suite.map((s, i) => (
            <li
              class="suite-row group flex items-center gap-3 px-3 py-2.5"
              draggable="true"
              data-fid={s.id}
              data-type={s.type}
              data-fragment={s.editorData}
              data-writing={s.type === 'writing' ? s.id : undefined}
            >
              <span class="cursor-grab text-base-content/25 transition-colors select-none group-hover:text-base-content/50" title="Drag to reorder" aria-hidden="true">⋮⋮</span>
              <span data-num class="w-4 shrink-0 text-right font-sans text-xs tabular-nums text-base-content/35" aria-hidden="true">{i + 1}</span>
              <TypeMark type={s.type} class="w-4 text-center" />
              <button type="button" class="row-open min-w-0 grow truncate text-left font-serif text-[0.95rem]" data-open>
                {s.summary}
                {s.attribution && <span class="ml-1.5 font-sans text-xs text-base-content/45">— {s.attribution}</span>}
              </button>
              {s.status === 'draft' && <StatusChip status={s.status} />}
              {s.others > 0 && (
                <span class="font-sans text-xs text-base-content/40" title={`Also lives in ${s.others} other constellation${s.others > 1 ? 's' : ''}`}>
                  &#10022;&times;{s.others + 1}
                </span>
              )}
              <span class="row-edit flex shrink-0 items-center gap-0.5">
                <button type="button" class="btn btn-ghost btn-xs" data-move="up" title="Move up" aria-label="Move up"><Icon name="ph:arrow-up" /></button>
                <button type="button" class="btn btn-ghost btn-xs" data-move="down" title="Move down" aria-label="Move down"><Icon name="ph:arrow-down" /></button>
                <button type="button" class="btn btn-ghost btn-xs text-error/70" data-unplace title="Remove from this constellation" aria-label="Remove from this constellation">
                  <Icon name="ph:x" />
                </button>
              </span>
            </li>
          ))}
        </ol>
      )}
    </section>
  </div>

  <FragmentSheet
    subjects={subjectNames}
    authors={authors ?? []}
    works={(works ?? []).map((w) => ({ id: w.id, title: w.title, authorId: w.author_id }))}
    constellations={allConstellations ?? []}
  />
  <WritingSheet subjects={subjectNames} constellations={allConstellations ?? []} />
  <FragmentBrowser
    constellation={c.id}
    constellationName={c.name}
    constellationDescription={c.description}
    constellationColor={c.color}
  />
</AdminLayout>

<script>
  import { actions } from 'astro:actions';
  import { confirmDialog } from '../../../scripts/confirm-dialog';
  import { formatActionError } from '../../../scripts/action-error';

  const root = document.getElementById('ccomposer')!;
  const cid = root.dataset.id!;
  // anything the editor sheets save on this page joins this suite
  document.body.dataset.placeIn = cid;

  const errBox = document.getElementById('cc-error') as HTMLParagraphElement;
  const show = (m: string) => ((errBox.textContent = m), (errBox.hidden = false));

  // ── the constellation form: save is armed only by an actual edit ───
  const form = document.getElementById('cc-form') as HTMLFormElement;
  const saveBtn = document.getElementById('cc-save') as HTMLButtonElement;
  const savedFlash = document.getElementById('cc-saved')!;
  let dirty = false;
  const setDirty = () => {
    dirty = true;
    saveBtn.disabled = false;
    savedFlash.hidden = true;
  };
  form.addEventListener('input', setDirty);
  form.addEventListener('change', setDirty);
  window.addEventListener('beforeunload', (e) => {
    if (dirty) {
      e.preventDefault();
      e.returnValue = '';
    }
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    saveBtn.disabled = true;
    const { data, error } = await actions.constellations.save(new FormData(form));
    if (error) {
      saveBtn.disabled = false;
      return show(formatActionError(error));
    }
    errBox.hidden = true;
    dirty = false;
    if (data?.slug) {
      root.dataset.slug = data.slug;
      (document.getElementById('cc-slug') as HTMLInputElement).value = data.slug;
      (document.getElementById('cc-preview') as HTMLAnchorElement).href = `/${data.slug}`;
    }
    savedFlash.hidden = false;
    setTimeout(() => (savedFlash.hidden = true), 1600);
  });

  document.getElementById('cc-delete')?.addEventListener('click', async () => {
    const ok = await confirmDialog({
      title: 'Delete constellation',
      message: 'Delete this constellation? Its composition is lost; the fragments themselves are untouched.',
      confirmLabel: 'Delete',
      danger: true,
    });
    if (!ok) return;
    const fd = new FormData();
    fd.set('id', cid);
    const { error } = await actions.constellations.remove(fd);
    if (error) return show(formatActionError(error));
    dirty = false; // don't fight the unload guard on the way out
    location.href = '/admin/constellations';
  });

  // ── the suite: reorder / unplace / open ────────────────────────────
  const rows = document.getElementById('suite-rows');

  async function persistOrder() {
    if (!rows) return;
    const ids = [...rows.querySelectorAll<HTMLElement>('li[data-fid]')].map((l) => l.dataset.fid).join(',');
    if (!ids) return;
    const fd = new FormData();
    fd.set('constellation_id', cid);
    fd.set('fragment_ids', ids);
    const { error } = await actions.constellations.reorderPlacements(fd);
    if (error) show(formatActionError(error));
    else renumber();
  }

  /** Keep the visible position numbers honest after any reorder. */
  function renumber() {
    rows?.querySelectorAll<HTMLElement>('li[data-fid]').forEach((li, i) => {
      const n = li.querySelector('[data-num]');
      if (n) n.textContent = String(i + 1);
    });
  }

  rows?.addEventListener('click', async (e) => {
    const li = (e.target as Element).closest('li[data-fid]') as HTMLElement | null;
    if (!li) return;
    const btn = (e.target as Element).closest('button');

    if (btn?.dataset.move) {
      const sib = btn.dataset.move === 'up' ? li.previousElementSibling : li.nextElementSibling;
      if (!sib) return;
      btn.dataset.move === 'up' ? sib.before(li) : sib.after(li);
      (btn as HTMLButtonElement).focus(); // keep the keyboard where the row went
      return persistOrder();
    }
    if (btn?.hasAttribute('data-unplace')) {
      const fd = new FormData();
      fd.set('constellation_id', cid);
      fd.set('fragment_id', li.dataset.fid!);
      const { error } = await actions.constellations.unplace(fd);
      if (error) return show(formatActionError(error));
      return location.reload();
    }
    if (btn?.hasAttribute('data-open')) {
      if (li.dataset.writing) return void document.dispatchEvent(new CustomEvent('writing:edit', { detail: li.dataset.writing }));
      if (li.dataset.fragment) document.dispatchEvent(new CustomEvent('fragment:edit', { detail: li.dataset.fragment }));
    }
  });

  // drag to reorder (the nudge buttons remain the touch/keyboard path)
  let dragged: HTMLElement | null = null;
  rows?.addEventListener('dragstart', (e) => {
    dragged = (e.target as Element).closest('li[data-fid]');
    if (dragged) {
      dragged.classList.add('is-dragging');
      e.dataTransfer?.setData('text/plain', dragged.dataset.fid!);
    }
  });
  rows?.addEventListener('dragover', (e) => {
    e.preventDefault();
    const over = (e.target as Element).closest('li[data-fid]') as HTMLElement | null;
    if (!over || !dragged || over === dragged) return;
    const r = over.getBoundingClientRect();
    e.clientY < r.top + r.height / 2 ? over.before(dragged) : over.after(dragged);
  });
  rows?.addEventListener('drop', (e) => {
    e.preventDefault();
    dragged?.classList.remove('is-dragging');
    if (dragged) persistOrder();
    dragged = null;
  });
  rows?.addEventListener('dragend', () => {
    dragged?.classList.remove('is-dragging');
    dragged = null;
  });
</script>

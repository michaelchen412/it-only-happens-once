---
/*
  /admin/people/[slug] — THE PROFILE (docs/plans/archive/12-people.md §4, ADR-0012).

  A FULL PAGE, NOT A SHEET, and that is a deliberate departure from admin.md
  §3.6, which retired the standalone writing page in favour of overlays
  everywhere. That decision was about *editing context*: clicking an essay while
  composing a constellation threw you out of the room you were working in. A
  profile has no analogous host — it is a reading destination you navigate to on
  purpose, and it is long and multi-sectioned in a way a sheet would cramp. The
  things you *do* here are still overlays: adding and editing are PersonSheet.

  ⚠ NO PRONOUNS IN ANY SYSTEM-AUTHORED LABEL (§4, 10-hq.md §10e). The prototype
  shipped headings reading "Who he is" and "From him", which quietly assumed HQ
  knows everybody's gender and would need a pronoun column to keep the promise.
  It does not get one. Every label here is neutral — About, Where, Known since —
  and pronouns appear only inside Michael's own prose, where he is the author.
  This is cheap to hold now and expensive to retrofit.

  FOUR LAYERS, ORDERED BY HOW OFTEN THEY CHANGE (§4): the fixed facts across
  the top, then the timeline in the main column — the only part that changes
  weekly and the part you scroll — with About and Shared in the rail. On a
  phone the order inverts: you open a profile on a phone to remember who
  somebody is, not to scroll a year of entries.
*/
import { Icon } from 'astro-icon/components';
import AdminLayout from '../../../layouts/AdminLayout.astro';
import PersonSheet from '../../../components/admin/PersonSheet.astro';
import { renderMarkdown } from '../../../lib/markdown';
import { dmd, fullDate, nextOccurrence } from '../../../lib/hq/dates';
import { CIRCLES, hueFor, knownFor, monogram, signPhotos, upcomingBirthday, type Person } from '../../../lib/hq/people';
import TimelineZone, { type TimelineEntry } from '../../../components/admin/TimelineZone.astro';
import SharedZone from '../../../components/admin/SharedZone.astro';
import LinkSheet from '../../../components/admin/LinkSheet.astro';
import { since } from '../../../lib/hq/interactions';
import { pickerOptions, sharedFor, type Shared } from '../../../lib/hq/links';

const { slug } = Astro.params;
const supabase = Astro.locals.supabase;

const { data: person } = await supabase.from('people').select('*').eq('slug', slug!).maybeSingle<Person>();

// The blog's pattern rather than a redirect: a real 404 status with a page that
// says so. A redirect to the roster would lose the fact that the address was
// wrong, and this is exactly where a stale bookmark lands.
if (!person) Astro.response.status = 404;

const { ymd: todayYmd } = Astro.locals.today;

/**
 * The timeline, in two queries rather than one clever embed.
 *
 * The first asks which interactions this person was at; the second fetches them
 * WITH ALL their participants, which is the part a single `!inner` join cannot
 * give you — filtering by `person_id` would also filter the participant list
 * down to this person, so every entry would report that nobody else was there.
 */
let entries: TimelineEntry[] = [];
let roster: Pick<Person, 'id' | 'display_name' | 'photo_path'>[] = [];
let shared: Shared = { works: [], fragments: [], count: 0 };
let options: Awaited<ReturnType<typeof pickerOptions>> = { works: [], fragments: [] };

if (person) {
  const { data: mine } = await supabase.from('interaction_people').select('interaction_id').eq('person_id', person.id);

  const ids = (mine ?? []).map((r) => r.interaction_id);
  if (ids.length) {
    const { data: rows } = await supabase
      .from('interactions')
      .select(
        'id, occurred_on, kind, body, created_at, updated_at, interaction_people(person_id, people(id, display_name, slug))',
      )
      .in('id', ids)
      // Newest first, and `created_at` breaks the tie: two entries logged on the
      // same day would otherwise come back in whatever order Postgres chose,
      // and the order would change between renders.
      .order('occurred_on', { ascending: false })
      .order('created_at', { ascending: false });

    entries = (rows ?? []).map((row) => {
      const links = (row.interaction_people ?? []) as {
        person_id: string;
        people: { id: string; display_name: string; slug: string } | null;
      }[];
      return {
        ...(row as unknown as TimelineEntry),
        others: links.map((l) => l.people).filter((p): p is NonNullable<typeof p> => !!p && p.id !== person.id),
      };
    });
  }

  // Everyone else who could have been there. Archived people are excluded: they
  // are out of the roster and out of search (§3), and a picker is search.
  const { data: others } = await supabase
    .from('people')
    .select('id, display_name, photo_path')
    .is('archived_at', null)
    .neq('id', person.id)
    .order('display_name');
  roster = others ?? [];

  // The shelf, and what the link picker may choose from. Two round trips that
  // only happen on a real profile — the 404 path does none of this.
  [shared, options] = await Promise.all([sharedFor(supabase, person.id), pickerOptions(supabase)]);
}

// DERIVED, never stored — `max(occurred_on)` over this person's entries. It is
// computed from what is already on the page rather than re-queried, so the
// header and the timeline below it cannot disagree.
const lastContact = entries.length ? entries[0].occurred_on : null;
const photos = person ? await signPhotos(supabase, [person.photo_path]) : new Map<string, string>();
const photoUrl = person?.photo_path ? (photos.get(person.photo_path) ?? null) : null;

const circleLabel = person ? (CIRCLES.find((c) => c.key === person.circle)?.label ?? person.circle) : '';
const known = person ? knownFor(person.known_since_year, todayYmd) : null;
const bio = renderMarkdown(person?.bio);

// The birthday always shows on the profile, unlike the card's cake — here you
// came to look somebody up, so the fact is the point rather than an
// interruption. The next occurrence is resolved so it carries a weekday: a
// month/day has no weekday until you say which year (10-hq.md §10d).
const birthdayYmd =
  person && person.birth_month != null && person.birth_day != null
    ? nextOccurrence(person.birth_month, person.birth_day, todayYmd)
    : null;
const birthdaySoon = !!(person && upcomingBirthday(person, todayYmd));
---

<AdminLayout title={person?.display_name ?? 'Not found'} active="people">
  {
    !person ? (
      <div class="mx-auto w-full max-w-4xl px-4 py-6 sm:px-6">
        <a href="/admin/people" class="admin-back mb-4 inline-flex">
          <span aria-hidden="true">←</span> People
        </a>
        <p class="font-serif text-lg">Nobody here by that name.</p>
      </div>
    ) : (
      <div class="hq-cq mx-auto w-full max-w-4xl px-4 py-6 sm:px-6" data-person-id={person.id}>
        <a href="/admin/people" class="admin-back mb-4 inline-flex">
          <span aria-hidden="true">←</span> People
        </a>

        {person.archived_at && (
          <p class="admin-hint rounded-box border-base-300 bg-base-200 mb-4 border px-3 py-2 text-xs">
            Archived — not in the roster or in search.
          </p>
        )}

        {/* 1 · THE FIXED FACTS. A compact dt/dd strip rather than a stacked
            list: four short facts read faster side by side and wrap cleanly on
            a phone. Last contact joins this row in Piece 2 — a derived fact and
            a stored one look identical to a reader, so filing them apart would
            be an implementation detail leaking into the layout. */}
        <header class="phead">
          <span class:list={['face face--lg', hueFor(person.id)]} aria-hidden="true">
            {photoUrl ? <img src={photoUrl} alt="" /> : monogram(person.display_name)}
          </span>

          <div class="min-w-0 flex-1">
            <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
              <h1 class="font-display text-3xl font-light">{person.display_name}</h1>
              <span class="chip u-none">{circleLabel}</span>
            </div>
            {person.epithet && <p class="text-base-content/70 mt-1 font-serif text-base">{person.epithet}</p>}

            {/* `lastContact` belongs in this condition, not just in the strip.
                It was left out at first and a person whose only fact was a
                logged entry rendered NO fact strip at all — the derived one
                cannot depend on a stored one being present. */}
            {(birthdayYmd || known || person.location || lastContact) && (
              <dl class="phead__facts">
                {birthdayYmd && (
                  <div>
                    <dt>Birthday</dt>
                    <dd>
                      <Icon name="ph:cake" class:list={[birthdaySoon ? 'text-primary' : 'opacity-50']} />
                      <button type="button" class="stamp" title={fullDate(birthdayYmd)}>
                        {dmd(birthdayYmd, todayYmd)}
                      </button>
                    </dd>
                  </div>
                )}
                {known && (
                  <div>
                    <dt>Known since</dt>
                    <dd>{known}</dd>
                  </div>
                )}
                {person.location && (
                  <div>
                    <dt>Where</dt>
                    <dd>{person.location}</dd>
                  </div>
                )}
                {/* A DERIVED fact in the same strip as the stored ones, on
                    purpose: the two look identical to a reader, so filing them
                    apart would be an implementation detail leaking into the
                    layout (§4). It reads as a DURATION — "3 weeks ago" answers
                    the question, "7/20 Sat" does not — with the exact date one
                    tap away on the stamp. */}
                {lastContact && (
                  <div>
                    <dt>Last contact</dt>
                    <dd>
                      <button type="button" class="stamp" title={fullDate(lastContact)}>
                        <Icon name="ph:clock-light" class="stamp__i" />
                        {since(lastContact, todayYmd)}
                      </button>
                    </dd>
                  </div>
                )}
              </dl>
            )}
          </div>

          {/* Just a pencil, on the block it edits (Michael, 2026-08-01: it
              should be "more intuitively placed"). Not a stacked pair of
              buttons in a corner away from the thing they act on. */}
          <button type="button" data-open-person-sheet class="zone__act shrink-0" aria-label="Edit details">
            <Icon name="ph:pencil-simple" />
          </button>
        </header>

        {/* §4's layout: the TIMELINE takes the main column because it is the
            only part that changes weekly and the part you scroll; About takes
            the rail. On a phone the order INVERTS — About first, then the
            timeline — because you open a profile on a phone to remember who
            somebody is, not to scroll a year of entries. That is what the
            `o-*` classes do; on desktop they all go `order: 0` and the real
            column wrappers take over (traps 1 and 2 in app.css). */}
        <div class="hq-grid mt-6">
          <div class="col-main">
            <div class="o-2">
              <TimelineZone person={person} entries={entries} roster={roster} today={todayYmd} />
            </div>
          </div>

          <div class="col-rail">
            {/* 2 · ABOUT — "who they are", hand-authored, changes maybe twice a
            year. Set in the serif, because it is writing.

            A PLAIN TEXTAREA, NOT TIPTAP, and that is a reading of §4's "full
            editor" rather than a shortcut: this is one optional prose field on
            a page that otherwise ships almost no JavaScript, and the admin
            already splits minimal-editor fields from full-sheet ones (admin.md
            §2). Pulling the whole composer bundle onto every profile for a
            field edited twice a year is the wrong trade. It stores Markdown
            either way, so a later change of mind costs nothing. */}
            <section class="zone cn-azure o-1">
              <div class="zone__head">
                <span class="zone__chip">
                  <Icon name="ph:user-circle" />
                </span>
                <h2 class="zone__title">About</h2>
                <button type="button" class="zone__act" data-bio-edit aria-label="Edit description">
                  <Icon name="ph:pencil-simple" />
                </button>
              </div>

              <div class="zone__body" data-bio-view>
                {bio ? (
                  <div class="reading text-base-content/80 font-serif text-sm leading-relaxed" set:html={bio} />
                ) : (
                  <p class="admin-hint text-sm">Nothing written yet.</p>
                )}
              </div>

              <form class="zone__body" data-bio-form hidden>
                <label class="f">
                  <span class="sr-only">About {person.display_name}</span>
                  {/* On ONE line, deliberately: a textarea's value is its child
                  text, so breaking this across lines would prepend the
                  template's own indentation to everything Michael has written
                  — and it would do it silently, growing by a few spaces every
                  time the file was reformatted. */}
                  <textarea
                    name="bio"
                    rows="8"
                    placeholder="What you’d say if someone asked about them."
                    set:text={person.bio ?? ''}
                  />
                </label>
                <p data-bio-error hidden role="alert" class="admin-alert mt-3" />
                <div class="mt-3 flex justify-end gap-2">
                  <button type="button" class="btn btn-ghost btn-sm font-sans" data-bio-cancel>
                    Cancel
                  </button>
                  <button type="submit" class="btn btn-sm zone__cta cn-azure font-sans" data-bio-save>
                    Save
                  </button>
                </div>
              </form>
            </section>

            {/* 3 · SHARED — what they've given him (§5). The one seam with the
            corpus, and it sits BELOW About because About changes twice a year
            while this grows every time you link something. */}
            <div class="o-3">
              <SharedZone person={person} shared={shared} />
            </div>
          </div>
        </div>

        {/* Archiving is EXPLICIT and never automatic, however long the silence —
            and it is reversible. Down here rather than beside the pencil,
            because it is a deliberate act and should take a deliberate scroll. */}
        <div class="border-base-300 mt-10 border-t pt-4">
          <button
            type="button"
            class="admin-hint hover:text-base-content text-xs hover:underline"
            data-archive={person.archived_at ? 'restore' : 'archive'}
            data-person-name={person.display_name}
          >
            {person.archived_at ? 'Put back in the roster' : 'Archive — keeps everything, removes them from the roster'}
          </button>
          {/* ⚠ ITS OWN ERROR LINE. A failure here used to be written into the
              bio box up in the rail — off screen from a control deliberately
              placed at the foot of a long page, which makes a refused archive
              indistinguishable from one that silently did nothing. Same
              reasoning as LinkSheet's two error targets. */}
          <p data-archive-error hidden role="alert" class="admin-alert mt-2" />
        </div>
      </div>
    )
  }

  {person && <PersonSheet person={person} photoUrl={photoUrl} />}
  {
    person && (
      <LinkSheet
        personName={person.display_name}
        personSlug={person.slug}
        works={options.works}
        fragments={options.fragments}
        linkedWorks={shared.works.map((w) => w.id)}
        linkedFragments={shared.fragments.map((f) => f.id)}
      />
    )
  }

  <script>
    import '../../../scripts/person-profile';
  </script>
</AdminLayout>

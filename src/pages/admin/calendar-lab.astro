---
/*
  /admin/calendar-lab — a LOCAL-ONLY bench for the calendar view
  (docs/plans/13-agenda.md, Piece 4). Dev-gated below; never linked.
  Deleted by the piece it informs.

  The month grid itself is conventional and low-risk. What is NOT is the thing
  this lab exists to judge (10-hq.md §11):

    FOUR SOURCES ON ONE GRID, AND ONLY TWO OF THEM ARE WRITABLE.

      · HQ events        writable   — dinners, blocks, things he schedules
      · tasks (due_on)   writable   — rendered as tasks, never as events
      · Google mirror    READ-ONLY  — invitations, conference calls
      · birthdays        NOT ROWS   — derived from people, so not even editable
                                      in principle

    "Rendering must make the read-only ones visibly read-only, or he will try to
    drag one and be confused about why the change vanished." (§5)

  The whole design question is how to say that WITHOUT chrome — the Today lab
  already cut "Google · read-only" as a label nobody would act on. So the answer
  here is structural: writable items carry a solid left edge and a pointer
  cursor, mirrored ones carry a hairline and a lock on hover, and derived ones
  are a mark with no body at all. Try to click each and see what happens.

  Static invented data, `data-src` on everything (10-hq.md §10g).
*/
import AdminLayout from '../../layouts/AdminLayout.astro';
import { Icon } from 'astro-icon/components';

if (import.meta.env.PROD) return Astro.redirect('/admin', 302);

function ordinal(n: number) { const r = n % 100; return r >= 11 && r <= 13 ? `${n}th` : `${n}${['th','st','nd','rd'][n % 10] ?? 'th'}`; }
function t12(hhmm: string) { const [h, m] = hhmm.split(':').map(Number); return `${((h + 11) % 12) + 1}:${String(m).padStart(2, '0')} ${h < 12 ? 'AM' : 'PM'}`; }
function fullDate(d: Date) { return `${d.toLocaleDateString('en-US', { weekday: 'long' })}, ${d.toLocaleDateString('en-US', { month: 'long' })} ${ordinal(d.getDate())}, ${d.getFullYear()}`; }

const TODAY = new Date();
const Y = TODAY.getFullYear();
const M = TODAY.getMonth();

/* The four kinds, and what each one is allowed to do. `write` is not decoration
   — it is what decides the cursor, the hover, and whether a click opens an
   editor or an explanation. */
type Kind = 'event' | 'task' | 'mirror' | 'birthday';
const KIND: Record<Kind, { write: boolean; src: string }> = {
  event:    { write: true,  src: 'events' },
  task:     { write: true,  src: 'tasks.due_on' },
  mirror:   { write: false, src: 'external_events' },
  birthday: { write: false, src: 'people.birth_month/day — derived, not a row' },
};

interface Item { d: number; kind: Kind; title: string; time?: string; end?: string; who?: string; loc?: string }
const ITEMS: Item[] = [
  { d: 2,  kind: 'mirror',   title: 'Standup', time: '09:30', end: '09:45' },
  { d: 2,  kind: 'task',     title: 'Rent' },
  { d: 4,  kind: 'birthday', title: 'Rosalind' },
  { d: 4,  kind: 'mirror',   title: 'Quarterly review', time: '13:00', end: '14:00' },
  { d: 5,  kind: 'task',     title: 'Draft the Sky essay' },
  { d: 6,  kind: 'event',    title: 'Climbing with Joon', time: '18:30', end: '20:30', loc: 'Great Western' },
  { d: 7,  kind: 'task',     title: 'Deep clean the bathroom' },
  { d: 9,  kind: 'event',    title: 'Dinner — Tobias', time: '19:00', who: 'Tobias', loc: 'Ottavio' },
  { d: 11, kind: 'mirror',   title: 'Dentist', time: '08:15', end: '09:00' },
  { d: 12, kind: 'mirror',   title: 'Design review', time: '11:00', end: '12:00' },
  { d: 13, kind: 'task',     title: 'Book the Portland flights' },
  { d: 14, kind: 'event',    title: 'Writing block', time: '09:00', end: '12:00' },
  { d: 14, kind: 'mirror',   title: 'All-hands', time: '16:00', end: '17:00' },
  { d: 15, kind: 'mirror',   title: 'Lunch w/ Devi', time: '12:30', end: '13:30' },
  { d: 17, kind: 'event',    title: 'Ceramics class', time: '18:00', end: '20:00' },
  /* The 19th carries ALL FOUR kinds on purpose — it is the day panel's example,
     and the read-only story is only testable where the sources sit together. */
  { d: 19, kind: 'mirror',   title: 'Offsite planning', time: '10:00', end: '15:00' },
  { d: 19, kind: 'task',     title: 'Call the accountant' },
  { d: 19, kind: 'event',    title: 'Haircut', time: '17:30' },
  { d: 19, kind: 'birthday', title: 'Arun' },
  { d: 19, kind: 'mirror',   title: 'Late sync', time: '19:00', end: '19:30' },
  { d: 21, kind: 'event',    title: 'Drive to Tahoe', time: '07:00' },
  { d: 22, kind: 'birthday', title: 'Devi' },
  { d: 25, kind: 'mirror',   title: 'Kickoff', time: '10:30', end: '11:30' },
  { d: 27, kind: 'task',     title: 'Renew the passport' },
  { d: 30, kind: 'mirror',   title: 'Retro', time: '15:00', end: '16:00' },
];

/* Six weeks, always — a month grid that changes height between months makes the
   whole page jump, and the row you were looking at moves under the cursor.
   Rendered SERVER-SIDE: the Today lab built its calendar with createElement and
   every scoped hover rule silently did nothing (10-hq.md §10h, trap 3). */
const first = new Date(Y, M, 1);
const start = new Date(Y, M, 1 - first.getDay());
const CELLS = Array.from({ length: 42 }, (_, i) => {
  const d = new Date(start.getFullYear(), start.getMonth(), start.getDate() + i);
  return {
    date: d,
    out: d.getMonth() !== M,
    today: d.toDateString() === TODAY.toDateString(),
    items: d.getMonth() === M ? ITEMS.filter((x) => x.d === d.getDate()) : [],
  };
});
const DOW = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];

/* The day panel. The 19th is the busiest day on purpose — four items, three
   sources, and one of them not a row at all. */
const PANEL_DAY = new Date(Y, M, 19);
const PANEL = ITEMS.filter((x) => x.d === 19).sort((a, b) => (a.time ?? '99').localeCompare(b.time ?? '99'));

/* The week view exists for "what is actually coming", so it shows the SAME
   union with room for detail rather than a second data model. */
const WEEK = Array.from({ length: 7 }, (_, i) => {
  const d = new Date(Y, M, 17 + i);
  return { date: d, today: d.toDateString() === TODAY.toDateString(), items: ITEMS.filter((x) => x.d === d.getDate()).sort((a, b) => (a.time ?? '99').localeCompare(b.time ?? '99')) };
});
---

<AdminLayout title="Calendar lab">
  <div class="sticky top-0 z-30 mb-6 border-b border-warning/40 bg-warning/10 px-4 py-3 font-sans">
    <div class="mx-auto flex max-w-6xl flex-wrap items-center gap-x-6 gap-y-2 text-sm">
      <span class="font-semibold">Calendar lab</span>
      <span class="flex items-center gap-1">
        <span class="admin-hint mr-1 text-xs">View</span>
        <button type="button" data-view="month" class="btn btn-xs btn-neutral font-sans">Month</button>
        <button type="button" data-view="week" class="btn btn-xs btn-ghost font-sans">Week</button>
      </span>
      <button type="button" id="src-btn" class="btn btn-xs btn-ghost font-sans">Show provenance</button>
      <a href="/admin" class="admin-back ml-auto text-xs">← Observatory</a>
    </div>
    <p id="blurb" class="mx-auto mt-2 max-w-6xl text-xs text-base-content/60"></p>
  </div>

  <div id="frame" class="mx-auto w-full max-w-6xl px-4 pb-28">
    <header class="mb-4 flex flex-wrap items-center gap-3">
      <h1 class="font-display text-2xl font-light">{TODAY.toLocaleDateString('en-US', { month: 'long' })} {Y}</h1>
      <span class="flex items-center">
        <button type="button" class="navb" aria-label="Previous month"><Icon name="ph:caret-left" /></button>
        <button type="button" class="navb" aria-label="Next month"><Icon name="ph:caret-right" /></button>
      </span>
      <button type="button" class="chip chip--soon">Today</button>
      <button type="button" class="btn btn-sm ml-auto gap-1 font-sans zone__cta cn-amber"><Icon name="ph:plus" /> New event</button>
    </header>

    {/* Four sources on one grid is genuinely ambiguous, and a four-word key is a
        fixed cost — unlike a label repeated on every row, which is what got cut
        from Today. Four words, and nothing else. */}
    <div class="legend">
      <span class="lg"><i class="lg__m lg__m--event"></i> Yours</span>
      <span class="lg"><i class="lg__m lg__m--task"></i> Task</span>
      <span class="lg"><i class="lg__m lg__m--mirror"></i> <Icon name="simple-icons:google" class="lg__g" /> Mirrored</span>
      <span class="lg"><i class="lg__m lg__m--birthday"></i> Birthday</span>
    </div>

    {/* ══════════════════ MONTH ══════════════════ */}
    <div data-view-panel="month">
      <div class="cal">
        <div class="cal__dow">{DOW.map((d) => <span>{d}</span>)}</div>
        <div class="cal__grid">
          {CELLS.map((c) => (
            <div class:list={['cell', c.out && 'cell--out', c.today && 'cell--today']}>
              <span class="cell__n">{c.date.getDate()}</span>
              {c.items.slice(0, 3).map((it) => (
                <button
                  type="button"
                  class:list={['ev', `ev--${it.kind}`, !KIND[it.kind].write && 'ev--ro']}
                  data-open-day
                  data-src={KIND[it.kind].src}
                >
                  {it.kind === 'mirror' && <Icon name="simple-icons:google" class="ev__g" />}
                  {it.kind === 'birthday' && <Icon name="ph:cake" class="ev__i" />}
                  {it.kind === 'task' && <Icon name="ph:circle" class="ev__i" />}
                  {it.time && <span class="ev__t">{t12(it.time).replace(':00', '')}</span>}
                  <span class="ev__x">{it.title}</span>
                  {!KIND[it.kind].write && <Icon name="ph:lock-simple" class="ev__lock" />}
                </button>
              ))}
              {c.items.length > 3 && <button type="button" class="cell__more" data-open-day>+{c.items.length - 3} more</button>}
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* ══════════════════ WEEK ══════════════════
        Not a second data model — the same union, given room for detail. */}
    <div data-view-panel="week" hidden>
      <div class="wk">
        {WEEK.map((d) => (
          <div class:list={['wkcol', d.today && 'wkcol--today']}>
            <div class="wkcol__h">
              <span class="wkcol__d">{DOW[d.date.getDay()]}</span>
              <span class="wkcol__n">{d.date.getDate()}</span>
            </div>
            <div class="wkcol__b">
              {d.items.length === 0 ? <span class="wkcol__e">—</span> : d.items.map((it) => (
                <button type="button" class:list={['wev', `ev--${it.kind}`, !KIND[it.kind].write && 'ev--ro']} data-src={KIND[it.kind].src}>
                  <span class="wev__t">
                    {it.kind === 'mirror' && <Icon name="simple-icons:google" class="ev__g" />}
                    {it.kind === 'birthday' && <Icon name="ph:cake" class="ev__i" />}
                    {it.kind === 'task' && <Icon name="ph:circle" class="ev__i" />}
                    {it.time ? t12(it.time) : it.kind === 'task' ? 'anytime' : 'all day'}
                    {!KIND[it.kind].write && <Icon name="ph:lock-simple" class="ev__lock" />}
                  </span>
                  <span class="wev__x">{it.title}</span>
                </button>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    {/* ══════════════════ THE DAY PANEL ══════════════════
        Where the read-only story is actually told — once, in words, at the
        moment you tried to act on one. Not on every row of the grid. */}
    <aside class="day" data-day hidden>
      <div class="day__head">
        <h2 class="font-display text-lg font-light">{fullDate(PANEL_DAY)}</h2>
        <button type="button" class="zone__act" data-close-day aria-label="Close"><Icon name="ph:x" /></button>
      </div>
      <ul class="day__list">
        {PANEL.map((it) => (
          <li class:list={['drow', `ev--${it.kind}`]} data-src={KIND[it.kind].src}>
            <span class="drow__t">
              {it.time ? t12(it.time) : it.kind === 'task' ? 'anytime' : 'all day'}
              {it.end && <span class="drow__e">→ {t12(it.end)}</span>}
            </span>
            <span class="min-w-0 flex-1">
              <span class="drow__x">
                {it.kind === 'mirror' && <Icon name="simple-icons:google" class="ev__g" />}
                {it.kind === 'birthday' && <Icon name="ph:cake" class="ev__i" />}
                {it.title}
              </span>
              {it.loc && <span class="drow__l">{it.loc}</span>}
            </span>
            {/* The affordance IS the explanation. A writable row offers the verb;
                a mirrored one offers only the annotation HQ can actually make;
                a derived one offers nothing, because there is no row to open. */}
            {KIND[it.kind].write ? (
              it.kind === 'task'
                ? <button type="button" class="chip chip--act shrink-0"><Icon name="ph:check" /> Did it</button>
                : <button type="button" class="chip chip--act shrink-0"><Icon name="ph:pencil-simple" /> Edit</button>
            ) : it.kind === 'mirror' ? (
              <button type="button" class="chip chip--suggest shrink-0"><Icon name="ph:plus" /> Tag someone</button>
            ) : null}
          </li>
        ))}
      </ul>
    </aside>
  </div>
</AdminLayout>

<style>
  .navb { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 0.5rem; cursor: pointer; color: color-mix(in oklch, var(--color-base-content) 50%, transparent); }
  .navb:hover { background: var(--color-base-200); color: var(--color-base-content); }
  .zone__act { display: grid; place-items: center; width: 1.75rem; height: 1.75rem; border-radius: 0.5rem; cursor: pointer; color: color-mix(in oklch, var(--color-base-content) 55%, transparent); }
  .zone__act:hover { background: var(--color-base-200); color: var(--color-base-content); }
  .zone__cta { background: var(--cn); color: var(--color-base-100); border-color: transparent; }
  .zone__cta:hover { filter: brightness(1.08); }
  .chip { display: inline-flex; align-items: center; gap: 0.3125rem; padding: 0.1875rem 0.5rem; border-radius: 999px; font-family: var(--font-sans); font-size: 0.6875rem; line-height: 1.4; border: 1px solid transparent; white-space: nowrap; }
  .chip--soon { background: var(--color-base-200); color: color-mix(in oklch, var(--color-base-content) 62%, transparent); border-color: var(--color-base-300); }
  .chip--act { cursor: pointer; background: var(--color-base-100); border-color: var(--color-base-300); color: color-mix(in oklch, var(--color-base-content) 70%, transparent); }
  .chip--act:hover { background: var(--color-base-200); color: var(--color-base-content); }
  .chip--suggest { cursor: pointer; background: transparent; color: color-mix(in oklch, var(--color-base-content) 62%, transparent); border: 1px dashed var(--color-base-300); }
  .chip--suggest:hover { background: var(--color-base-200); color: var(--color-base-content); }

  /* ── the legend ─────────────────────────────────────────────────────────── */
  .legend { display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem 1.25rem; margin-bottom: 0.625rem; font-family: var(--font-sans); font-size: 0.6875rem; color: color-mix(in oklch, var(--color-base-content) 55%, transparent); }
  .lg { display: inline-flex; align-items: center; gap: 0.375rem; }
  .lg__m { width: 0.625rem; height: 0.625rem; border-radius: 0.1875rem; }
  .lg__g { font-size: 0.75rem; opacity: 0.7; }

  /* THE COLOUR RULE FOR THIS PAGE. Domain hue says which part of life; here all
     four are "the agenda", so hue would say nothing. What differs is AUTHORITY,
     so that is what the treatment encodes:
       yours     solid fill      — you own it
       task      lighter fill, ○ — you own it, but it is not an event
       mirrored  hairline, no fill — a copy of something that lives elsewhere
       birthday  no body at all  — not a row anywhere

     FILL MEANS WRITABLE. The first draft gave tasks an outline ring, which put
     them in the same visual class as the Google mirror — so the strongest
     distinction on the grid was accidentally "event vs everything else" rather
     than "yours vs not yours", which is the one §5 actually asks for.
     None of it is the urgency axis, which stays reserved (10-hq.md §10a). */
  .lg__m--event    { background: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 70%, transparent); }
  .lg__m--task     { background: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 28%, transparent); }
  .lg__m--mirror   { background: transparent; border: 1px solid color-mix(in oklch, var(--color-base-content) 35%, transparent); }
  .lg__m--birthday { background: transparent; border: 1px dashed color-mix(in oklch, var(--cn-rose, oklch(70% 0.1 10)) 60%, transparent); }

  /* ── month ──────────────────────────────────────────────────────────────── */
  .cal { border: 1px solid var(--color-base-300); border-radius: var(--radius-box); overflow: hidden; background: var(--color-base-100); }
  .cal__dow { display: grid; grid-template-columns: repeat(7, 1fr); border-bottom: 1px solid var(--color-base-300); background: var(--color-base-200); }
  .cal__dow span { padding: 0.375rem 0.5rem; font-family: var(--font-sans); font-size: 0.625rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: color-mix(in oklch, var(--color-base-content) 45%, transparent); }
  /* Six rows ALWAYS. A grid that changes height between months makes the page
     jump and the row under your cursor move. */
  .cal__grid { display: grid; grid-template-columns: repeat(7, 1fr); grid-auto-rows: minmax(6.25rem, auto); }
  .cell { min-width: 0; padding: 0.25rem; border-right: 1px solid color-mix(in oklch, var(--color-base-300) 70%, transparent); border-bottom: 1px solid color-mix(in oklch, var(--color-base-300) 70%, transparent); display: flex; flex-direction: column; gap: 0.125rem; }
  .cell:nth-child(7n) { border-right: 0; }
  .cell--out { background: color-mix(in oklch, var(--color-base-200) 55%, transparent); }
  .cell--out .cell__n { opacity: 0.35; }
  .cell__n { font-family: var(--font-sans); font-size: 0.6875rem; font-variant-numeric: tabular-nums; color: color-mix(in oklch, var(--color-base-content) 55%, transparent); padding: 0.0625rem 0.1875rem; }
  .cell--today .cell__n { align-self: flex-start; border-radius: 999px; background: var(--color-primary); color: var(--color-primary-content); font-weight: 700; padding: 0.0625rem 0.375rem; }
  .cell__more { align-self: flex-start; cursor: pointer; padding: 0.0625rem 0.25rem; font-family: var(--font-sans); font-size: 0.625rem; color: color-mix(in oklch, var(--color-base-content) 50%, transparent); }
  .cell__more:hover { text-decoration: underline; }

  .ev { display: flex; align-items: center; gap: 0.25rem; width: 100%; min-width: 0; cursor: pointer; padding: 0.125rem 0.3125rem; border-radius: 0.25rem; font-family: var(--font-sans); font-size: 0.6875rem; line-height: 1.35; text-align: left; }
  .ev__x { min-width: 0; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .ev__t { font-variant-numeric: tabular-nums; opacity: 0.75; flex-shrink: 0; }
  .ev__g, .ev__i { flex-shrink: 0; font-size: 0.6875rem; opacity: 0.75; }
  .ev__lock { flex-shrink: 0; font-size: 0.6875rem; opacity: 0; }

  .ev--event { background: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 20%, transparent); color: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 55%, var(--color-base-content)); }
  .ev--event:hover { background: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 32%, transparent); }
  .ev--task { background: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 9%, transparent); box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 32%, transparent); color: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 55%, var(--color-base-content)); }
  .ev--task:hover { background: color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 20%, transparent); }
  .ev--mirror { background: transparent; box-shadow: inset 0 0 0 1px color-mix(in oklch, var(--color-base-content) 20%, transparent); color: color-mix(in oklch, var(--color-base-content) 68%, transparent); }
  .ev--birthday { background: transparent; color: color-mix(in oklch, var(--cn-rose, oklch(70% 0.1 10)) 55%, var(--color-base-content)); }

  /* The read-only signal, said three ways and none of them a word: no lift on
     hover, a lock that appears when you reach for it, and — in the day panel —
     one sentence explaining where the thing actually lives. */
  .ev--ro:hover { background: color-mix(in oklch, var(--color-base-content) 6%, transparent); }
  .ev--ro:hover .ev__lock { opacity: 0.5; }

  /* ── week ───────────────────────────────────────────────────────────────── */
  .wk { display: grid; grid-template-columns: repeat(7, 1fr); gap: 0.5rem; }
  @media (max-width: 60rem) { .wk { grid-template-columns: repeat(2, 1fr); } }
  .wkcol { border: 1px solid var(--color-base-300); border-radius: var(--radius-box); background: var(--color-base-100); overflow: hidden; }
  .wkcol--today { border-color: color-mix(in oklch, var(--color-primary) 55%, transparent); }
  .wkcol__h { display: flex; align-items: baseline; justify-content: space-between; padding: 0.375rem 0.5rem; border-bottom: 1px solid var(--color-base-300); background: var(--color-base-200); }
  .wkcol--today .wkcol__h { background: color-mix(in oklch, var(--color-primary) 12%, transparent); }
  .wkcol__d { font-family: var(--font-sans); font-size: 0.5625rem; letter-spacing: 0.07em; text-transform: uppercase; color: color-mix(in oklch, var(--color-base-content) 45%, transparent); }
  .wkcol__n { font-family: var(--font-display, serif); font-size: 1rem; }
  .wkcol__b { display: flex; flex-direction: column; gap: 0.25rem; padding: 0.375rem; min-height: 6rem; }
  .wkcol__e { font-size: 0.75rem; color: color-mix(in oklch, var(--color-base-content) 22%, transparent); }
  .wev { display: block; width: 100%; cursor: pointer; padding: 0.25rem 0.375rem; border-radius: 0.3125rem; text-align: left; font-family: var(--font-sans); }
  .wev__t { display: flex; align-items: center; gap: 0.25rem; font-size: 0.625rem; font-variant-numeric: tabular-nums; opacity: 0.8; }
  .wev__x { display: block; font-size: 0.75rem; line-height: 1.3; }

  /* ── the day panel ──────────────────────────────────────────────────────── */
  .day { margin-top: 1.25rem; border: 1px solid var(--color-base-300); border-radius: var(--radius-box); background: var(--color-base-100); overflow: hidden; }
  .day__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.75rem 1rem; border-bottom: 1px solid var(--color-base-300); }
  .day__list { padding: 0.25rem 1rem 0.75rem; }
  .drow { display: flex; align-items: flex-start; gap: 0.875rem; padding: 0.625rem 0; }
  .drow + .drow { border-top: 1px solid color-mix(in oklch, var(--color-base-300) 60%, transparent); }
  .drow__t { flex: 0 0 5.5rem; font-family: var(--font-sans); font-size: 0.75rem; font-variant-numeric: tabular-nums; color: color-mix(in oklch, var(--color-base-content) 62%, transparent); }
  .drow__e { display: block; font-size: 0.625rem; opacity: 0.7; }
  .drow__x { display: flex; align-items: center; gap: 0.375rem; font-size: 0.9375rem; }
  .drow__l { display: block; margin-top: 0.0625rem; font-family: var(--font-sans); font-size: 0.6875rem; color: color-mix(in oklch, var(--color-base-content) 45%, transparent); }
  .chip--act svg, .chip--suggest svg { font-size: 0.8125rem; }
  /* A left rule in the panel, carrying the same authority language as the grid. */
  .drow.ev--event    { box-shadow: inset 3px 0 0 -0px color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 55%, transparent); padding-left: 0.75rem; }
  .drow.ev--task     { box-shadow: inset 3px 0 0 -0px color-mix(in oklch, var(--cn-amber, oklch(70% 0.12 62)) 30%, transparent); padding-left: 0.75rem; }
  .drow.ev--mirror   { box-shadow: inset 3px 0 0 -0px color-mix(in oklch, var(--color-base-content) 18%, transparent); padding-left: 0.75rem; }
  .drow.ev--birthday { box-shadow: inset 3px 0 0 -0px color-mix(in oklch, var(--cn-rose, oklch(70% 0.1 10)) 40%, transparent); padding-left: 0.75rem; }
  .drow.ev--event, .drow.ev--task, .drow.ev--mirror, .drow.ev--birthday { background: transparent; color: inherit; }

  body.show-src [data-src] { outline: 1px dashed color-mix(in oklch, var(--color-info) 55%, transparent); outline-offset: 1px; position: relative; }
  body.show-src [data-src]::after { content: attr(data-src); position: absolute; left: 0; top: 100%; z-index: 10; margin-top: 2px; padding: 1px 5px; border-radius: 3px; font-family: ui-monospace, monospace; font-size: 9px; line-height: 1.5; white-space: nowrap; background: var(--color-info); color: var(--color-info-content); pointer-events: none; }
</style>

<script>
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const $$ = <T extends HTMLElement>(s: string) => Array.from(document.querySelectorAll<T>(s));

  const BL: Record<string, string> = {
    month: 'The default. Four sources on one grid — try clicking a Google row and a birthday, and see whether it is obvious which ones HQ can change.',
    week: 'For "what is actually coming". The same union with room for detail, not a second data model.',
  };

  const day = $<HTMLElement>('[data-day]');
  $$('[data-open-day]').forEach((b) => b.addEventListener('click', () => {
    day.hidden = false;
    day.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }));
  $<HTMLButtonElement>('[data-close-day]').addEventListener('click', () => (day.hidden = true));

  $$<HTMLButtonElement>('[data-view]').forEach((b) => b.addEventListener('click', () => {
    const v = b.dataset.view!;
    $$('[data-view-panel]').forEach((p) => (p.hidden = p.dataset.viewPanel !== v));
    $('#blurb').textContent = BL[v];
    $$<HTMLButtonElement>('[data-view]').forEach((o) => {
      const hit = o === b;
      o.classList.toggle('btn-neutral', hit); o.classList.toggle('btn-ghost', !hit);
    });
  }));

  const srcBtn = $<HTMLButtonElement>('#src-btn');
  srcBtn.addEventListener('click', () => {
    const active = document.body.classList.toggle('show-src');
    srcBtn.textContent = active ? 'Hide provenance' : 'Show provenance';
    srcBtn.classList.toggle('btn-neutral', active); srcBtn.classList.toggle('btn-ghost', !active);
  });

  $('#blurb').textContent = BL.month;
</script>

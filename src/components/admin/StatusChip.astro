---
/*
  StatusChip — note / draft / published, one implementation for every admin
  surface (fragment rows, constellation rows, the composer suite). Deliberately
  calm: a draft is a normal state in this workshop, not a warning, and a note is
  quieter still — it's the tier below a draft, not a problem with one.
*/
interface Props {
  status: string;
  class?: string;
}
const { status, class: className = '' } = Astro.props;
const variant = status === 'published' ? 'on' : status === 'note' ? 'note' : 'off';
---

<span class:list={['admin-chip', `admin-chip--${variant}`, className]}>{status}</span>

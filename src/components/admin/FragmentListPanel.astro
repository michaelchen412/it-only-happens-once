---
/*
  FragmentListPanel — the Fragment Manager's toolbar + table, shared verbatim by
  /admin/fragments (mode="manage"), the fragments-panel partial the composer's browser
  sheet fetches (mode="pick"), and the song sheet's pairing picker (mode="pair",
  plan 39). Everything inside is CLASS-scoped (no ids) so two
  panels can never collide, and src/scripts/fragment-panel.ts wires any instance
  from its root element. Keep it script-free: partials strip component scripts.

  ⚠ THE TWO PICKERS ARE NOT THE SAME SHAPE, and `pick` is the bigger one.
  `pick` places MANY fragments and therefore carries a cart — checkboxes, a
  select-all, a bulk bar. `pair` writes a single foreign key, so it has no cart
  at all and its toolbar sheds the filters that answer nothing about writing:
  the type segments (writing is the only type it shows, so "All 40 · writing 40"
  is two ways of saying one number) and the author/work selects (both read
  columns only a quote fills in).
*/
import { Icon } from 'astro-icon/components';
import FragmentRow from './FragmentRow.astro';
import EmptyState from './EmptyState.astro';
import SubjectFilter from './SubjectFilter.astro';
import type { FragmentListData, FragmentListParams, PanelMode } from '../../lib/fragment-query';
// The vocabulary, not a fourth copy of it (plans/29 · §3). The type filter this
// renders and the parser that reads the resulting `?type=` were two separate
// lists of the same three words, one file apart.
import { FRAGMENT_TYPES } from '../../lib/fragments-display';

interface Props {
  data: FragmentListData;
  params: FragmentListParams;
  mode?: PanelMode;
}
const { data, params: p, mode = 'manage' } = Astro.props;
// Neither trash nor notes reaches either picker: you compose a constellation
// out of finished work, not out of scratch — and you pair music to a piece you
// mean to keep.
const view = mode === 'manage' ? p.view : 'list';
const pair = mode === 'pair';
const epigraph = mode === 'epigraph';
/** The two pickers that write ONE value — no cart, no select-all (FragmentRow). */
const single = pair || epigraph;
const COLUMNS = [
  { field: 'title', label: 'Fragment', align: 'left', cls: 'w-full', sortable: true },
  { field: 'status', label: 'Status', align: 'left', cls: 'hidden sm:table-cell', sortable: false },
  { field: 'posted', label: 'Posted', align: 'right', cls: 'hidden md:table-cell', sortable: true },
  { field: 'edited', label: 'Edited', align: 'right', cls: '', sortable: true },
] as const;
---

<div
  class="fpanel"
  data-mode={mode}
  data-view={view}
  data-constellation={p.constellation ?? undefined}
  data-song={p.pairedSong ?? undefined}
>
  {/* Toolbar */}
  <form
    method="GET"
    action="/admin/fragments"
    class="fpanel-filters flex flex-wrap items-center gap-x-3 gap-y-2 text-sm"
  >
    <input type="hidden" name="sort" class="fpanel-sort" value={`${p.sortField}_${p.sortDir}`} />
    <input type="hidden" name="type" class="fpanel-type" value={p.type ?? ''} />
    <input type="hidden" name="view" value={view === 'list' ? '' : view} />

    {
      /* type filter = segmented control (single-select), with counts.

        ⚠ GONE ENTIRELY IN PAIR MODE, which is a different decision from the
        `song` segment's below. There the control still has a job and one
        option is withheld; here `pairable` has already reduced the corpus to
        one type, so every segment would report the same number as All and
        pressing any of them would change nothing. A control whose options are
        indistinguishable is not a narrow control, it is a dead one. */
      /* ⚠ AND DEAD IN THE EPIGRAPH PICKER FOR THE SAME REASON — `quotable` pins
        the corpus to published quotes, so every segment would report the number
        All reports. */
      !single && (
        <div class="seg" role="radiogroup" aria-label="Filter by type">
          <button
            type="button"
            role="radio"
            aria-checked={!p.type}
            class:list={['type-badge', !p.type && 'is-active']}
            data-type-filter=""
          >
            All <span class="type-badge__n">{data.totalCount}</span>
          </button>
          {
            /* The picker drops the `song` segment entirely rather than showing it
              at zero (ADR 0031). A segment reading "song 0" invites the press that
              proves it. Songs used to be filtered out of the picker's row query
              because a song could never sit in a suite; since ADR 0035 they are
              not fragments at all, so there is nothing to exclude.

              ⚠ THIS COMMENT WAS RIGHT AND THE CODE WAS NOT, for two days. The
              filter it describes in the past tense (`params.placeable` →
              `neq('type', 'song')`) was still live in `fragment-query.ts` until
              2026-08-17, comparing the enum to a label the migration had
              deleted — which Postgres errors on rather than ignoring, so this
              picker returned NO rows at all. Reasoning written down is not the
              same as reasoning applied. */
            FRAGMENT_TYPES.map((t) => (
              <button
                type="button"
                role="radio"
                aria-checked={p.type === t}
                class:list={['type-badge capitalize', p.type === t && 'is-active']}
                data-type-filter={t}
              >
                {t} <span class="type-badge__n">{data.typeCounts[t]}</span>
              </button>
            ))
          }
        </div>
      )
    }

    {/* search — icon lives inside the field (daisyUI pattern; no overlay) */}
    <label class="input input-sm flex min-w-[12rem] flex-1 items-center gap-2 font-sans md:max-w-xs">
      <Icon name="ph:magnifying-glass" class="text-base-content/50 shrink-0" />
      <input
        type="search"
        name="q"
        value={p.q}
        placeholder="Search fragments…"
        class="grow"
        aria-label="Search fragments"
      />
    </label>

    <SubjectFilter subjects={data.allSubjects} value={p.subjectSlugs} />
    {
      /* ⚠ AUTHOR AND WORK ARE QUOTE COLUMNS, so they leave in pair mode with the
        type segments. `author_id` and `work_id` are provenance — who said it and
        where it is from — and a piece of Michael's own writing fills in neither.
        In a writing-only list both selects would offer their full roster and
        every option would return nothing, which is worse than a dead control:
        it is a control that answers, and answers "no results", and reads as an
        empty corpus. (Subjects stay: writing carries those.) */
      /* ⚠ `!pair`, NOT `!single` — and this is the one place the two single-select
        pickers genuinely differ. Author and work are PROVENANCE, and the note
        above is about a writing-only list, where both selects would answer
        every option with nothing. The epigraph picker is quotes-only, which is
        exactly the corpus those two facets describe: "the Marcus Aurelius one",
        "the one from Meditations" is how you find a quote you half remember.
        Withheld from one picker and kept in the other, because the reason was
        never "a picker is narrow" — it was "these two fields are empty on
        writing". */
      !pair && (
        <>
          <select name="author" aria-label="Filter by author" class="select select-sm max-w-[10rem] font-sans">
            <option value="">All authors</option>
            {data.allAuthors.map((a) => (
              <option value={a.slug} selected={a.slug === p.authorSlug}>
                {a.name}
              </option>
            ))}
          </select>
          <select name="work" aria-label="Filter by work" class="select select-sm max-w-[10rem] font-sans">
            <option value="">All works</option>
            {data.allWorks.map((w) => (
              <option value={w.slug} selected={w.slug === p.workSlug}>
                {w.title}
              </option>
            ))}
          </select>
        </>
      )
    }
    {/* The fragment→constellation view: what's placed where, and what's placed nowhere. */}
    <select name="in" aria-label="Filter by constellation" class="select select-sm max-w-[12rem] font-sans">
      <option value="">Any constellation</option>
      <option value="none" selected={p.membership === 'none'}>— in none —</option>
      {
        data.allConstellations.map((c) => (
          <option value={c.slug} selected={c.slug === p.membership}>
            {c.name}
          </option>
        ))
      }
    </select>
    <button type="button" data-clear class="text-base-content/60 hover:text-base-content underline">clear</button>
  </form>

  {/* The table (swapped in place on filter/sort) */}
  <div class="fpanel-list mt-4">
    {
      data.rows.length === 0 ? (
        <EmptyState
          class="mt-6"
          title={p.filtered ? 'Nothing matches.' : view === 'trash' ? 'Trash is empty.' : 'Nothing here yet.'}
          hint={
            view === 'list' && !p.filtered && mode === 'manage'
              ? 'A song enters at Listening, in one motion with the hearing.'
              : /* ⚠ "Nothing matches" is the EXPECTED state in pair mode, not a
                  failure — it is what you see one keystroke before you create
                  the piece you came here to write. So the hint names the row
                  below rather than apologising for an empty table. */
                pair && p.filtered
                ? 'Nothing here by that name — the row below will start it as a draft.'
                : undefined
          }
        >
          {/* ⚠ THE DOOR, AND THIS IS THE ROOM THAT MOST NEEDED ONE (plan 38 ·
              §4.2). The old copy said "Add a piece of writing, a quote, or a
              song to begin" while the only control that does any of that was
              folded inside the header's `Add ▾` menu — so an empty room named an
              action and then hid it behind a disclosure. Of the six empty states
              this was the one describing a door you could not see.

              ⚠ AND THE OLD SENTENCE PROMISED A SONG THIS MENU HAS NOT OFFERED
              SINCE ADR 0031. A song enters at /admin/listening, in one motion
              with the listening; the menu above dropped it and this line was
              never updated. The hint says where songs actually go rather than
              implying a third button that is not here.

              Same `[data-new-writing]` / `[data-new]` hooks the menu items
              carry: both scripts bind with `querySelectorAll`, so these are the
              SAME control in a second place rather than a second write path.
              Manage mode only — the composer's picker sheet borrows this panel,
              and "write something new" is not what you are there to do. */}
          {view === 'list' && !p.filtered && mode === 'manage' && (
            <div class="mt-4 flex flex-wrap justify-center gap-2">
              <button type="button" data-new-writing class="btn btn-sm zone__cta cn-gold gap-1 font-sans">
                <Icon name="ph:plus" /> Write something
              </button>
              <button type="button" data-new="quote" class="btn btn-sm zone__cta cn-gold gap-1 font-sans">
                <Icon name="ph:plus" /> Add a quote
              </button>
            </div>
          )}
        </EmptyState>
      ) : (
        <div class="rounded-box border-base-300 overflow-x-auto border">
          <table class="w-full text-sm">
            <caption class="sr-only">{view === 'trash' ? 'Trashed fragments' : 'Fragments'}</caption>
            <thead>
              <tr class="border-base-300 bg-base-200/50 border-b">
                {/* ⚠ NO CART IN PAIR MODE, so no select-all and no column to
                    hold it. `paired_song_id` is ONE key on ONE row — there is no
                    "pair all four of these" to express, and a select-all that
                    can only ever mean "the last one you ticked" is a control
                    lying about what it does. FragmentRow drops the matching
                    <td>; the two must agree or every row shifts one cell left. */}
                {!single && (
                  <th scope="col" class="w-8 px-3 py-2">
                    <input type="checkbox" class="checkbox checkbox-xs select-all" aria-label="Select all" />
                  </th>
                )}
                <th scope="col" class="w-6">
                  <span class="sr-only">Type</span>
                </th>
                {COLUMNS.map((c) => (
                  <>
                    <th
                      scope="col"
                      class:list={[
                        c.cls,
                        'text-base-content/60 px-3 py-2.5 font-sans text-xs font-normal tracking-wide uppercase',
                        c.align === 'right' ? 'text-right' : 'text-left',
                      ]}
                      aria-sort={
                        c.sortable && p.sortField === c.field
                          ? p.sortDir === 'asc'
                            ? 'ascending'
                            : 'descending'
                          : undefined
                      }
                    >
                      {c.sortable ? (
                        <button
                          type="button"
                          class:list={[
                            'sort-header hover:text-base-content inline-flex items-center gap-1',
                            p.sortField === c.field && 'text-base-content',
                          ]}
                          data-field={c.field}
                        >
                          {c.label}
                          <span
                            class:list={['text-[0.6rem]', p.sortField !== c.field && 'opacity-30']}
                            aria-hidden="true"
                          >
                            {p.sortField === c.field ? (p.sortDir === 'asc' ? '▲' : '▼') : '⇅'}
                          </span>
                        </button>
                      ) : (
                        c.label
                      )}
                    </th>
                    {/* sits beside the fragment's identity, before its lifecycle columns */}
                    {c.field === 'title' && view !== 'trash' && (
                      <th
                        scope="col"
                        class="text-base-content/60 hidden px-3 py-2.5 text-left font-sans text-xs font-normal tracking-wide uppercase lg:table-cell"
                      >
                        Constellations
                      </th>
                    )}
                  </>
                ))}
                {mode !== 'manage' && (
                  <th
                    scope="col"
                    class="text-base-content/60 px-3 py-2 text-right font-sans text-xs font-normal tracking-wide uppercase"
                  >
                    <span class="sr-only">{pair ? 'Pair' : epigraph ? 'Use as the epigraph' : 'Place'}</span>
                  </th>
                )}
                {view === 'trash' && (
                  <th
                    scope="col"
                    class="text-base-content/60 px-3 py-2 text-right font-sans text-xs font-normal tracking-wide uppercase"
                  >
                    Actions
                  </th>
                )}
              </tr>
            </thead>
            <tbody>
              {data.rows.map((r) => (
                <FragmentRow
                  fragment={r}
                  subjects={data.subjectsByFragment[r.id] ?? []}
                  constellations={data.constellationsByFragment[r.id] ?? []}
                  authorName={r.author_id ? data.authorNameById[r.author_id] : undefined}
                  workName={r.work_id ? data.workTitleById[r.work_id] : undefined}
                  view={view}
                  mode={mode}
                  placed={data.placedIds.has(r.id)}
                  paired={data.pairedIds.has(r.id)}
                  pairedToOther={
                    (r.paired_song_id && r.paired_song_id !== p.pairedSong
                      ? data.songTitleById[r.paired_song_id]
                      : '') || ''
                  }
                  searchTerm={p.searching ? p.q : ''}
                />
              ))}
            </tbody>
          </table>
          {
            /* ⚠ THE ONE THING A CAPPED LIST MUST DO IS SAY SO (plans/30 · §6).
              PostgREST stops at 1000 rows with or without a `.limit()`, so this
              table was always capped — it just had no way to tell you, and the
              badge counts above come from a different query, so they would have
              gone on reporting the real total beside a list quietly missing its
              tail. Rendered below the rows rather than above them because it is
              a fact about where the list ENDS, and that is where you meet it. */
            data.truncated && (
              <p class="border-base-300 text-base-content/60 border-t px-3 py-2 text-sm">
                Showing the first {data.rows.length}. Filter or search to reach the rest.
              </p>
            )
          }
        </div>
      )
    }
  </div>
</div>

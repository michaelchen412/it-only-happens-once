---
/*
  TypeCount — "▤ 5 writing" as a proper badge. Replaces the old cryptic
  "mix ” 6 ▤ 5 ♪ 1" run-on: each type gets its own labelled pill in its own
  color, so the mix of a constellation is legible at a glance.
*/
import TypeMark from './TypeMark.astro';
import { typeCountLabel, type FragmentType } from '../../lib/fragments-display';

interface Props {
  type: FragmentType;
  count: number;
  /** Shown on hover — e.g. a gentle nudge when the mix is thin. */
  title?: string;
}
const { type, count, title } = Astro.props;
// The mass-noun rule lives in fragments-display.ts, not here: the composer
// recomputes these badges client-side after an unplace, and both sides have to
// singularise the same way or the number and the noun disagree.
---

<span class:list={['admin-stat', count === 0 && 'opacity-50']} title={title} data-type-count={type}>
  <TypeMark type={type} />
  <b class="admin-stat__n">{count}</b>
  <span class="admin-stat__label">{typeCountLabel(type, count)}</span>
</span>

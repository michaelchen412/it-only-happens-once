---
/*
  TypeMark — a fragment's signature mark (▤ ” ♪) with its type name for screen
  readers. ONE implementation, so every admin surface reads the same way.

  The mark is NOT colour-coded (changed 2026-07-24, design.md §14 resolved).
  The three glyphs already distinguish type unambiguously by SHAPE, which made
  the colour redundant — and colour was needed for something it can only mean
  once: WHICH CONSTELLATION a fragment belongs to. So the division of labour is
  now shape = what kind of thing this is, colour = which way of seeing it
  belongs to. Keeping both would have put two colour languages on every row.
*/
import { TYPE_META, type FragmentType } from '../../lib/fragments-display';

interface Props {
  type: FragmentType | string;
  class?: string;
}
const { type, class: className = '' } = Astro.props;
const meta = TYPE_META[type as FragmentType] ?? TYPE_META.writing;
---

<span class:list={['text-base-content/45 shrink-0 font-serif select-none', className]}>
  <span aria-hidden="true">{meta.glyph}</span>
  <span class="sr-only">{meta.label}</span>
</span>

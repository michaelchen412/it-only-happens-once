---
/*
  WritingSheet — the writing composer as a near-fullscreen <dialog> drawer
  (docs/admin.md §5). The standalone /admin/writing/[id] page is retired: every
  context (the Fragment Manager, the constellation composer, the browser sheet)
  opens writing in THIS overlay so you never lose sight of what you were
  looking at. Same engine as before: TipTap → Markdown (ADR-0006), drafts
  autosave, published pieces take explicit "Save changes", PublishDialog for
  the last-mile metadata.

  Open it via:
   · document.dispatchEvent(new CustomEvent('writing:edit', { detail: '<id>' }))
   · a [data-new-writing] button anywhere on the page
   · deep link: #edit=<id> / #new-writing (the retired page redirects here)

  While open the hash mirrors the document (#edit=<id>) so a mid-edit refresh
  reopens it; on close the previous hash (e.g. the browser sheet's #browse) is
  restored. Closing after any save reloads the page so lists/suites refresh.
  In a composer context (body[data-place-in]) the FIRST save also places the
  new piece into that constellation — same hook FragmentSheet uses.
*/
import { Icon } from 'astro-icon/components';
import EditorToolbar from './EditorToolbar.astro';
import PublishDialog from './PublishDialog.astro';
import LinkDialog from './LinkDialog.astro';
import AltTextDialog from './AltTextDialog.astro';
import ConstellationPicker from './ConstellationPicker.astro';
import BackToTop from '../BackToTop.astro';

interface Props {
  subjects: string[];
  /** Every constellation — the membership picker (docs/admin.md §2). */
  constellations?: { id: string; name: string; slug: string }[];
}
const { subjects, constellations = [] } = Astro.props;
---

{
  /* max-w-5xl, not 4xl (docs/plans/16 · Piece 1). MEASURED, not preferred: at
    896px the command row's content came to ~1020px even after four buttons
    moved behind ⋯ and even at rest, so the tab strip was silently clipping
    Versions — and clipping Music too the moment the status line reached its
    longest sentence. Two tabs quietly missing on a desktop is a worse outcome
    than the shifts this piece set out to remove.
    It costs the writing surface nothing: the document column below is
    independently `max-w-2xl` and centred, so the measure you type against is
    unchanged — only the chrome gets the room it was already using. The
    FragmentBrowser drawer next door is already 5xl. */
}
<dialog id="wsheet" class="drawer-dialog w-full max-w-5xl" aria-labelledby="ws-heading">
  <form id="ws-form" class="flex h-full flex-col">
    <input type="hidden" name="id" />
    <input type="hidden" name="body" id="ws-body-field" />

    {/* command row + formatting toolbar (always visible; the document scrolls) */}
    <div class="border-base-300 bg-base-100/95 shrink-0 border-b">
      <div id="ws-command-row" class="flex items-center gap-3 px-6 py-2">
        <button type="button" data-ws-close class="text-base-content/50 hover:text-base-content" aria-label="Close"
          >✕</button
        >
        {
          /* The word "WRITING" used to sit here permanently (docs/plans/16 ·
            Piece 1). A title field and a rich text editor are directly below
            it, so as a label it was a third assertion of the obvious — but it
            did do one real job: it flipped to "Note", which is the one thing
            about this drawer you cannot see by looking at it. So the word goes
            and the FLIP stays, as a chip that appears only for a note.

            ⚠ THIS WAS A <TypeMark>, AND STOPPED BEING ONE ON 2026-08-17, when
            writing lost its glyph (TYPE_META). TypeMark went on rendering the
            accessible name correctly — but as an EMPTY box inside a `gap-1.5`
            flex row, which pushed "Note" 6px right of where the row's own
            padding puts everything else. There is no column to reserve here:
            a heading is not a row, nothing below it needs holding off a
            margin, so the honest replacement is the sr-only text alone.

            It has to stay SOMETHING: `aria-labelledby="ws-heading"` on the
            dialog points at this element, so an empty one would leave a
            near-fullscreen drawer with no accessible name at all. */
        }
        <span
          id="ws-heading"
          class="text-base-content/40 flex shrink-0 items-center font-sans text-xs tracking-widest uppercase"
        >
          <span class="sr-only">writing</span>
          <span id="ws-heading-label" hidden>Note</span>
        </span>

        {
          /* Membership is a TAB, not a popover, and lives here rather than in
            the publish dialog: a DRAFT essay never opens that dialog, and
            placing drafts in piles is what the composing room is for. */
        }
        <div id="ws-tabs" class="admin-tabs ml-2 border-b-0" role="tablist" aria-label="Editor sections">
          <button
            type="button"
            role="tab"
            class="admin-tab"
            data-tab="doc"
            aria-selected="true"
            aria-controls="ws-panel-doc"
          >
            Document
          </button>
          <button
            type="button"
            role="tab"
            class="admin-tab"
            data-tab="constellations"
            aria-selected="false"
            tabindex="-1"
            aria-controls="ws-panel-cn"
          >
            Constellations<span id="ws-cn-count" class="admin-tab__n"></span>
          </button>
          {
            /* The paired song (ADR-0009). A tab for the same reason membership
              is one: a DRAFT never opens the publish dialog, and pairing a
              song to a piece you're still writing is the whole habit this
              restores. */
          }
          <button
            type="button"
            role="tab"
            class="admin-tab"
            data-tab="music"
            aria-selected="false"
            tabindex="-1"
            aria-controls="ws-panel-music"
          >
            Music<span id="ws-music-mark" class="admin-tab__n"></span>
          </button>
          {/* Only published pieces have versions — a draft edits itself. */}
          <button
            type="button"
            role="tab"
            class="admin-tab"
            data-tab="versions"
            hidden
            aria-selected="false"
            tabindex="-1"
            aria-controls="ws-panel-versions"
          >
            Versions<span id="ws-ver-count" class="admin-tab__n"></span>
          </button>
        </div>

        {
          /* Length lives here rather than in its own corner (docs/plans/06): the
            row already carries the state of the piece, and length is state.
            `#ws-count` stays neutral while `#ws-status-text` beside it goes
            warning/error — the number is never the thing shouting. */
        }
        <div
          id="ws-status"
          class="text-base-content/55 ml-auto flex items-center gap-2 font-sans text-xs"
          aria-live="polite"
        >
          <span id="ws-count" hidden class="text-base-content/40 whitespace-nowrap tabular-nums"></span>
          {
            /* No `hidden` on the spinner: app.css hides it with `visibility` so
              it never gives its width back. A draft autosaves every 1.2s, so
              this was a ~1rem hole opening and closing beside the words you
              were writing, twice a second-and-a-bit, indefinitely. */
          }
          <span id="ws-spinner" class="loading loading-spinner loading-xs"></span>
          <span id="ws-status-text">Autosaves as you write</span>
          {
            /* THE PROOFREAD CHIP (docs/plans/22 · Piece 6). Its own element
              rather than borrowing `#ws-status-text`, which is autosave's
              channel — an autosave landing a second later would wipe the count
              mid-read, and autosave fires every 1.2s.

              No `aria-live` of its own: `#ws-status` above already carries
              `aria-live="polite"` on the CONTAINER, so anything appearing in
              here is announced for free. A nested live region is the obvious
              mistake to make at this point, not a safeguard.

              Hidden at rest, so it costs the row no width until it has
              something to say — which is the whole argument for a chip over a
              permanent counter. */
          }
          <span id="ws-pf-chip" hidden class="text-primary flex items-center gap-1.5 whitespace-nowrap">
            <span id="ws-pf-count"></span>
            <button type="button" id="ws-pf-title" hidden class="underline underline-offset-2">in the title</button>
            <button
              type="button"
              id="ws-pf-dismiss"
              aria-label="Dismiss proofreading"
              class="text-base-content/40 hover:text-base-content">✕</button
            >
          </span>
        </div>

        {
          /* Outside both action groups on purpose: a draft has a real page to
            look at now (docs/plans/01), so this button is not a published-only
            affordance any more. The script relabels it View ↗ / Preview ↗. */
        }
        <a id="ws-view-link" href="#" target="_blank" hidden class="btn btn-ghost btn-sm normal-case">View ↗</a>

        {
          /* THE ROW HOLDS TWO ACTIONS AND A DOOR (docs/plans/16 · Piece 1).
            It used to hold six, and the row was carrying three different jobs
            at once: what am I looking at (heading, tabs), what is happening
            (count, spinner, status), and what can I do. Only the first two
            earn permanent residence, so what stays is the PRIMARY (the one
            thing this state is for) and View ↗ (frequent, and it's how you
            check your work). Everything else went behind ⋯.

            The alternative was a second row allowed to wrap. Rejected: a wrap
            is a layout shift by another name — it re-flows at width
            boundaries — and it spends vertical space in a drawer whose whole
            job is the document. A menu's contents can appear and disappear
            (Discard only exists while you're dirty) at zero cost to the row,
            which is exactly the property this piece was fixing. */
        }
        <div id="ws-actions-draft" class="flex shrink-0 items-center gap-2">
          <button type="button" id="ws-open-publish" class="btn btn-primary btn-sm normal-case">Publish…</button>
        </div>
        <div id="ws-actions-published" hidden class="flex shrink-0 items-center gap-2">
          <button type="button" id="ws-save-changes" class="btn btn-primary btn-sm normal-case" disabled
            >Save changes</button
          >
        </div>

        <div class="relative shrink-0">
          <button
            type="button"
            id="ws-more-btn"
            hidden
            class="btn btn-ghost btn-sm px-2"
            aria-haspopup="menu"
            aria-expanded="false"
            aria-label="More actions"><span aria-hidden="true">⋯</span></button
          >
          <div
            id="ws-more-menu"
            hidden
            role="menu"
            class="rounded-box border-base-300 bg-base-100 absolute right-0 z-50 mt-1 w-52 border py-1 shadow-lg"
          >
            {
              /* PROOFREAD LIVES HERE, NOT IN THE ROW (docs/plans/22 · Piece 6).
                16 · Piece 1 measured the command row at 896px: its content came
                to ~1020px even after four buttons moved behind ⋯ and even at
                rest, which was silently clipping the Versions tab. A fifth
                top-level control re-opens a bug that was already paid for.

                ⚠ And this is the item that makes ⋯ permanent. `syncMoreMenu`
                hides the button when nothing behind it is visible, which on a
                plain draft was everything — so a Proofread in here would have
                been unreachable in exactly the state you proofread in. It is in
                that visibility list now, which means the door is always there.
                That is the trade: one always-present button in the row, in
                exchange for the control being where you can press it. */
            }
            <button type="button" id="ws-proofread" role="menuitem" class="add-item w-full px-3 py-2 text-left text-sm"
              >Proofread</button
            >
            {
              /* Notes promote one step at a time — note → draft → published —
                but nothing stops a finished note going straight out via
                Publish…, which is why that one stayed in the row. */
            }
            <button
              type="button"
              id="ws-to-draft"
              hidden
              role="menuitem"
              class="add-item w-full px-3 py-2 text-left text-sm">Make it a draft</button
            >
            <button
              type="button"
              id="ws-open-details"
              hidden
              role="menuitem"
              class="add-item w-full px-3 py-2 text-left text-sm">Details…</button
            >
            <button
              type="button"
              id="ws-discard"
              hidden
              role="menuitem"
              class="add-item w-full px-3 py-2 text-left text-sm">Discard changes</button
            >
            <button
              type="button"
              id="ws-unpublish"
              hidden
              role="menuitem"
              class="add-item w-full px-3 py-2 text-left text-sm">Unpublish</button
            >
          </div>
        </div>
      </div>
      {/* wrapped (not given an id) so EditorToolbar stays shared-as-is */}
      <div id="ws-toolbar">
        <EditorToolbar class="border-base-300/60 border-t px-6 py-1.5" image />
      </div>
    </div>

    {/* Document */}
    <div class="grow overflow-y-auto overscroll-contain">
      <div id="ws-panel-doc" role="tabpanel" data-tabpanel="doc" class="mx-auto w-full max-w-2xl px-6 pt-10 pb-24">
        <input
          name="title"
          placeholder="Title"
          aria-label="Title"
          class="font-display placeholder:text-base-content/25 w-full border-none bg-transparent text-4xl font-light outline-none"
        />
        <p id="ws-error" hidden role="alert" class="admin-alert mt-4"></p>
        {
          /* `min-h-96` is the canvas: an essay opens with a page's worth of room
            to click into, not one line. It sits here rather than on the shared
            `.tiptap-doc` (where it used to live) because it is this editor's
            decision — see admin.css. */
        }
        <div id="ws-editor" class="reading mt-6 min-h-96"></div>

        {
          /* DELETE LEFT THE TOP BAR (docs/plans/16 · Piece 1). It was sitting
            in a row of benign controls, one keystroke from Unpublish — a
            destructive action wearing the same clothes as "Details…". The
            constellation composer already solved this: Delete sits apart,
            below a rule, at the END of the thing it destroys, with a line
            saying what it does and doesn't touch. Same treatment here.

            Deliberately NOT inside the ⋯ menu, which was the other candidate:
            a menu is where you put things you reach for occasionally, and
            putting delete one arrow-key from Unpublish would have reproduced
            the original fault in a smaller box. */
        }
        <div
          id="ws-delete-zone"
          hidden
          class="border-base-300 mt-20 flex flex-wrap items-center justify-between gap-4 border-t pt-4"
        >
          <p class="admin-hint">
            Deleting moves this piece to the trash. Its constellations keep their shape, and nothing else you've written
            is touched.
          </p>
          <button type="button" id="ws-delete" class="btn btn-ghost btn-sm text-error gap-1.5 font-sans normal-case">
            <Icon name="ph:trash" /> Delete
          </button>
        </div>
      </div>

      <div
        id="ws-panel-cn"
        role="tabpanel"
        data-tabpanel="constellations"
        hidden
        class="mx-auto w-full max-w-2xl px-6 pt-8 pb-24"
      >
        <h3 class="font-display text-lg">In which constellations</h3>
        <p class="admin-hint mt-1 mb-4">
          The ways of seeing this piece belongs to. Changes apply immediately — no save needed. Adding puts it at the
          end of that constellation's suite; reorder in the composer.
        </p>
        <ConstellationPicker scope="writing" constellations={constellations} />
      </div>

      {
        /* The paired song (ADR-0009 "paired media", docs/plans/04 Piece 3).
          Applies IMMEDIATELY like constellation membership — it's a relation,
          not a field of the document, so it must never ride along with the
          compare-and-set save and risk a rewrite. */
      }
      <div
        id="ws-panel-music"
        role="tabpanel"
        data-tabpanel="music"
        hidden
        class="mx-auto w-full max-w-2xl px-6 pt-8 pb-24"
      >
        <h3 class="font-display text-lg">The song that goes with this</h3>
        <p class="admin-hint mt-1 mb-4">
          One song, paired to this piece — it plays at the top, before the words. Changes apply immediately, no save
          needed. This is the pairing 50 of the imported essays already carried; a constellation's score is a different
          thing, set in the composer.
        </p>
        <p id="ws-music-error" hidden role="alert" class="admin-alert mb-3"></p>

        {/* What's paired now (or nothing) */}
        <div id="ws-music-current" class="rounded-box border-base-300 mb-5 flex items-center gap-3 border px-4 py-3">
          <span id="ws-music-none" class="admin-hint italic">Nothing paired yet.</span>
          <span
            id="ws-music-name"
            hidden
            class="font-serif text-[1.05rem] tracking-[0.06em] [font-variant:all-small-caps]"></span>
          <button type="button" id="ws-music-clear" hidden class="btn btn-ghost btn-xs text-error ml-auto normal-case">
            Unpair
          </button>
        </div>

        <label class="f">
          <span class="f__k">Find a song</span>
          {
            /* ONE FIELD, TWO KINDS OF INPUT (plan 33 §6a). It used to take only a
              query, so pairing a song that wasn't in the corpus meant leaving for
              the Fragment Manager, making it, and coming back to a sheet you had
              lost your place in. Pasting a link now offers to add it here.

              ⚠ `type="search"` is kept even though it also takes URLs. The type
              buys the clear-field affordance and the right keyboard for the
              common case, which is still typing a title; a URL pasted into a
              search field is not a validation problem, because nothing here
              validates it — `songs.lookup` does, on the server, once. */
          }
          <input id="ws-music-q" type="search" autocomplete="off" placeholder="Title or artist — or paste a link" />
        </label>
        <ul id="ws-music-results" class="mt-3 space-y-1"></ul>
        {
          /* ⚠ THE `{' '}` IS LOAD-BEARING, not a formatting artifact. Astro drops
            the newline-plus-indent before an inline element at the start of a
            line, so `the same\n<code>saveSong</code>` renders as
            "the samesaveSong". Prettier reflows this paragraph on every save and
            decides where the line breaks fall, so the space has to be written
            rather than left to the wrapping. */
        }
        <p class="admin-hint mt-4">
          Paste a Spotify or YouTube link and it can be added and paired without leaving this sheet — the same{' '}
          <code>saveSong</code> the Fragment Manager uses, reached from here. A song already in the corpus under a different
          form of its link is recognised rather than duplicated.
        </p>
      </div>

      {
        /* Versions (docs/admin.md §5, plan 07). Editing a published piece writes
          here, never to the live row — so this panel is both the history and
          the answer to "where did my unsaved rewrite go". */
      }
      <div
        id="ws-panel-versions"
        role="tabpanel"
        data-tabpanel="versions"
        hidden
        class="mx-auto w-full max-w-2xl px-6 pt-8 pb-24"
      >
        <h3 class="font-display text-lg">Versions</h3>
        <p class="admin-hint mt-1 mb-4">
          Editing a published piece never changes what readers see. Your edits are kept here until you promote one — and
          promoting keeps whatever it replaces, so an opening you liked better is never gone.
        </p>
        <p id="ws-ver-error" hidden role="alert" class="admin-alert mb-3"></p>
        <ol id="ws-ver-list" class="space-y-2"></ol>
      </div>
    </div>
    <BackToTop scroller="#wsheet .grow.overflow-y-auto" inDialog />

    {
      /* ONE POPOVER, EVERY MARK (docs/plans/22 · Piece 5). `anchorPopover` takes
        its trigger as a CALLBACK rather than an element precisely so one popover
        can serve a pile of things and say which one opened it — that is the
        notes room's shape, and "one popover, many inline marks" is the same
        shape. The title `<input>` is just another trigger.

        Native `popover` (auto), so opening, Escape, light-dismiss and
        one-at-a-time all belong to the browser, and the top layer keeps it clear
        of the drawer's own clipping — trap 7 in app.css. */
    }
    <div class="pop" popover id="ws-pf-pop">
      <p class="px-1 py-0.5 text-sm">
        <s id="ws-pf-before" class="text-base-content/50"></s>
        <span aria-hidden="true">→</span>
        <strong id="ws-pf-after"></strong>
      </p>
      <div class="mt-1 flex items-center gap-1">
        <button type="button" id="ws-pf-fix" class="btn btn-primary btn-xs normal-case">Fix it</button>
        <button type="button" id="ws-pf-ignore" class="btn btn-ghost btn-xs normal-case">Ignore</button>
      </div>
    </div>
  </form>
</dialog>

<PublishDialog formId="ws-form" subjectNames={subjects} />
<LinkDialog id="ws-link-dialog" />
<AltTextDialog id="ws-alt-dialog" />

<script>
  import '../../scripts/writing-sheet';
</script>

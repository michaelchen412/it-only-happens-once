---
/*
  FragmentBrowser — the composer's "Add" surface: a large <dialog> drawer
  holding a mini Fragment Manager (the same table/filters as /admin/fragments, served by
  the fragments-panel partial in mode=pick). Browse the whole corpus, place
  with the per-row ＋ or checkbox-select many and place them together. Rows
  already in this constellation render dimmed and unselectable (visible truth,
  never re-addable). Clicking a row opens its real editor in a sheet on top —
  quote/song → FragmentSheet, writing → WritingSheet — and the header's own
  Add ▾ creates new fragments that auto-place via body[data-place-in].

  Nothing here navigates. A sheet that saves on top of this drawer, and this
  drawer closing after a placement, both announce `fragments:changed` — the
  composer refreshes its suite in place and this drawer refreshes its own rows,
  so composing survives a save with its scroll position, its view mode and its
  unsaved form edits intact. The #browse hash is kept for a genuine hard
  refresh; it is no longer what makes a save land back inside the browser,
  because the browser no longer closes for one.
*/
import { Icon } from 'astro-icon/components';
import TypeMark from './TypeMark.astro';
import BackToTop from '../BackToTop.astro';

interface Props {
  constellation: string;
  /** Shown on rows the moment they're placed, so the column stays truthful. */
  constellationName: string;
  /** The "what is this for" reminder while you pick (docs/admin.md §2). */
  constellationDescription?: string | null;
  /** Colour slot, so a chip added live matches the server-rendered ones. */
  constellationColor?: string | null;
}
const { constellation, constellationName, constellationDescription, constellationColor } = Astro.props;
---

<dialog
  id="fbrowser"
  class="drawer-dialog w-full max-w-5xl"
  data-constellation={constellation}
  data-constellation-name={constellationName}
  data-constellation-color={constellationColor}
  aria-labelledby="fb-title"
>
  <div class="flex h-full flex-col">
    <header class="border-base-300 flex shrink-0 items-center gap-3 border-b px-6 py-3">
      <div class="min-w-0">
        <h2 id="fb-title" class="font-display truncate text-xl">
          Add to <span id="fb-cname" class="text-primary">{constellationName}</span>
        </h2>
        {
          /* Rendered even when empty, so a description added in the form behind
          this drawer has somewhere to land without a reload (sky:changed). */
        }
        <p
          id="fb-cdesc"
          class="admin-hint line-clamp-1"
          title={constellationDescription}
          hidden={!constellationDescription}
        >
          {constellationDescription}
        </p>
      </div>
      <p id="fb-error" hidden role="alert" class="admin-alert px-2 py-1 text-xs"></p>
      <div class="relative ml-auto">
        <button
          id="fb-add-btn"
          class="btn btn-primary btn-sm gap-1 font-sans"
          aria-haspopup="menu"
          aria-expanded="false"
        >
          <Icon name="ph:plus" /> Add <span aria-hidden="true">▾</span>
        </button>
        <div
          id="fb-add-menu"
          hidden
          role="menu"
          aria-label="Add a fragment"
          class="rounded-box border-base-300 bg-base-100 absolute right-0 z-30 mt-1 w-40 overflow-hidden border py-1 shadow-lg"
        >
          <button
            data-new-writing
            role="menuitem"
            class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"
            ><TypeMark type="writing" /> Writing</button
          >
          <button
            data-new="quote"
            role="menuitem"
            class="add-item flex w-full items-center gap-2 px-3 py-2 text-left text-sm"
            ><TypeMark type="quote" /> Quote</button
          >
          {
            /* NO SONG, and its absence is the decision rather than an omission
              (ADR 0031). This menu makes a fragment *to place in this suite*,
              and a song is never a suite stanza — it accompanies a
              constellation through `score_url` or through an essay's
              `paired_song_id`, both relations rather than membership. Offering
              a create here would make something the picker below cannot show
              and `constellations.place` refuses. Songs enter at
              /admin/listening, in the same motion as the listening. */
          }
        </div>
      </div>
      <button type="button" data-fb-close class="text-base-content/50 hover:text-base-content" aria-label="Close"
        >✕</button
      >
    </header>

    <div id="fb-panel" class="grow overflow-y-auto overscroll-contain px-6 py-4">
      <p class="text-base-content/50 font-sans text-sm">Loading fragments…</p>
    </div>

    <BackToTop scroller="#fb-panel" inDialog class="bottom-20" />

    {
      /* The cart bar — it appears once anything is in the cart, and STAYS while
        you change the filter underneath it. Two controls exist only because of
        that: the "· n shown here" half of the count, which explains a number
        you can't finish counting on screen, and Clear — with a persisting cart,
        "change the filter" is no longer the way to empty it, so there has to be
        one. */
    }
    <footer
      id="fb-bulkbar"
      hidden
      class="border-base-300 bg-base-200 flex shrink-0 items-center gap-3 border-t px-6 py-2.5 font-sans text-sm"
    >
      <span id="fb-bulkcount" class="text-base-content/70 whitespace-nowrap">0 selected</span>
      <button id="fb-place-selected" class="btn btn-primary btn-xs normal-case">Place in constellation</button>
      <button id="fb-clear-selected" class="btn btn-ghost btn-xs ml-auto normal-case">Clear</button>
    </footer>
  </div>
</dialog>

<script>
  import '../../scripts/fragment-browser';
</script>

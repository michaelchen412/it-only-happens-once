---
/*
  One row of the fragment table (<tr>), shared by the Fragment Manager and the
  composer's browser sheet (mode="pick"). The TITLE is the real, focusable
  control — a <button> for every type: quote/song rows open the FragmentSheet,
  writing rows open the WritingSheet (`data-writing`). A click anywhere else on
  the row is a mouse-only convenience that triggers the same thing
  (src/scripts/fragment-panel.ts). In trash view the row isn't an edit target
  and shows Restore / Delete-forever actions.

  mode="pick" (the browser sheet): rows already placed in the target
  constellation render dimmed with a disabled checkbox — visible, never
  re-addable; everything else gets a per-row ＋ place button (data-act).

  The CONSTELLATIONS CELL is a control, not a label: it opens this fragment's
  editor already on its Constellations tab (`data-act="constellations"` →
  src/scripts/open-editor.ts). See the cell itself for why it's one button
  rather than one per chip.

  When a search term is active, the title/attribution highlight matches and a
  `writing` fragment shows an excerpt line per match window (search-highlight.ts).
*/
import type { Database } from '../../lib/database.types';
import { shortDate, rowTitle } from '../../lib/fragments-display';
import { excerpts, toPlain } from '../../lib/search-highlight';
import Highlighted from './Highlighted.astro';
import TypeMark from './TypeMark.astro';
import StatusChip from './StatusChip.astro';
import StarMark from '../StarMark.astro';

type FragmentRowT = Database['public']['Tables']['fragments']['Row'];
interface Props {
  fragment: FragmentRowT;
  subjects: string[];
  constellations?: { id: string; name: string; slug: string; color?: string | null }[];
  authorName?: string;
  workName?: string;
  view?: 'list' | 'trash';
  mode?: 'manage' | 'pick';
  placed?: boolean;
  searchTerm?: string;
}
const {
  fragment: r,
  subjects,
  constellations = [],
  authorName,
  workName,
  view = 'list',
  mode = 'manage',
  placed = false,
  searchTerm = '',
} = Astro.props;
// The combo prefill needs ids (to select the existing entity), not just names.
const authorId = r.author_id ?? '';
const workId = r.work_id ?? '';
const trash = mode === 'manage' && view === 'trash';
const pick = mode === 'pick';
const term = searchTerm.trim();

// Excerpt the essay body (writing only — for quotes the body IS the shown title).
const { windows: bodyWindows, more: moreMatches } =
  term && r.type === 'writing' && r.body ? excerpts(toPlain(r.body), term) : { windows: [], more: 0 };

// A quote's fuller identity for the citation line: "— Author, Work".
//
// ⚠ From the RELATION, not from `details.source_title` (2026-08-05, plan 17a).
// That key was a string copy of `works.title` — 41 of its 42 rows verbatim — and
// `saveQuote` has stopped writing it, so reading it here would have blanked this
// label on every quote the moment it was next saved. The prop beside it has been
// the real answer all along; the copy was only ever a duplicate that could drift.
const quoteWork = r.type === 'quote' ? (workName ?? '').trim() : '';

// The membership cell's two names. STATE FIRST, THEN THE VERB — the same order
// the chips read in, so the screen reader hears what the eye sees. `title` stays
// the mouse-only full list it always was; it is not an accessible name, which is
// why the label below exists rather than being left to it.
const cnNames = constellations.map((c) => c.name);
const cnTitle = cnNames.join(' · ') || undefined;
const cnLabel = cnNames.length
  ? `In ${cnNames.join(', ')} — change constellations`
  : 'In no constellations — assign one';

// The primary line. A quote's body is Markdown → strip it to plain text for the row.
const primaryText = r.type === 'quote' ? toPlain(rowTitle(r)) : rowTitle(r);

const editorData =
  r.type === 'writing'
    ? ''
    : JSON.stringify({
        id: r.id,
        type: r.type,
        title: r.title ?? '',
        body: r.body ?? '',
        attribution: r.attribution ?? '',
        source_url: r.source_url ?? '',
        status: r.status,
        year: new Date(r.occurred_at).getUTCFullYear(),
        occurredIso: r.occurred_at,
        datePrecision: r.date_precision,
        authorId,
        // The ONLY record that a quote is Michael's own — there is no author row
        // to infer it from. Without it the sheet reopens a self-authored quote
        // as "nobody knows" and the next save clears the flag.
        isSelf: r.is_self ?? false,
        authorName: authorName ?? '',
        workId,
        workName: workName ?? '',
        subjects: subjects.join(', '),
        constellationIds: constellations.map((c) => c.id), // seeds the membership picker
        details: (r.details ?? {}) as Record<string, unknown>,
      });
---

<tr
  class:list={[
    'fragment-row border-base-300 border-b last:border-0',
    !trash && !placed && 'hover:bg-base-200/40',
    pick && placed && 'opacity-45',
  ]}
  data-id={r.id}
  data-type={r.type}
  data-writing={r.type === 'writing' ? r.id : undefined}
  data-fragment={editorData || undefined}
  data-placed={placed ? '' : undefined}
  data-constellations={constellations.map((c) => c.id).join(',')}
>
  <td class="w-8 px-3 py-2.5 align-top" data-noedit>
    <input
      type="checkbox"
      class="row-check checkbox checkbox-xs"
      value={r.id}
      disabled={pick && placed}
      aria-label={`Select ${primaryText}`}
    />
  </td>
  <td class="w-6 pt-2.5 text-center align-top">
    <TypeMark type={r.type} />
  </td>
  <td class="w-full max-w-0 py-2.5 pr-3 align-top">
    {
      trash ? (
        <div class:list={r.type === 'quote' ? 'line-clamp-3 italic' : 'truncate'}>
          <Highlighted text={primaryText} term={term} />
        </div>
      ) : r.type === 'quote' ? (
        <button type="button" class="row-open line-clamp-3 max-w-full text-left italic">
          <Highlighted text={primaryText} term={term} />
        </button>
      ) : (
        <button type="button" class="row-open block max-w-full truncate text-left">
          <Highlighted text={primaryText} term={term} />
        </button>
      )
    }
    {
      r.attribution ? (
        <div class="text-base-content/60 truncate font-sans text-xs">
          {r.type === 'quote' && '— '}
          <Highlighted text={r.attribution} term={term} />
          {quoteWork && (
            <>
              , <span class="italic">{quoteWork}</span>
            </>
          )}
        </div>
      ) : (
        /* THE TWO SILENCES, told apart (docs/plans/17a). A quote with no line
           renders nothing on the page whether Michael wrote it or nobody knows
           — but here they must not look alike, and neither may look like a row
           you forgot to finish. A matched pair in muted italic, in the slot the
           citation would occupy, reads as a statement ABOUT the row rather than
           as data in it. (Rejected: "Myself", which reads as a value someone
           typed; and a glyph alone, which has to be learned.) */
        r.type === 'quote' && (
          <div class="text-base-content/40 truncate font-sans text-xs italic">
            {r.is_self ? 'your words' : 'source unknown'}
          </div>
        )
      )
    }
    {
      bodyWindows.length > 0 && (
        <div class="text-base-content/60 mt-1 space-y-0.5 font-sans text-xs leading-relaxed">
          {bodyWindows.map((ex) => (
            <p>
              {ex.lead && '… '}
              <Highlighted segs={ex.segs} />
              {ex.trail && ' …'}
            </p>
          ))}
          {moreMatches > 0 && (
            <p class="text-base-content/45">
              +{moreMatches} more match{moreMatches === 1 ? '' : 'es'}
            </p>
          )}
        </div>
      )
    }
  </td>
  {
    /* ── The membership cell: ONE button, ONE verb ──────────────────────────
      Filing a fragment used to cost a detour — open the row, find the tab,
      then find your place in the list again. The chips you were already
      reading are the door now.

      NOT A BUTTON PER CHIP, for three reasons that all point the same way. A
      <button> may not contain interactive content, so a per-chip ✕ would mean
      the cell can't be one control at all — it becomes a strip of small
      targets with dead gaps between them, and "click the column" stops
      existing. It would also hang an unassign on the kind of fast, unaimed
      click a dense table invites; ConstellationPicker made this same call for
      its ↗ ("specified not to forward activation" is a thin thread). And this
      row already carries three click meanings — a fourth is fine, a fourth
      that changes with which 60px you hit is not. Removal lives in the picker,
      where it is labelled and instantly reversible.

      The cell is `data-noedit` so its dead space does NOTHING rather than
      falling through to "open this fragment" — one region, one answer. */
    !trash && (
      <td class="hidden max-w-[13rem] align-top lg:table-cell" data-noedit>
        <button type="button" class="cn-cell" data-act="constellations" title={cnTitle} aria-label={cnLabel}>
          <span class="cn-cell__chips">
            {constellations.length === 0 ? (
              <span class="admin-chip admin-chip--none">none</span>
            ) : (
              constellations.map((c) => (
                <span class:list={['admin-chip admin-chip--in max-w-[11rem] truncate', c.color && `cn-${c.color}`]}>
                  <StarMark class="mr-1" />
                  {c.name}
                </span>
              ))
            )}
          </span>
          {/* Reserved, never inserted on hover — see .cn-cell in app.css. */}
          <span class="cn-cell__mark" aria-hidden="true">
            ＋
          </span>
        </button>
      </td>
    )
  }
  <td class="hidden px-3 pt-2.5 align-top sm:table-cell">
    <StatusChip status={r.status} />
  </td>
  <td
    class="text-base-content/65 hidden px-3 pt-2.5 text-right align-top font-sans text-xs whitespace-nowrap md:table-cell"
  >
    {shortDate(r.occurred_at)}
  </td>
  <td class="text-base-content/65 px-3 pt-2.5 text-right align-top font-sans text-xs whitespace-nowrap">
    {shortDate(r.updated_at)}
  </td>
  {
    pick && (
      <td class="px-3 pt-1.5 text-right align-top whitespace-nowrap" data-noedit>
        {placed ? (
          <span class="text-primary/70 font-sans text-[0.65rem] tracking-wide uppercase">
            <StarMark /> placed
          </span>
        ) : (
          <button
            type="button"
            class="btn btn-ghost btn-xs font-sans normal-case"
            data-act="place"
            data-id={r.id}
            title="Place in this constellation"
          >
            ＋
          </button>
        )}
      </td>
    )
  }
  {
    trash && (
      <td class="px-3 pt-2.5 text-right align-top whitespace-nowrap" data-noedit>
        <button class="text-base-content/70 hover:text-primary font-sans text-xs" data-act="restore" data-id={r.id}>
          Restore
        </button>
        <button class="text-base-content/70 hover:text-error ml-3 font-sans text-xs" data-act="purge" data-id={r.id}>
          Delete
        </button>
      </td>
    )
  }
</tr>

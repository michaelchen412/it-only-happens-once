---
/*
  One row of the fragment table (<tr>), shared by the Fragment Manager and the
  composer's browser sheet (mode="pick"). The TITLE is the real, focusable
  control — a <button> for every type, and each type names its own surface
  through `scripts/open-editor.ts`: quotes carry `data-fragment` and open the
  FragmentSheet, writing carries `data-writing` and opens the WritingSheet,
  songs carry `data-song` and open the SongSheet (ADR 0031). A click anywhere else on
  the row is a mouse-only convenience that triggers the same thing
  (src/scripts/fragment-panel.ts). In trash view the row isn't an edit target
  and shows Restore / Delete-forever actions.

  mode="pick" (the browser sheet): rows already placed in the target
  constellation render dimmed with a disabled checkbox — visible, never
  re-addable; everything else gets a per-row ＋ place button (data-act).

  mode="pair" (the song sheet's picker, plan 39): the same dimming for rows
  already paired to THIS song, and no checkbox column at all — `paired_song_id`
  is one key on one row, so there is nothing to multi-select. Two ⚠ deviations
  from pick, both deliberate:

   · THE TITLE PAIRS INSTEAD OF OPENING (ruling 5). `.row-open` is still the
     control; what the host does with it is the host's business, and the pair
     picker's host pairs. The composer opens editors because placing is
     curation and you must read what you curate — pairing is not curation, you
     already know what the piece is.
   · THE MEMBERSHIP CELL STOPS BEING A BUTTON, for the same reason: pressing it
     opens this fragment's editor, and /admin/listening does not mount one. It
     renders as a plain label so the column still says where the piece lives and
     the four columns beside it stay in line.

  The CONSTELLATIONS CELL is a control, not a label: it opens this fragment's
  editor already on its Constellations tab (`data-act="constellations"` →
  src/scripts/open-editor.ts). See the cell itself for why it's one button
  rather than one per chip.

  When a search term is active, the title/attribution highlight matches and a
  `writing` fragment shows an excerpt line per match window (search-highlight.ts).

  `data-status` is on the row for the pair picker, which repaints the song
  sheet's paired list from the row it just picked rather than refetching the
  song. Reading the status chip's rendered text was the alternative, and it is
  one relabelling away from breaking.
*/
import type { Database } from '../../lib/database.types';
import type { PanelMode } from '../../lib/fragment-query';
import { shortDate, homeDate, rowTitle } from '../../lib/fragments-display';
import { excerpts, toPlain } from '../../lib/search-highlight';
import Highlighted from './Highlighted.astro';
import TypeMark from './TypeMark.astro';
import StatusChip from './StatusChip.astro';
import StarMark from '../StarMark.astro';

type FragmentRowT = Database['public']['Tables']['fragments']['Row'];
interface Props {
  fragment: FragmentRowT;
  subjects: string[];
  constellations?: { id: string; name: string; slug: string; color?: string | null }[];
  authorName?: string;
  workName?: string;
  view?: 'list' | 'trash';
  mode?: PanelMode;
  placed?: boolean;
  /** pair mode: already paired to the song the picker is open on. */
  paired?: boolean;
  /**
   * pair mode: the title of the song this piece is paired to, when it is a
   * DIFFERENT one. Empty otherwise — including for the target song itself,
   * which `paired` already covers. It rides on the row so the confirm can name
   * what a pick is about to take without a second round trip (ruling 2).
   */
  pairedToOther?: string;
  searchTerm?: string;
}
const {
  fragment: r,
  subjects,
  constellations = [],
  authorName,
  workName,
  view = 'list',
  mode = 'manage',
  placed = false,
  paired = false,
  pairedToOther = '',
  searchTerm = '',
} = Astro.props;
// The combo prefill needs ids (to select the existing entity), not just names.
// The configured home zone, for the `Edited` stamp. `Astro.locals` is available
// to any .astro component during SSR, so this needs no prop threading — and it
// is the same resolved value every other room's clock reads (middleware.ts).
const { tz } = Astro.locals.today;
const authorId = r.author_id ?? '';
const workId = r.work_id ?? '';
const trash = mode === 'manage' && view === 'trash';
const pick = mode === 'pick';
const pair = mode === 'pair';
// "Already in the target" — placed for a constellation, paired for a song. One
// name because every use below is the same question, and writing both conditions
// at each of the five sites is how the two modes drift apart.
const taken = pick ? placed : pair && paired;
const term = searchTerm.trim();

// Excerpt the essay body (writing only — for quotes the body IS the shown title).
const { windows: bodyWindows, more: moreMatches } =
  term && r.type === 'writing' && r.body ? excerpts(toPlain(r.body), term) : { windows: [], more: 0 };

// A quote's fuller identity for the citation line: "— Author, Work".
//
// ⚠ From the RELATION, not from `details.source_title` (2026-08-05, plan 17a).
// That key was a string copy of `works.title` — 41 of its 42 rows verbatim — and
// `saveQuote` has stopped writing it, so reading it here would have blanked this
// label on every quote the moment it was next saved. The prop beside it has been
// the real answer all along; the copy was only ever a duplicate that could drift.
const quoteWork = r.type === 'quote' ? (workName ?? '').trim() : '';

// The membership cell's two names. STATE FIRST, THEN THE VERB — the same order
// the chips read in, so the screen reader hears what the eye sees. `title` stays
// the mouse-only full list it always was; it is not an accessible name, which is
// why the label below exists rather than being left to it.
const cnNames = constellations.map((c) => c.name);
const cnTitle = cnNames.join(' · ') || undefined;
const cnLabel = cnNames.length
  ? `In ${cnNames.join(', ')} — change constellations`
  : 'In no constellations — assign one';

// The primary line. A quote's body is Markdown → strip it to plain text for the row.
const primaryText = r.type === 'quote' ? toPlain(rowTitle(r)) : rowTitle(r);

/*
  ⚠ A QUOTE IS CLAMPED SHORTER IN THE DRAWER THAN IN THE MANAGER, and the
  asymmetry is the point rather than an oversight (Michael, 2026-08-15: *"in the
  fragment browser quotes should not be completely displayed. They should
  truncate after a certain length"* → two lines, browser only).

  A quote has no title, so its BODY is its primary line — which means a row's
  height is set by how long the quotation is, and three lines of one is a tall
  row. That is a fair trade in `/admin/fragments`, where the table IS the room
  and you are reading to find something. It is a bad one in the browser drawer,
  where the table is a picker over a suite you are composing: you are scanning
  for a piece you already have in mind, and every extra line is one fewer row on
  screen at the moment you most want the list dense.

  Two rather than one, because a single line of a quotation is often just its
  run-up ("It is a truth universally acknowledged, that a single man in") and
  tells you nothing about which quote it is.
*/
const quoteClamp = pick || pair ? 'line-clamp-2' : 'line-clamp-3';

/*
  ⚠ QUOTES ONLY NOW (ADR 0031). Writing has always opened its own workshop from
  `data-writing`; a SONG now opens `SongSheet` from `data-song`, the same way and
  for the same reason — one editor per kind, named by an id rather than by a
  payload. So this blob, which exists to fill the FragmentSheet's fields without
  a round trip, has one consumer left.

  A song deliberately does NOT get the same treatment. Its sheet needs the
  album, the year, both notes and the paired essays, and carrying those on every
  row would ship every private note in the corpus into the manager's HTML in
  order to open one of them. `songs.forSheet` is one read on open instead.
*/
const editorData =
  r.type !== 'quote'
    ? ''
    : JSON.stringify({
        id: r.id,
        type: r.type,
        // The sheet shows it and can override it. It is carried because a saved
        // quote's slug is FROZEN (actions/_shared.ts `fragmentSlug`) — so the
        // field has to open on the real address rather than re-deriving a
        // preview of one that will be ignored.
        slug: r.slug,
        title: r.title ?? '',
        body: r.body ?? '',
        attribution: r.attribution ?? '',
        source_url: r.source_url ?? '',
        status: r.status,
        year: new Date(r.occurred_at).getUTCFullYear(),
        occurredIso: r.occurred_at,
        datePrecision: r.date_precision,
        authorId,
        // The ONLY record that a quote is Michael's own — there is no author row
        // to infer it from. Without it the sheet reopens a self-authored quote
        // as "nobody knows" and the next save clears the flag.
        isSelf: r.is_self ?? false,
        authorName: authorName ?? '',
        workId,
        workName: workName ?? '',
        subjects: subjects.join(', '),
        constellationIds: constellations.map((c) => c.id), // seeds the membership picker
        details: (r.details ?? {}) as Record<string, unknown>,
      });
---

<tr
  class:list={[
    'fragment-row border-base-300 border-b last:border-0',
    !trash && !taken && 'hover:bg-base-200/40',
    taken && 'opacity-45',
  ]}
  data-id={r.id}
  data-type={r.type}
  data-status={r.status}
  data-writing={r.type === 'writing' ? r.id : undefined}
  data-fragment={editorData || undefined}
  data-placed={placed ? '' : undefined}
  data-paired={paired ? '' : undefined}
  data-paired-to={pairedToOther || undefined}
  data-constellations={constellations.map((c) => c.id).join(',')}
>
  {
    !pair && (
      <td class="w-8 px-3 py-2.5 align-top" data-noedit>
        <input
          type="checkbox"
          class="row-check checkbox checkbox-xs"
          value={r.id}
          disabled={pick && placed}
          aria-label={`Select ${primaryText}`}
        />
      </td>
    )
  }
  <td class="w-6 pt-2.5 text-center align-top">
    <TypeMark type={r.type} />
  </td>
  <td class="w-full max-w-0 py-2.5 pr-3 align-top">
    {
      trash ? (
        /* Trash is manage-only, so this is always the three-line clamp — the
           drawer never renders a trashed row. Written as `quoteClamp` anyway,
           so the two never have to be kept in step by hand. */
        <div class:list={r.type === 'quote' ? [quoteClamp, 'italic'] : 'truncate'}>
          <Highlighted text={primaryText} term={term} />
        </div>
      ) : r.type === 'quote' ? (
        <button type="button" class:list={['row-open max-w-full text-left italic', quoteClamp]}>
          <Highlighted text={primaryText} term={term} />
        </button>
      ) : (
        <button type="button" class="row-open block max-w-full truncate text-left">
          <Highlighted text={primaryText} term={term} />
        </button>
      )
    }
    {
      r.attribution ? (
        <div class="text-base-content/60 truncate font-sans text-xs">
          {r.type === 'quote' && '— '}
          <Highlighted text={r.attribution} term={term} />
          {quoteWork && (
            <>
              , <span class="italic">{quoteWork}</span>
            </>
          )}
        </div>
      ) : (
        /* THE TWO SILENCES, told apart (docs/plans/17a). A quote with no line
           renders nothing on the page whether Michael wrote it or nobody knows
           — but here they must not look alike, and neither may look like a row
           you forgot to finish. A matched pair in muted italic, in the slot the
           citation would occupy, reads as a statement ABOUT the row rather than
           as data in it. (Rejected: "Myself", which reads as a value someone
           typed; and a glyph alone, which has to be learned.) */
        r.type === 'quote' && (
          <div class="text-base-content/40 truncate font-sans text-xs italic">
            {r.is_self ? 'your words' : 'source unknown'}
          </div>
        )
      )
    }
    {
      bodyWindows.length > 0 && (
        <div class="text-base-content/60 mt-1 space-y-0.5 font-sans text-xs leading-relaxed">
          {bodyWindows.map((ex) => (
            <p>
              {ex.lead && '… '}
              <Highlighted segs={ex.segs} />
              {ex.trail && ' …'}
            </p>
          ))}
          {moreMatches > 0 && (
            <p class="text-base-content/45">
              +{moreMatches} more match{moreMatches === 1 ? '' : 'es'}
            </p>
          )}
        </div>
      )
    }
  </td>
  {
    /* ── The membership cell: ONE button, ONE verb ──────────────────────────
      Filing a fragment used to cost a detour — open the row, find the tab,
      then find your place in the list again. The chips you were already
      reading are the door now.

      NOT A BUTTON PER CHIP, for three reasons that all point the same way. A
      <button> may not contain interactive content, so a per-chip ✕ would mean
      the cell can't be one control at all — it becomes a strip of small
      targets with dead gaps between them, and "click the column" stops
      existing. It would also hang an unassign on the kind of fast, unaimed
      click a dense table invites; ConstellationPicker made this same call for
      its ↗ ("specified not to forward activation" is a thin thread). And this
      row already carries three click meanings — a fourth is fine, a fourth
      that changes with which 60px you hit is not. Removal lives in the picker,
      where it is labelled and instantly reversible.

      The cell is `data-noedit` so its dead space does NOTHING rather than
      falling through to "open this fragment" — one region, one answer. */
    !trash &&
      /* ⚠ A SONG GETS THE COLUMN BUT NOT THE CONTROL (ADR 0031). A song is
        never a member of a constellation — `constellations.place` and
        `setMembership` both refuse one — so the ＋ here would be an invitation
        the action declines, and pressing it would open the song sheet, which
        has no Constellations tab to land on. Silently doing something other
        than what a control promises is worse than not offering it.

        The `<td>` still renders, empty: the table's columns are shared by every
        row, and dropping the cell on one type would shift the two dates beside
        it out of line with the rows above and below. */
      (pair ? (
        /* ⚠ THE SAME CHIPS, NOT A CONTROL (plan 39 · ruling 5). This cell's
          whole job elsewhere is to open the fragment's editor on its
          Constellations tab — and the pair picker has ruled that it opens no
          editors, because /admin/listening does not mount the writing sheet and
          a control that silently does nothing is worse than one that isn't
          there. The column still earns its width: where a piece already lives
          is exactly the context you want while deciding what to pair to it. */
        <td class="hidden max-w-[13rem] align-top lg:table-cell" data-noedit>
          <span class="cn-cell cn-cell--static" title={cnTitle}>
            <span class="cn-cell__chips">
              {constellations.length === 0 ? (
                <span class="admin-chip admin-chip--none">none</span>
              ) : (
                constellations.map((c) => (
                  <span class:list={['admin-chip admin-chip--in max-w-[11rem] truncate', c.color && `cn-${c.color}`]}>
                    <StarMark class="mr-1" />
                    {c.name}
                  </span>
                ))
              )}
            </span>
          </span>
        </td>
      ) : (
        <td class="hidden max-w-[13rem] align-top lg:table-cell" data-noedit>
          <button type="button" class="cn-cell" data-act="constellations" title={cnTitle} aria-label={cnLabel}>
            <span class="cn-cell__chips">
              {constellations.length === 0 ? (
                <span class="admin-chip admin-chip--none">none</span>
              ) : (
                constellations.map((c) => (
                  <span class:list={['admin-chip admin-chip--in max-w-[11rem] truncate', c.color && `cn-${c.color}`]}>
                    <StarMark class="mr-1" />
                    {c.name}
                  </span>
                ))
              )}
            </span>
            {/* Reserved, never inserted on hover — see .cn-cell in app.css. */}
            <span class="cn-cell__mark" aria-hidden="true">
              ＋
            </span>
          </button>
        </td>
      ))
  }
  <td class="hidden px-3 pt-2.5 align-top sm:table-cell">
    <StatusChip status={r.status} />
  </td>
  <td
    class="text-base-content/65 hidden px-3 pt-2.5 text-right align-top font-sans text-xs whitespace-nowrap md:table-cell"
  >
    {shortDate(r.occurred_at)}
  </td>
  {
    /* ⚠ AN INSTANT, IN THE HOME ZONE, IN A REAL `<time>` (plan 42 · §4.C.7).
      This printed UTC as a bare string — the one list in the Observatory outside
      the timestamp mechanism. `Posted` beside it stays UTC on purpose: it is a
      calendar date, not an instant. See `fragments-display.ts` for both halves
      and for the write-side defect neither of them fixes. */
  }
  <td class="text-base-content/65 px-3 pt-2.5 text-right align-top font-sans text-xs whitespace-nowrap">
    <time datetime={r.updated_at}>{homeDate(r.updated_at, tz)}</time>
  </td>
  {
    pick && (
      <td class="px-3 pt-1.5 text-right align-top whitespace-nowrap" data-noedit>
        {placed ? (
          <span class="text-primary/70 font-sans text-[0.65rem] tracking-wide uppercase">
            <StarMark /> placed
          </span>
        ) : (
          <button
            type="button"
            class="btn btn-ghost btn-xs font-sans normal-case"
            data-act="place"
            data-id={r.id}
            title="Place in this constellation"
          >
            ＋
          </button>
        )}
      </td>
    )
  }
  {
    pair && (
      <td class="px-3 pt-1.5 text-right align-top whitespace-nowrap" data-noedit>
        {paired ? (
          <span class="text-primary/70 font-sans text-[0.65rem] tracking-wide uppercase">
            <StarMark /> paired
          </span>
        ) : (
          /* ⚠ THE BUTTON SAYS WHAT IT WILL COST, and this is the one row where
            ＋ alone would be a lie: pairing a piece that already holds another
            song REPLACES that song. The word is on the control and the whole
            sentence is in the confirm behind it (ruling 2), so the steal is
            legible before the press and impossible without a second one. */
          <button
            type="button"
            class:list={['btn btn-ghost btn-xs font-sans normal-case', pairedToOther && 'text-warning']}
            data-act="pair"
            data-id={r.id}
            title={pairedToOther ? `Replace ${pairedToOther} with this song` : 'Pair this song to it'}
          >
            {pairedToOther ? 'Replace' : '＋'}
          </button>
        )}
      </td>
    )
  }
  {
    trash && (
      <td class="px-3 pt-2.5 text-right align-top whitespace-nowrap" data-noedit>
        <button class="text-base-content/70 hover:text-primary font-sans text-xs" data-act="restore" data-id={r.id}>
          Restore
        </button>
        <button class="text-base-content/70 hover:text-error ml-3 font-sans text-xs" data-act="purge" data-id={r.id}>
          Delete
        </button>
      </td>
    )
  }
</tr>

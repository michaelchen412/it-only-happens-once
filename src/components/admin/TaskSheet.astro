---
/*
  TaskSheet — write a task down, or change one (docs/plans/archive/13-agenda.md §3, §3a,
  §4).

  A SHEET, NOT A PAGE, and a native <dialog> like every other editor in here:
  focus-trapping, Escape and scroll-lock for free.

  ⚠ AND THE TOP LAYER IS WHY THERE IS NO ANCHORED PICKER ANYWHERE IN IT (trap 7,
  12-people.md §10). A popover anchored inside a `.zone` is either covered by the
  sticky header or clipped by the zone's `overflow: hidden` — inert either way,
  and invisible to typecheck, build and a screenshot. Everything that opens here
  is either the dialog itself or a native control (`<input type="date">`,
  `<select>`), all of which the browser renders above everything.

  ⚠ ONE SHEET, MANY TASKS — unlike PersonSheet, whose page holds exactly one
  person and can therefore server-render its values. The room lists dozens, so
  the row carries its own JSON and `task-sheet.ts` fills the form on open. That
  is one more place the form and the row could disagree, which is why the row
  serialises the COLUMNS rather than what it happens to be displaying.

  TWO SECTIONS EXIST ONLY ONCE THERE IS A DATE. A lead is "N days before…"
  and a recurrence is "…and again", so both are meaningless without one. They
  appear when you pick a date rather than sitting there disabled beside a
  sentence explaining why (10-hq.md §10i).
*/
import { Icon } from 'astro-icon/components';
import KindBar from './KindBar.astro';
import { EFFORTS, PRIORITIES } from '../../lib/hq/tasks';
import { PRESETS, presetLabel } from '../../lib/hq/recurrence';
import type { Ymd } from '../../lib/hq/time';
import type { Tables } from '../../lib/database.types';
import SheetHeader from './SheetHeader.astro';
import SheetError from './SheetError.astro';
import MiniEditor from './MiniEditor.astro';

interface Props {
  /** Today in the configured home zone — the lead sentence measures against it. */
  today: Ymd;
  /**
   * The active goals, for the picker. **Omitted or empty means no Goal field at
   * all** — 13 · Piece 1 shipped without one for exactly this reason, and the
   * rule outlives it: a select whose only option is "none" is a control that
   * asks a question with no answers (10-hq.md §10b).
   */
  goals?: Pick<Tables<'goals'>, 'id' | 'name'>[];
}
const { today, goals = [] } = Astro.props;
---

<dialog id="task-sheet" class="drawer-dialog w-full max-w-md" aria-labelledby="task-sheet-title">
  <form id="task-form" class="flex h-full flex-col overflow-hidden font-sans" data-today={today}>
    <SheetHeader titleId="task-sheet-title" title="New task" />

    <SheetError id="task-error" />

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 py-5">
      {
        /* Only ever visible when a reading filled this form in (14 · Piece 3).
          A task typed by hand is not a judgement anybody made. */
      }
      <KindBar self="task" />

      <label class="f">
        <span class="f__k">What <em>required</em></span>
        <input type="text" name="title" required maxlength="300" placeholder="Deep clean the bathroom" />
      </label>

      {
        /* ⚠ A MINI EDITOR, NOT A TEXTAREA, AND THIS FIELD WAS THE WORST CASE OF
          IT IN THE BUILDING. The placeholder read *"Optional. Markdown."* and
          NOTHING EVER RENDERED IT — `tasks.astro` carried the column
          into the row payload and back into this form, and no surface on the
          site ever ran it through `renderMarkdown`. So the promise was doubly
          broken: you were asked to type asterisks, and then shown your own
          asterisks back for ever.

          Both halves are answered together, and they have to be — a rich editor
          over a value nobody renders would only have moved the lie. The notes
          now appear on the row that owns them, clamped to two lines
          (`.task__n`), which is the only reason the field is worth filling in.

          Same ruling SetSheet cites for its description: ADR 0006 chose
          WYSIWYG-storing-Markdown, ADR 0018 retired "plain textarea, ever".

          ⚠ NO HIDDEN INPUT HERE, unlike SetSheet — that sheet's action reads
          `new FormData(form)`, which cannot see a contenteditable. This one
          builds its payload field by field, so the script calls `getMarkdown()`
          at submit and there is no third copy of the value to fall out of step.

          ⚠ AND IT IS A <div>, NOT A <label>. A label's `for` cannot address a
          contenteditable, and wrapping one puts the whole surface inside a
          click target that steals the caret's column on every press. */
      }
      {
        /* ⚠ `lists` (plan 44). A task's notes hold the steps INSIDE one task —
          the detail that is not worth splitting into five more rows. That is the
          same argument the goal page makes for its own notes, and it is the
          reason this field earns lists where a log entry or a bio does not:
          those answer *"what happened"* and *"who they are"*, which are
          narrative, and a list there would change what the field is for. */
      }
      <div class="f mt-4">
        <span class="f__k">Notes</span>
        <MiniEditor id="task-notes" wrapId="task-notes-wrap" size="max-h-[28vh] min-h-[3.25rem]" lists />
      </div>

      <fieldset class="fs mt-4">
        <legend class="fs__k">When</legend>
        <div class="flex flex-wrap items-end gap-2">
          <label class="f">
            <span class="f__k">Date</span>
            <input type="date" name="dueOn" class="f--narrow" data-due />
          </label>
          <label class="f">
            <span class="f__k">Time</span>
            <input type="time" name="dueTime" class="f--narrow" data-time />
          </label>
          <button type="button" class="btn btn-ghost btn-xs mb-1 font-sans" data-clear-time>Clear</button>
          {
            /* Nullable time is not a shrug (§3) — but it is ONE WORD beside the
              field rather than a paragraph under it (§10i). */
          }
          <span class="f__h mb-1" data-anytime>anytime</span>
        </div>
        {
          /* WHICH WORDS PRODUCED THIS DATE (§6.3). A date on its own cannot be
            judged; "read from 'every Thursday'" can be judged at a glance, and
            a silently misparsed date is worse than no parse at all (§6.2). */
        }
        <p class="f__h mt-1" data-parsed-from="due_on" hidden></p>
        <p class="f__h" data-parsed-from="due_time" hidden></p>
        <p class="f__h u-warn rounded-field mt-1 inline-block px-2" data-parsed-warn hidden></p>
      </fieldset>

      <fieldset class="fs">
        {
          /* ⚠ STACKED, NOT TWO COLUMNS, AND `flex-wrap` NEVER SAVED THIS. These
            sat side by side in a `flex flex-wrap` whose children were
            `min-w-0 flex-1` — and `flex-1` is `flex: 1 1 0%`, a ZERO basis, so
            the row always "fits" and wrapping can never fire. The columns shrank
            for ever instead.

            That is not a phone problem. The sheet is `max-w-md` — 28rem, its
            width on the largest desktop there is — so each column was ~10rem,
            Effort split it FOUR ways, and `.pseg__b`'s `text-overflow: ellipsis`
            rendered `Qui…` `Sitt…` `Blo…` `Pro…` on every screen size ever
            shipped. The same failure `.pseg--fit`'s note records for the
            calendar's `Mon…`, and invisible to `tasks.mobile.spec.ts` for the
            same reason: an ellipsis is not an overflow.

            Full width gives Effort ~5.5rem a segment and Priority ~8rem. No
            breakpoint restores the two-column version, because a 28rem cap means
            there is no width at which it would have fitted. */
        }
        <div class="space-y-3">
          <div>
            <p class="f__k">Effort</p>
            <div class="pseg" role="radiogroup" aria-label="Effort">
              {
                EFFORTS.map((e) => (
                  <button
                    type="button"
                    class="pseg__b"
                    role="radio"
                    data-effort={e.key}
                    title={e.hint}
                    aria-checked={e.key === 'sitting'}
                  >
                    {e.label}
                  </button>
                ))
              }
            </div>
          </div>
          <div>
            <p class="f__k">Priority</p>
            <div class="pseg" role="radiogroup" aria-label="Priority">
              {
                PRIORITIES.map((p) => (
                  <button
                    type="button"
                    class="pseg__b"
                    role="radio"
                    data-prio={p.key}
                    aria-checked={p.key === 'normal'}
                  >
                    {p.label}
                  </button>
                ))
              }
            </div>
          </div>
        </div>

        {
          /* The lead rule is invisible machinery until it names a date. ONE line,
            and only the outcome — a second line naming which rule fired taught
            the mechanic instead of stating the result. */
        }
        <div class="lead" data-dated hidden>
          <p class="lead__l"><Icon name="ph:calendar-blank" /> <span data-lead-line></span></p>
          <label class="lead__o">
            <input type="checkbox" data-override-on />
            <span>Warn me</span>
            {
              /* NOT `disabled` — see task-sheet.ts. A dead grey box beside a
                sentence explaining why it is dead is the exact shape §10i
                rejects, and this file's own header cites §10i for the two
                sections that appear only once there is a date. Typing here
                arms the tick. */
            }
            <input type="text" inputmode="numeric" class="f--n" value="3" data-override-n aria-label="Days ahead" />
            <span>days ahead instead</span>
          </label>
        </div>
      </fieldset>

      <fieldset class="fs" data-dated hidden>
        <legend class="fs__k">Repeats</legend>
        <div class="pseg pseg--wrap" role="radiogroup" aria-label="Repeats">
          <button type="button" class="pseg__b" role="radio" data-rep="none" aria-checked="true">Doesn’t repeat</button>
          <button type="button" class="pseg__b" role="radio" data-rep="after" aria-checked="false">After I do it</button
          >
          <button type="button" class="pseg__b" role="radio" data-rep="fixed" aria-checked="false">On a schedule</button
          >
        </div>

        <div class="mt-3" data-rep-panel="after" hidden>
          <div class="flex flex-wrap items-center gap-2">
            <span class="admin-hint text-xs">Every</span>
            <input type="text" inputmode="numeric" class="f--n" value="2" data-every aria-label="How many" />
            {
              /* ⚠ `pseg--fit`: THREE WORDS OF DIFFERENT LENGTHS IN A SENTENCE.
                `.pseg__b`'s default `flex: 1 1 0` gives every segment the SAME
                width, which is right for a full-width control and wrong here —
                `days` and `weeks` are 51px, `months` is 59px, so equal thirds
                meant `month…` at 390px. That is verbatim the case `.pseg--fit`
                was added for ("Month does not fit its own"), and the class was
                simply never reached for a second time. Found by the new
                ellipsis spec on its first run, in a control nobody had
                suspected. */
            }
            <div class="pseg pseg--fit" role="radiogroup" aria-label="Unit">
              <button type="button" class="pseg__b" role="radio" data-unit="days" aria-checked="false">days</button>
              <button type="button" class="pseg__b" role="radio" data-unit="weeks" aria-checked="true">weeks</button>
              <button type="button" class="pseg__b" role="radio" data-unit="months" aria-checked="false">months</button>
            </div>
            <span class="admin-hint text-xs">after I finish</span>
          </div>
          {/* This mode HAS no schedule, so it previews nothing. One clause. */}
          <p class="prev prev--none">Counted from the day you tick it.</p>
        </div>

        <div class="mt-3" data-rep-panel="fixed" hidden>
          {
            /* Nobody hand-writes RRULE (§4), so the schedule is picked by name —
              and the names are rebuilt from the date, because "every Monday" is
              only true while the date is a Monday. The rule string itself is
              storage, not interface, and never appears. */
          }
          <div class="f">
            <select name="preset" data-preset aria-label="Schedule">
              {PRESETS.map((p) => <option value={p}>{presetLabel(p, today)}</option>)}
            </select>
          </div>
          <p class="prev" data-prev></p>
        </div>
      </fieldset>

      {
        goals.length > 0 && (
          <fieldset class="fs">
            <legend class="fs__k">Goal</legend>
            {/* A task with a goal and no date is not a graveyard item — it is
                part of something you care about, not scheduled yet (§4a), and
                it lives on the goal's page. */}
            <div class="f">
              <select name="goalId" data-goal-id aria-label="Goal">
                <option value="">— none —</option>
                {goals.map((g) => (
                  <option value={g.id}>{g.name}</option>
                ))}
              </select>
            </div>
          </fieldset>
        )
      }
    </div>

    <div class="border-base-300 bg-base-200 flex shrink-0 items-center gap-2 border-t px-6 py-3">
      <button type="button" class="btn btn-ghost btn-sm text-error gap-1 font-sans" data-delete hidden>
        <Icon name="ph:trash" /> Delete
      </button>
      <button type="button" data-close class="btn btn-ghost btn-sm ml-auto font-sans">Cancel</button>
      <button type="submit" class="btn btn-sm zone__cta cn-amber gap-1 font-sans" data-submit>Add task</button>
    </div>
  </form>
</dialog>

<script>
  import '../../scripts/task-sheet';
</script>

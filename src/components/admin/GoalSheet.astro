---
/*
  GoalSheet — name an intention, or change what it says (13-agenda.md §4a).

  Five fields and no more, and the shortness is the design: a goal that needs a
  form is a project. **Name is the only required one** — you can write down
  *"be a better friend to the people I've drifted from"* and close the sheet.

  ⚠ IT WAS FOUR UNTIL 2026-08-10, and Notes is the one that joined. Michael, on
  the goal that asked for it — *wake up and get moving*, against the weight of
  an anxiety dream: **"the why is only half of it."** The other half is what is
  actually in the routine, and it had nowhere to go: it is not a reason, and it
  is emphatically not a task, so filing it as five subtasks would have taught
  the goal to be a project on the one surface built to refuse that.

  ⚠ SO NOTES IS PROSE AND STAYS PROSE. It cannot be ticked, counted, dated or
  scored — a `text` column is the same defence that keeps `progress` and
  `due_on` off this table, and `- [ ]` typed in here comes back a plain bullet
  because the sanitizer drops the checkbox. Its length is why it is a textarea
  and not a fifth control: a control would be a form growing, a page of notes is
  the goal talking.

  ⚠ THE HORIZON IS A SEGMENTED CONTROL, NOT A TEXT FIELD, and that is the rule
  made structural (settled 2026-08-03). §4a: *the horizon is deliberately vague
  — never a date. The moment a goal has a deadline it is a task.* A text field
  would leave that to discipline; three buttons cannot express March 3rd.

  THE VALUES ARE SERVER-RENDERED and the same component does both jobs: pass a
  `goal` and it is the edit sheet, omit it and it is the New sheet. The goal
  page has exactly one goal on it, and the room only ever creates — so unlike
  TaskSheet there is nothing to switch between and no prefill step.

  NO PROGRESS FIELD, NO TARGET, NO DEADLINE. Nothing here can be rendered as a
  bar, because a direction cannot be 60% travelled.
*/
import { Icon } from 'astro-icon/components';
import { HORIZONS } from '../../lib/hq/goals';
import type { Tables } from '../../lib/database.types';
import SheetHeader from './SheetHeader.astro';
import SheetError from './SheetError.astro';
import MiniEditor from './MiniEditor.astro';

interface Props {
  /** Omitted = the New sheet. Present = the edit sheet for that goal. */
  goal?: Tables<'goals'>;
}
const { goal } = Astro.props;
const editing = !!goal;
---

<dialog id="goal-sheet" class="drawer-dialog w-full max-w-md" aria-labelledby="goal-sheet-title">
  <form id="goal-form" class="flex h-full flex-col overflow-hidden font-sans" data-id={goal?.id}>
    <SheetHeader titleId="goal-sheet-title">{editing ? 'Edit goal' : 'New goal'}</SheetHeader>

    <SheetError id="goal-sheet-error" />

    <div class="min-h-0 flex-1 overflow-y-auto overscroll-contain px-6 py-5">
      <label class="f">
        <span class="f__k">The goal <em>required</em></span>
        <input type="text" name="name" required maxlength="200" placeholder="Get back in shape" value={goal?.name} />
      </label>

      <div class="f mt-4">
        <span class="f__k">Horizon</span>
        <div class="pseg" role="radiogroup" aria-label="Horizon">
          {
            HORIZONS.map((h) => (
              <button
                type="button"
                class="pseg__b"
                role="radio"
                data-horizon={h.key}
                aria-checked={(goal?.horizon ?? 'this_year') === h.key}
              >
                {h.label}
              </button>
            ))
          }
        </div>
      </div>

      {
        /* ⚠ A MINI EDITOR, AND THE `breaks: false` IS THE WHOLE CARE HERE. The
          goal page renders a why with `renderMarkdown(goal.why)` — no `breaks`
          — on the stated reasoning that *"a why is prose, where a wrapped line
          is not a break"*. Mounting this editor at the mini editor's old
          hardcoded `true` would have shown you a line break the page then
          silently closed up, which is a WYSIWYG lying about the one character
          the field's own comment went out of its way to decide. Notes below
          renders `{ breaks: true }` and so is mounted that way; the pair is the
          reason `mountMiniEditor` takes the option at all.

          ⚠ THE HIDDEN INPUT IS THE SERVER VALUE ARRIVING, NOT THE FORM VALUE
          LEAVING — unlike SetSheet's, whose action reads `new FormData`. This
          sheet is server-rendered per goal and builds its payload by hand, so
          the script seeds the editor from here and serializes with
          `getMarkdown()`. */
      }
      <div class="f mt-4">
        <span class="f__k">Why</span>
        <MiniEditor id="goal-why" wrapId="goal-why-wrap" size="max-h-[30vh] min-h-[5rem]" />
        <input type="hidden" data-why-value value={goal?.why ?? ''} />
      </div>

      {
        /* The practice, not the reason. Roomier than Why on purpose: this is the
          field that holds a list, and a two-row box would ask you to keep it
          short on the one surface where the detail IS the point.

          ⚠ `lists` HERE AND NOT ON WHY, A FOOT ABOVE — the pair is the whole
          register question, asked per FIELD rather than per sheet. A why is the
          reason a goal exists and reads as prose; notes are *how it is actually
          kept*, and a morning routine is an enumeration. The alternative that
          lost was filing the routine as five subtasks, which would have taught a
          goal to be a project on the one surface built to refuse that
          (docs/admin.md §14).

          ⚠ THIS COMMENT SAID "usually with no bullet in sight" UNTIL PLAN 44,
          and it was describing a limit rather than a preference: the editor had
          no list nodes, so there was no bullet to see. Two near-identical copies
          of this block sat here, both already calling this "the field that holds
          a list" while the field could not make one — which is how the gap went
          unnoticed for nine days. They are merged into this one.

          `breaks: true` still matters and is unchanged, because a list is not
          the only shape this field takes: notes typed as bare LINES (`Teeth` /
          `Read the day` / `Move`) are still lines, and prose rules would run all
          three into one sentence. */
      }
      <div class="f mt-4">
        <span class="f__k">Notes</span>
        <MiniEditor id="goal-notes" wrapId="goal-notes-wrap" size="max-h-[38vh] min-h-[6.5rem]" lists />
        <input type="hidden" data-notes-value value={goal?.notes ?? ''} />
      </div>
    </div>

    <div class="border-base-300 bg-base-200 flex shrink-0 items-center gap-2 border-t px-6 py-3">
      {
        editing && (
          <button type="button" class="btn btn-ghost btn-sm text-error gap-1 font-sans" data-delete-goal>
            <Icon name="ph:trash" /> Delete
          </button>
        )
      }
      <button type="button" data-close class="btn btn-ghost btn-sm ml-auto font-sans">Cancel</button>
      <button type="submit" class="btn btn-sm zone__cta cn-amber gap-1 font-sans" data-submit>
        {editing ? 'Save' : 'Add goal'}
      </button>
    </div>
  </form>
</dialog>

<script>
  import '../../scripts/goal-sheet';
</script>

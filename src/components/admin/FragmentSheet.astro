---
/*
  FragmentSheet — the quick-editor for QUOTES (docs/admin.md §6–7),
  as a native <dialog> drawer. Native gives focus-trapping, Escape, scroll-lock,
  and focus restoration for free; we add the slide/fade animation via the
  `.drawer-dialog` utility in app.css. Self-contained: its script wires the
  list's New/Edit buttons, so the list page doesn't need to know about it.

  The quote body is a TipTap editor (WYSIWYG → Markdown, same engine as the
  writing composer; ADR-0006) with `breaks: true` so poetry line breaks survive.
  Dates follow the composer convention: automatic (now) unless a legacy date is
  set explicitly.

  WIDER THAN THE OTHER SHEETS (max-w-2xl, 42rem — half again the max-w-md the
  task/goal/person/link drawers use, 2026-08-11). Those are a handful of short
  inputs; this one is a WYSIWYG editor with a derived-attribution preview under
  it, and at 28rem the quote wrapped every few words while the "Shows as" line
  broke mid-attribution — you couldn't read the sentence you were judging. Not
  the writing composer's max-w-5xl: that sheet is a full-page essay surface, and
  a quote is still a drawer beside the list you opened it from.

  ⚠ THE WORDS ARE THE ONLY REQUIRED FIELD ON A QUOTE (2026-08-05, plan 17a).
  Attribution used to be required too, which made an unattributed quote
  impossible to enter through this sheet — so the corpus's one such row can only
  have arrived by import. Silence is now a legitimate answer, and it means two
  opposite things: "Michael wrote it" and "nobody knows". The `is_self` column
  is what tells them apart; see src/lib/provenance.ts.
*/
import { actions } from 'astro:actions';
import TagInput from '../TagInput.astro';
import SubjectsField from './SubjectsField.astro';
import EntityCombo from './EntityCombo.astro';
import ConstellationPicker from './ConstellationPicker.astro';
import SharedByField from './SharedByField.astro';
import BackToTop from '../BackToTop.astro';
import MiniEditor from './MiniEditor.astro';

interface Props {
  subjects: string[];
  authors?: { id: string; name: string }[];
  works?: { id: string; title: string; authorId: string | null }[];
  /** Every constellation — the membership picker (docs/admin.md §2). */
  constellations?: { id: string; name: string; slug: string }[];
  /** The roster, for "Shared by" (12 · Piece 3). Empty = the field renders nothing. */
  people?: { id: string; display_name: string }[];
  /** `fragment_id → person_id[]`, rendered once so opening a sheet needs no round trip. */
  sharedBy?: Record<string, string[]>;
  /**
   * Arriving from a profile's "Add a quote" (§5). The new-quote sheet opens
   * with this person already ticked in Shared by — which is the whole flow:
   * a quote they said out loud enters the corpus AND attaches, in one move.
   */
  linkPersonId?: string | null;
  /** Open this editor on load, for the same arrival. */
  autoNew?: 'quote' | null;
}
const {
  subjects,
  authors = [],
  works = [],
  constellations = [],
  people = [],
  sharedBy = {},
  linkPersonId = null,
  autoNew = null,
} = Astro.props;
/**
 * "Me" leads the Who list (docs/plans/17a) — not a checkbox off to the side.
 * Every quote answers "who said it"; sometimes the answer is you. A checkbox
 * would make a fourth thing to remember out of a case the model already covers.
 *
 * ⚠ IT IS NOT AN `authors` ROW, and the sentinel id is what keeps it from
 * becoming one. An author row would give the derivation a name to lead with, so
 * every self-authored quote would render "— Michael Chen" on a site that is
 * already his — and `resolveAuthor` would happily upsert it on the first save.
 * The sheet strips this id before submitting and sends `is_self` instead.
 */
const SELF_ID = 'self';
const authorOptions = [{ id: SELF_ID, name: 'Me' }, ...authors.map((a) => ({ id: a.id, name: a.name }))];
const workOptions = works.map((w) => ({ id: w.id, name: w.title, authorId: w.authorId }));
---

<dialog
  id="sheet"
  class="drawer-dialog w-full max-w-2xl"
  aria-labelledby="sheet-title"
  data-shared-by={JSON.stringify(sharedBy)}
  data-link-person={linkPersonId ?? undefined}
  data-auto-new={autoNew ?? undefined}
>
  <div class="flex h-full flex-col overflow-y-auto overscroll-contain">
    <header class="border-base-300 flex items-center justify-between border-b px-6 py-4">
      <h2 id="sheet-title" class="font-display text-xl">New quote</h2>
      <button type="button" data-close class="text-base-content/50 hover:text-base-content" aria-label="Close">✕</button
      >
    </header>

    <div class="admin-tabs px-6" role="tablist" aria-label="Editor sections">
      <button
        type="button"
        role="tab"
        class="admin-tab"
        data-tab="fields"
        aria-selected="true"
        aria-controls="sheet-panel-fields"
      >
        <span id="sheet-tab-fields-label">Quote</span>
      </button>
      <button
        type="button"
        role="tab"
        class="admin-tab"
        data-tab="constellations"
        aria-selected="false"
        tabindex="-1"
        aria-controls="sheet-panel-cn"
      >
        Constellations<span id="sheet-cn-count" class="admin-tab__n"></span>
      </button>
    </div>

    <p id="sheet-error" hidden role="alert" class="admin-alert mx-6 mt-4"></p>

    <div id="sheet-panel-fields" role="tabpanel" data-tabpanel="fields">
      {/* QUOTE */}
      <form
        id="quote-form"
        method="POST"
        action={actions.fragments.saveQuote}
        class="flex flex-col gap-4 p-6 font-sans"
      >
        <input type="hidden" name="id" />
        <input type="hidden" name="body" id="quote-body" />

        {/* — required — */}
        <div class="f">
          {
            /* ⚠ THIS WAS A RED `*` CARRYING `aria-hidden` AND A `title`, AND IT
              MARKED NOTHING AT ALL. `aria-hidden` takes it out of the
              accessibility tree, and `title` is a desktop-hover tooltip — so to
              a screen reader, and on any phone, the quote sheet's ONE required
              field announced as optional. Three ways of saying "required" were
              live in this admin and this was the only one that did not work.
              `<em>required</em>` is the word the other sheets use and ADR 0033
              settles on: real text, in the label, readable by everything. */
          }
          <span class="f__k">Quote <em>required</em></span>
          <MiniEditor id="quote-editor" wrapId="quote-editor-wrap" size="max-h-[45vh] min-h-[10rem]" />
        </div>
        {
          /* ═══ THE THREE FACTS (docs/plans/17a-quote-matrix.md) ═══════════════
          Who / From / Where, and a line DERIVED from them. Seven fields became
          three, and the one the reader sees stopped being one you type.

          What was here before, and why it went: a REQUIRED "Attribution" whose
          only definition lived inside a collapsed box labelled OPTIONAL — so you
          had to open an optional section to learn what the required field meant.
          Beside it, "Source title", labelled "shown after the attribution",
          which was shown after the attribution in exactly zero places a reader
          could reach; 42 quotes carry one and 41 are a verbatim copy of the Work
          above it. That is why entering a quote felt like more decisions than it
          actually is — three of the seven fields were duplicates of the others.

          THE ORDER IS THE MACHINERY'S. The old form read Attribution → Author →
          Work while the logic flowed the other way (Author fills Attribution;
          Work snaps Author), so filling it top-to-bottom worked against the
          grain. Who → From → Where runs with it.

          EVERY HELPER LINE NAMES ITS AUDIENCE — "a reader sees this only if they
          ask". That sentence existed nowhere in the old form, and its absence
          WAS the bug: nothing said which fields readers see and which exist only
          for filing. ══════════════════════════════════════════════════════════ */
        }
        <div class="flex flex-col gap-3">
          <label class="f">
            <span class="f__k">Who said it</span>
            <EntityCombo
              id="quote-author"
              name="author_name"
              idName="author_id"
              noun="author"
              label="Who said it"
              placeholder="Marcus Aurelius"
              options={authorOptions}
            />
            {
              /* The two silences, named where you choose between them. "Me" and
              blank both render no line at all — and they mean opposite things,
              which is the whole reason the flag is stored rather than inferred.
              Michael's "how does the UI know to list it or not?" is answered
              here: you told it. Blank is not Me. */
            }
            <span class="text-base-content/45 text-xs"
              >Pick <b class="font-medium">Me</b> for your own words. Leave it blank if nobody knows — both stay quiet on
              the page, and the workshop tells them apart.</span
            >
          </label>
          <label class="f">
            <span class="f__k">From what</span>
            <EntityCombo
              id="quote-work"
              name="work_name"
              idName="work_id"
              noun="work"
              label="From what"
              placeholder="Meditations · The Bible"
              options={workOptions}
            />
            <span class="text-base-content/45 text-xs">For filing — a reader sees this only if they ask.</span>
          </label>
          {
            /* FREE TEXT, AND IT STAYS FREE TEXT. The matrix holds six different
            citation traditions — books and verses, letters and verses, a book of
            the Bible with chapter and verse, acts and scenes, a bare
            circumstance, and an attribution-within-an-attribution. A structured
            locator would have to KNOW which tradition it is in, which makes
            choosing one a new decision on every quote — the exact overhead this
            rebuild exists to remove — and needs a new branch for every tradition
            that turns up next. That is the `scriptureRe` mistake generalised and
            made permanent. Every tradition already has a conventional written
            form and Michael already knows it.

            ⚠ AND NOTHING HERE MAY BE GUESSED FROM THE WORK. Picking "The Bible"
            must never pop a book-and-chapter helper; picking "Meditations" must
            never prefill "Book ". That is tradition-detection wearing a
            friendlier hat, and the moment it guesses wrong you are deleting its
            guess before typing yours. */
          }
          <label class="f">
            <span class="f__k">Where in it</span>
            <input name="citation" id="quote-where" placeholder="Book 2:2 · John 3:16 · Letter 24:19–20 · p. 41" />
            <span class="text-base-content/45 text-xs">The reference, exactly as you’d say it out loud.</span>
          </label>
        </div>

        {
          /* THE PREVIEW IS THE ACTUAL FIX FOR "OVERWHELMING". The fields become
          mechanical and the judgement moves to a sentence you can read: you stop
          reasoning about which field the reader sees, because you are looking at
          what the reader sees.

          BOTH HALVES, TOGETHER. "Shows as" is the line under the quote; "Behind
          it" is what the citation reveal opens onto. Showing only the first
          would hide the thing this whole model exists to make explicit, in the
          one place the decision actually gets made.

          ⚠ "Behind it" describes a control that IS NOT BUILT YET (17a, "Still
          open — the reveal itself"). It is honest anyway: the derivation is
          real, the data is real, and this is the only surface where you can see
          what a reader will be able to ask for. When the reveal ships, this
          preview needs no change at all. */
        }
        <div class="rounded-field border-base-300/70 bg-base-200/40 flex flex-col gap-1.5 border px-3 py-2.5 text-sm">
          <div class="flex items-baseline gap-2">
            <span class="text-base-content/45 w-16 shrink-0 text-xs">Shows as</span>
            <span id="quote-preview-line" class="text-base-content/85 min-w-0 flex-1 font-serif break-words"></span>
            <button
              type="button"
              id="quote-attr-edit"
              class="text-base-content/45 hover:text-primary shrink-0 text-xs underline underline-offset-2"
              >change</button
            >
          </div>
          <div class="flex items-baseline gap-2">
            <span class="text-base-content/45 w-16 shrink-0 text-xs">Behind it</span>
            <span id="quote-preview-reveal" class="text-base-content/55 min-w-0 flex-1 text-xs break-words"></span>
          </div>
        </div>

        {
          /* THE OVERRIDE — the only remaining use for a stored display string,
          and it is now the EXCEPTION rather than the thing you fill in every
          time. Hidden until asked for, because a derivation you can overrule at
          a glance is a different object from a field you must fill.

          Measured before shipping: applying the rule to all 76 live quotes
          reproduces the attribution Michael typed by hand on 74 of them, exactly
          — and on 76 once the migration moves two scripture locators out of the
          wrong column. ZERO surviving overrides. So this input should stay empty
          essentially forever, and the day it isn't is the day the rule met a
          case the matrix is missing. */
        }
        <label id="quote-attr-override" hidden class="f">
          <span class="text-base-content/70 flex items-center gap-2">
            Shown instead
            <button
              type="button"
              id="quote-attr-revert"
              class="text-base-content/45 hover:text-primary text-xs underline underline-offset-2"
              >use the derived line</button
            >
          </span>
          <input name="attribution" placeholder="Matthew 5:43–48" />
          <span class="text-base-content/45 text-xs">Only when the line above is wrong for this one quote.</span>
        </label>

        <label class="f">
          <span class="f__k">Source link <span>— optional</span></span>
          <input name="source_url" type="url" placeholder="https://…" />
        </label>

        {
          /* Beside the provenance facets, because that is what it is: Author and
          Work say where the words came from, this says who put them in front
          of you. A tick applies immediately (§5) — it never rides along with
          the save below. */
        }
        <SharedByField scope="quote" people={people} />

        <SubjectsField id="quote-subjects">
          <TagInput name="subjects" label="Subjects" suggestions={subjects} placeholder="stoicism, acceptance" />
        </SubjectsField>

        {/* — date: automatic unless backdating a legacy quote — */}
        <div class="flex flex-col gap-2 text-sm">
          <label class="flex cursor-pointer items-center gap-2">
            <input type="checkbox" id="quote-date-toggle" class="checkbox checkbox-xs" />
            <span class="f__k">Set a specific date</span>
          </label>
          <p id="quote-date-note" class="text-base-content/45 text-xs">
            Dated today automatically — enable only to backdate a legacy quote.
          </p>
          <input type="datetime-local" name="occurred_at" id="quote-occurred" disabled />
        </div>

        {
          /* — the address —
            Last, with the date, because both are last-mile metadata: everything
            above says what the quote IS, these two say how it is filed.

            ⚠ IT MATTERS MORE HERE THAN IN THE WRITING SHEET, and the reason is
            that a quote has no draft lifecycle — it publishes on save. So the
            first press of Save quote is also the moment its URL freezes
            (actions/_shared.ts `fragmentSlug`), where an essay gets a whole
            drafting period to change its mind. This field is the one chance to
            look at the address before it becomes a promise.

            Auto-filled from the attribution and the opening words, exactly as
            the server derives it, and it stops auto-filling the moment you type
            in it — the writing sheet's `slugTouched` rule, same behaviour in
            the second room. Editing is an override, not the normal path. */
        }
        <label class="f">
          <span class="f__k">Address <span>— the URL</span></span>
          <span class="flex items-center gap-0 pr-2 pl-3">
            <span class="text-base-content/35 shrink-0 select-none">/blog/</span>
            <input
              name="slug"
              id="quote-slug"
              class="min-w-0 flex-1 bg-transparent outline-none"
              placeholder="auto"
              spellcheck="false"
              autocapitalize="off"
              autocorrect="off"
            />
          </span>
          <span id="quote-slug-note" class="text-base-content/45 text-xs"
            >Set when you first save. Change it only if this one reads badly — any link already shared stops working.</span
          >
        </label>

        {/* Quotes publish on save — no draft lifecycle (docs/admin.md). Unpublish via the list. */}
        <input type="hidden" name="status" value="published" />

        <div class="mt-2 flex items-center gap-2">
          <button type="submit" id="quote-save" class="btn btn-primary btn-sm flex-1 normal-case">Save quote</button>
        </div>

        {
          /* DELETE LEFT THE ACTION ROW, and the sentence it is answering to was
            written one file over, in `WritingSheet.astro`: *"a destructive
            action does not belong in a row of benign ones, one keystroke from
            Unpublish."* This sheet had it sitting flush beside **Save quote**,
            and — because both are `hidden` until you open an EXISTING quote —
            it appeared next to Save exactly when there was something to lose.

            Same treatment as the writing sheet and the constellation composer:
            apart, below a rule, at the END of the thing it destroys, with a
            line saying what it takes and what it leaves. Three sheets, one
            rule; before this, three treatments of it.

            ⚠ IT STAYS INSIDE THE `<form>`. `fragment-sheet.ts`'s `toggleDelete`
            reaches for it with `form.querySelector`, and a Delete moved below
            `</form>` for tidiness would be invisible to that lookup — the
            button would simply never appear. The zone carries the `hidden`
            now; the button keeps `data-delete` because the click handler binds
            on that attribute document-wide. */
        }
        <div
          data-delete-zone
          hidden
          class="border-base-300 mt-12 flex flex-wrap items-center justify-between gap-4 border-t pt-4"
        >
          <p class="admin-hint">
            Deleting removes this quote and its links. The constellations it sits in keep their shape, and the author
            and work stay in the library.
          </p>
          <button type="button" data-delete class="btn btn-ghost btn-sm text-error normal-case">Delete</button>
        </div>
      </form>

      {
        /* ⚠ THE SONG FORM WAS HERE, AND ADR 0031 TOOK IT OUT. A song has its own
          sheet now (`SongSheet.astro`), because the split this file carried was
          two editors divided by FIELD: the metadata lived here and the feelings
          lived in /admin/listening, and neither surface could show you the whole
          object. Michael, 2026-08-11: *"this division is really uncomfortable
          for me, and I don't think it's a clean implementation."*

          THREE THINGS WENT WITH IT AND NONE OF THEM CAME BACK:

           · "Why this one" — the annotation ADR 0009 gave a song so it would
             qualify as a fragment. One song in forty-eight used it in seventeen
             days, and what it said was an observation, not a justification. A
             song has NOTES now, split by audience: one anyone can open, one
             nobody but Michael ever will.
           · Subjects — a subject is what a piece is ABOUT, and a song is not
             about anything you can paraphrase. The one time this corpus filed
             one that way it produced `jazz`.
           · The Spotify lookup — the song sheet's paste bar owns that call now,
             so there is one lookup path rather than two.

          What this sheet is, therefore, is the QUOTE editor. It kept its
          filename because renaming it would touch every mount for no gain. */
      }
    </div>

    <div id="sheet-panel-cn" role="tabpanel" data-tabpanel="constellations" hidden class="p-6">
      <p class="admin-hint mb-3">
        Which ways of seeing this belongs to. Changes apply immediately — no save needed. Adding puts it at the end of
        that constellation's suite; reorder in the composer.
      </p>
      <ConstellationPicker scope="fragment" constellations={constellations} />
    </div>
  </div>
  <BackToTop scroller="#sheet > div" inDialog />
</dialog>

<script>
  import '../../scripts/fragment-sheet';
</script>

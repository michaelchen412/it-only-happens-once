---
/*
  SongSheet — THE editor for a song, and the only one (docs/plans/37 §2, ADR 0031).

  ⚠ IT REPLACES TWO EDITORS THAT WERE SPLIT BY FIELD, which is the defect it
  exists to close. `/admin/listening` owned the feelings and could not touch the
  metadata; `FragmentSheet`'s song form owned the metadata and knew nothing about
  feelings — so filing a song meant two surfaces, and neither could show you the
  whole object. Michael, 2026-08-11: *"this division is really uncomfortable for
  me, and I don't think it's a clean implementation. Ideally… we open up a sheet
  to edit all the fields, all in one place, albeit separated in tabs."*

  ⚠ THE PASTE BAR LIVES IN HERE RATHER THAN ON THE PAGE (Michael's call,
  2026-08-11), and that is what makes the consolidation cheap rather than
  expensive. A sheet carrying its own front door is MOUNTABLE ANYWHERE — so the
  Fragment Manager can open the same editor instead of needing a second copy or
  a navigation out of the room. A page-level paste bar would have forced one of
  those two. The cost is one press to open the sheet that the inline bench did
  not charge; plan 37's exit condition (twenty songs in a sitting) is what judges
  whether that was worth it.

  ⚠ AND NOTHING HERE PROPOSES A FEELING. The corpus tags SUBJECTS with a model
  (ADR-0007) because a subject is what a piece is about and that is legible from
  the text. A feeling is not a property of the song — it is what happened in
  Michael — so `songs.setFeelings` has no `suggestFeelings` beside it and this
  sheet has no button that would call one. Michael, 2026-08-10: *"AI can't tell
  me what I feel."* Since ADR 0031 also took subjects off songs, **no part of a
  song is machine-taggable at all**, which is a cleaner line than the one it
  replaced.
*/
import SharedByField from './SharedByField.astro';
import FragmentBrowser from './FragmentBrowser.astro';
import BackToTop from '../BackToTop.astro';
import MiniEditor from './MiniEditor.astro';
import SheetHeader from './SheetHeader.astro';
import SheetError from './SheetError.astro';

interface Props {
  /** The vocabulary, in `sort` order — dark to light. That order is a claim. */
  feelings: { id: string; name: string }[];
  /** The roster, for "Shared by" — a song someone sent is its clearest case. */
  people?: { id: string; display_name: string }[];
  /** `fragment_id → person_id[]`, rendered once so opening needs no round trip. */
  sharedBy?: Record<string, string[]>;
}
const { feelings, people = [], sharedBy = {} } = Astro.props;
const thisYear = new Date().getUTCFullYear();
---

<dialog
  id="song-sheet"
  class="drawer-dialog w-full max-w-md"
  aria-labelledby="sng-title"
  data-shared-by={JSON.stringify(sharedBy)}
>
  <div id="sng-scroll" class="flex h-full flex-col overflow-y-auto overscroll-contain">
    <SheetHeader titleId="sng-title" title="New song" />

    <SheetError id="sng-error" />

    {
      /* THE FRONT DOOR. `type="url"` rather than `search`: this field takes one
        specific kind of string, and the keyboard a phone raises for a URL is the
        one with the slash on it. On an existing song it holds the CANONICAL
        `source_url` we stored — not what was once pasted — so changing it is how
        you re-point a song at a better link. */
    }
    <div class="px-6 pt-4">
      <label class="block">
        <span class="sr-only">Paste a Spotify or YouTube link</span>
        <input
          id="sng-url"
          type="url"
          autocomplete="off"
          spellcheck="false"
          placeholder="Paste a Spotify or YouTube link…"
          class="w-full font-sans"
        />
      </label>
      {
        /* ⚠ THE PLAYER IS A DIV THE SCRIPT FILLS, AND REMOVING THE IFRAME IS THE
          ONLY PAUSE WE HAVE. A cross-origin frame cannot be controlled from
          outside — no API, no postMessage we own. So closing the sheet, loading
          a different song, and saving all DESTROY the frame, and that is what
          stops the sound. Anything that "hides" a player instead of removing it
          leaves music playing in a room you have left. */
      }
      <div id="sng-player" class="mt-4 empty:mt-0"></div>
    </div>

    <div class="admin-tabs mt-4 px-6" role="tablist" aria-label="Song sections">
      {
        /* ⚠ FEELINGS IS FIRST AND IS THE DEFAULT, and that is the ergonomic
          argument for the whole sheet. The loop plan 33 §3 says decides whether
          any of this happens — paste, listen, press the words, save, next — must
          never require visiting a second tab. The metadata arrives already
          filled from `songs.lookup`, so Facts is the tab you open when the
          lookup got something wrong, not the one you pass through.

          ⚠ AND THE NAMES ARE A TRIAD: Feelings / Facts / Notes — what it did to
          you, what is true about it, what you want to say. "The song" sat here
          first and said nothing; the word that replaced it states ADR 0031's
          own claim in the interface, because the distinction the whole record
          turns on is that A FEELING IS NOT A PROPERTY OF THE SONG AND A FACT
          IS. It also picks up the quote sheet's vocabulary, where provenance is
          already "the three facts". */
      }
      <button
        type="button"
        role="tab"
        class="admin-tab"
        data-tab="feelings"
        aria-selected="true"
        aria-controls="sng-panel-feelings"
      >
        Feelings<span id="sng-feel-count" class="admin-tab__n"></span>
      </button>
      <button
        type="button"
        role="tab"
        class="admin-tab"
        data-tab="facts"
        aria-selected="false"
        tabindex="-1"
        aria-controls="sng-panel-facts"
      >
        Facts
      </button>
      <button
        type="button"
        role="tab"
        class="admin-tab"
        data-tab="notes"
        aria-selected="false"
        tabindex="-1"
        aria-controls="sng-panel-notes"
      >
        Notes<span id="sng-notes-mark" class="admin-tab__n"></span>
      </button>
    </div>

    {/* ── FEELINGS ─────────────────────────────────────────────────────── */}
    <div id="sng-panel-feelings" role="tabpanel" data-tabpanel="feelings" class="px-6 py-5">
      {
        /* Buttons, not checkboxes, and pressed rather than checked:
          `aria-pressed` is the role for a toggle that changes a thing rather
          than submitting a value, and it keeps the row reading as a row of WORDS
          instead of a form. The order is `feelings.sort` — dark to light — which
          is the spectrum's claim and not an alphabetisation. */
      }
      <div id="sng-words" class="flex flex-wrap gap-2">
        {
          feelings.map((f) => (
            <button
              type="button"
              class="sng-word rounded-field border-base-300 hover:border-base-content/40 border px-2.5 py-1 font-sans text-sm transition-colors"
              data-feeling={f.id}
              aria-pressed="false"
            >
              {f.name}
            </button>
          ))
        }
      </div>

      {
        /* ADDING A WORD MID-LISTEN. Not a convenience: plan 33 §1 says the
          vocabulary is *discovered by tagging, not by drafting*, and that is only
          true if a word can be added without stopping the track. A sheet that
          made you leave for the Library would fail on exactly the songs that
          matter most — the ones whose feeling is not in the list yet.

          ⚠ AND IT IS DELIBERATELY PLAIN. The counterweight is size discipline: a
          prominent "+ new word" turns sixteen words into sixty by month three.
          It types the whole word, it lands at the bright end of the spectrum
          where it is visibly unplaced, and the Library is where it gets its
          position. */
      }
      <div class="mt-4 flex flex-wrap items-center gap-2">
        <input
          id="sng-newword"
          placeholder="a word that isn’t here…"
          aria-label="Add a word to the vocabulary"
          class="input input-xs input-bordered w-48 font-sans"
        />
        <button id="sng-addword" type="button" class="btn btn-ghost btn-xs normal-case">Add it</button>
        <span id="sng-wordnote" hidden class="admin-hint italic"></span>
      </div>
    </div>

    {/* ── FACTS ────────────────────────────────────────────────────────── */}
    <div
      id="sng-panel-facts"
      role="tabpanel"
      data-tabpanel="facts"
      hidden
      class="flex flex-col gap-4 px-6 py-5 font-sans"
    >
      {
        /* Auto-filled from the lookup but editable: a five-artist track joins to
          "Miles Davis, John Coltrane, Cannonball Adderley, Bill Evans", which is
          a credit list rather than an attribution. */
      }
      <label class="f">
        <span class="f__k">Title</span>
        <input id="sng-song-title" class="font-serif" />
      </label>
      <label class="f">
        <span class="f__k">Artist</span>
        <input id="sng-artist" placeholder="Miles Davis" />
      </label>
      <label class="f">
        <span class="f__k">Album</span>
        <input id="sng-album" placeholder="Kind of Blue" />
      </label>
      <label class="f">
        <span class="f__k">Added <span>— the year it entered the corpus</span></span>
        <input id="sng-year" type="number" value={thisYear} />
      </label>

      {
        /* THE PAIRING (ADR 0011, plan 37 §2, plan 39). It is the single most
          useful fact about 46 of the 48 songs here.

          ⚠ THIS WAS READ-ONLY UNTIL 2026-08-12, AND THE REVERSAL IS THE POINT.
          What stood here said: *"NOT EDITABLE, and that is the decision rather
          than a shortcut. Pairing is the ESSAY's decision — `songs.pair` is
          called from the writing sheet's Music tab, which is where you are when
          the question 'what goes with this piece?' actually arises. A second
          control here would be a second write path…"*

          Half of that is still true and it is the half worth keeping: *where you
          are when the question arises* is the right test. It was applied to ONE
          question. There are two, they are different, and they arise in
          different rooms:

            what song goes with this piece?  →  the writing sheet, mid-draft
            what am I going to write about?  →  HERE, mid-listen

          The half that was never true is "a second write path". Both doors call
          ONE `songs.pair`, against ONE column, with ONE enforcement of
          `type = 'writing'`. Nothing can disagree, because the invariant that
          mattered was never *one control* — it was *one write path*.

          ⚠ AND THE OLD ROUTE WAS ONLY WALKABLE BY STOPPING THE MUSIC, which is
          what makes this a defect rather than a preference. Reaching the Music
          tab meant closing this sheet, and closing this sheet DESTROYS THE
          IFRAME (see the player above). The only control that could record the
          thought was unreachable without ending the listening that produced it.

          ⚠ THE CARDINALITY IS ASYMMETRIC AND NOTHING ELSE IN THE REPO SAYS SO.
          A writing has at MOST ONE song — `paired_song_id` is a single column.
          A song may be paired to MANY writings; there is no unique constraint.
          So this is a LIST where the writing sheet's version is a single value,
          and a pick from this side can take a slot that already holds another
          song. That steal is possible on purpose and confirmed on purpose
          (plan 39 · ruling 2). It is never silent.

          ⚠ THE WRAP NO LONGER HIDES WHEN EMPTY. It is the door now, and a door
          that disappears when there is nothing behind it cannot be used. */
      }
      <div id="sng-paired-wrap" class="f">
        <span class="f__k">Paired with <span>— the pieces this song plays above</span></span>
        <ul id="sng-paired" class="flex flex-col gap-1"></ul>
        <p id="sng-paired-none" class="f__h italic">Nothing yet.</p>
        <div class="mt-2 flex flex-wrap items-center gap-2">
          <button id="sng-pair-add" type="button" class="btn btn-ghost btn-xs gap-1 normal-case">
            ＋ Pair with a piece
          </button>
          {
            /* ⚠ OFFERED, NOT DISABLED, WHILE THE SONG IS UNSAVED (plan 39 ·
              ruling 3). Disabling until Save was the alternative, and it loses
              on the very flow this sheet exists for: Save destroys the iframe,
              so "save first, then pair" is "stop the music, then pair" — the
              defect above, rebuilt one control to the left. The pick is held and
              flushed on the first save, the way SharedByField already holds its
              ticks. This line is what keeps the wait legible instead of looking
              like a press that did nothing. */
          }
          <span id="sng-pair-queued" hidden class="f__h italic"></span>
        </div>
      </div>

      <SharedByField scope="song" people={people} />

      {
        /* DELETE LEFT THE STICKY FOOTER (plan 38 · §1.4), for the reason
          `WritingSheet.astro` states about its own: *"a destructive action does
          not belong in a row of benign ones, one keystroke from Unpublish."*
          Here it was worse than in the quote sheet — the footer FOLLOWS YOU
          DOWN THE PAGE, so Delete sat a thumb's width from **Save song** on
          every screen of every tab, and both are `hidden` until you open an
          existing song, i.e. it appeared beside Save exactly when there was
          something to lose.

          ⚠ THE FOOT OF *FACTS*, NOT OF FEELINGS, and the tab is the decision.
          Feelings is the fast loop this sheet was built for — paste, listen,
          press the words, Save — and a delete control at the end of it is in
          the path you take twenty times a week. Facts is where the song's
          identity lives (title, artist, album, the pairing), so it is the end
          of the thing being destroyed, and reaching it costs one deliberate tab
          press. That cost is the feature.

          The alternative that lost: the foot of Notes, because Notes is last.
          Last is not the same as "the end of the object" — a private note is
          the one part of a song you would keep if you could. */
      }
      <div
        id="sng-delete-zone"
        hidden
        class="border-base-300 mt-8 flex flex-wrap items-center justify-between gap-4 border-t pt-4"
      >
        <p class="admin-hint">
          Deleting removes this song, its feelings and its notes. The feeling vocabulary itself is untouched, and any
          essay it was paired with keeps its own text.
        </p>
        <button id="sng-delete" type="button" class="btn btn-ghost btn-sm text-error normal-case">Delete</button>
      </div>
    </div>

    {/* ── NOTES ────────────────────────────────────────────────────────── */}
    <div
      id="sng-panel-notes"
      role="tabpanel"
      data-tabpanel="notes"
      hidden
      class="flex flex-col gap-5 px-6 py-5 font-sans"
    >
      {
        /* ⚠ THIS IS NOT "WHY THIS ONE", AND THE RENAME IS THE WHOLE POINT (ADR
          0031). ADR 0009 gave a song `body` as an annotation — the sentence on
          *why this song* — and in seventeen days one song in forty-eight used
          it. What it was used for was *"I love Janek's playing in the beginning;
          it really sets the tone for the whole piece"*: an observation, not a
          justification. The field was mislabelled from the hour it was created,
          and the label is what kept it empty.

          Michael, 2026-08-11: *"I don't need to tell you why the music is good.
          That's violating a really big aesthetic principle of mine — I want to
          show and not tell."*

          SPLIT BY AUDIENCE, NOT BY LENGTH, and the helper lines say which is
          which in the one place the choice is actually made. That sentence
          existed nowhere in the old form, and its absence WAS the bug: nothing
          said who would read what you were typing. */
      }
      <div class="f">
        <span class="f__k">A note <span>— anyone can open this</span></span>
        <MiniEditor id="sng-pub" wrapId="sng-pub-wrap" size="max-h-[28vh] min-h-[5rem]" />
        <span class="text-base-content/45 text-xs">
          Opens from a small mark beside the song in the music room. Leave it empty and there is no mark — which is the
          normal case.
        </span>
      </div>

      <div class="f">
        <span class="f__k">For you <span>— nobody else, ever</span></span>
        <MiniEditor id="sng-priv" wrapId="sng-priv-wrap" size="max-h-[28vh] min-h-[5rem]" />
        <span class="text-base-content/45 text-xs">
          Where it came from, the week it belongs to, what to listen for. Stored in its own table, admin-only, and
          revoked from the public key — it is never rendered anywhere.
        </span>
      </div>
    </div>

    {
      /* ONE SAVE, IN THE FOOTER, FOR THE WHOLE SHEET — and this deviates from
        plan 37's table, which had feelings and notes applying immediately while
        the metadata kept a Save.

        WHY IT CHANGED once it was laid out: "applies immediately" exists to stop
        a relation riding along with a COMPARE-AND-SET save that could lose a
        rewrite — that is the rule `pair` and the constellation picker follow,
        and both live on the writing sheet, which has exactly such a save. A song
        has none: `saveSong` carries no `base_updated_at` and there is no
        autosave to collide with. So the reason for splitting the writes does not
        apply here, and three write moments across three tabs would have made
        "have I saved?" a question you answer by remembering which tab you were
        on.

        One object, one editor, one Save. The fast loop stays one press:
        paste → listen → press the words → Save.

        The exception is Shared by, which keeps its own immediate contract and
        queues its ticks until a new song has an id — see SharedByField. */
    }
    {
      /* ⚠ THE ONLY SHEET IN THE WORKSHOP WITH A STICKY FOOTER, and it is the
        one that should have one. Every other sheet's primary action sits inline
        at the end of ITS FORM, because the form is the whole sheet — the quote
        sheet's second tab applies immediately and has nothing to save. Here one
        Save commits all THREE tabs, so it belongs to the sheet rather than to
        any panel: put it at the foot of Feelings and it reads as saving the
        words only, and it disappears entirely the moment you open Notes.

        Checked against the others during the consistency pass (ADR 0032) rather
        than assumed — this is drift that earns itself, which is a different
        thing from drift nobody noticed. */
    }
    <div class="border-base-300 bg-base-100 sticky bottom-0 mt-auto flex items-center gap-2 border-t px-6 py-4">
      {
        /* Named, like "Save quote" and "Add task" beside it — a bare "Save" is
          the one label that tells you nothing about what you are committing. */
      }
      <button id="sng-save" type="button" class="btn btn-primary btn-sm flex-1 normal-case">Save song</button>
      <span id="sng-status" class="admin-hint ml-auto" aria-live="polite"></span>
    </div>
  </div>
  <BackToTop scroller="#sng-scroll" inDialog />
</dialog>

{
  /* ⚠ THE PAIRING PICKER SHIPS WITH THE SHEET, NOT WITH THE PAGE (plan 39), for
    the same reason the paste bar does — stated at the top of this file: *"a
    sheet carrying its own front door is MOUNTABLE ANYWHERE"*. Both rooms that
    mount this sheet get the picker by construction, and neither has to know it
    exists. A page-level mount would have been two more imports to keep in step,
    and the day a third room opens a song it would have shipped without one.

    It is a SIBLING of the sheet, not a child: a <dialog> nested inside another
    <dialog> inherits the parent's `display: none` when the parent is closed,
    and the top layer does not care about DOM depth anyway. */
}
<FragmentBrowser mode="pair" />

<style>
  /* The pressed state, and it is the only styling this sheet adds.

     A border and a weight rather than a fill: the row is a row of WORDS, and a
     block of coloured chips reads as a form control. `--color-primary` is the
     same accent the rest of the workshop uses for "this is on". */
  .sng-word[aria-pressed='true'] {
    border-color: var(--color-primary);
    color: var(--color-primary);
    font-weight: 500;
  }
</style>

<script>
  import '../../scripts/song-sheet';
</script>

---
/*
  EntityCombo — a searchable single-select combobox with an explicit "create"
  affordance, for provenance facets (Author, Work). Unlike a native <datalist>,
  it CONSTRAINS: you either pick an existing entity (commits its id) or you
  explicitly choose "＋ Add «text»" to create one on save (id blank, name carries
  the text). It submits two hidden fields — `<idName>` (the entity id, blank when
  creating) and `<name>` (the display text) — so the save action prefers the id
  and only creates-by-name when the id is absent.

  Options are `{ id, name, authorId? }`. The component doesn't couple Author→Work
  itself; the parent scopes the Work list with setOptions() and reads a pick's
  authorId from the `combo:change` event to keep the two fields coherent (see
  FragmentSheet). `combo:change` fires only on USER edits — the programmatic
  setters (setValue/clear/setOptions) stay silent, so parent wiring can't loop.

  Public API: setValue(id, name), clear(), getId(), getName(), getOption(),
  setOptions(list). Modelled on TagInput's custom-element pattern.
*/
import { Icon } from 'astro-icon/components';

interface Option {
  id: string;
  name: string;
  authorId?: string | null;
}
interface Props {
  name: string;
  idName: string;
  noun: string;
  label?: string;
  options?: Option[];
  placeholder?: string;
  id?: string;
  class?: string;
}
const { name, idName, noun, label, options = [], placeholder = '', id, class: className = '' } = Astro.props;
---

{
  /* ⚠ A DECLARED CLONE SOURCE, not a hopeful `document.querySelector` (plan 42
    · §4.B.5). This element builds its whole menu in the browser, so its
    "＋ Add «text»" row cannot use `<Icon>` — and `icon.ts` clones from whatever
    `ph:plus` the page already rendered. On a page where this combo is the ONLY
    thing wanting a plus, there is nothing to clone and the create row would
    lose its mark. Rendering one here, hidden, makes the source a fact of the
    component rather than a property of the page it lands on — and it costs one
    `<use>` against a sprite symbol that is emitted once either way. */
}
<span hidden data-icon-source><Icon name="ph:plus" /></span>

<entity-combo
  id={id}
  class:list={['entity-combo', className]}
  data-name={name}
  data-id-name={idName}
  data-noun={noun}
  data-label={label ?? noun}
  data-placeholder={placeholder}
  data-options={JSON.stringify(options)}></entity-combo>

<script>
  import '../../scripts/entity-combo';
</script>

<style is:global>
  .entity-combo {
    display: block;
    position: relative;
  }
  .entity-combo__field {
    padding-right: 1.75rem;
  }
  .entity-combo__clear {
    position: absolute;
    top: 0;
    right: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 1.75rem;
    font-size: 0.7rem;
    color: var(--color-base-content);
    opacity: 0.4;
  }
  .entity-combo__clear:hover {
    opacity: 1;
    color: var(--color-error);
  }
  .entity-combo__menu {
    position: absolute;
    top: calc(100% + 0.25rem);
    left: 0;
    right: 0;
    z-index: 40;
    max-height: 14rem;
    overflow-y: auto;
    margin: 0;
    padding: 0.25rem;
    list-style: none;
    background: var(--color-base-100);
    border: 1px solid var(--color-base-300);
    border-radius: var(--radius-box);
    box-shadow: 0 8px 24px -8px color-mix(in oklab, var(--color-base-content) 25%, transparent);
  }
  .entity-combo__opt {
    padding: 0.35rem 0.55rem;
    font-size: 0.85rem;
    line-height: 1.3;
    color: var(--color-base-content);
    border-radius: var(--radius-field);
    cursor: pointer;
  }
  .entity-combo__opt.is-active,
  .entity-combo__opt:hover {
    background: var(--color-base-200);
  }
  /* Pinned to the foot of the menu (docs/plans/16 · Piece 2). "＋ Add" was
     appended after up to 50 rows, so on a long list the ONLY way to create
     something sat below the fold — the likeliest reason creating an author
     felt harder than it is. Its position in the list is unchanged (still last,
     still after you've looked); only its visibility is. The alternative —
     moving it to the top — was rejected: it would put "make a new one" above
     "here is the one that exists", which is the wrong order to offer. */
  .entity-combo__opt--create {
    position: sticky;
    bottom: 0;
    background: var(--color-base-100);
    border-top: 1px solid var(--color-base-300);
    color: color-mix(in oklab, var(--color-primary) 85%, var(--color-base-content));
  }
  /* The honest cap. Muted and un-clickable on purpose: it is a statement about
     the list, not another thing in it. */
  .entity-combo__more {
    padding: 0.35rem 0.55rem;
    font-family: var(--font-sans);
    font-size: 0.7rem;
    font-style: italic;
    line-height: 1.3;
    color: var(--text-whisper);
    cursor: default;
  }
  .entity-combo__opt--create b {
    font-weight: 600;
  }
  .entity-combo__plus {
    margin-right: 0.15rem;
  }
</style>

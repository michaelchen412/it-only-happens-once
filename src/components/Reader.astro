---
/*
  Reader — a reusable, in-context reading surface (a native top-layer <dialog>).

  Drop <Reader /> once on a page. Anything with `data-read="<slug>"` opens it,
  filled from the matching `<template data-reader-content="<slug>">` on the page
  — or, if there is no template, FETCHED from the permalink (see `fill` below).
  The feed underneath never moves, so closing drops the reader back exactly where
  the reader was scrolling — the whole point of not navigating away.

  Open state is mirrored to the URL hash (`#read=<slug>`) so the browser Back
  button and Escape both close it, and it reconciles on client-side navigation.
  Built to be reused by the constellation views later — nothing here is
  blog-specific.

  Desktop: a right-side sheet at full height (a comfortable reading width).
  Mobile: a full-screen sheet (styles in app.css). Motion self-disables under
  prefers-reduced-motion (global rule).
*/
import { Icon } from 'astro-icon/components';
import BackToTop from './BackToTop.astro';
---

<dialog id="site-reader" class="reader drawer-dialog" aria-label="Reading view">
  <button type="button" class="reader-close" data-reader-close aria-label="Close reading view">
    <Icon name="ph:x" class="text-lg" />
  </button>
  <div class="reader-scroll">
    <div class="reader-inner prose-measure mx-auto"></div>
  </div>
  <BackToTop scroller="#site-reader .reader-scroll" inDialog />
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';
  import { closeWithExit } from '../scripts/dialog-close';

  const PREFIX = 'read=';

  const reader = () => document.getElementById('site-reader') as HTMLDialogElement | null;
  const readSlug = () => {
    const h = location.hash.slice(1);
    return h.startsWith(PREFIX) ? decodeURIComponent(h.slice(PREFIX.length)) : null;
  };

  // True when the reader was opened by a click (so there's a history entry to pop
  // on close); false when we arrived already pointing at it (deep link / refresh).
  let openedViaTrigger = false;

  // Lock page scroll without shifting the layout: measure the scrollbar we're
  // about to hide and pad the page by exactly that width. (scrollbar-gutter was
  // unreliable across browsers, so we compensate explicitly.)
  //
  // ⚠ THE LOCK IS HELD THROUGH THE SLIDE-OUT and dropped after it, which is why
  // `close()` waits rather than releasing on a timer. Drop it while the drawer
  // is still moving and the frozen feed gets its scrollbar back and reflows
  // sideways BEHIND it — a jump at the exact moment the eye is following
  // something leave.
  function lockScroll() {
    const sbw = window.innerWidth - document.documentElement.clientWidth;
    document.documentElement.style.setProperty('--reader-sbw', `${sbw}px`);
    document.documentElement.classList.add('reader-open');
  }
  function unlockScroll() {
    document.documentElement.classList.remove('reader-open');
    document.documentElement.style.removeProperty('--reader-sbw');
  }

  /**
   * ⚠ TWO SOURCES, AND THE SECOND ONE EXISTS BECAUSE INERT IS NOT FREE.
   *
   * A template is instant and stays the first choice: `/blog` paginates, so it
   * ships one per card for a page of ~7 and the reader opens with no network at
   * all. The music room cannot do that — it opens with the whole corpus, so it
   * would ship one template per distinct paired essay. Measured in the bench:
   * **408 KB of templates inside a 797 KB document, 51% of the page**, on every
   * arrival, for content most visitors will never open.
   *
   * So a page may ship NO templates and let this fetch the permalink instead.
   * `/blog/<slug>` renders the same `PostArticle`, which is the whole reason
   * that component exists as one renderer rather than three.
   *
   * The sheet opens FIRST and fills when the answer arrives. Waiting for the
   * network before showing anything would make a click feel broken on a slow
   * connection, and the slide-in is the acknowledgement.
   */
  let fillSeq = 0;

  function templateFor(slug: string): HTMLTemplateElement | null {
    return document.querySelector(`template[data-reader-content="${CSS.escape(slug)}"]`);
  }

  async function fetchArticle(slug: string): Promise<Node | null> {
    try {
      const res = await fetch(`/blog/${encodeURIComponent(slug)}`, { headers: { Accept: 'text/html' } });
      if (!res.ok) return null;
      // DOMParser rather than innerHTML on a live node: the document it builds is
      // inert, so nothing in it runs or loads until the one element we choose is
      // adopted into this page.
      const doc = new DOMParser().parseFromString(await res.text(), 'text/html');
      const article = doc.querySelector('article.post-article');
      return article ? document.importNode(article, true) : null;
    } catch {
      return null; // offline, or the route moved — the caller falls back
    }
  }

  function show(d: HTMLDialogElement, slug: string) {
    // Reopened while the last close was still sliding out — tapping a second
    // fragment straight after dismissing the first. Clearing the flag is what
    // `closeWithExit` watches for: it stands down instead of shutting a sheet
    // that has just been handed new content.
    delete d.dataset.closing;
    if (!d.open) d.showModal();
    // Which slug this sheet is currently showing. On the ELEMENT, not in a
    // module variable: this script is not re-executed across view transitions,
    // but the dialog node is replaced — so a fresh node correctly reports
    // "showing nothing" instead of inheriting the old page's answer.
    d.dataset.readerSlug = slug;
    const scroll = d.querySelector('.reader-scroll');
    if (scroll) scroll.scrollTop = 0;
    lockScroll();
  }

  async function open(slug: string): Promise<boolean> {
    const d = reader();
    const inner = d?.querySelector('.reader-inner');
    if (!d || !inner) return false;
    if (d.open && d.dataset.readerSlug === slug) return true; // already showing it

    const tpl = templateFor(slug);
    if (tpl) {
      inner.replaceChildren(tpl.content.cloneNode(true));
      show(d, slug);
      return true;
    }

    const seq = ++fillSeq;
    const waiting = document.createElement('p');
    waiting.className = 'text-base-content/40 py-16 text-center font-serif italic';
    waiting.textContent = 'Opening…';
    inner.replaceChildren(waiting);
    show(d, slug);

    const article = await fetchArticle(slug);
    if (seq !== fillSeq) return true; // a newer open already claimed the sheet
    if (!article) return false; // caller sends them to the permalink
    inner.replaceChildren(article);
    const scroll = d.querySelector('.reader-scroll');
    if (scroll) scroll.scrollTop = 0;
    return true;
  }

  function close() {
    const d = reader();
    if (!d || !d.open) return unlockScroll();
    if (d.dataset.closing) return; // already sliding out; don't restart it
    delete d.dataset.readerSlug;
    // ⚠ THE SHEET STAYS OPEN WHILE IT LEAVES. `d.close()` here would be the
    // obvious line and it is the one that made this vanish on an iPhone —
    // animating a CLOSED dialog needs the `overlay` property, which Safari and
    // Firefox do not have. `closeWithExit` slides it out while it is still open
    // and shuts it afterwards; see scripts/dialog-close.ts for the whole story.
    //
    // The scroll-lock is NOT released here. It comes off on the dialog's own
    // `close` event (bindDialog), which is the only signal that covers every way
    // this sheet can shut — including the ones we don't initiate.
    void closeWithExit(d);
  }

  // The URL hash is the single source of truth; reconcile the DOM to it.
  async function sync() {
    const slug = readSlug();
    if (!slug) return close();
    if (!(await open(slug))) {
      // No template on this page AND the permalink would not answer — a deleted
      // post, or a bad hash. Send them to the canonical URL, which will say so
      // properly rather than leaving an empty sheet open.
      location.replace(`/blog/${slug}`);
    }
  }

  /**
   * ⚠ OPEN THROUGH THE ROUTER — `location.hash = …` LOOKS EQUIVALENT AND IS NOT.
   *
   * The ClientRouter keeps its own idea of where we are (`originalLocation`),
   * and only updates it for navigations that go through `navigate()`. Setting
   * the hash directly moves the URL behind its back, so the entry we pushed is
   * one the router never saw.
   *
   * That does nothing visible until the reader closes. `history.back()` fires
   * `popstate`, the router compares the entry it remembers (`/blog`, no hash)
   * with where we landed (`/blog`, no hash), concludes this was NOT a
   * hash-only move — and does a full page navigation: refetch `/blog`, swap
   * the whole document. Measured: the swap landed **73ms into the 280ms
   * slide-out**, replacing the dialog node mid-animation. The sheet started to
   * leave and then vanished, and `astro:before-swap` dropped the scroll-lock
   * early on the way past. That was the close-jank — not the animation, which
   * was correct all along.
   *
   * Routing the open through `navigate()` teaches the router the hash entry is
   * its own, so the matching `history.back()` takes its same-page short circuit
   * (no fetch, no swap, scroll restored) and leaves the slide-out alone.
   *
   * It also means NO `hashchange`: the router pushes the URL with
   * `history.pushState`, which fires nothing. So reconcile by hand afterwards.
   * If the router isn't on the page at all, `navigate()` falls back to a real
   * fragment navigation, `hashchange` DOES fire, and `sync()` runs twice —
   * harmless, because `open()` no-ops when the sheet already shows that slug.
   */
  async function goTo(slug: string) {
    await navigate(`#${PREFIX}${encodeURIComponent(slug)}`);
    await sync();
  }

  // Every close intent collapses to "leave the reader hash". Prefer history.back()
  // so the pushed entry is popped; if we arrived on it, strip the hash in place.
  function dismiss() {
    if (!readSlug()) return close();
    if (openedViaTrigger) {
      openedViaTrigger = false;
      history.back();
    } else {
      history.replaceState(null, '', location.pathname + location.search);
      close();
    }
  }

  // Capture phase, deliberately: a trigger may be an <a href> (the suite's
  // writing fragments link to their permalinks as the no-JS fallback), and the
  // ClientRouter's own click listener would otherwise win the race and
  // navigate. Capturing + stopPropagation lets the reader claim its triggers
  // before the router sees them; everything else passes through untouched.
  document.addEventListener(
    'click',
    (e) => {
      const target = e.target as Element;
      const trigger = target?.closest?.('[data-read]');
      if (trigger) {
        // Let ⌘/Ctrl/Shift/Alt-click (or a non-primary button) fall through to
        // the href — power users can still open the permalink in a new tab.
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0) return;
        e.preventDefault();
        e.stopPropagation();
        const slug = trigger.getAttribute('data-read');
        if (slug) {
          openedViaTrigger = true;
          void goTo(slug);
        }
        return;
      }
      if (target?.closest?.('[data-reader-close]')) {
        e.preventDefault();
        return dismiss();
      }
      const d = reader();
      if (d && d.open && target === d) dismiss(); // click on the backdrop
    },
    true,
  );

  // Escape on a modal <dialog> is governed by the `cancel` event — a keydown
  // preventDefault() does NOT stop the native close. If the browser pre-closes
  // the dialog, the sheet snaps away instead of leaving. Intercept `cancel` and
  // route Escape through dismiss() instead — exactly like the admin drawer.
  // (Neither `cancel` nor `close` bubbles, so both bind on the element; the
  // dataset flag keeps it idempotent across the view-transition swaps that
  // replace the reader.)
  function bindDialog() {
    const d = reader();
    if (!d || d.dataset.cancelBound) return;
    d.dataset.cancelBound = '1';
    d.addEventListener('cancel', (e) => {
      e.preventDefault();
      dismiss();
    });
    // ⚠ THE SCROLL-LOCK COMES OFF HERE, on the one event that means "this sheet
    // is now shut" no matter who shut it. Releasing it inside close() instead
    // covers only the paths we control, and the browser has at least one of its
    // own: Chromium's close watcher fires `cancel` only while the press still
    // carries user activation, so a SECOND Escape during the slide-out closes
    // the dialog directly, past the handler above. That is a fine outcome — you
    // pressed Escape twice, the sheet goes — but the teardown has to notice.
    // Keying on `close` makes every route out land in the same place.
    d.addEventListener('close', () => {
      delete d.dataset.closing;
      delete d.dataset.readerSlug;
      unlockScroll();
    });
  }

  // `void`, deliberately: `sync` is async only because filling from a fetch is,
  // and none of these three callers has anything to do with the answer. An
  // unhandled rejection is impossible — `fetchArticle` catches its own — so the
  // marker is here to say the floating promise is intended rather than missed.
  window.addEventListener('hashchange', () => void sync());
  // Deep links + view-transition navigation: reconcile on arrival.
  document.addEventListener('astro:page-load', () => {
    openedViaTrigger = false;
    bindDialog();
    void sync();
  });
  // <html> persists across view transitions — never leak the scroll lock.
  document.addEventListener('astro:before-swap', unlockScroll);
  bindDialog();
  void sync(); // first load
</script>

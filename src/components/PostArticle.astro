---
/*
  PostArticle — the one canonical rendering of a full essay (design.md §10).

  Deliberately shared by three surfaces so they stay pixel-identical:
    • the in-context Reader (cloned from a <template>),
    • the card's reader <template> in the feed,
    • the /blog/[slug] permalink page.

  Header: the subjects the piece touches (quiet serif links — NOT ✦, which is
  reserved for constellations, §3), the display title, the Timestamp, and read
  time. Body is authored Markdown scoped to `.reading`. The caller supplies the
  measure (`.prose-measure`) and padding.
*/
import Timestamp from './Timestamp.astro';
import { renderMarkdown } from '../lib/markdown';
import { embedForUrl } from '../lib/media';
import type { WritingItem } from '../lib/blog';

interface Props {
  item: WritingItem;
  /** Link the title to its permalink (feed/reader) vs. plain h1 (the page itself). */
  linkTitle?: boolean;
}
const { item, linkTitle = false } = Astro.props;
const bodyHtml = renderMarkdown(item.bodyMarkdown);

// The paired song (ADR-0009): *this song goes with this piece*. It sits at the
// HEAD, below the title block and above the prose — "press play, then read",
// the same invitation a constellation's score makes above its suite. The score
// is the constellation's; this one belongs to the essay.
//
// NOTHING LOADS IN THE FEED. Every surface but the permalink renders
// PostArticle inside a <template> (PostCard, ConstellationSuite, the composer),
// and template contents are inert — so a 7-essay page spawns zero third-party
// frames, and the iframe only starts when the Reader clones it.

// `embedForUrl`, NOT `parseSongRef`: two imported essays are paired with a
// Spotify playlist, which no song fragment may cite but which still has to
// play. "What may a song cite" and "what can we embed" are different questions.
const pairedEmbed = item.paired ? embedForUrl(item.paired.url) : null;
// The legacy `details.media` path carries no title or artist, so there is
// nothing to caption with — the embed names itself. Only a promoted song
// fragment gets the line above it.
const pairedCaption = item.paired?.title ? item.paired : null;
const pairedTitle = pairedCaption
  ? `${pairedCaption.title} — paired with ${item.title}`
  : `Paired with ${item.title}`;
---

<article class="post-article">
  <h1 class="font-display text-3xl leading-[1.12] font-light sm:text-5xl">
    {
      linkTitle ? (
        <a href={`/blog/${item.slug}`} class="transition-colors hover:text-primary">
          {item.title}
        </a>
      ) : (
        item.title
      )
    }
  </h1>

  <div class="mt-5 flex flex-wrap items-center gap-3 text-sm text-base-content/40">
    <Timestamp date={item.occurredAt} updated={item.updatedAt ?? undefined} kind="posted" precision={item.precision} />
    <span class="font-sans">·</span>
    <span class="font-sans">{item.readMinutes} min read</span>
  </div>

  {
    item.subjects.length > 0 && (
      <p class="mt-3 flex flex-wrap items-center gap-x-3 gap-y-1 font-serif text-sm text-base-content/45 italic">
        {item.subjects.map((s, i) => (
          <>
            {i > 0 && <span class="text-base-content/20 not-italic">·</span>}
            <a href={`/blog?subject=${s.slug}`} class="transition-colors hover:text-base-content/70">
              {s.name}
            </a>
          </>
        ))}
      </p>
    )
  }

  {
    pairedEmbed && (
      <figure class="post-paired prose-measure mt-8">
        {pairedCaption && (
          <figcaption class="mb-2 font-serif text-[0.95rem] tracking-[0.06em] text-base-content/45 [font-variant:all-small-caps]">
            <span aria-hidden="true">♪</span> {pairedCaption.title}
            {pairedCaption.artist && <span class="text-base-content/35"> — {pairedCaption.artist}</span>}
          </figcaption>
        )}
        {pairedEmbed.height === null ? (
          <div class="aspect-video overflow-hidden" style="border-radius: var(--radius-box)">
            <iframe
              class="h-full w-full"
              src={pairedEmbed.src}
              loading="lazy"
              allow={pairedEmbed.allow}
              title={pairedTitle}
              style="border: 0"
            />
          </div>
        ) : (
          <iframe
            src={pairedEmbed.src}
            width="100%"
            height={pairedEmbed.height}
            loading="lazy"
            allow={pairedEmbed.allow}
            title={pairedTitle}
            style="border-radius: var(--radius-box); border: 0"
          />
        )}
      </figure>
    )
  }

  {bodyHtml && <div class="reading mt-10" set:html={bodyHtml} />}
</article>

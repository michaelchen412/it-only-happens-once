---
/*
  PostArticle — the one canonical rendering of a full essay (design.md §10).

  Deliberately shared by three surfaces so they stay pixel-identical:
    • the in-context Reader (cloned from a <template>),
    • the card's reader <template> in the feed,
    • the /blog/[slug] permalink page.

  Header: the display title, the Timestamp and the read time — the two facts a
  reader wants before committing to a long piece, and nothing else. Body is
  authored Markdown scoped to `.reading`. The caller supplies the measure
  (`.prose-measure`) and padding.

  ⚠ THE SUBJECTS AND THE SHARE MARK ARE AT THE FOOT, in `FragmentStrip`, and
  that is a reversal — both shipped in the header first. See
  docs/adr/0023-the-apparatus-closes-the-reading.md and the note above the strip. It also makes three surfaces agree where two used
  to: PostCard already footed its subjects, the quote page foots its whole
  apparatus, and this was the one that did not.
*/
import Timestamp from './Timestamp.astro';
import FragmentStrip from './FragmentStrip.astro';
import { enhanceEssayImages } from '../lib/essay-images';
import { renderMarkdown } from '../lib/markdown';
import { embedForUrl } from '../lib/media';
import type { WritingItem } from '../lib/blog';

interface Props {
  item: WritingItem;
  /** Link the title to its permalink (feed/reader) vs. plain h1 (the page itself). */
  linkTitle?: boolean;
  /**
   * Off in the composer's Read view (plan 32 · §9). Everywhere else this renders
   * — the feed's template, the Reader, the permalink — a reader is looking at a
   * published piece and can hand it on. In the composer Michael is looking at
   * his own draft, and a share control there offers to publish a URL that may
   * not resolve yet.
   */
  share?: boolean;
}
const { item, linkTitle = false, share = true } = Astro.props;
// The sanitizer already gave every image its lazy/decoding/dimensions; this
// pass adds srcset through the image service (plan 43 §5), and it lives HERE
// because PostArticle is the one renderer every essay passes through — the
// feed's template, the Reader, the permalink and the suite all arrive at this
// line, so one seam covers all four.
const bodyHtml = await enhanceEssayImages(renderMarkdown(item.bodyMarkdown));

// The paired song (ADR-0009): *this song goes with this piece*. It sits at the
// HEAD, below the title block and above the prose — "press play, then read",
// the same invitation a constellation's score makes above its suite. The score
// is the constellation's; this one belongs to the essay.
//
// NOTHING LOADS IN THE FEED. Every surface but the permalink renders
// PostArticle inside a <template> (PostCard, ConstellationSuite, the composer),
// and template contents are inert — so a 7-essay page spawns zero third-party
// frames, and the iframe only starts when the Reader clones it.

// `embedForUrl`, NOT `parseSongRef`: two imported essays are paired with a
// Spotify playlist, which no song fragment may cite but which still has to
// play. "What may a song cite" and "what can we embed" are different questions.
const pairedEmbed = item.paired ? embedForUrl(item.paired.url) : null;
// NO VISIBLE CAPTION. The player already prints the track, the artist, and the
// artwork in type larger than ours — a "♪ Title — Artist" line above it said
// the same thing twice, and the second saying was the smaller one. What we knew
// that the embed doesn't (that this song goes with THIS piece) is the only fact
// worth carrying, and it goes where it reads better: the iframe's accessible
// name, for anyone arriving by screen reader. Sighted readers get the embed and
// its position — under the title, above the prose — which is the whole sentence.
const pairedTitle = item.paired?.title
  ? `${item.paired.title} — paired with ${item.title}`
  : `Paired with ${item.title}`;
---

<article class="post-article">
  <h1 class="font-display text-3xl leading-[1.12] font-light sm:text-5xl">
    {
      linkTitle ? (
        <a href={`/blog/${item.slug}`} class="hover:text-primary transition-colors">
          {item.title}
        </a>
      ) : (
        item.title
      )
    }
  </h1>

  {
    /*
    ⚠ TWO FACTS AND NOTHING ELSE. This line briefly carried the share mark and,
    below it, the subjects — four layers of chrome between the title and the
    first sentence of a piece that averages 5,700 characters. Both moved to the
    foot (docs/adr/0023-the-apparatus-closes-the-reading.md); what is left is the two things a reader wants BEFORE they
    commit: when it was written, and how long it will take.
  */
  }
  <div class="text-base-content/40 mt-5 flex flex-wrap items-center gap-3 text-sm">
    <Timestamp date={item.occurredAt} updated={item.updatedAt ?? undefined} kind="posted" precision={item.precision} />
    <span class="font-sans">·</span>
    <span class="font-sans">{item.readMinutes} min read</span>
  </div>

  {
    pairedEmbed && (
      <figure class="post-paired prose-measure mt-8">
        {pairedEmbed.height === null ? (
          <div class="aspect-video overflow-hidden" style="border-radius: var(--radius-box)">
            <iframe
              class="h-full w-full"
              src={pairedEmbed.src}
              loading="lazy"
              allow={pairedEmbed.allow}
              title={pairedTitle}
              style="border: 0"
            />
          </div>
        ) : (
          <iframe
            src={pairedEmbed.src}
            width="100%"
            height={pairedEmbed.height}
            loading="lazy"
            allow={pairedEmbed.allow}
            title={pairedTitle}
            style="border-radius: var(--radius-box); border: 0"
          />
        )}
      </figure>
    )
  }

  {bodyHtml && <div class="reading mt-10" set:html={bodyHtml} />}

  {
    /*
    ⚠ THE APPARATUS CLOSES THE PIECE
    (docs/adr/0023-the-apparatus-closes-the-reading.md). Michael, 2026-08-10: *"a lot of
    pieces of writing can be rather long. By the time the user is done reading
    and they feel really inspired, we should have some kind of share affordance
    near the bottom."*

    He is right, and the first build was wrong in a way worth naming: the share
    mark shipped at the HEAD, argued from a reader who decides partway through.
    That reader exists, but the one who matters is the one who has just FINISHED
    — the whole premise of this feature is that a link is worth sending because
    the recipient will come and look around, and that impulse arrives at the last
    paragraph, thousands of pixels below where the control was. These essays
    average 5,700 characters and run to 14,000.

    ⚠ MOVED, NOT DUPLICATED. Two share marks on one essay is the same redundancy
    this file already removed once — the paired-song caption said what the embed
    was saying, and the smaller saying lost. A reader who wants to send a piece
    without reading it still has the feed card's own permalink.

    Rendered only where the whole piece is: `share` is off in the composer's Read
    view, and `neighbourhood` is absent on any surface that loaded an excerpt
    rather than an essay.
  */
  }
  {
    share && item.neighbourhood && (
      <FragmentStrip
        slug={item.slug}
        subjects={item.subjects}
        constellations={item.neighbourhood.constellations}
        related={item.neighbourhood.related}
        relatedTotal={item.neighbourhood.relatedTotal}
        sharesWholeSignature={item.neighbourhood.sharesWholeSignature}
        occurredAt={item.occurredAt}
        precision={item.precision}
        shareLabel="Share this piece"
      />
    )
  }
</article>

---
/*
  FragmentStrip — the closing apparatus of a published fragment, in one place.

  A rule, then: its subjects, the constellations it sits in, the lines it is kin
  to, when it arrived, and a share mark set into the rule's right terminus.

  ⚠ ONE COMPONENT BECAUSE IT IS ONE IDEA, and it was written twice before it was
  written once. The quote page grew this first (plan 32 · §3); an essay then
  wanted the identical thing at the foot of a long read, and the choice was to
  copy it or to name it. `SuiteStanza`'s own header states this repo's rule —
  *"a pattern that exists in two places becomes a primitive"* — and the cost of
  the copy would not have been the duplication, it would have been the DRIFT: two
  strips answering "where else does this live?" in two registers, six months
  apart, with nobody able to say which one was the intended answer.

  ⚠ IT SITS AT THE END, ALWAYS, AND FOR A QUOTE THAT IS NOT A CHOICE — a quote is
  two lines, so its end and its beginning are the same place. For an essay it is
  the whole decision, and it reverses where the share mark first shipped:
  docs/adr/0023-the-apparatus-closes-the-reading.md carries the argument, the
  corpus numbers behind it, and the three alternatives that lost.
*/
import Timestamp from './Timestamp.astro';
import Reveal from './Reveal.astro';
import StarBloom from './StarBloom.astro';
import ShareMark from './ShareMark.astro';
import type { SubjectRef } from '../lib/blog';
import type { QuoteConstellation, QuoteNeighbour } from '../lib/quote-page';

interface Props {
  /**
   * Other published fragments carrying EVERY one of these subjects — the real
   * size of the "More on …" link's destination, minus this fragment.
   *
   * ⚠ 0 IS COMMON, NOT AN EDGE CASE: 57 of 131 published fragments (44%) have a
   * combination nobody else carries. Michael, 2026-08-10: *"can it not say 'more
   * on tag x tag x tag' if there isnt actually any other posts with that combo?
   * … often times the exact combination of tags results in only one result — the
   * exact thing we were just reading."*
   */
  sharesWholeSignature?: number;
  /** The fragment's own address — what the share mark hands over. */
  slug: string;
  subjects: SubjectRef[];
  /**
   * ⚠ BOTH DEFAULT TO EMPTY, AND THE FEED DELIBERATELY PASSES NEITHER. A card is
   * one of seven or twenty-five on a page; "1 constellation · 4 related lines"
   * repeated twenty-five times down the quotes view is a toolbar, not a feed,
   * and it is the same repetition that kept a share mark off every suite stanza.
   * Michael, 2026-08-10: *"should be the full strip but no need for
   * related/constellations. share mark, date, for consistency."*
   *
   * They belong to the OPENED fragment, where there is one of it.
   */
  constellations?: QuoteConstellation[];
  related?: QuoteNeighbour[];
  /** The TRUE size of the related set. The popover shows the top few and
   *  scrolls; a count that was really a cap would be worse than no count. */
  relatedTotal?: number;
  occurredAt: string;
  precision: 'day' | 'year';
  /**
   * ⚠ OFF WHERE THE CARD ALREADY SHOWS ONE. A writing card carries
   * "date · read time" under its title — the two facts you weigh before opening
   * it — so repeating the date at the foot would be the same duplication that
   * moved the share mark down in the first place. A quote card has no head line
   * at all, so its date lives here.
   */
  showDate?: boolean;
  /**
   * The rule above the strip.
   *
   * ⚠ OFF IN A FEED, ON A PAGE. A rule means "a boundary", and a list already
   * has one at every card edge — using the same mark for *between items* and
   * *within an item* makes neither legible. Measured on the quotes view before
   * this existed: **49 horizontal rules on one page**, 25 strip rules and 24
   * card separators, at near-identical weight. Michael: *"the divider line is
   * too visually similar to the divider lines separating each quote."*
   *
   * On a page or in a sheet the fragment owns the screen, nothing else divides
   * it from what follows, and the rule is the only thing saying the work has
   * ended and the apparatus has begun. There it earns its mark.
   */
  ruled?: boolean;
  /**
   * The share mark.
   *
   * ⚠ OFF IN A FEED, ON AN OPENED FRAGMENT. It was briefly on the cards too,
   * and Michael took it back off on sight: *"the share button is back in a
   * strange place off to the side, and even on a 3rd line by itself in smaller
   * screens. I think lets just remove it and keep it only in the sheet view as
   * we had before."*
   *
   * He is right, and the reason is the one this component's `ruled` prop is
   * already about. The mark is designed to be SET INTO A RULE — that is what
   * gives it a fixed address at the line's right terminus. A feed card has no
   * rule (the card edge does that job), so the mark had nothing to sit in and
   * fell back to being the last item in a wrapping row: the exact floating
   * behaviour ADR-0023 · Decision 2 removed from the essay header, reintroduced
   * one surface over. On a narrow screen it wrapped to a line of its own.
   *
   * So this returns to what ADR-0023 already said: ONE share mark per fragment,
   * where the fragment is being read.
   */
  share?: boolean;
  /** "Share this quote" / "Share this piece" — the mark's only accessible name. */
  shareLabel: string;
  /** A quote's date is provenance ("Added"); an essay's is publication. */
  dateKind?: 'posted' | 'added';
  datePrefix?: string;
  /** Which feed a subject link lands in. Quotes filter within `?view=quotes`. */
  subjectView?: 'writing' | 'quotes';
}
const {
  slug,
  subjects,
  constellations = [],
  related = [],
  relatedTotal = 0,
  occurredAt,
  precision,
  shareLabel,
  showDate = true,
  ruled = true,
  share = true,
  sharesWholeSignature = 0,
  dateKind = 'posted',
  datePrefix,
  subjectView = 'writing',
} = Astro.props as Props;

const subjectQ = subjectView === 'quotes' ? 'view=quotes&' : '';

const preview = (s: string, n = 96) => (s.length > n ? s.slice(0, n).trimEnd() + '…' : s);
const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;

// Each star breathes on its own phase — synchronised pulsing reads as machinery.
// Derived from the slug so it is stable across renders (index.astro's rule).
const phaseOf = (s: string) => -(([...s].reduce((a, ch) => a + ch.charCodeAt(0), 0) % 90) / 10).toFixed(1) + 's';

// ⚠ NOT "see all N" — a different set, and it must not claim to be the same one.
// `related` is ranked by how many subjects each fragment shares (an OR, scored);
// this is the feed's subject filter, which STACKS (AND — `?subject=a,b`, see
// blog/index.astro). So it lands on everything carrying this fragment's WHOLE
// signature: a stricter kind of kin, not a longer version of the list. Naming
// the subjects says that out loud and costs nothing.
//
// ⚠ AND ONLY WHEN SOMETHING IS THERE. The filter STACKS, so for a fragment whose
// combination is unique it returns exactly one row — this one. Nearly half of
// them are in that case (see `sharesWholeSignature`), so for nearly half of the
// site this link promised more of something and delivered the page you were
// already on. Third instance of one shape: the author door, "Appears in" minus
// the room you are in, and this. A door back to where you already are is not a
// door, and each one read as a feature until its count was checked.
const allSubjectsHref =
  subjects.length > 0 && sharesWholeSignature > 0
    ? `/blog?${subjectQ}subject=${subjects.map((s) => s.slug).join(',')}`
    : null;
---

{
  /*
      ⚠ THE SHARE MARK IS NOT IN THIS FLOW, and that is the point of `relative`
      here. Everything else in the strip is a FACT ABOUT THE QUOTE — its
      subjects, its constellations, its kin, when it arrived. Share is the only
      ACTION, and while it sat at the end of the same wrapping row it inherited
      that row's behaviour: it moved when the row rewrapped, sat beside "5
      related lines" as though it were a fifth fact, and landed somewhere
      different on a quote with two subjects than on one with four. Michael:
      *"it kind of just oddly sits to the right, especially when it gets to 2
      lines since it moves with the related stuff … I want it to be grounded
      somewhere."* A control with no fixed address is one the reader has to find
      again every time.

      So it comes out of the flow and onto the RULE — the one element here that
      is the same length in the same place on every quote at every width. See
      ShareMark for why the line breaks around it.

      ⚠ THE DATE RENDERS TWICE, sm:hidden / hidden sm:inline. It changes GROUP
      between the two widths (metadata above, actions row beside) and no single
      DOM position gives both. Duplicating one <time> is cheaper than a grid
      whose areas re-flow, and it is why the two tiers can be pure flex-wrap
      with no ordering tricks.
    */
}
<div
  class:list={[
    'text-whisper relative flex flex-wrap items-center gap-x-5 gap-y-3 font-sans text-sm',
    // The mark straddles the rule, so it only needs room reserved when there IS
    // one; unruled, it sits at the end of the row like any other item.
    ruled ? 'border-base-content/10 mt-12 border-t pt-5 pr-12 sm:pr-14' : 'mt-6',
  ]}
>
  {ruled && share && <ShareMark url={`/blog/${slug}`} label={shareLabel} onRule />}

  {
    subjects.length > 0 && (
      <ul class="flex flex-wrap items-center gap-x-3 gap-y-1 text-xs">
        {subjects.map((s) => (
          <li>
            <a href={`/blog?${subjectQ}subject=${s.slug}`} class="hover:text-muted transition-colors">
              {s.name}
            </a>
          </li>
        ))}
      </ul>
    )
  }

  {/* mobile tier 1, right end */}
  {
    showDate && (
      <span class="ml-auto text-xs sm:hidden">
        <Timestamp date={occurredAt} kind={dateKind} precision={precision} prefix={datePrefix} />
      </span>
    )
  }

  {/* the actions — their own row below `sm`, right-aligned at `sm` */}
  <div class="flex w-full items-center gap-x-4 gap-y-2 sm:ml-auto sm:w-auto">
    {
      constellations.length > 0 && (
        <Reveal wide label={`Appears in ${plural(constellations.length, 'constellation', 'constellations')}`}>
          <span class="qp-ctl">{plural(constellations.length, 'constellation', 'constellations')}</span>
          <Fragment slot="content">
            <p class="qp-label">Appears in</p>
            <ul class="qp-list">
              {constellations.map((c) => (
                <li>
                  {/* The Sky's own vocabulary at popover scale — `cn-<slot>`
                          hands the row its colour, `.sky-star` breathes and
                          glows, `.sky-name` carries a TRACE of that colour at
                          rest and comes to full on attention, and StarBloom
                          parts on `.group:hover`. Every one of those is an
                          existing class (admin.css, which app.css imports):
                          nothing is redrawn for this surface, so the mark blooms
                          here exactly as it does on the front page.

                          ⚠ THE BLOOM IS HOVER-ONLY HERE, a deliberate departure
                          from the overview where hover-only was the bug ADR-0022
                          fixed. The overview had to ANNOUNCE that its names were
                          links to a reader who had not touched anything. This
                          list is already inside a popover the reader chose to
                          open — the affordance was established by the act of
                          opening it, so a proximity tracker in here would be
                          motion with nothing left to say. */}
                  <a href={`/${c.slug}`} class:list={['qp-row group', `cn-${c.color}`]}>
                    <span class="qp-row__head">
                      <span class="sky-star text-sm" style={`--glow: .72; --phase: ${phaseOf(c.slug)}`}>
                        <StarBloom />
                      </span>
                      <span class="sky-name qp-row__name">{c.name}</span>
                    </span>
                    {c.description && <span class="qp-row__sub qp-row__sub--indent">{c.description}</span>}
                  </a>
                </li>
              ))}
            </ul>
          </Fragment>
        </Reveal>
      )
    }

    {
      related.length > 0 && (
        <Reveal wide label={`${relatedTotal} related`}>
          {/* ⚠ "N related", not "N related lines". Two reasons, and the first is
                  this repo's own vocabulary: ADR-0017 is titled *"A quote is
                  three facts; the line under it is derived"* — **the line**
                  already means the ATTRIBUTION here, so counting quotes in
                  "lines" collides with it. The second is that this list is
                  MIXED: across the corpus 318 of these entries are quotes and
                  214 are essays, so a noun naming either is wrong for two
                  fifths of it. No noun is needed. */}
          <span class="qp-ctl">{relatedTotal} related</span>
          <Fragment slot="content">
            <p class="qp-label">Along the same lines</p>
            <ul class="qp-list">
              {related.map((r) => (
                <li>
                  <a href={`/blog/${r.slug}`} class="qp-row">
                    <span class="qp-row__title">{r.type === 'writing' ? r.title : preview(r.body)}</span>
                    <span class="qp-row__sub">
                      {r.type === 'writing' ? 'an essay' : (r.attribution ?? 'unattributed')}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
            {allSubjectsHref && (
              <a href={allSubjectsHref} class="qp-door qp-door--ruled">
                More on {subjects.map((s) => s.name).join(' · ')}
                <span class="qp-door__arrow">→</span>
              </a>
            )}
          </Fragment>
        </Reveal>
      )
    }

    {
      showDate && (
        <span class="hidden sm:inline">
          <Timestamp date={occurredAt} kind={dateKind} precision={precision} prefix={datePrefix} />
        </span>
      )
    }
    {
      /* Unruled, the mark has no line to be set into — so it ends the row, which
        is the same PLACE, just without a rule drawn through it. */
    }
  </div>
</div>

<style is:global>
  /* The strip's controls are sans, where Reveal's default register is the
     caller's — an attribution is serif small-caps and these are chrome. */
  .qp-ctl {
    font-family: var(--font-sans, ui-sans-serif);
  }

  .qp-cite {
    display: block;
  }
  .qp-door {
    display: flex;
    align-items: baseline;
    gap: 0.4rem;
    color: color-mix(in oklab, var(--color-base-content) 85%, transparent);
    transition: color 160ms ease;
  }
  .qp-door:hover {
    color: var(--color-primary);
  }
  .qp-door--ruled {
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in oklab, var(--color-base-content) 12%, transparent);
  }
  .qp-door__arrow {
    opacity: 0.5;
  }

  .qp-label {
    font-family: var(--font-sans, ui-sans-serif);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-whisper);
    margin-bottom: 0.6rem;
  }
  .qp-list {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }
  .qp-row {
    display: block;
  }
  .qp-row__head {
    display: flex;
    align-items: baseline;
  }
  /* ⚠ LAYOUT ONLY — `.sky-name` owns a constellation row's ink and this must not
     become a second opinion about it. */
  .qp-row__name {
    font-family: var(--font-display, var(--font-serif));
    font-size: 1.02rem;
    font-weight: 300;
    line-height: 1.3;
  }
  .qp-row__title {
    display: block;
    color: color-mix(in oklab, var(--color-base-content) 85%, transparent);
    line-height: 1.4;
    transition: color 160ms ease;
  }
  .qp-row:hover .qp-row__title {
    color: var(--color-primary);
  }
  .qp-row__sub {
    display: block;
    margin-top: 0.15rem;
    font-size: 0.78rem;
    color: var(--text-whisper);
    font-variant: all-small-caps;
    letter-spacing: 0.06em;
  }
  /* Aligns a description under the NAME rather than under the star, the way the
     overview's `ml-6` does. The number is the star's own reserved width: a 1em
     mark at .875rem plus StarBloom's 0.85em of companion room on each side. */
  .qp-row__sub--indent {
    margin-left: calc(0.875rem * 2.7);
    font-variant: normal;
    letter-spacing: 0.01em;
    font-size: 0.8rem;
  }
</style>

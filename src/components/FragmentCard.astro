---
import Timestamp from './Timestamp.astro';
import Label from './Label.astro';
import { TYPE_META } from '../lib/fragments-display';

/*
  FragmentCard — the atom, standardized.

  RULES (agreed):
    - The card is a fixed FRAME; content truncates to fit, never the reverse.
    - Flex column with the date footer pinned to the bottom (mt-auto via grow),
      so the date sits on the same baseline across every card in a row.
    - Titles clamp to 1 line; bodies / quotes / excerpts clamp to 2 lines.
    - Writing ALWAYS shows an excerpt.
    - Height is not hard-coded: cards stretch to match their row (flex/grid
      `stretch`), so they align without dead space. Width is set by the caller
      (rail passes `w-72 shrink-0`; a grid lets them fill the column).

  Per type:
    quote   → the quote (2 ln) + attribution,      (Added)
    writing → title + excerpt,  posted date + read (Posted)
  The Spotify embed / full quote / full essay live on the fragment's own page,
  not on the card — that's what keeps every card the same shape.
*/
interface Props {
  type: 'quote' | 'writing';
  title?: string;
  body?: string; // quote text, excerpt, or (song) optional album line
  attribution?: string; // artist(+album) · quote author · source
  date?: string | Date;
  updated?: string | Date;
  precision?: 'day' | 'year';
  meta?: string; // e.g. read time
  class?: string;
}
const { type, title, body, attribution, date, updated, precision = 'day', meta, class: className = '' } = Astro.props;

// glyph/label/tone come from TYPE_META (the one map); the card adds only what
// is its own business — the hover border and which date word it uses.
const CARD = {
  quote: { hover: 'hover:border-secondary/40', kind: 'added' },
  writing: { hover: 'hover:border-accent/40', kind: 'posted' },
}[type];
const cfg = { ...TYPE_META[type], ...CARD };
---

<article
  class:list={[
    'rounded-box border-base-300 bg-base-200 flex h-full flex-col border p-5 transition-colors',
    cfg.hover,
    className,
  ]}
>
  {
    /* The glyph is conditional because writing no longer has one (TYPE_META,
      2026-08-17) and this header lays out with `gap` — an empty span would
      indent the word "writing" past every "quote" beside it in the grid. The
      label was always the thing saying what the card is; the mark only ever
      repeated it in a second alphabet. */
  }
  <header class="flex items-center gap-2">
    {
      cfg.glyph && (
        <span class:list={['text-sm', cfg.tone]} aria-hidden="true">
          {cfg.glyph}
        </span>
      )
    }
    <Label variant="chrome" as="span">{cfg.label}</Label>
  </header>

  <div class="mt-3 grow">
    {
      type === 'quote' ? (
        <blockquote class="line-clamp-2 text-lg leading-relaxed italic">{body}</blockquote>
      ) : (
        <>
          {title && <h3 class="line-clamp-1 text-xl leading-snug">{title}</h3>}
          {body && <p class="text-base-content/60 mt-1 line-clamp-2">{body}</p>}
        </>
      )
    }
    {attribution && <p class="text-base-content/50 mt-2 line-clamp-1 font-sans text-sm">{attribution}</p>}
  </div>

  <footer class="text-base-content/30 mt-4 flex items-center gap-1 font-sans text-xs">
    {date && <Timestamp date={date} updated={updated} kind={cfg.kind as 'posted' | 'added'} precision={precision} />}
    {meta && <span>· {meta}</span>}
  </footer>
</article>

---
/*
  StarMark — the site's signature mark, drawn rather than borrowed
  (design.md §8). Chosen 2026-07-24 from four candidates; the shape and the
  reasoning live in src/lib/star-mark.ts.

  Inherits `currentColor`, so it takes a constellation's `--cn` wherever one is
  set, and glows via `filter: drop-shadow` the way the old glyph did with
  `text-shadow`. Sized in `em`, so it sits inline with text at any scale.

  Decorative by default — pass `label` only when it is the sole content of a
  control that has no other accessible name.

  ⚠ IT CARRIES `width`/`height` ATTRIBUTES AS WELL AS THE CSS, which looks like
  a duplicate of `.star-mark` and is not. An <svg> with a viewBox and no
  dimensions has no intrinsic size, so in any frame where the stylesheet is not
  applied it fills its container — and this mark is the site's face, so that
  reads as the favicon flashing across the whole page. It happened for real
  (see the Analytics note in SiteLayout, which put every stylesheet in the body
  and cost a styleless frame per navigation). These are presentation
  attributes, the weakest thing in the cascade, so `.star-mark` and every
  override of it — `.sky-star`'s .48em, the bloom's satellites — still decide
  the size exactly as before. This only decides what happens when nothing else
  can.
*/
import { STAR_PATH, STAR_VIEWBOX } from '../lib/star-mark';

interface Props {
  class?: string;
  label?: string;
}
const { class: className = '', label } = Astro.props;
---

<svg
  viewBox={STAR_VIEWBOX}
  width="1em"
  height="1em"
  class:list={['star-mark', className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  fill="none"
>
  <path d={STAR_PATH} fill="currentColor"></path>
</svg>

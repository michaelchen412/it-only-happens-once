---
/*
  BackToTop — a quiet floating control that appears once you've scrolled a
  screen or so down, and returns you to the top. It stays hidden until earned
  and tucks itself away again near the top; motion self-disables under
  prefers-reduced-motion.

  `scroller` names the thing that actually scrolls. Omit it for a page (window
  scroll); pass a selector for a container — the Reader's `.reader-scroll`, an
  editor drawer's document area — because window scroll never fires for those.

  `inDialog` positions it absolutely instead of fixed: inside a <dialog> the
  control belongs to the sheet, so it must sit above the sheet's own footer
  rather than at the viewport's corner.
*/
import { Icon } from 'astro-icon/components';

interface Props {
  scroller?: string;
  inDialog?: boolean;
  class?: string;
}
const { scroller, inDialog = false, class: className = '' } = Astro.props;
---

<button
  type="button"
  data-back-to-top
  data-scroller={scroller}
  class:list={['back-to-top', inDialog && 'back-to-top--in-sheet', className]}
  aria-label="Back to top"
>
  <Icon name="ph:arrow-up" class="text-lg" />
</button>

<script>
  import '../scripts/back-to-top';
</script>

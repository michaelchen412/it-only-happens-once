---
/*
  Colophon — the "how this was made" note, editorial-style. See design.md §3.

  THE DRAWER ONLY. A native top-layer popover holding the typefaces (and *why*
  Atkinson), the stack as monochrome marks, the authorship attestation, and a
  link to the source. Not a "powered by" badge strip.

  ⚠ IT RENDERS NO TRIGGER, AND THAT IS THE FIX FOR A REAL BUG. This used to be
  button-plus-panel, mounted inside the top bar's utilities `<div>` — which is
  inside `#site-menu`, which is `display: none` below `md:` until the hamburger
  opens it. That was invisible while the only trigger lived in there with it:
  the menu was necessarily open. The moment the footer grew a second trigger, a
  phone could press a visible button, flip the popover to `:popover-open`, and
  get NOTHING — an element in a `display: none` subtree paints no box, measured
  0×0. So the panel is mounted once at layout level, outside every trigger's
  container, and the triggers are plain `popovertarget` buttons wherever they
  belong (SiteLayout renders both: the bar's ⌗ and the footer's).

  Positioned with a small script relative to the trigger that was pressed — more
  reliable across browsers than CSS anchor positioning, and it works whether the
  trigger is inline (desktop), inside the mobile menu, or at the foot of the
  page. The listeners are delegated on `document`, so they survive view-
  transition navigations without re-binding.
*/
import { Icon } from 'astro-icon/components';

const repo = 'https://github.com/michaelchen412/it-only-happens-once';
const stack = [
  { icon: 'simple-icons:astro', label: 'Astro' },
  { icon: 'simple-icons:supabase', label: 'Supabase' },
  { icon: 'simple-icons:tailwindcss', label: 'Tailwind CSS' },
  { icon: 'simple-icons:daisyui', label: 'daisyUI' },
  { icon: 'simple-icons:typescript', label: 'TypeScript' },
  { icon: 'simple-icons:vercel', label: 'Vercel' },
];
---

<div
  id="site-colophon"
  popover
  class="colophon-popover rounded-box border-base-300 bg-base-200 border p-5 text-left shadow-lg"
>
  {
    /* Built with — the stack as monochrome marks, in muted ink (a colophon, not
      a badge strip; see design.md §3).

      ⚠ "THIS SITE IS AN INDEPENDENT PROJECT BUILT WITH", not "Built with"
      (2026-08-11). Michael's ask, and the reason is what this whole drawer is
      for: *"I do want it to be known that I didn't use a website builder."* The
      ⌗ in the bar says there is a repo; the stack list says which tools. Neither
      says the thing actually being claimed, which is that nobody assembled this
      from a template. The lead-in is the one line in here that can.

      It went out first as "An independent project built with" and gained its
      subject an hour later, also Michael's call. The longer one is the better
      one for a reason worth keeping: without "This site is", the phrase floats —
      it could be describing the STACK below it as independent, which is not a
      claim about anything. Naming the subject is what turns a label into an
      assertion. It is still a LEAD-IN rather than a sentence of its own — the
      list completes it — so the register does not change and no badge appears. */
  }
  <p class="text-whisper font-sans text-xs tracking-wide">This site is an independent project built with</p>
  <ul class="text-faint mt-2 flex flex-wrap gap-x-4 gap-y-2 font-sans text-sm">
    {
      stack.map((s) => (
        <li class="inline-flex items-center gap-1.5">
          <Icon name={s.icon} class="size-4" />
          {s.label}
        </li>
      ))
    }
  </ul>

  {
    /* Typeset in — a tiny specimen: each face is named IN its own face, so the
      note shows what it says. Newsreader (the reading voice) set in Newsreader;
      Atkinson Hyperlegible (the interface) set in Atkinson. */
  }
  <p class="text-whisper mt-5 font-sans text-xs tracking-wide">Typeset in</p>
  <dl class="mt-2 space-y-1">
    <div class="flex items-baseline justify-between gap-3">
      <dt class="text-base-content/85 font-serif text-lg leading-tight">Newsreader</dt>
      <dd class="text-whisper font-sans text-xs">reading</dd>
    </div>
    <div class="flex items-baseline justify-between gap-3">
      <dt class="text-base-content/85 font-sans text-base leading-tight whitespace-nowrap">Atkinson Hyperlegible</dt>
      <dd class="text-whisper font-serif text-xs">interface</dd>
    </div>
  </dl>
  <p class="text-whisper mt-2.5 font-serif text-sm leading-relaxed">
    Atkinson was drawn by the Braille Institute so that people who struggle to read still can.
  </p>

  {/* No AI-generated content. */}
  <p class="border-base-300 text-whisper mt-4 border-t pt-4 font-sans text-xs leading-relaxed">
    There is no AI-generated content on this blog; all content is authored, edited, and compiled by me. Claude Code was
    only used to streamline the development process of the site itself.
  </p>

  {
    /* The feed's only visible address (plan 34 · §5). A <link rel="alternate">
      in Base is what a reader's *browser* uses; this is what a *person* uses,
      and a feed nobody can find is a feed nobody reads.

      ⚠ HERE RATHER THAN IN THE NAV, DELIBERATELY. The top bar is three links
      and a wordmark, and RSS is a minority affordance — putting it up there
      would spend the site's most contested row on a control most visitors will
      never press. The colophon is already the drawer for *how this was made*,
      which is the same register: infrastructure, offered quietly to whoever
      goes looking. It also keeps the mark out of the mobile burger, where the
      three real destinations need the room. */
  }
  <div class="mt-5 flex items-center justify-between gap-3">
    <a
      href={repo}
      target="_blank"
      rel="noopener noreferrer"
      class="text-primary inline-flex items-center gap-1.5 font-sans text-sm hover:underline"
    >
      <Icon name="simple-icons:github" class="size-4" />
      {
        /* "my project", not just "on GitHub" — same 2026-08-11 reason as the
          lead-in above. "View on GitHub" describes a destination; the point is
          whose it is. */
      }
      View my project on GitHub
      <Icon name="ph:arrow-up-right" class="size-3" />
    </a>
    <a href="/rss.xml" class="text-whisper hover:text-base-content font-sans text-sm transition-colors"> RSS </a>
  </div>
</div>

<script>
  const TRIGGER = 'button[popovertarget="site-colophon"]';

  /* ⚠ TAKES THE TRIGGER AS AN ARGUMENT — it used to look it up as
     `document.querySelector(TRIGGER)`, which is the FIRST such button in the
     document and therefore always the top bar's. That was invisible while the
     bar was the only trigger, and became a real defect the moment the footer
     grew a second one: pressing it placed the drawer under a button ~2,000px
     above, i.e. off-screen, at the top of a page you are at the bottom of.
     Found on a bench that mounted a second trigger, which is the only way it
     could ever have been found. */
  function positionColophon(btn: HTMLElement) {
    const pop = document.getElementById('site-colophon');
    if (!pop) return;
    const r = btn.getBoundingClientRect();
    const pad = 8;
    const pw = pop.offsetWidth;
    const ph = pop.offsetHeight;
    const left = Math.max(pad, Math.min(r.right - pw, window.innerWidth - pw - pad));
    // Open downward by default (the bar's trigger has the whole page below it);
    // the flip then handles the footer's, which never has room underneath and
    // always has room above. No footer-specific branch is needed.
    let top = r.bottom + pad;
    if (top + ph > window.innerHeight - pad) {
      const above = r.top - ph - pad;
      if (above >= pad) top = above; // flip up only if it actually fits
    }
    pop.style.left = `${left}px`;
    pop.style.top = `${top}px`;
    pop.style.right = 'auto';
    pop.style.bottom = 'auto';
  }

  // Remembered so a resize repositions against the trigger that opened it,
  // rather than guessing at one.
  let opener: HTMLElement | null = null;

  // Delegated on document, so it survives view-transition navigation.
  document.addEventListener('click', (e) => {
    const btn = (e.target as Element)?.closest?.(TRIGGER) as HTMLElement | null;
    if (!btn) return;
    opener = btn;
    requestAnimationFrame(() => {
      const pop = document.getElementById('site-colophon');
      if (pop && pop.matches(':popover-open')) positionColophon(btn);
    });
  });
  window.addEventListener('resize', () => {
    const pop = document.getElementById('site-colophon');
    if (pop && opener && pop.matches(':popover-open')) positionColophon(opener);
  });
</script>

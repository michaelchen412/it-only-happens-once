---
/*
  PreviewBar — the band across an unpublished piece being previewed on its real
  public URL (docs/plans/01).

  It exists because the preview is deliberately indistinguishable from the live
  page: same route, same layout, same PostArticle, so what you check is what
  readers get. That fidelity is the whole point, and it is also the hazard — so
  the one difference has to say itself plainly. Never mistake a preview for the
  live page; that mistake is the reason this file exists.

  Only ever seen by an admin session: everyone else gets the same 404 they got
  before this feature, and the page that renders this bar sends
  `private, no-store` so it can't be cached at the edge on their behalf.
*/
import { Icon } from 'astro-icon/components';

interface Props {
  /** Which tier — a note reads one step quieter than a draft, as it does in the
   *  manager, the chips, and the sheet's heading. */
  status: 'note' | 'draft';
  /** Back to the workshop with this piece open. The sheet reads the hash. */
  editHref?: string;
}
const { status, editHref } = Astro.props;
---

{
  /* `top-14` parks it directly under SiteLayout's sticky bar, so it stays in
    view down a long draft — the warning is worth the pixels. */
}
<div class="border-warning/40 bg-warning/10 sticky top-14 z-20 border-b backdrop-blur">
  <div class="text-base-content/70 mx-auto flex max-w-2xl items-center gap-2 px-5 py-2 font-sans text-xs">
    <Icon name="ph:eye" class="text-warning size-4 shrink-0" />
    <p>
      <b class="font-medium">{status === 'note' ? 'A note' : 'Draft'} — only you can see this.</b>
      <span class="text-base-content/50">This is the real page, exactly as it will look. It just isn’t public yet.</span
      >
    </p>
    {
      editHref && (
        <a
          href={editHref}
          class="hover:text-base-content ml-auto shrink-0 whitespace-nowrap underline underline-offset-2"
        >
          Edit
        </a>
      )
    }
  </div>
</div>

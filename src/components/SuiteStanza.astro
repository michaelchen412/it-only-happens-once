---
/*
  SuiteStanza — ONE stanza of a suite, in its own register (design.md §13).

  Extracted so the public suite and the composer's Read view render a placed
  fragment from a single definition (§2.3: a pattern that exists in two places
  becomes a primitive). This is the CONTENT only — the margin mark, the stanza
  offsets, the drawn line and the passing lamplight are the public suite's
  chrome and stay in ConstellationSuite.astro.

    • quote   — set whole, never truncated; line breaks preserved; a serif
                all-small-caps attribution.
    • writing — display title + fading excerpt and NO metadata; the block opens
                the blog's own Reader (`data-read`), so an essay reads
                identically everywhere.
    • song    — the ANNOTATION leads and the embed closes as citation (ADR-0009).
                A song is Michael's words about a track plus the track itself —
                structurally what a quote is, inverted: someone else's words plus
                who said them. So the display-register title is gone when there
                are words (the embed already shows title and artist, and an
                essay-sized heading made a song stanza read like an essay); the
                artist keeps the attribution register a quote's figcaption uses.
                An UNANNOTATED song falls back to title + artist — there's
                nothing else to set, and the embed may be blocked.
                A song is a STANZA: it plays where it was placed (design.md §14).
                The score above the suite is independent — either, or both, or
                neither.
*/
import type { SuiteItem } from '../lib/constellations';
import { renderMarkdown } from '../lib/markdown';
import { parseSongRef, songEmbed } from '../lib/media';

interface Props {
  item: SuiteItem;
}
const { item } = Astro.props;

// `parseSongRef`, not `parseSpotifyEmbed`: a song may cite a YouTube video as
// well as a Spotify track or album (docs/plans/04 Piece 3), and a placed song
// has to render wherever it was placed.
const ref = item.kind === 'song' && item.sourceUrl ? parseSongRef(item.sourceUrl) : null;
const embed = ref ? songEmbed(ref) : null;
const noteHtml = item.kind === 'song' ? renderMarkdown(item.body) : '';
---

{
  item.kind === 'quote' && (
    <figure>
      <blockquote class="prose-measure text-[1.35rem] leading-[1.5] font-light whitespace-pre-line sm:text-[1.6rem]">
        {item.body}
      </blockquote>
      {item.attribution && (
        <figcaption class="text-base-content/50 mt-3 font-serif text-[1.05rem] tracking-[0.06em] [font-variant:all-small-caps]">
          — {item.attribution}
        </figcaption>
      )}
    </figure>
  )
}

{
  item.kind === 'writing' && (
    <a href={`/blog/${item.item.slug}`} data-read={item.item.slug} class="block cursor-pointer">
      <h2 class="sw-title font-display text-2xl leading-tight font-light sm:text-3xl">{item.item.title}</h2>
      <p class="sw-excerpt excerpt-fade prose-measure text-base-content/70 mt-3 line-clamp-4 text-[1.05rem] leading-[1.7]">
        {item.item.excerpt}
      </p>
    </a>
  )
}

{
  item.kind === 'song' && (
    <div>
      {noteHtml ? (
        <div class="suite-note reading prose-measure" set:html={noteHtml} />
      ) : (
        <h2 class="sw-title font-display text-2xl leading-tight font-light sm:text-3xl">{item.title}</h2>
      )}
      {item.attribution && (
        <p
          class:list={[
            'suite-attrib text-base-content/50 font-serif text-[1.05rem] tracking-[0.06em] [font-variant:all-small-caps]',
            // prose wants a little more air beneath it than a title does
            noteHtml ? 'mt-3' : 'mt-2',
          ]}
        >
          — {item.attribution}
        </p>
      )}
      {embed &&
        (embed.height === null ? (
          // Video has no natural row height — it's 16:9 and scales with the
          // measure, so the box sets the ratio and the frame fills it.
          <div class="mt-4 aspect-video max-w-xl overflow-hidden" style="border-radius: var(--radius-box)">
            <iframe
              class="h-full w-full"
              src={embed.src}
              loading="lazy"
              allow={embed.allow}
              title={item.title}
              style="border: 0"
            />
          </div>
        ) : (
          <iframe
            class="mt-4 max-w-xl"
            src={embed.src}
            width="100%"
            height={embed.height}
            loading="lazy"
            allow={embed.allow}
            title={item.title}
            style="border-radius: var(--radius-box); border: 0"
          />
        ))}
    </div>
  )
}

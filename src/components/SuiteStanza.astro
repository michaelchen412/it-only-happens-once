---
/*
  SuiteStanza — ONE stanza of a suite, in its own register (design.md §13).

  Extracted so the public suite and the composer's Read view render a placed
  fragment from a single definition (§2.3: a pattern that exists in two places
  becomes a primitive). This is the CONTENT only — the margin mark, the stanza
  offsets, the drawn line and the passing lamplight are the public suite's
  chrome and stay in ConstellationSuite.astro.

    • quote   — set whole, never truncated; line breaks preserved; a serif
                all-small-caps attribution.
    • writing — display title + fading excerpt and NO metadata; the block opens
                the blog's own Reader (`data-read`), so an essay reads
                identically everywhere. It is also the one stanza that sits on a
                PAGE — a sheet that fades in left to right so the drawn figure
                passes through it (ADR-0029). The sheet is not here: it is CSS on
                `.suite-writing > .grow`, which both this component's callers
                already build, so the public suite and the composer's Read view
                get it from one definition and neither can drift.
  ⚠ AND THERE IS NO SONG STANZA — there was one, and ADR 0031 deleted it. Music
  accompanies a constellation as its SCORE (`constellations.score_url`) or
  through one essay's `paired_song_id`; both are relations rather than
  membership, and neither renders here. A suite is a sequence read at the
  reader's pace, and a four-minute song does not queue. In the three weeks the
  stanza existed, zero of 48 songs were placed in one. `git log` has the
  implementation if that ever reverses.
*/
import type { SuiteItem } from '../lib/constellations';
import QuoteReveal from './QuoteReveal.astro';
import { renderMarkdown, toPlainText } from '../lib/markdown';
import { quoteStyle } from '../lib/quote-scale';

interface Props {
  item: SuiteItem;
}
const { item } = Astro.props;

// The third of the three surfaces that render a quote body, and it renders it
// the same way the other two do — see QuoteArticle for the contract. The suite
// is where an unhonoured `\` would have been loudest: a stanza is set at
// display size with nothing else on the line.
const quoteHtml = item.kind === 'quote' ? renderMarkdown(item.quote.body, { breaks: true }) : '';

// ⚠ AND IT RAMPS THE SAME WAY THEY DO, AS OF 2026-09-01 (`/lab/quotes`). This was
// flat 1.35 / 1.6rem, which is the register a SHORT stanza wants — and a suite
// is exactly where the flat version hurt most, because a stanza is set with
// nothing else on the line and the file header already says so. A 500-character
// passage at 1.6rem in the middle of a read stops being a movement and becomes
// the piece. The ceiling is unchanged; only the long ones move.
const quoteSizeStyle = item.kind === 'quote' ? quoteStyle(toPlainText(item.quote.body).length, 'suite') : '';
---

{
  item.kind === 'quote' && (
    /*
      ⚠ THE STANZA OPENS NOW, and the anchor is what says so. Until 2026-08-10 a
      quote here was inert by deliberation, and that was right while there was
      nowhere for it to go — ConstellationSuite's header still carries the
      argument, because the rule it states did not change, only the facts under
      it: an openable stanza gets a word, an unopenable one does not. A quote
      became openable when it got an apparatus worth opening (plan 32), so it
      gets its word.

      ⚠ IT DOES NOT NAVIGATE. `data-read` hands it to the Reader, which fills
      itself from the `<template>` ConstellationSuite renders alongside — the
      same drawer, and the same mechanism, an essay stanza has always used.
      Michael, 2026-08-10: *"they should show up in a sheet and, obviously, not
      in their own dedicated page."* The `href` is the no-JS floor and the
      ⌘-click path, and it is a real page either way.

      ⚠ THE ATTRIBUTION STAYS OUTSIDE THE ANCHOR. It is already a control (the
      citation reveal), and nesting a button inside a link is both invalid and a
      coin-toss about which one a click means. So the LINE opens the sheet and
      the NAME opens its citation, which is the same division the sheet itself
      uses once it is open.
    */
    <figure>
      <a href={`/blog/${item.quote.slug}`} data-read={item.quote.slug} class="block">
        <blockquote
          class="quote-body quote-ramp prose-measure leading-[1.5] font-light"
          style={quoteSizeStyle}
          set:html={quoteHtml}
        />
      </a>
      {item.quote.attribution && (
        <figcaption class="text-whisper mt-3 font-serif text-[1.05rem] tracking-[0.06em] [font-variant:all-small-caps]">
          {'— '}
          <QuoteReveal reveal={item.quote.reveal}>{item.quote.attribution}</QuoteReveal>
        </figcaption>
      )}
    </figure>
  )
}

{
  item.kind === 'writing' && (
    <a href={`/blog/${item.item.slug}`} data-read={item.item.slug} class="block cursor-pointer">
      <h2 class="sw-title font-display text-2xl leading-tight font-light sm:text-3xl">{item.item.title}</h2>
      <p class="sw-excerpt excerpt-fade prose-measure text-muted mt-3 line-clamp-4 text-[1.05rem] leading-[1.7]">
        {item.item.excerpt}
      </p>
    </a>
  )
}

---
/*
  QuoteArticle — the ONE canonical rendering of a quote and its apparatus.

  Named for `PostArticle` and shared the same way, by three surfaces that must
  stay identical:
    • the quote's permalink, `/blog/[slug]`,
    • the in-context Reader, cloned from a `<template>`,
    • a constellation suite's quote stanza, which fills that template.

  It was `QuotePage.astro` for one commit, when a quote's own page was the only
  place this existed. Michael, 2026-08-10: *"within the constellation view, the
  quotes should be clickable … they should show up in a sheet and, obviously,
  not in their own dedicated page, but basically the same feature set."* The
  rename is the point — this is a rendering, not a route.

  THE WHOLE PAGE IS: the line, the attribution, a rule, and one strip. That is a
  ruling, not a starting point. The bench opened with "Appears in" and "Along the
  same lines" as stacked sections below the quote, and Michael ruled them out on
  sight — *"long, extended sections at the bottom … causes visual clutter, mixes
  in with all the other main UI elements, and creates confusion."* So everything
  with depth opens a POPOVER from the strip and nothing unrolls down the page.

  WHY THE PAGE EXISTS AT ALL, since a quote is two lines and a permalink for it
  sounds like overkill — it did to Michael too, until: *"it can actually tell us
  a lot about interconnected ideas … showing the constellations that something
  is in is very valuable to understand the context of the thing."* The page is
  therefore a DOOR, not a destination. A quote alone on a page is a dead end;
  the recipient of a shared link reads two lines and leaves. Everything in the
  strip exists to give them somewhere to go, which is also the reason the share
  verb is a LINK rather than copied text:

    "people going to the site and willing to share content from the site
     generally want other people to also visit the site and see if there are
     other unique perspectives that might be worth exploring."

  ⚠ THE STRIP IS ONE DESIGN AT TWO WIDTHS, not two layouts.
    below `sm`  two tiers — subjects and the date above, the ACTIONS on their own
                row beneath. Five controls do not fit a 390px line, and squeezing
                them there is how a strip becomes a toolbar.
    `sm` and up one line — subjects left, everything else right.
  Both were benched as rivals. They are the same layout; the second is what the
  first does when it has room.

  ⚠ NOTE THE BACKTICKS ABOVE, AND DO NOT "TIDY" THEM INTO `< sm`. A bare `<` in
  a frontmatter comment silently breaks the Astro compiler's `Props` extraction:
  `Astro.props` degrades to `any`, every destructured field with it, and the only
  symptom is a scatter of ts(7006) "implicitly has an 'any' type" errors on
  callback parameters TWO HUNDRED LINES BELOW, pointing nowhere near the cause.
  It cost a bisect to find. src/tests/astro-props.test.ts guards every component.
*/
import Reveal from './Reveal.astro';
import FragmentStrip from './FragmentStrip.astro';
// Aliased: the type and this component share a name, and the shadow silently
// widened `page` to `any` — every callback below lost its parameter types.
import type { QuotePage as QuotePageData } from '../lib/quote-page';

interface Props {
  page: QuotePageData;
  /**
   * The constellation the reader is STANDING IN, when this opens inside a suite.
   *
   * ⚠ It is dropped from "Appears in", and that is not tidying. A door back to
   * the room you are already in is not a door; listing it would make the control
   * count one higher than the number of places it can actually take you, which
   * is the same lie the "45 related lines" count told before §6. When it is the
   * only one, the control does not render at all.
   */
  inConstellation?: string;
}
const { page, inConstellation } = Astro.props as Props;
const { quote, related, relatedTotal, author } = page;
const constellations = inConstellation
  ? page.constellations.filter((c) => c.slug !== inConstellation)
  : page.constellations;

// The type ramps DOWN as the line grows. A six-word aphorism at essay size looks
// lost; a stanza at display size overruns the screen. Three steps, chosen
// against the real corpus (30 → 843 characters, mean 189).
const len = quote.body.length;
const size =
  len < 90
    ? 'text-[2rem] sm:text-[2.6rem]'
    : len < 320
      ? 'text-[1.6rem] sm:text-[2rem]'
      : 'text-[1.35rem] sm:text-[1.6rem]';

// ⚠ The attribution is a control whenever there is ANYTHING behind it, which is
// the change from the feed's rule. QuoteReveal renders nothing without a
// citation — but there is now a second thing there: the rest of this author's
// lines. Michael, 2026-08-10: *"that author's name is clickable regardless of
// whether there's a citation or not."*
//
// ⚠ AND `others > 0` IS LOAD-BEARING. 29 of 35 authors in the corpus have
// exactly one quote, so without it the door would, for 40% of quotes, open onto
// a page containing only the quote you are already reading.
const hasDoor = Boolean(author && author.others > 0);
// PROPOSED FACET, built in §5 — filters on `author_id`, never on the attribution
// string, which is a derived LINE (three published quotes carry one with no
// author row behind it).
const authorHref = author ? `/blog?view=quotes&author=${author.slug}` : null;

const plural = (n: number, one: string, many: string) => `${n} ${n === 1 ? one : many}`;
---

{
  /* ⚠ NO FRAME OF ITS OWN — no <main>, no measure, no vertical centring. The
    permalink wants a full screen with the line floated in the middle of it; the
    Reader wants the top of a 44rem drawer. Both are the CALLER's business, and
    baking either one in here is what would make the third surface need a copy. */
}
<div class="quote-article">
  <figure>
    <blockquote class:list={['text-base-content font-serif leading-[1.42] font-light whitespace-pre-line', size]}>
      {quote.body}
    </blockquote>

    {
      quote.attribution && (
        <figcaption class="text-base-content/50 mt-6 font-serif text-[1.15rem] tracking-[0.06em] [font-variant:all-small-caps]">
          {/* The em-dash stays OUTSIDE the control: it is punctuation, not the
                name, and underlining it on hover reads as a typo. (QuoteCard
                makes the same point in the same words.) */}
          {'— '}
          {quote.reveal || hasDoor ? (
            <Reveal label={`About ${quote.attribution}`}>
              {quote.attribution}
              <Fragment slot="content">
                {quote.reveal && <span class="qp-cite">{quote.reveal}</span>}
                {hasDoor && authorHref && (
                  <a href={authorHref} class:list={['qp-door', quote.reveal && 'qp-door--ruled']}>
                    {plural(author!.others, 'more line', 'more lines')} from {author!.name}
                    <span class="qp-door__arrow">→</span>
                  </a>
                )}
              </Fragment>
            </Reveal>
          ) : (
            quote.attribution
          )}
        </figcaption>
      )
    }
  </figure>

  <FragmentStrip
    slug={quote.slug}
    subjects={quote.subjects}
    constellations={constellations}
    related={related}
    relatedTotal={relatedTotal}
    occurredAt={quote.occurredAt}
    precision={quote.precision}
    shareLabel="Share this quote"
    dateKind="added"
    datePrefix="Added"
    subjectView="quotes"
  />
</div>

---
/*
  PostCard — one essay in the blog feed (design.md §4, the Index).

  Adopts the constellation's reading surface (sky-lab round 2): the title + a
  faded, clamped excerpt form ONE reader trigger — click opens the in-context
  Reader (permalink is the no-JS fallback), and the pair warms toward lamplight
  on hover/focus. Unlike the constellation, the blog KEEPS its metadata — date,
  read time, and subjects (left-aligned) sit quietly as chrome (§7).

  ⚠ IT SAYS `Read →` NOW, AND IT USED NOT TO. This file argued the opposite for
  most of its life — *"there's no 'Read more' button: the fade + ellipsis is the
  invitation"* — and that was right about the FADE and wrong about who could see
  it. It is the same hole ADR-0022 found in the Sky: a gradient and a hover warm
  are both invisible to a thumb, so on a phone the feed was a list of titles with
  nothing saying which of them opened, and the excerpt's fade could as easily
  read as a styling choice. Michael, 2026-08-10: *"we're missing the Read button
  on the main blog portion."*

  ⚠ AND IT IS THE SUITE'S OWN WORD, DELIBERATELY — `.suite-cta`, the same
  `Read →` in the same serif small-caps that a constellation gives its openable
  stanzas. Inventing a second phrasing here would make one gesture look like two
  features. What differs is only the trigger for the warm: the suite has
  `.is-focus` (proximity on touch, cursor on desktop) and the feed has its own
  `.post-read` hover/focus-within, which is the pre-existing split between a room
  you scroll THROUGH and a list you point AT.

  When a search term is active it switches to the occurrence view: the title
  highlights its matches (and still opens the Reader), and the body becomes
  bounded, windowed excerpts around each match (search-highlight.ts — same engine
  + rules as the admin, see docs/search.md). The reader <template> always carries
  the full, un-highlighted essay.
*/
import Timestamp from './Timestamp.astro';
import PostArticle from './PostArticle.astro';
import FragmentStrip from './FragmentStrip.astro';
import Highlighted from './admin/Highlighted.astro';
import { highlight, excerpts, toPlain, MIN_SEARCH } from '../lib/search-highlight';
import type { WritingItem } from '../lib/blog';

interface Props {
  item: WritingItem;
  /** The active search term, when searching — drives match highlighting. */
  term?: string;
}
const { item, term = '' } = Astro.props;

const searching = term.trim().length >= MIN_SEARCH;
const titleSegs = searching ? highlight(item.title, term) : null;
const { windows, more } = searching ? excerpts(toPlain(item.bodyMarkdown), term) : { windows: [], more: 0 };
const showWindows = searching && windows.length > 0;
---

<article class="post-card py-9 first:pt-0">
  {
    /* The reading surface: title + excerpt warm together on hover/focus and open
      the Reader. The metadata sits inside so it warms with them, but stays its
      own (non-link) chrome. */
  }
  <div class="post-read">
    <h2 class="post-title font-display text-2xl leading-snug font-light sm:text-3xl">
      <a href={`/blog/${item.slug}`} data-read={item.slug}>
        {titleSegs ? <Highlighted segs={titleSegs} /> : item.title}
      </a>
    </h2>

    <div class="text-whisper mt-3 flex flex-wrap items-center gap-3 text-sm">
      <Timestamp
        date={item.occurredAt}
        updated={item.updatedAt ?? undefined}
        kind="posted"
        precision={item.precision}
      />
      <span class="font-sans">·</span>
      <span class="font-sans">{item.readMinutes} min read</span>
    </div>

    {
      showWindows ? (
        <div class="text-muted mt-4 space-y-1.5 font-serif leading-relaxed">
          {windows.map((w) => (
            <p>
              {w.lead && '… '}
              <Highlighted segs={w.segs} />
              {w.trail && ' …'}
            </p>
          ))}
          {more > 0 && (
            <p class="text-whisper font-sans text-xs">
              +{more} more {more === 1 ? 'match' : 'matches'}
            </p>
          )}
        </div>
      ) : (
        <a href={`/blog/${item.slug}`} data-read={item.slug} class="mt-4 block cursor-pointer">
          <p
            class:list={[
              'post-excerpt text-muted font-serif leading-relaxed',
              item.hasMore && 'post-excerpt-fade line-clamp-5',
            ]}
          >
            {item.excerpt}
          </p>
        </a>
      )
    }

    {
      /* aria-hidden + tabindex="-1": this duplicates the title's own link, which
        already carries the accessible name and the tab stop. Exactly the suite's
        reasoning, because it is exactly the suite's control. */
    }
    <a href={`/blog/${item.slug}`} data-read={item.slug} class="suite-cta post-cta" tabindex="-1" aria-hidden="true">
      <span class="suite-cta__word">Read</span>
      <span class="suite-cta__arrow">→</span>
    </a>
  </div>

  {
    /*
    ⚠ THE CARD CLOSES LIKE THE PIECE DOES (ADR-0023). This was a bare list of
    subjects with no rule — a third answer to "how does a fragment present its
    metadata", alongside the quote card's crammed figcaption and the opened
    view's ruled strip. Michael, 2026-08-10: *"I think we need to apply these
    changes to the blog view for the entries for writing/quotes."*

    ⚠ NO related/constellation CONTROLS, and no date. The controls belong to the
    opened fragment, where there is one of it — twenty-five "4 related lines"
    down the quotes view is a toolbar. The date is already in the head line
    above, which is where a card's "should I open this?" facts live.

    The subject CAP goes with the old list, deliberately: `+2` was there because
    a bare wrapping list had nothing to hold it. The strip is a two-column rule
    that already wraps, and a reader scanning a feed is better served by the
    tags than by a count of the ones being withheld.
  */
  }
  <FragmentStrip
    slug={item.slug}
    subjects={item.subjects}
    occurredAt={item.occurredAt}
    precision={item.precision}
    showDate={false}
    ruled={false}
    share={false}
    shareLabel="Share this piece"
  />

  {/* Full essay, cloned into the Reader on demand. Inert until then. */}
  <template data-reader-content={item.slug}>
    <PostArticle item={item} linkTitle />
  </template>
</article>

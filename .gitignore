# build output
dist/
.vercel/
# generated types
.astro/

# local Squarespace export — personal content (journal + letters); kept out of
# git history. The reflections import (scripts/) reads it locally, not from git.
legacy/

# local-only docs — internal strategy + a personal portrait. They live on disk
# and inform the work, but are deliberately kept out of the public repo.
about-michael.md
vision.md
design.md

# plan stubs — jumping-off notes for upcoming work, fleshed out one per
# conversation. Working thoughts, not documentation; docs/ holds what shipped.
docs/plans/

# dependencies
node_modules/

# Playwright — the e2e harness. `.auth/` holds a REAL admin session minted for
# the test run (see tests/e2e/auth.setup.ts); it is a live credential and must
# never be committed. `fixtures.json` names rows discovered in the live DB.
tests/e2e/.auth/
test-results/
playwright-report/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables — never commit secrets. .env.example is the tracked template.
.env
.env.*
!.env.example

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# Supabase CLI scratch — written by `supabase link`/`db push`, machine-local
# and not part of the schema record. `supabase/migrations/` is.
supabase/.temp/

# Copy this file to `.env.local` and fill in the values.
# `.env.local` is git-ignored; this template is committed so the required
# variables are documented (anti-drift). See docs/auth.md §Secrets.
#
# Rule: only PUBLIC_* variables may be referenced from client-side code.
#       Everything else is server-only and must never reach the browser.

# --- Supabase ---------------------------------------------------------------
PUBLIC_SUPABASE_URL="https://deodwnoztppvtrnehwzg.supabase.co"
# Publishable/anon key — safe in the browser; RLS restricts it to published rows.
PUBLIC_SUPABASE_ANON_KEY="sb_publishable_xxxxxxxx"
# SERVER ONLY. Bypasses RLS. Used only in trusted server scripts (e.g. seeds).
# Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=""

# --- Auth ------------------------------------------------------------------
# Auth is Supabase Auth (Google OAuth + passkeys). No extra keys needed: the
# Google client ID/secret are configured in the Supabase dashboard, and auth
# uses the PUBLIC_SUPABASE_* values above. See docs/auth.md.

# --- AI ---------------------------------------------------------------------
# SERVER ONLY. Powers the admin "Suggest subjects" button (Claude Haiku 4.5).
# Absent = the button degrades gracefully (manual tagging still works).
# console.anthropic.com → API keys.
ANTHROPIC_API_KEY=""

# --- Contact form -----------------------------------------------------------
# The public /about "Say hello" form: email delivery via Resend, spam-guarded
# by Cloudflare Turnstile. If these are absent the form still renders, but
# submitting returns "not configured yet" (and Turnstile is skipped in dev).

# SERVER ONLY. resend.com → API Keys.
RESEND_API_KEY=""
# Where messages are delivered (your inbox).
CONTACT_TO_EMAIL="you@example.com"
# Optional From address — must be on a domain verified in Resend. Defaults to
# Resend's shared onboarding@resend.dev (fine for a first end-to-end test).
CONTACT_FROM_EMAIL=""

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile). The site key is PUBLIC
# (embedded in the widget); the secret key is SERVER ONLY.
PUBLIC_TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""

# --- Google Calendar (HQ · docs/plans/13-agenda.md §2) -----------------------
# SERVER ONLY. A read-only one-way mirror of the primary personal calendar.
#
# OAuth, with the app PUBLISHED to production. Publishing is what matters: an
# app left in "Testing" issues refresh tokens that expire after 7 days, which
# would break an unattended sync every week. Published, consent happens once and
# the refresh token does not expire. Google shows an "unverified app" screen at
# that one consent (Advanced → Go to …) and nothing after; no verification
# review was required for a single-user app.
#
# Two approaches were tried and rejected, so they don't get re-proposed:
#   · service account + calendar sharing — the ACL never lands on a consumer
#     gmail.com calendar (404 on every read). Works only for Workspace.
#   · the secret ICS URL — no auth at all, but Google refreshes that feed on a
#     delay of hours, and Today's whole job is "what is my day".
#
# Client type is "Desktop app", so the one-time consent can use a 127.0.0.1
# loopback redirect with no redirect URI to configure.
# console.cloud.google.com → APIs & Services → Credentials.
GOOGLE_OAUTH_CLIENT_ID=""
GOOGLE_OAUTH_CLIENT_SECRET=""
# Obtained once via the consent flow with access_type=offline. A LIVE credential:
# it reads the calendar indefinitely with no further interaction.
GOOGLE_OAUTH_REFRESH_TOKEN=""
# The calendar to read: the owner's email address — NOT the literal "primary",
# which resolves elsewhere and returns zero events with no error.
GOOGLE_CALENDAR_ID=""
